#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#==========================================================================
# PROCESS:    API.GCP.LoadServiceAccount
# PURPOSE:    Load GBQ service account JSON key file into }GCP_Service_Account cube
# DEVELOPER:  Steve Waterbury
# DATE:       2026-03-25
#
# CHANGE HISTORY:
# 2026-03-25 | Steve Waterbury | Initial creation
### 2026-04-01         Steve Waterbury    Code formatting: multi-line IF blocks, NumberToString -> STR
#
# PARAMETERS:
#   pFileName - Name of JSON key file in the server file store
#               (upload via PAW Files > Import before running)
#
# NOTES:
#   - Reads file as ASCII datasource, accumulates all lines, parses with JsonGet
#   - Converts literal \n in private_key to actual newlines for JwtCreate
#   - Writes all 11 fields to }GCP_Service_Account cube
#==========================================================================

# --- Logging setup ---
sProcess = GetProcessName();
sLogLevel = CellGetS('ProcessControl', sProcess, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo  = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo  = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;

IF(pFileName @= '');
  LogOutput('ERROR', sProcess | ' | pFileName parameter is empty - aborting.');
  ProcessError;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | Loading GBQ service account from file: ' | pFileName);
ENDIF;

# Initialize accumulator for JSON content
sFullJson = '';

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****

# Accumulate each line of the JSON file into a single string
sFullJson = sFullJson | ' ' | vLine;

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****

# --- Logging setup (re-read in epilog scope) ---
sProcess = GetProcessName();
sLogLevel = CellGetS('ProcessControl', sProcess, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo  = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo  = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;

IF(sFullJson @= '');
  LogOutput('ERROR', sProcess | ' | No data read from file - check file path and contents.');
  ProcessError;
ENDIF;

IF(bLogDebug = 1);
  LogOutput('DEBUG', sProcess | ' | Accumulated JSON length: ' | TRIM(STR(LONG(sFullJson), 10, 0)));
ENDIF;

# ===========================================================
# Parse each field from the JSON
# ===========================================================

sCube = '}GCP_Service_Account';
sMeasure = 'Value';

# 1. type
sVal = JsonGet(sFullJson, 'type');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'type', sMeasure);

# 2. project_id
sVal = JsonGet(sFullJson, 'project_id');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'project_id', sMeasure);

# 3. private_key_id
sVal = JsonGet(sFullJson, 'private_key_id');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'private_key_id', sMeasure);

# 4. private_key (special handling for \n)
sVal = JsonGet(sFullJson, 'private_key');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;

# Replace literal \n (backslash + n) with actual newline CHAR(10)
sBackslash = CHAR(92);
sEscN = sBackslash | 'n';
nPos = SCAN(sEscN, sVal);
WHILE(nPos > 0);
  sVal = SUBST(sVal, 1, nPos - 1) | CHAR(10) | SUBST(sVal, nPos + 2, LONG(sVal) - nPos - 1);
  nPos = SCAN(sEscN, sVal);
END;
CellPutS(sVal, sCube, 'private_key', sMeasure);

IF(bLogDebug = 1);
  LogOutput('DEBUG', sProcess | ' | private_key loaded, length after newline conversion: ' | TRIM(STR(LONG(sVal), 10, 0)));
ENDIF;

# 5. client_email
sVal = JsonGet(sFullJson, 'client_email');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'client_email', sMeasure);

# 6. client_id
sVal = JsonGet(sFullJson, 'client_id');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'client_id', sMeasure);

# 7. auth_uri
sVal = JsonGet(sFullJson, 'auth_uri');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'auth_uri', sMeasure);

# 8. token_uri
sVal = JsonGet(sFullJson, 'token_uri');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'token_uri', sMeasure);

# 9. auth_provider_x509_cert_url
sVal = JsonGet(sFullJson, 'auth_provider_x509_cert_url');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'auth_provider_x509_cert_url', sMeasure);

# 10. client_x509_cert_url
sVal = JsonGet(sFullJson, 'client_x509_cert_url');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'client_x509_cert_url', sMeasure);

# 11. universe_domain
sVal = JsonGet(sFullJson, 'universe_domain');
IF(SUBST(sVal, 1, 1) @= '"');
  sVal = SUBST(sVal, 2, LONG(sVal) - 2);
ENDIF;
CellPutS(sVal, sCube, 'universe_domain', sMeasure);

IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | All 11 fields loaded into }GCP_Service_Account cube.');
  LogOutput('INFO', sProcess | ' | Process completed successfully.');
ENDIF;

#endregion