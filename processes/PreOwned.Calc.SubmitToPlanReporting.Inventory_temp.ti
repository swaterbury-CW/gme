#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-08
# LAST UPDATE: 2026-05-08
# CHANGED BY: Steve Waterbury
# COMMENTS: Worker. Submits Merch PreOwned Inventory -> Merch Plan Reporting.
# CHANGE HISTORY:
#   2026-05-08 | Steve Waterbury | Creation. Design plan e6010c9bdb78.
#   2026-05-08 | Steve Waterbury | Default-hier ELCOMP descent (per design).
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START ' | cProcessName | ' V=' | pVersion | ' Cat=' | pPreOwnedCategory); ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pVersion: ' | pVersion);
  ProcessError;
ENDIF;
IF(pPreOwnedCategory @= '' % DIMIX('Merch PreOwned Category', pPreOwnedCategory) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pPreOwnedCategory: ' | pPreOwnedCategory);
  ProcessError;
ENDIF;

sSrcCube = 'Merch PreOwned Inventory';
sDstCube = 'Merch Plan Reporting';
sCubeSplit = 'Merch Channel Split';
sViewName = 'temp_PreOwnedSubmit_Inventory';

sMDX = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch PreOwned Inventory Measure].[Merch PreOwned Inventory Measure])},0)} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period].[Merch Time Period])},0)} * {Descendants([Merch PreOwned Category].[Merch PreOwned Category].[' | pPreOwnedCategory | '],99,SELF_AND_BEFORE)} ON ROWS FROM [Merch PreOwned Inventory] WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';

IF(ViewExists(sSrcCube, sViewName) = 1); ViewDestroy(sSrcCube, sViewName); ENDIF;
ViewCreateByMDX(sSrcCube, sViewName, sMDX);
DatasourceType = 'VIEW';
DatasourceNameForServer = sSrcCube;
DatasourceCubeview = sViewName;
nWritten = 0;
nSkipped = 0;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(Value = 0); ItemSkip; ENDIF;

sTargetMeasure = ATTRS('Merch PreOwned Inventory Measure', vMerch_PreOwned_Inventory_Measure, 'Plan Reporting Measure');
IF(Trim(sTargetMeasure) @= ''); nSkipped = nSkipped + 1; ItemSkip; ENDIF;
IF(DIMIX('Merch Plan Reporting Measure', sTargetMeasure) = 0);
  LogOutput('ERROR', cProcessName | ' | Unmapped measure ' | vMerch_PreOwned_Inventory_Measure | ' -> ' | sTargetMeasure);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

sTargetSKU = vMerch_PreOwned_Category;
nGuard = 0;
WHILE(DIMIX('Merch SKU', sTargetSKU) > 0
      & DTYPE('Merch SKU', sTargetSKU) @= 'C'
      & nGuard < 20);
  sTargetSKU = ELCOMP('Merch SKU', sTargetSKU, 1);
  nGuard = nGuard + 1;
END;
IF(DIMIX('Merch SKU', sTargetSKU) = 0);
  LogOutput('ERROR', cProcessName | ' | No Merch SKU match for ' | vMerch_PreOwned_Category);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

sLifecycle = ATTRS('Merch SKU', sTargetSKU, 'Lifecycle_Status_Description');
IF(Trim(sLifecycle) @= '' % DIMIX('Merch Lifecycle', sLifecycle) = 0); sLifecycle = 'Active'; ENDIF;

nApplySplit = ATTRN('Merch PreOwned Inventory Measure', vMerch_PreOwned_Inventory_Measure, 'Apply Channel Split');
sCategoryForSplit = ATTRS('Merch PreOwned Category', vMerch_PreOwned_Category, 'SGM_Category_Group');

nChDim = DIMSIZ('Merch Channel');
i = 1;
WHILE(i <= nChDim);
  sCh = DIMNM('Merch Channel', i);
  IF(ELLEV('Merch Channel', sCh) = 0);
    nOut = Value;
    bWrite = 1;
    IF(nApplySplit = 1);
      IF(DIMIX('Merch Category', sCategoryForSplit) > 0);
        nSplit = CellGetN(sCubeSplit, pVersion, vMerch_Time_Period, sCategoryForSplit, sCh, 'Split Pct');
        IF(nSplit = 0); bWrite = 0; ENDIF;
        nOut = Value * nSplit;
      ELSE;
        bWrite = 0;
      ENDIF;
    ENDIF;
    IF(bWrite = 1);
      IF(CellIsUpdateable(sDstCube, pVersion, vMerch_Time_Period, sTargetSKU, sCh, sLifecycle, sTargetMeasure) = 1);
        CellPutN(nOut, sDstCube, pVersion, vMerch_Time_Period, sTargetSKU, sCh, sLifecycle, sTargetMeasure);
        nWritten = nWritten + 1;
      ELSE;
        LogOutput('ERROR', cProcessName | ' | Not updateable: ' | sTargetSKU | '/' | sCh | '/' | sTargetMeasure);
      ENDIF;
    ENDIF;
  ENDIF;
  i = i + 1;
END;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(sSrcCube, sViewName) = 1); ViewDestroy(sSrcCube, sViewName); ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END ' | cProcessName | ' Written=' | TRIM(STR(nWritten, 10, 0)) | ' Skipped=' | TRIM(STR(nSkipped, 10, 0)));
ENDIF;

#endregion