#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-11
# LAST UPDATE: 2026-05-11
# CHANGED BY: Steve Waterbury
# COMMENTS:
# Copies Merch Budget Staging onward into Merch Forecast and Merch Plan Reporting
# at the Budget (Static) version. Driven by 'Forecast Measure Map' and
# 'Plan Reporting Measure Map' string attributes on Merch Budget Measure.
# RATE-FORM: when the target measure is 'Full Price AUR' or 'Base AUC', the
# loader divides the staged dollar by sales_units and writes a per-unit rate.
# Base Revenue / Base Cost derive from the rate writes via cube N rules.
# Plan Reporting writes channel-spread via Merch Channel Split [Split Pct]; SKU
# category resolved via SGM_Category alt hier on Merch SKU.
# CHANGE HISTORY:
#   2026-05-11 | Steve Waterbury | Initial creation
#EndRegion

cProcessName = GetProcessName();

#Region : Logging
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
#EndRegion

#Region : Validation
IF(pSourceVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pSourceVersion empty');
  ProcessError;
ENDIF;
IF(pTargetVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pTargetVersion empty');
  ProcessError;
ENDIF;
IF(pTimePeriod @= '');
  LogOutput('ERROR', cProcessName | ' | pTimePeriod empty');
  ProcessError;
ENDIF;
IF(pLifecycle @= '');
  LogOutput('ERROR', cProcessName | ' | pLifecycle empty');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pSourceVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Bad source version: ' | pSourceVersion);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pTargetVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Bad target version: ' | pTargetVersion);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Bad time period: ' | pTimePeriod);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Lifecycle', pLifecycle) = 0);
  LogOutput('ERROR', cProcessName | ' | Bad lifecycle: ' | pLifecycle);
  ProcessError;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Src=' | pSourceVersion | ' Tgt=' | pTargetVersion | ' Time=' | pTimePeriod | ' Lifecycle=' | pLifecycle);
ENDIF;

cSrcCube   = 'Merch Budget Staging';
cFcstCube  = 'Merch Forecast';
cPRCube    = 'Merch Plan Reporting';
cSplitCube = 'Merch Channel Split';
cMeasDim   = 'Merch Budget Measure';

nRecordCount = 0;
nFcstWritten = 0;
nPRWritten = 0;
nFcstBlocked = 0;
nPRBlocked = 0;
nUnmapped = 0;
nZeroUnitsSkip = 0;

#Region : Build TM1CubeView
sView = 'TI_BudgetToFcst_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Budget Measure])},0)} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[' | pTimePeriod | '])},0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])},0)} ON ROWS FROM [Merch Budget Staging] WHERE ([Merch Version].[' | pSourceVersion | '])';
ViewCreateByMDX(cSrcCube, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cSrcCube, sView, 0);
ViewExtractSkipZeroesSet(cSrcCube, sView, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = cSrcCube;
DatasourceCubeview = sView;
#EndRegion
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
# No metadata-phase work — all dim members are pre-existing.
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Per-Row Load
nRecordCount = nRecordCount + 1;

nVal = CellGetN(cSrcCube, pSourceVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Budget_Measure);
IF(nVal = 0);
  ItemSkip;
ENDIF;

sFcstMeas = ATTRS(cMeasDim, vMerch_Budget_Measure, 'Forecast Measure Map');
sPRMeas   = ATTRS(cMeasDim, vMerch_Budget_Measure, 'Plan Reporting Measure Map');
IF(sFcstMeas @= '' & sPRMeas @= '');
  nUnmapped = nUnmapped + 1;
  ItemSkip;
ENDIF;

bIsRate = 0;
IF(sFcstMeas @= 'Full Price AUR' % sFcstMeas @= 'Base AUC');
  bIsRate = 1;
ENDIF;
nWriteVal = nVal;
IF(bIsRate = 1);
  nUnits = CellGetN(cSrcCube, pSourceVersion, vMerch_Time_Period, vMerch_SKU, 'sales_units');
  IF(nUnits = 0);
    nZeroUnitsSkip = nZeroUnitsSkip + 1;
    ItemSkip;
  ENDIF;
  nWriteVal = nVal \ nUnits;
ENDIF;

IF(sFcstMeas @<> '' & DIMIX('Merch Forecast Measure', sFcstMeas) > 0);
  IF(CellIsUpdateable(cFcstCube, pTargetVersion, vMerch_Time_Period, vMerch_SKU, sFcstMeas) = 1);
    CellPutN(nWriteVal, cFcstCube, pTargetVersion, vMerch_Time_Period, vMerch_SKU, sFcstMeas);
    nFcstWritten = nFcstWritten + 1;
  ELSE;
    nFcstBlocked = nFcstBlocked + 1;
  ENDIF;
ENDIF;

IF(sPRMeas @<> '' & DIMIX('Merch Plan Reporting Measure', sPRMeas) > 0);
  sCategory = '';
  IF(HierarchyElementExists('Merch SKU', 'SGM_Category', vMerch_SKU) = 1);
    sCategory = ElementParent('Merch SKU', 'SGM_Category', vMerch_SKU, 1);
  ENDIF;
  IF(sCategory @<> '' & DIMIX('Merch Category', sCategory) > 0);
    nChIdx = 1;
    WHILE(nChIdx <= 7);
      IF(nChIdx = 1);
        sChan = 'Retail';
      ELSEIF(nChIdx = 2);
        sChan = 'Ecom';
      ELSEIF(nChIdx = 3);
        sChan = 'GEEK';
      ELSEIF(nChIdx = 4);
        sChan = 'SPEC';
      ELSEIF(nChIdx = 5);
        sChan = 'STOR';
      ELSEIF(nChIdx = 6);
        sChan = 'VIRT';
      ELSE;
        sChan = 'WHSE';
      ENDIF;
      nPct = CellGetN(cSplitCube, pTargetVersion, vMerch_Time_Period, sCategory, sChan, 'Split Pct');
      IF(nPct <> 0);
        IF(CellIsUpdateable(cPRCube, pTargetVersion, vMerch_Time_Period, vMerch_SKU, sChan, pLifecycle, sPRMeas) = 1);
          CellPutN(nWriteVal * nPct, cPRCube, pTargetVersion, vMerch_Time_Period, vMerch_SKU, sChan, pLifecycle, sPRMeas);
          nPRWritten = nPRWritten + 1;
        ELSE;
          nPRBlocked = nPRBlocked + 1;
        ENDIF;
      ENDIF;
      nChIdx = nChIdx + 1;
    END;
  ENDIF;
ENDIF;
#EndRegion
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSrcCube, sView) = 1);
  ViewDestroy(cSrcCube, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Records=' | TRIM(STR(nRecordCount,10,0)) | ' | FcstWritten=' | TRIM(STR(nFcstWritten,10,0)) | ' | PRWritten=' | TRIM(STR(nPRWritten,10,0)) | ' | FcstBlocked=' | TRIM(STR(nFcstBlocked,10,0)) | ' | PRBlocked=' | TRIM(STR(nPRBlocked,10,0)) | ' | Unmapped=' | TRIM(STR(nUnmapped,10,0)) | ' | ZeroUnitsSkip=' | TRIM(STR(nZeroUnitsSkip,10,0)));
ENDIF;
#endregion