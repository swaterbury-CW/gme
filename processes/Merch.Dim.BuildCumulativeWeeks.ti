#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-25
# LAST UPDATE: 2026-04-01
# COMMENTS:
# Cross-year cumulative Thru elements. Cleans edges, rebuilds nested.
# Sets Prior Cumulative on every leaf week — first week of each year
# points to prior year's last Thru (e.g. FY26-W01 -> Thru FY25-W52).
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-03-25         Steve Waterbury    Cross-year; nested; edge cleanup; leaf attr fix
### 2026-04-01         Steve Waterbury    Applied guardrails header template
#
#EndRegion

sLogLevel = CellGetS('ProcessControl', GetProcessName(), 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0; IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
bLogDebug = 0; IF(sLogLevel @= 'DEBUG'); bLogDebug = 1; ENDIF;

sDim = 'Merch Time Period';
IF(DIMIX('}ElementAttributes_Merch Time Period', 'Prior Cumulative') = 0);
  AttrInsert(sDim, 'Previous Week', 'Prior Cumulative', 'S');
ENDIF;

#Region : Auto-detect FY range
nEarliestYear = 9999;
nLatestYear = 0;
nDimSize = DIMSIZ(sDim);
nScan = 1;
WHILE(nScan <= nDimSize);
    sEl = DIMNM(sDim, nScan);
    IF(LONG(sEl) = 6 & SUBST(sEl, 1, 2) @= 'FY' & DTYPE(sDim, sEl) @= 'C');
        nYr = NUMBR(SUBST(sEl, 3, 4));
        IF(nYr < 100); nYr = 2000 + nYr; ENDIF;
        IF(nYr < nEarliestYear); nEarliestYear = nYr; ENDIF;
        IF(nYr > nLatestYear); nLatestYear = nYr; ENDIF;
    ENDIF;
    nScan = nScan + 1;
END;
IF(pStartYear @<> ''); nOverride = NUMBR(pStartYear); IF(nOverride > 0); nEarliestYear = nOverride; ENDIF; ENDIF;
IF(pEndYear @<> ''); nOverride = NUMBR(pEndYear); IF(nOverride > 0); nLatestYear = nOverride; ENDIF; ENDIF;
IF(nEarliestYear = 9999 % nLatestYear = 0);
    LogOutput('ERROR', GetProcessName() | ' | No fiscal years found');
    ProcessQuit;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
    LogOutput('INFO', GetProcessName() | ' | START - FY' | TRIM(STR(nEarliestYear, 4, 0)) | ' through FY' | TRIM(STR(nLatestYear, 4, 0)));
ENDIF;

#Region : Cleanup existing Thru edges
nClean = 1;
WHILE(nClean <= nDimSize);
    sEl = DIMNM(sDim, nClean);
    IF(SUBST(sEl, 1, 5) @= 'Thru ' & DTYPE(sDim, sEl) @= 'C');
        nChildren = ELCOMPN(sDim, sEl);
        WHILE(nChildren > 0);
            sChild = ELCOMP(sDim, sEl, 1);
            DimensionElementComponentDeleteDirect(sDim, sEl, sChild);
            nChildren = nChildren - 1;
        END;
    ENDIF;
    nClean = nClean + 1;
END;
#EndRegion

#Region : Build cross-year Thru + set Prior Cumulative on every leaf
sPriorThru = '';
nTotalCreated = 0;

nYear = nEarliestYear;
WHILE(nYear <= nLatestYear);
    sFY = 'FY' | SUBST(TRIM(STR(nYear, 4, 0)), 3, 2);
    nMaxWeek = 52;
    IF(DIMIX(sDim, sFY | '-W53') > 0); nMaxWeek = 53; ENDIF;

    nWeek = 1;
    WHILE(nWeek <= nMaxWeek);
        IF(nWeek < 10);
            sWeekEl = sFY | '-W0' | TRIM(STR(nWeek, 1, 0));
        ELSE;
            sWeekEl = sFY | '-W' | TRIM(STR(nWeek, 2, 0));
        ENDIF;

        IF(DIMIX(sDim, sWeekEl) > 0);
            sThruEl = 'Thru ' | sWeekEl;

            IF(DIMIX(sDim, sThruEl) = 0);
                DimensionElementInsertDirect(sDim, '', sThruEl, 'C');
                nTotalCreated = nTotalCreated + 1;
            ENDIF;

            ### Nested children: prior Thru + current week
            IF(sPriorThru @<> '' & DIMIX(sDim, sPriorThru) > 0);
                DimensionElementComponentAddDirect(sDim, sThruEl, sPriorThru, 1);
            ENDIF;
            DimensionElementComponentAddDirect(sDim, sThruEl, sWeekEl, 1);

            ### Set Prior Cumulative attribute on the LEAF WEEK
            ### FY26-W01 → Thru FY25-W52 (crosses years)
            ### FY15-W01 (earliest) → empty (no prior)
            AttrPutS(sPriorThru, sDim, sWeekEl, 'Prior Cumulative');

            IF(bLogDebug = 1);
                LogOutput('DEBUG', GetProcessName() | ' | ' | sWeekEl | ' PriorCum=' | sPriorThru);
            ENDIF;

            sPriorThru = sThruEl;
        ENDIF;

        nWeek = nWeek + 1;
    END;

    nYear = nYear + 1;
END;
#EndRegion

IF(bLogInfo = 1);
    LogOutput('INFO', GetProcessName() | ' | COMPLETE - ' | TRIM(STR(nTotalCreated, 6, 0)) | ' new Thru elements, cross-year');
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion