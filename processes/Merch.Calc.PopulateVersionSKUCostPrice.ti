#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-11
# LAST UPDATE: 2026-04-11
# COMMENTS:
# Populates Cost and Sales_Price in Merch Version SKU Attributes
# from Merch SKU dimension attributes.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-04-11         Steve Waterbury    Initial creation
#
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' pVersion=' | pVersion);
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid version: ' | pVersion);
  ProcessQuit;
ENDIF;
sCube = 'Merch Version SKU Attributes';
nWritten = 0;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ELLEV('Merch SKU', vSKU) = 0);
  nCost = ATTRN('Merch SKU', vSKU, 'Cost');
  IF(nCost <> 0);
    IF(CellIsUpdateable(sCube, pVersion, vSKU, 'Cost') = 1);
      CellPutN(nCost, sCube, pVersion, vSKU, 'Cost');
      nWritten = nWritten + 1;
    ENDIF;
  ENDIF;
  nPrice = ATTRN('Merch SKU', vSKU, 'Sales_Price');
  IF(nPrice <> 0);
    IF(CellIsUpdateable(sCube, pVersion, vSKU, 'Sales_Price') = 1);
      CellPutN(nPrice, sCube, pVersion, vSKU, 'Sales_Price');
      nWritten = nWritten + 1;
    ENDIF;
  ENDIF;
ENDIF;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' Written=' | TRIM(STR(nWritten, 10, 0)));
ENDIF;
#endregion