#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# PROCESS    : Merch.Period.Close.Finalize
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-06-04
# CHANGED BY : Steve Waterbury
# PURPOSE    : Once-per-close finalization. (1) Reloads ALL closed periods'
#              actuals (Epilog loop over closed weeks -> Merch.Load.ActualsToForecast
#              per week). (2) Rebuilds the full closed-period feed. (3) Refreshes
#              ALL time-bearing security overlays so closed periods lock.
#              Called by Merch.Period.Close (pFinalize=1) and once by
#              Merch.Period.Close.Range. Idempotent. No datasource.
# PARAMS     : pVersion (Calculated Merch Version), required.
# CHANGE HISTORY:
#   2026-06-04  Steve Waterbury  Initial creation (design plan 6ff6ede1e816, EP3)
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'INFO';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | pVersion not found: ' | pVersion);
  ProcessError;
ENDIF;
IF(ATTRS('Merch Version', pVersion, 'Version_Type') @<> 'Calculated');
  LogOutput('ERROR', cProcessName | ' | pVersion is not Calculated: ' | pVersion);
  ProcessError;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | pVersion=' | pVersion);
ENDIF;

nLCP = ATTRN('Merch Version', pVersion, 'Last_Closed_Period');
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
# (1) Reload all CLOSED periods' actuals. Iterate Merch Time Period LEAVES here in
#     the Epilog (TI ATTRN is valid in TI code; loop in Epilog avoids the Prolog
#     element-iteration guardrail). Call the existing, unmodified loader per week.
nReloaded = 0;
nTP = DIMSIZ('Merch Time Period');
nI = 1;
WHILE(nI <= nTP);
  sWeek = DIMNM('Merch Time Period', nI);
  IF(DTYPE('Merch Time Period', sWeek) @= 'N');
    nStart = ATTRN('Merch Time Period', sWeek, 'Start_Date');
    IF(nStart > 0 & nStart <= nLCP);
      ExecuteProcess('Merch.Load.ActualsToForecast', 'pTimePeriod', sWeek);
      nReloaded = nReloaded + 1;
    ENDIF;
  ENDIF;
  nI = nI + 1;
END;

# (2) Rebuild the full closed-period feed (blank pPeriod = all closed).
ExecuteProcess('Merch.Feed.LoadClosedPeriods', 'pVersion', pVersion, 'pPeriod', '');

# (3) Refresh ALL time-bearing security overlays so closed periods lock per LCP.
#     Data-driven loop over }Cubes (folded in here; no separate wrapper process).
nOverlays = 0;
nC = 1;
nCubes = DIMSIZ('}Cubes');
WHILE(nC <= nCubes);
  sCube = DIMNM('}Cubes', nC);
  IF(SUBST(sCube, 1, 1) @<> '}');
    IF(CubeExists('}SecurityOverlayGlobal_' | sCube) = 1);
      bHasTime = 0;
      nD = 1;
      sD = TABDIM(sCube, nD);
      WHILE(sD @<> '');
        IF(sD @= 'Merch Time Period');
          bHasTime = 1;
        ENDIF;
        nD = nD + 1;
        sD = TABDIM(sCube, nD);
      END;
      IF(bHasTime = 1);
        ExecuteProcess('Merch.Security.RefreshOverlays', 'pCube', sCube);
        nOverlays = nOverlays + 1;
      ENDIF;
    ENDIF;
  ENDIF;
  nC = nC + 1;
END;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | pVersion=' | pVersion | ' | WeeksReloaded=' | TRIM(STR(nReloaded, 10, 0)) | ' | OverlaysRefreshed=' | TRIM(STR(nOverlays, 10, 0)));
ENDIF;
#endregion