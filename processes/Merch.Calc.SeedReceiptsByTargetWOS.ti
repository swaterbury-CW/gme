#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-23
# LAST UPDATE: 2026-05-04
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Seeds Merch Forecast Receipts where weekly WOS (OI / Expected Calc Sales)
# drops below SKU-level Target_WOS_Applied. Receipt sized to bring OI up to
# the cumulative sum of Expected Calc Sales over the next Target_WOS_Applied
# weeks, rounded up to MOQ multiples. Skips SKUs whose version-level
# Is Replenishable is not 'Y' or whose MOQ is not positive.
#
# Datasource: TM1CubeView on Merch Version SKU Attributes, NON EMPTY on
# Target_WOS_Applied. Uses Expected Calc Sales (unconstrained demand) as the
# WOS denominator and forward-demand source so the seeder isn't tricked by
# the supply-constrained Calc Units rule.
#
#### CHANGE HISTORY:
### 2026-04-23  Steve Waterbury  Initial creation (TM1DimensionSubset)
### 2026-04-29  Steve Waterbury  Master_Pack_Quanity typo fix
### 2026-05-02  Steve Waterbury  DEBUG instrumentation + Is Replenishable gate
### 2026-05-04  Steve Waterbury  v2: TM1CubeView datasource + per-week WOS gate; remove ItemReject
### 2026-05-04  Steve Waterbury  v3: Expected Calc Sales as demand input; receipt sized to cumulative
###                              forward sum of ECS over target_WOS weeks.
#EndRegion

cCubeForecast = 'Merch Forecast';
cCubeAttrs    = 'Merch Version SKU Attributes';
cDimVersion   = 'Merch Version';
cDimSKU       = 'Merch SKU';
cDimTP        = 'Merch Time Period';
cAttrLCP      = 'Last_Closed_Period';
cAttrNextWk   = 'Next Week';
cMeasTgtWOS   = 'Target_WOS_Applied';
cMeasMOQ      = 'Master_Pack_Quantity';
cMeasReceipts = 'Receipts';
cMeasOI       = 'Opening Inventory';
cMeasECS      = 'Expected Calc Sales';
cMeasIsReplen = 'Is Replenishable';

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | SKU=' | pSKU | ' | Category=' | pCategory | ' | Overwrite=' | pOverwrite);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX(cDimVersion, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version missing: ' | pVersion);
  ProcessError;
ENDIF;
IF(pOverwrite @= '');
  pOverwrite = 'N';
ENDIF;
IF(pOverwrite @<> 'Y' & pOverwrite @<> 'N');
  LogOutput('ERROR', cProcessName | ' | pOverwrite must be Y or N');
  ProcessError;
ENDIF;

nLCP = ATTRN(cDimVersion, pVersion, cAttrLCP);
IF(nLCP = 0);
  LogOutput('ERROR', cProcessName | ' | Last_Closed_Period not set on version ' | pVersion);
  ProcessError;
ENDIF;
sFirstOpenTP = TIMST(nLCP + 7, '\Y-\m-\d');
IF(DIMIX(cDimTP, sFirstOpenTP) = 0);
  LogOutput('ERROR', cProcessName | ' | First open week not found: ' | sFirstOpenTP);
  ProcessError;
ENDIF;

IF(pSKU @<> '');
  IF(DIMIX(cDimSKU, pSKU) = 0);
    LogOutput('ERROR', cProcessName | ' | SKU not found: ' | pSKU);
    ProcessError;
  ENDIF;
  sSkuSet = '{[Merch SKU].[Merch SKU].[' | pSKU | ']}';
ELSE;
  IF(pCategory @<> '');
    sSkuSet = 'FILTER(TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])},0), [Merch SKU].[Merch SKU].CurrentMember.Properties("SGM Category") = "' | pCategory | '")';
  ELSE;
    sSkuSet = 'TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])},0)';
  ENDIF;
ENDIF;

sViewName = 'TI_SeedReceiptsByTargetWOS';
IF(ViewExists(cCubeAttrs, sViewName) = 1);
  ViewDestroy(cCubeAttrs, sViewName);
ENDIF;
sMdxQuery = 'SELECT NON EMPTY {[Merch Version SKU Attribute Measure].[Merch Version SKU Attribute Measure].[Target_WOS_Applied]} ON COLUMNS, NON EMPTY {' | sSkuSet | '} ON ROWS FROM [Merch Version SKU Attributes] WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
ViewCreateByMDX(cCubeAttrs, sViewName, sMdxQuery, 1);
ViewExtractSkipCalcsSet(cCubeAttrs, sViewName, 0);
ViewExtractSkipZeroesSet(cCubeAttrs, sViewName, 1);
ViewSuppressZeroesSet(cCubeAttrs, sViewName, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = cCubeAttrs;
DatasourceCubeview = sViewName;

IF(bLogDebug = 1);
  LogOutput('DEBUG', cProcessName | ' | BIND | View=' | sViewName | ' | Cube=' | cCubeAttrs | ' | LCP=' | TRIM(STR(nLCP, 20, 0)) | ' | FirstOpenTP=' | sFirstOpenTP | ' | MDX=' | sMdxQuery);
ENDIF;

nSkuProcessed = 0;
nSkuSkipped = 0;
nReceiptsWritten = 0;
nReceiptsCleared = 0;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sSKU = vMerch_SKU;
nTargetWOS = CellGetN(cCubeAttrs, pVersion, sSKU, cMeasTgtWOS);
nMOQ = CellGetN(cCubeAttrs, pVersion, sSKU, cMeasMOQ);
sIsReplen = CellGetS(cCubeAttrs, pVersion, sSKU, cMeasIsReplen);

IF(bLogDebug = 1);
  LogOutput('DEBUG', cProcessName | ' | SKU_START | SKU=' | sSKU | ' | TargetWOS=' | TRIM(STR(nTargetWOS, 20, 4)) | ' | MOQ=' | TRIM(STR(nMOQ, 20, 0)) | ' | IsReplen=' | sIsReplen);
ENDIF;

IF(nTargetWOS <= 0);
  nSkuSkipped = nSkuSkipped + 1;
  ItemSkip;
ENDIF;
IF(sIsReplen @<> 'Y');
  nSkuSkipped = nSkuSkipped + 1;
  ItemSkip;
ENDIF;
IF(nMOQ <= 0);
  nSkuSkipped = nSkuSkipped + 1;
  ItemSkip;
ENDIF;

nTargetWOSInt = INT(nTargetWOS);
IF(nTargetWOSInt < 1);
  nTargetWOSInt = 1;
ENDIF;

IF(pOverwrite @= 'Y');
  sTPClr = sFirstOpenTP;
  WHILE(sTPClr @<> '');
    IF(CellIsUpdateable(cCubeForecast, pVersion, sTPClr, sSKU, cMeasReceipts) = 1);
      CellPutN(0, cCubeForecast, pVersion, sTPClr, sSKU, cMeasReceipts);
      nReceiptsCleared = nReceiptsCleared + 1;
    ENDIF;
    sTPClr = ATTRS(cDimTP, sTPClr, cAttrNextWk);
  END;
ENDIF;

sTP = sFirstOpenTP;
WHILE(sTP @<> '');
  nOI = CellGetN(cCubeForecast, pVersion, sTP, sSKU, cMeasOI);
  nECS = CellGetN(cCubeForecast, pVersion, sTP, sSKU, cMeasECS);
  nWOS = 0;
  nFwdSum = 0;
  nDeficit = 0;
  nReceipt = 0;
  sOutcome = 'NO_DEMAND';
  IF(nECS > 0);
    nWOS = nOI \ nECS;
    IF(nWOS < nTargetWOS);
      sTPFwd = sTP;
      k = 0;
      WHILE(k < nTargetWOSInt & sTPFwd @<> '');
        nFwdSum = nFwdSum + CellGetN(cCubeForecast, pVersion, sTPFwd, sSKU, cMeasECS);
        sTPFwd = ATTRS(cDimTP, sTPFwd, cAttrNextWk);
        k = k + 1;
      END;
      nDeficit = nFwdSum - nOI;
      IF(nDeficit > 0);
        nMultiple = INT(nDeficit \ nMOQ);
        IF(nMultiple * nMOQ < nDeficit);
          nMultiple = nMultiple + 1;
        ENDIF;
        nReceipt = nMultiple * nMOQ;
        IF(CellIsUpdateable(cCubeForecast, pVersion, sTP, sSKU, cMeasReceipts) = 1);
          CellPutN(nReceipt, cCubeForecast, pVersion, sTP, sSKU, cMeasReceipts);
          nReceiptsWritten = nReceiptsWritten + 1;
          sOutcome = 'WROTE';
        ELSE;
          sOutcome = 'LOCKED_SKIP';
        ENDIF;
      ELSE;
        sOutcome = 'WOS_OK_FWD';
      ENDIF;
    ELSE;
      sOutcome = 'WOS_OK';
    ENDIF;
  ENDIF;
  IF(bLogDebug = 1);
    LogOutput('DEBUG', cProcessName | ' | WEEK | SKU=' | sSKU | ' | TP=' | sTP | ' | OI=' | TRIM(STR(nOI, 20, 2)) | ' | ECS=' | TRIM(STR(nECS, 20, 2)) | ' | WOS=' | TRIM(STR(nWOS, 20, 4)) | ' | FwdSum=' | TRIM(STR(nFwdSum, 20, 2)) | ' | Deficit=' | TRIM(STR(nDeficit, 20, 2)) | ' | Receipt=' | TRIM(STR(nReceipt, 20, 0)) | ' | Outcome=' | sOutcome);
  ENDIF;
  sTP = ATTRS(cDimTP, sTP, cAttrNextWk);
END;

nSkuProcessed = nSkuProcessed + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cCubeAttrs, sViewName) = 1);
  ViewDestroy(cCubeAttrs, sViewName);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | SkuProcessed=' | TRIM(STR(nSkuProcessed, 10, 0)) | ' | SkuSkipped=' | TRIM(STR(nSkuSkipped, 10, 0)) | ' | ReceiptsWritten=' | TRIM(STR(nReceiptsWritten, 10, 0)) | ' | ReceiptsCleared=' | TRIM(STR(nReceiptsCleared, 10, 0)));
ENDIF;

#endregion