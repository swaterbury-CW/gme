#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-06
# LAST UPDATE: 2026-05-06
# CHANGED BY: Steve Waterbury
# COMMENTS:
# Orchestrator for budget BQ load. Loops 1..nPageCount and dispatches each
# budget_<prefix>N.json file to Merch.Load.Budget.BQ.Page worker. Supports
# parallel (RunProcess + WaitForInternalJobs assignment-form) or sequential
# (ExecuteProcess) modes. Optional pre-load ViewZeroOut of staging cube on
# pVersion. Numeric flag params declared type=String per Actuals.BQ pattern;
# materialized into NUMBR locals for STR/<=/= safety.
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | Initial creation
#EndRegion

#Region : Constants & Coerced Locals
cProcessName = GetProcessName();
cCube = 'Merch Budget Staging';
cVerDim = 'Merch Version';
cPageProc = 'Merch.Load.Budget.BQ.Page';
nPageCount = NUMBR(pPageCount);
nUseRunProcess = NUMBR(pUseRunProcess);
nClearFirst = NUMBR(pClearFirst);
nPagesRun = 0;
#EndRegion

#Region : Logging Configuration
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
#EndRegion

#Region : Validate Parameters
IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion is empty');
  ProcessError;
ENDIF;
IF(DIMIX(cVerDim, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Unknown Merch Version: ' | pVersion);
  ProcessError;
ENDIF;
IF(pFilePrefix @= '');
  LogOutput('ERROR', cProcessName | ' | pFilePrefix is empty');
  ProcessError;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | Prefix=' | pFilePrefix | ' | Pages=' | TRIM(STR(nPageCount, 5, 0)) | ' | Parallel=' | TRIM(STR(nUseRunProcess, 1, 0)) | ' | ClearFirst=' | TRIM(STR(nClearFirst, 1, 0)));
ENDIF;

#Region : Optional Clear (ViewZeroOut on pVersion)
IF(nClearFirst = 1);
  sViewName = cProcessName | '_clear';
  sSubVer = cProcessName | '_clear_ver';
  IF(ViewExists(cCube, sViewName) = 1);
    ViewDestroy(cCube, sViewName);
  ENDIF;
  IF(SubsetExists(cVerDim, sSubVer) = 1);
    SubsetDestroy(cVerDim, sSubVer);
  ENDIF;
  SubsetCreate(cVerDim, sSubVer);
  SubsetElementInsert(cVerDim, sSubVer, pVersion, 0);
  ViewCreate(cCube, sViewName);
  ViewSubsetAssign(cCube, sViewName, cVerDim, sSubVer);
  ViewExtractSkipCalcsSet(cCube, sViewName, 1);
  ViewExtractSkipZeroesSet(cCube, sViewName, 1);
  ViewZeroOut(cCube, sViewName);
  ViewDestroy(cCube, sViewName);
  SubsetDestroy(cVerDim, sSubVer);
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcessName | ' | Cleared ' | cCube | ' for version ' | pVersion);
  ENDIF;
ENDIF;
#EndRegion
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
# No metadata-phase work — orchestrator only.
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
# Orchestrator has no datasource; dispatch loop lives in Epilog.
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Dispatch Pages
nPage = 1;
IF(nUseRunProcess = 1);
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcessName | ' | Dispatching pages via RunProcess (parallel)');
  ENDIF;
  WHILE(nPage <= nPageCount);
    sPageFile = pFilePrefix | TRIM(STR(nPage, 5, 0)) | '.json';
    IF(FileExists(sPageFile) = 1);
      RunProcess(cPageProc, 'pVersion', pVersion, 'pFile', sPageFile);
      nPagesRun = nPagesRun + 1;
      IF(bLogInfo = 1);
        LogOutput('INFO', cProcessName | ' | Dispatched page ' | TRIM(STR(nPage, 5, 0)) | ': ' | sPageFile);
      ENDIF;
    ELSE;
      IF(bLogInfo = 1);
        LogOutput('INFO', cProcessName | ' | File not found, skipping: ' | sPageFile);
      ENDIF;
    ENDIF;
    nPage = nPage + 1;
  END;
  nDummy = WaitForInternalJobs();
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcessName | ' | All RunProcess jobs complete.');
  ENDIF;
ELSE;
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcessName | ' | Dispatching pages via ExecuteProcess (sequential)');
  ENDIF;
  WHILE(nPage <= nPageCount);
    sPageFile = pFilePrefix | TRIM(STR(nPage, 5, 0)) | '.json';
    IF(FileExists(sPageFile) = 1);
      nRC = ExecuteProcess(cPageProc, 'pVersion', pVersion, 'pFile', sPageFile);
      IF(nRC <> 0);
        LogOutput('ERROR', cProcessName | ' | Page ' | TRIM(STR(nPage, 5, 0)) | ' failed RC=' | TRIM(STR(nRC, 10, 0)));
      ELSE;
        nPagesRun = nPagesRun + 1;
        IF(bLogInfo = 1);
          LogOutput('INFO', cProcessName | ' | Processed page ' | TRIM(STR(nPage, 5, 0)) | ': ' | sPageFile);
        ENDIF;
      ENDIF;
    ELSE;
      IF(bLogInfo = 1);
        LogOutput('INFO', cProcessName | ' | File not found, skipping: ' | sPageFile);
      ENDIF;
    ENDIF;
    nPage = nPage + 1;
  END;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | PagesRun=' | TRIM(STR(nPagesRun, 5, 0)));
ENDIF;
#endregion