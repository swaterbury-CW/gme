#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-05-11
# LAST UPDATE: 2026-05-11
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Utility process. Stamps Last_Actuals_Refresh on every Actual + Calculated
# Merch Version element. Called from Merch.Load.Actuals.BQ at end of chain.
# pTimestampSerial: optional DAYNO serial string. Empty -> use NOW.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-05-11         Steve Waterbury    Initial creation
#EndRegion

cProcessName = GetProcessName();

#Region : Logging Configuration
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
#EndRegion

IF(pTimestampSerial @= '');
  nStamp = NOW;
ELSE;
  nStamp = StringToNumber(pTimestampSerial);
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Stamp=' | TRIM(STR(nStamp, 15, 5)));
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
cDim = 'Merch Version';
cAttr = 'Last_Actuals_Refresh';
nVersionsStamped = 0;
nVerIdx = 1;
nDimSize = DIMSIZ(cDim);
WHILE(nVerIdx <= nDimSize);
  sVer = DIMNM(cDim, nVerIdx);
  IF(DTYPE(cDim, sVer) @= 'N');
    sVerType = ATTRS(cDim, sVer, 'Version_Type');
    IF(sVerType @= 'Actual' % sVerType @= 'Calculated');
      AttrPutN(nStamp, cDim, sVer, cAttr);
      nVersionsStamped = nVersionsStamped + 1;
    ENDIF;
  ENDIF;
  nVerIdx = nVerIdx + 1;
END;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Stamped=' | TRIM(STR(nVersionsStamped, 10, 0)));
ENDIF;

#endregion