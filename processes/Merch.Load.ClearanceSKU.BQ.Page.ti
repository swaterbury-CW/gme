#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-06
# LAST UPDATE: 2026-05-06
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | Initial creation - per-page JSON worker for Clearance SKU loader.
cProcessName = GetProcessName();
cCube = 'Clearance SKU';
nRecordCount = 0;
nCellsWritten = 0;
DataSourceType = 'JSON';
DatasourceNameForServer = pPageFile;
DataSourceJsonRootPointer = '/rows';
DataSourceJsonVariableMapping = JsonAdd('{}', 'vRow', StringToJson('/f'));

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
cCube = 'Clearance SKU';
sPromo = JsonGet(vRow, '/0/v');
sStart = JsonGet(vRow, '/1/v');
sEnd   = JsonGet(vRow, '/2/v');
sOffer = JsonGet(vRow, '/3/v');
sSku   = JsonGet(vRow, '/4/v');
sColor = JsonGet(vRow, '/5/v');
sDisc  = JsonGet(vRow, '/6/v');
IF(SUBST(sPromo,1,1) @= '"');
  sPromo = SUBST(sPromo,2,LONG(sPromo)-2);
ENDIF;
IF(SUBST(sStart,1,1) @= '"');
  sStart = SUBST(sStart,2,LONG(sStart)-2);
ENDIF;
IF(SUBST(sEnd,1,1) @= '"');
  sEnd = SUBST(sEnd,2,LONG(sEnd)-2);
ENDIF;
IF(SUBST(sOffer,1,1) @= '"');
  sOffer = SUBST(sOffer,2,LONG(sOffer)-2);
ENDIF;
IF(SUBST(sSku,1,1) @= '"');
  sSku = SUBST(sSku,2,LONG(sSku)-2);
ENDIF;
IF(SUBST(sColor,1,1) @= '"');
  sColor = SUBST(sColor,2,LONG(sColor)-2);
ENDIF;
IF(SUBST(sDisc,1,1) @= '"');
  sDisc = SUBST(sDisc,2,LONG(sDisc)-2);
ENDIF;
IF(sSku @= '' % sSku @= 'null');
  ItemSkip;
ENDIF;
IF(DIMIX('Merch SKU', sSku) = 0);
  ItemSkip;
ENDIF;
IF(sPromo @<> '' & sPromo @<> 'null' & DIMIX('Clearance Promotion ID', sPromo) = 0);
  DimensionElementInsertDirect('Clearance Promotion ID', '', sPromo, 'N');
ENDIF;
IF(sColor @<> '' & sColor @<> 'null' & DIMIX('Clearance Color', sColor) = 0);
  DimensionElementInsertDirect('Clearance Color', '', sColor, 'N');
ENDIF;
IF(sOffer @<> '' & sOffer @<> 'null' & DIMIX('Clearance Offer Type', sOffer) = 0);
  DimensionElementInsertDirect('Clearance Offer Type', '', sOffer, 'N');
ENDIF;
nPromoStart = DAYNO(sStart);
nPromoEnd   = DAYNO(sEnd);
nDiscount   = NUMBR(sDisc);
nRecordCount = nRecordCount + 1;
nTPSize = DIMSIZ('Merch Time Period');
nI = 1;
WHILE(nI <= nTPSize);
  sWeek = DIMNM('Merch Time Period', nI);
  IF(ELLEV('Merch Time Period', sWeek) = 0);
    nWS = ATTRN('Merch Time Period', sWeek, 'Start_Date_Serial');
    nWE = ATTRN('Merch Time Period', sWeek, 'End_Date_Serial');
    IF(nWS <= nPromoEnd & nWE >= nPromoStart);
      IF(CellIsUpdateable(cCube, sWeek, sPromo, sSku, sColor, sOffer, 'Discount_Pct') = 1);
        CellPutN(nDiscount, cCube, sWeek, sPromo, sSku, sColor, sOffer, 'Discount_Pct');
      ENDIF;
      IF(CellIsUpdateable(cCube, sWeek, sPromo, sSku, sColor, sOffer, 'Active_Flag') = 1);
        CellPutN(1, cCube, sWeek, sPromo, sSku, sColor, sOffer, 'Active_Flag');
      ENDIF;
      nCellsWritten = nCellsWritten + 2;
    ENDIF;
  ENDIF;
  nI = nI + 1;
END;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(0 = 1);
  pPageFile = '';
  cProcessName = '';
  nRecordCount = 0;
  nCellsWritten = 0;
ENDIF;

#endregion