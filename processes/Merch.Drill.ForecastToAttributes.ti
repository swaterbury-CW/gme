#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-06
# LAST UPDATE: 2026-04-06
# COMMENTS:
# Drill-through from Merch Forecast to Merch Version SKU Attributes.
# Prolog-only stub. PA front-end handles the target cube navigation.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-04-06         Steve Waterbury    Initial creation
#
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'Drill: ' | cProcessName | ' V=' | pVersion | ' SKU=' | pSKU);
ENDIF;
#endregion
