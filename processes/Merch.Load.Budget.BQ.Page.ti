#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-06
# LAST UPDATE: 2026-05-06
# CHANGED BY: Steve Waterbury
# COMMENTS:
# Page worker for Merch.Load.Budget.BQ. Loads one paginated BQ budget JSON file into Merch Budget Staging.
# Schema cols: 0=sku, 1=SGM_Category (skipped, exists as SKU attr), 2=SGM_Category_Group (skipped),
# 3=fiscal_week_ending, 4..17 = 14 measures matching Merch Budget Measure element order.
# Time Period resolved per-row via End_Date_Serial attribute on Merch Time Period (last-date cache).
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | Initial creation
#EndRegion

#Region : Constants
cProcessName = GetProcessName();
cCube = 'Merch Budget Staging';
cSKUDim = 'Merch SKU';
cVerDim = 'Merch Version';
cTimeDim = 'Merch Time Period';
cMeasureDim = 'Merch Budget Measure';
nRecordCount = 0;
nCellsWritten = 0;
nSKUSkipped = 0;
nDateSkipped = 0;
#EndRegion

#Region : Logging Configuration
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo  = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
#EndRegion

#Region : Validate Parameters
IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion is empty');
  ProcessError;
ENDIF;
IF(pFile @= '');
  LogOutput('ERROR', cProcessName | ' | pFile is empty');
  ProcessError;
ENDIF;
IF(DIMIX(cVerDim, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Unknown Merch Version: ' | pVersion);
  ProcessError;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | File=' | pFile | ' | LogLevel=' | sLogLevel);
ENDIF;

# Per-row date cache (avoids iterating Time Period dim per row)
sLastDate = '';
sLastPeriod = '';

#Region : Configure JSON Datasource (override page file at runtime; vRow registered by set_process_datasource)
DatasourceType = 'JSON';
DatasourceNameForServer = pFile;
DataSourceJsonRootPointer = '/rows';
DataSourceJsonVariableMapping = JsonAdd('{}', 'vRow', StringToJson('/f'));
#EndRegion
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
# No metadata-phase work — all dim members are pre-existing.
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Per-Row Load

# Extract sku (col 0)
sSKU = JsonGet(vRow, '/0/v');
IF(SUBST(sSKU, 1, 1) @= '"');
  sSKU = SUBST(sSKU, 2, LONG(sSKU) - 2);
ENDIF;
IF(sSKU @= '' % sSKU @= 'null');
  ItemSkip;
ENDIF;
IF(DIMIX(cSKUDim, sSKU) = 0);
  nSKUSkipped = nSKUSkipped + 1;
  IF(bLogDebug = 1 & nSKUSkipped <= 5);
    LogOutput('DEBUG', cProcessName | ' | Unknown SKU (sample): ' | sSKU);
  ENDIF;
  ItemSkip;
ENDIF;

# Extract fiscal_week_ending (col 3)
sDate = JsonGet(vRow, '/3/v');
IF(SUBST(sDate, 1, 1) @= '"');
  sDate = SUBST(sDate, 2, LONG(sDate) - 2);
ENDIF;
IF(sDate @= '' % sDate @= 'null');
  nDateSkipped = nDateSkipped + 1;
  ItemSkip;
ENDIF;

# Resolve time period via End_Date_Serial attribute (cache last seen date)
IF(sDate @<> sLastDate);
  nTargetDayNo = DAYNO(sDate);
  sPeriodFound = '';
  nTIdx = 1;
  nTimeDimSize = DIMSIZ(cTimeDim);
  WHILE(nTIdx <= nTimeDimSize & sPeriodFound @= '');
    sElem = DIMNM(cTimeDim, nTIdx);
    IF(DTYPE(cTimeDim, sElem) @= 'N');
      IF(ATTRN(cTimeDim, sElem, 'End_Date_Serial') = nTargetDayNo);
        sPeriodFound = sElem;
      ENDIF;
    ENDIF;
    nTIdx = nTIdx + 1;
  END;
  sLastDate = sDate;
  sLastPeriod = sPeriodFound;
ENDIF;

IF(sLastPeriod @= '');
  nDateSkipped = nDateSkipped + 1;
  IF(bLogDebug = 1 & nDateSkipped <= 5);
    LogOutput('DEBUG', cProcessName | ' | Unmappable fiscal_week_ending (sample): ' | sDate);
  ENDIF;
  ItemSkip;
ENDIF;

sPeriod = sLastPeriod;
nRecordCount = nRecordCount + 1;

# Loop measure cols 4..17 (mapped 1:1 to Merch Budget Measure elements 1..14)
nColIdx = 4;
nMeasIdx = 1;
nMeasDimSize = DIMSIZ(cMeasureDim);
WHILE(nColIdx <= 17 & nMeasIdx <= nMeasDimSize);
  sMeasure = DIMNM(cMeasureDim, nMeasIdx);
  sJsonPath = '/' | TRIM(STR(nColIdx, 5, 0)) | '/v';
  sVal = JsonGet(vRow, sJsonPath);
  IF(SUBST(sVal, 1, 1) @= '"');
    sVal = SUBST(sVal, 2, LONG(sVal) - 2);
  ENDIF;
  IF(sVal @<> '' & sVal @<> 'null');
    nVal = StringToNumber(sVal);
    IF(CellIsUpdateable(cCube, pVersion, sPeriod, sSKU, sMeasure) = 1);
      CellPutN(nVal, cCube, pVersion, sPeriod, sSKU, sMeasure);
      nCellsWritten = nCellsWritten + 1;
    ENDIF;
  ENDIF;
  nColIdx = nColIdx + 1;
  nMeasIdx = nMeasIdx + 1;
END;
#EndRegion
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | File=' | pFile | ' | Records=' | TRIM(STR(nRecordCount, 10, 0)) | ' | Cells=' | TRIM(STR(nCellsWritten, 10, 0)) | ' | SKUSkipped=' | TRIM(STR(nSKUSkipped, 10, 0)) | ' | DateSkipped=' | TRIM(STR(nDateSkipped, 10, 0)));
ENDIF;
IF(nSKUSkipped > 0 % nDateSkipped > 0);
  LogOutput('INFO', cProcessName | ' | SKIP SUMMARY File=' | pFile | ' SKUSkipped=' | TRIM(STR(nSKUSkipped, 10, 0)) | ' DateSkipped=' | TRIM(STR(nDateSkipped, 10, 0)));
ENDIF;
#endregion