#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-05-11
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Phase 1 of promo->forecast push. Iterates active promos in
# Merch Promo Calendar for pVersion. Resolves per SKU x Week winner
# as the promo with smallest Blended AUR (deeper discount). Writes
# winner values to Merch Promo Winner Scratch (Min Blended AUR,
# Winner Pct of Week, Winner BER, Winner Effective Lift, Has Winner).
# Lift scaling: if Merch Promo ID attribute Lift Scaling = 'Unscaled',
# Effective Lift = raw Calc Sales Lift Pct. Else (default Scaled),
# Effective Lift = raw lift * Pct of Week. Zero-outs scratch for
# pVersion first, then chains to Merch.Calc.ApplyPromosToForecast.Finalize.
#
#### CHANGE HISTORY:
### 2026-04-20  Steve Waterbury  Initial creation
### 2026-05-11  Steve Waterbury  Qualify Merch Version hierarchy in ViewCreateByMDX strings (Forecast leaf exists in both Merch Version and Budget Rollup hierarchies)
#
#EndRegion

cProcessName = GetProcessName();

#Region : Logging
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion);
ENDIF;
#EndRegion

#Region : Validate
IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion);
  ProcessError;
ENDIF;
IF(DTYPE('Merch Version', pVersion) @<> 'N');
  LogOutput('ERROR', cProcessName | ' | Version must be a leaf element: ' | pVersion);
  ProcessError;
ENDIF;
#EndRegion

#Region : Constants
cCalendar = 'Merch Promo Calendar';
cScratch = 'Merch Promo Winner Scratch';
cPromoIDDim = 'Merch Promo ID';
cLiftAttr = 'Lift Scaling';
nRowsProcessed = 0;
nWinnersAssigned = 0;
nSkippedLock = 0;
#EndRegion

#Region : Zero out scratch for pVersion
sZeroView = 'TI_PromoAF_Zero_' | TRIM(STR(NOW, 15, 0));
sZeroMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Promo Winner Measure])}, 0)} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} ON ROWS '
  | 'FROM [' | cScratch | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
IF(ViewExists(cScratch, sZeroView) = 1);
  ViewDestroy(cScratch, sZeroView);
ENDIF;
ViewCreateByMDX(cScratch, sZeroView, sZeroMDX, 1);
ViewZeroOut(cScratch, sZeroView);
ViewDestroy(cScratch, sZeroView);
#EndRegion

#Region : Build source VIEW on Calendar
sView = 'TI_PromoAF_Src_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[Merch Promo Calendar Measure].[Active]} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Promo ID])}, 0)} ON ROWS '
  | 'FROM [' | cCalendar | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
ViewCreateByMDX(cCalendar, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cCalendar, sView, 0);
ViewExtractSkipZeroesSet(cCalendar, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cCalendar;
DatasourceCubeview = sView;
#EndRegion
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(Value = 0);
  ItemSkip;
ENDIF;

sSKU = vMerch_SKU;
sTime = vMerch_Time_Period;
sPromoID = vMerch_Promo_ID;

IF(DIMIX('Merch SKU', sSKU) = 0);
  ItemReject('Source SKU not found: ' | sSKU);
ENDIF;
IF(DIMIX('Merch Time Period', sTime) = 0);
  ItemReject('Source Time Period not found: ' | sTime);
ENDIF;
IF(DIMIX('Merch Promo ID', sPromoID) = 0);
  ItemReject('Source Promo ID not found: ' | sPromoID);
ENDIF;

IF(CellIsUpdateable(cScratch, pVersion, sTime, sSKU, 'Has Winner') = 0);
  nSkippedLock = nSkippedLock + 1;
  ItemSkip;
ENDIF;

nRowsProcessed = nRowsProcessed + 1;

nBlendedAUR = CellGetN(cCalendar, pVersion, sTime, sSKU, sPromoID, 'Blended AUR');
nPctOfWeek = CellGetN(cCalendar, pVersion, sTime, sSKU, sPromoID, 'Pct of Week');
nBER = CellGetN(cCalendar, pVersion, sTime, sSKU, sPromoID, 'BER');
nRawLift = CellGetN(cCalendar, pVersion, sTime, sSKU, sPromoID, 'Calc Sales Lift Pct');

nHasWinner = CellGetN(cScratch, pVersion, sTime, sSKU, 'Has Winner');
nCurrentMin = CellGetN(cScratch, pVersion, sTime, sSKU, 'Min Blended AUR');

bNewWinner = 0;
IF(nHasWinner = 0);
  bNewWinner = 1;
ELSEIF(nBlendedAUR < nCurrentMin);
  bNewWinner = 1;
ENDIF;

IF(bNewWinner = 1);
  sScaling = ATTRS(cPromoIDDim, sPromoID, cLiftAttr);
  nEffLift = nRawLift * nPctOfWeek;
  IF(sScaling @= 'Unscaled');
    nEffLift = nRawLift;
  ENDIF;

  CellPutN(nBlendedAUR, cScratch, pVersion, sTime, sSKU, 'Min Blended AUR');
  CellPutN(nPctOfWeek, cScratch, pVersion, sTime, sSKU, 'Winner Pct of Week');
  CellPutN(nBER, cScratch, pVersion, sTime, sSKU, 'Winner BER');
  CellPutN(nEffLift, cScratch, pVersion, sTime, sSKU, 'Winner Effective Lift');
  CellPutN(1, cScratch, pVersion, sTime, sSKU, 'Has Winner');
  nWinnersAssigned = nWinnersAssigned + 1;

  IF(bLogDebug = 1);
    LogOutput('DEBUG', cProcessName | ' | Winner ' | sPromoID | ' at ' | sSKU | '|' | sTime | ' Blended=' | TRIM(STR(nBlendedAUR, 15, 4)) | ' EffLift=' | TRIM(STR(nEffLift, 15, 4)));
  ENDIF;
ENDIF;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cCalendar, sView) = 1);
  ViewDestroy(cCalendar, sView);
ENDIF;

nRC = ExecuteProcess('Merch.Calc.ApplyPromosToForecast.Finalize', 'pVersion', pVersion);
IF(nRC <> 0);
  LogOutput('ERROR', cProcessName | ' | Finalize chain failed RC=' | TRIM(STR(nRC, 10, 0)));
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Version=' | pVersion | ' | Rows=' | TRIM(STR(nRowsProcessed, 10, 0)) | ' | Winners=' | TRIM(STR(nWinnersAssigned, 10, 0)) | ' | SkippedLocked=' | TRIM(STR(nSkippedLock, 10, 0)));
ENDIF;
#endregion