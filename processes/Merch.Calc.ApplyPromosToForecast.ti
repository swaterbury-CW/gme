#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-06-09
# CHANGED BY : Steve Waterbury
# COMMENTS: Phase 1 of promo->forecast push. STACKING: reads calendar 'All Promos' Effective values (was winner-takes-all). Pre-resets prior promo cells.
# CHANGE HISTORY:
#   2026-05-28  Steve Waterbury  Pre-reset Forecast cells for previously-winning SKU+Weeks
#   2026-06-09  Steve Waterbury  Stacking: read 'All Promos' Effective Week AUR/BER/Lift into scratch (Pct=1); replaces min-AUR winner (plan a240cabb67e4). LogOutput 3-arg
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion, 1);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required', 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(DTYPE('Merch Version', pVersion) @<> 'N');
  LogOutput('ERROR', cProcessName | ' | Version must be a leaf element: ' | pVersion, 1);
  ProcessError;
ENDIF;

cCalendar = 'Merch Promo Calendar';
cScratch = 'Merch Promo Winner Scratch';
cForecast = 'Merch Forecast';
cAttrs = 'Merch Version SKU Attributes';
cSKUDim = 'Merch SKU';
cTimeDim = 'Merch Time Period';
cPromoIDDim = 'Merch Promo ID';
nRowsProcessed = 0;
nWinnersAssigned = 0;
nSkippedLock = 0;
nResetCount = 0;

nSCnt = DIMSIZ(cSKUDim);
nTCnt = DIMSIZ(cTimeDim);
nS = 1;
WHILE(nS <= nSCnt);
  sResetSKU = DIMNM(cSKUDim, nS);
  IF(ELLEV(cSKUDim, sResetSKU) = 0);
    IF(CellGetS(cAttrs, pVersion, sResetSKU, 'Sellable Flag') @= 'Y');
      nT = 1;
      WHILE(nT <= nTCnt);
        sResetTime = DIMNM(cTimeDim, nT);
        IF(ELLEV(cTimeDim, sResetTime) = 0);
          IF(CellGetN(cScratch, pVersion, sResetTime, sResetSKU, 'Has Winner') = 1);
            IF(CellIsUpdateable(cForecast, pVersion, sResetTime, sResetSKU, 'Backend Adjustment') = 1);
              CellPutN(0, cForecast, pVersion, sResetTime, sResetSKU, 'Markdown %');
              CellPutN(1, cForecast, pVersion, sResetTime, sResetSKU, 'Promo Build');
              CellPutN(0, cForecast, pVersion, sResetTime, sResetSKU, 'Backend Adjustment');
              nResetCount = nResetCount + 1;
            ENDIF;
          ENDIF;
        ENDIF;
        nT = nT + 1;
      END;
    ENDIF;
  ENDIF;
  nS = nS + 1;
END;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | Forecast pre-reset rows: ' | TRIM(STR(nResetCount, 10, 0)), 1);
ENDIF;

sZeroView = 'TI_PromoAF_Zero_' | TRIM(STR(NOW, 15, 0));
sZeroMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Promo Winner Measure])}, 0)} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} ON ROWS '
  | 'FROM [' | cScratch | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
IF(ViewExists(cScratch, sZeroView) = 1);
  ViewDestroy(cScratch, sZeroView);
ENDIF;
ViewCreateByMDX(cScratch, sZeroView, sZeroMDX, 1);
ViewZeroOut(cScratch, sZeroView);
ViewDestroy(cScratch, sZeroView);

sView = 'TI_PromoAF_Src_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[Merch Promo Calendar Measure].[Active]} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Promo ID])}, 0)} ON ROWS '
  | 'FROM [' | cCalendar | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
ViewCreateByMDX(cCalendar, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cCalendar, sView, 0);
ViewExtractSkipZeroesSet(cCalendar, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cCalendar;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(Value = 0);
  ItemSkip;
ENDIF;

sSKU = vMerch_SKU;
sTime = vMerch_Time_Period;

IF(DIMIX('Merch SKU', sSKU) = 0);
  ItemReject('Source SKU not found: ' | sSKU);
ENDIF;
IF(DIMIX('Merch Time Period', sTime) = 0);
  ItemReject('Source Time Period not found: ' | sTime);
ENDIF;

IF(CellIsUpdateable(cScratch, pVersion, sTime, sSKU, 'Has Winner') = 0);
  nSkippedLock = nSkippedLock + 1;
  ItemSkip;
ENDIF;

nRowsProcessed = nRowsProcessed + 1;

nEffAUR = CellGetN(cCalendar, pVersion, sTime, sSKU, 'All Promos', 'Effective Week AUR');
nEffBER = CellGetN(cCalendar, pVersion, sTime, sSKU, 'All Promos', 'Effective Week BER');
nEffLift = CellGetN(cCalendar, pVersion, sTime, sSKU, 'All Promos', 'Effective Week Lift');

CellPutN(nEffAUR, cScratch, pVersion, sTime, sSKU, 'Min Blended AUR');
CellPutN(1, cScratch, pVersion, sTime, sSKU, 'Winner Pct of Week');
CellPutN(nEffBER, cScratch, pVersion, sTime, sSKU, 'Winner BER');
CellPutN(nEffLift, cScratch, pVersion, sTime, sSKU, 'Winner Effective Lift');
CellPutN(1, cScratch, pVersion, sTime, sSKU, 'Has Winner');
nWinnersAssigned = nWinnersAssigned + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cCalendar, sView) = 1);
  ViewDestroy(cCalendar, sView);
ENDIF;

nRC = ExecuteProcess('Merch.Calc.ApplyPromosToForecast.Finalize', 'pVersion', pVersion);
IF(nRC <> 0);
  LogOutput('ERROR', cProcessName | ' | Finalize chain failed RC=' | TRIM(STR(nRC, 10, 0)), 1);
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Version=' | pVersion | ' | Rows=' | TRIM(STR(nRowsProcessed, 10, 0)) | ' | Stacked=' | TRIM(STR(nWinnersAssigned, 10, 0)) | ' | SkippedLocked=' | TRIM(STR(nSkippedLock, 10, 0)) | ' | PreReset=' | TRIM(STR(nResetCount, 10, 0)), 1);
ENDIF;

#endregion