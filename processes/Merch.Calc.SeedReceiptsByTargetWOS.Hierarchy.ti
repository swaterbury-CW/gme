#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-05-04
# LAST UPDATE: 2026-07-13
# CHANGED BY : Steve Waterbury
# COMMENTS: Roles-node wrapper. (1) pre-receipt WOS (ForecastWOS.Orch, parallel); (2) RunProcess the .Seed child so seeded receipts COMMIT at its completion, then WaitForAllJobs; (3) post-receipt WOS (ForecastWOS.Orch, PARALLEL) reads the now-committed receipts. Parallel post-WOS replaces the former serial in-transaction run.
# CHANGE HISTORY:
#   2026-05-04 | Steve Waterbury | Initial
#   2026-07-12 | Steve Waterbury | pre + post ForecastWOS.Orch double-run
#   2026-07-13 | Steve Waterbury | Seed via RunProcess child (commit-before-WOS); post-WOS now PARALLEL
#EndRegion

cDimSKU = 'Merch SKU';
cDimVer = 'Merch Version';
cSeed = 'Merch.Calc.SeedReceiptsByTargetWOS.Seed';
cHierRoles = 'Roles';
cWOSOrch = 'Merch.Calc.ForecastWOS.Orch';

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required', 1);
  ProcessError;
ENDIF;
IF(DIMIX(cDimVer, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version missing: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(pNode @= '');
  LogOutput('ERROR', cProcessName | ' | pNode required', 1);
  ProcessError;
ENDIF;
IF(pHierarchy @= '');
  pHierarchy = cHierRoles;
ENDIF;
IF(pHierarchy @<> cHierRoles);
  LogOutput('ERROR', cProcessName | ' | pHierarchy must be Roles: ' | pHierarchy, 1);
  ProcessError;
ENDIF;
IF(HierarchyElementExists(cDimSKU, cHierRoles, pNode) = 0);
  LogOutput('ERROR', cProcessName | ' | pNode not in Roles hier: ' | pNode, 1);
  ProcessError;
ENDIF;
IF(pOverwrite @= '');
  pOverwrite = 'N';
ENDIF;
IF(pOverwrite @<> 'Y' & pOverwrite @<> 'N');
  LogOutput('ERROR', cProcessName | ' | pOverwrite must be Y or N', 1);
  ProcessError;
ENDIF;

nRCWOS1 = ExecuteProcess(cWOSOrch, 'pVersion', pVersion, 'pSKUElement', pNode, 'pSKU', '', 'pTargetMeasure', 'WOS', 'pUseRunProcess', '1');
IF(nRCWOS1 <> 0);
  LogOutput('ERROR', cProcessName | ' | ' | cWOSOrch | ' (pre-receipt) RC=' | TRIM(STR(nRCWOS1, 10, 0)), 1);
  ProcessError;
ENDIF;

sJob = RunProcess(cSeed, 'pVersion', pVersion, 'pNode', pNode, 'pHierarchy', cHierRoles, 'pOverwrite', pOverwrite);
IF(sJob @<> '');
  WaitForAllJobs(sJob);
ENDIF;

nRCWOS2 = ExecuteProcess(cWOSOrch, 'pVersion', pVersion, 'pSKUElement', pNode, 'pSKU', '', 'pTargetMeasure', 'WOS', 'pUseRunProcess', '1');
IF(nRCWOS2 <> 0);
  LogOutput('ERROR', cProcessName | ' | ' | cWOSOrch | ' (post-receipt) RC=' | TRIM(STR(nRCWOS2, 10, 0)), 1);
  ProcessError;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Node=' | pNode, 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

