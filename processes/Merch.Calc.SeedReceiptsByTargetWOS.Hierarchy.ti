#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-05-04
# LAST UPDATE: 2026-05-20
# CHANGED BY : Steve Waterbury
# COMMENTS: Roles-hier-only wrapper around SeedReceiptsByTargetWOS. PAW-invokable.
# CHANGE HISTORY:
#   2026-05-04 | Steve Waterbury | Initial
#   2026-05-20 | Steve Waterbury | Force pHierarchy='Roles' default; reject other; validate pNode in Roles (plan 6353aa33bf4d)
#EndRegion

cDimSKU = 'Merch SKU';
cDimVer = 'Merch Version';
cWorker = 'Merch.Calc.SeedReceiptsByTargetWOS';
cHierRoles = 'Roles';

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | Node=' | pNode | ' | Hierarchy=' | pHierarchy | ' | Overwrite=' | pOverwrite);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX(cDimVer, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version missing: ' | pVersion);
  ProcessError;
ENDIF;
IF(pNode @= '');
  LogOutput('ERROR', cProcessName | ' | pNode required');
  ProcessError;
ENDIF;
IF(pHierarchy @= '');
  pHierarchy = cHierRoles;
ENDIF;
IF(pHierarchy @<> cHierRoles);
  LogOutput('ERROR', cProcessName | ' | pHierarchy must be Roles (user-run processes Roles-only): ' | pHierarchy);
  ProcessError;
ENDIF;
IF(HierarchyElementExists(cDimSKU, cHierRoles, pNode) = 0);
  LogOutput('ERROR', cProcessName | ' | pNode not in Roles hier: ' | pNode);
  ProcessError;
ENDIF;
IF(pOverwrite @= '');
  pOverwrite = 'N';
ENDIF;
IF(pOverwrite @<> 'Y' & pOverwrite @<> 'N');
  LogOutput('ERROR', cProcessName | ' | pOverwrite must be Y or N');
  ProcessError;
ENDIF;

sSubName = 'TI_SeedReceiptsHier_' | TRIM(STR(NOW, 15, 0));
IF(HierarchySubsetExists(cDimSKU, cHierRoles, sSubName) = 1);
  HierarchySubsetDestroy(cDimSKU, cHierRoles, sSubName);
ENDIF;
sMdx = 'TM1FILTERBYLEVEL({DESCENDANTS([' | cDimSKU | '].[' | cHierRoles | '].[' | pNode | '])}, 0)';
SubsetCreateByMDX(sSubName, sMdx);

nSize = HierarchySubsetGetSize(cDimSKU, cHierRoles, sSubName);
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | Resolved ' | TRIM(STR(nSize, 10, 0)) | ' leaf SKUs below ' | pNode | ' (' | cHierRoles | ')');
ENDIF;

i = 1;
nDispatched = 0;
WHILE(i <= nSize);
  sSku = HierarchySubsetGetElementName(cDimSKU, cHierRoles, sSubName, i);
  IF(bLogDebug = 1);
    LogOutput('DEBUG', cProcessName | ' | DISPATCH | i=' | TRIM(STR(i, 10, 0)) | ' | SKU=' | sSku);
  ENDIF;
  ExecuteProcess(cWorker, 'pVersion', pVersion, 'pSKU', sSku, 'pCategory', '', 'pOverwrite', pOverwrite);
  nDispatched = nDispatched + 1;
  i = i + 1;
END;

IF(HierarchySubsetExists(cDimSKU, cHierRoles, sSubName) = 1);
  HierarchySubsetDestroy(cDimSKU, cHierRoles, sSubName);
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Dispatched=' | TRIM(STR(nDispatched, 10, 0)));
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

