#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-05-04
# LAST UPDATE: 2026-05-04
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Wrapper around Merch.Calc.SeedReceiptsByTargetWOS that runs the seeder for
# every leaf SKU below an arbitrary hierarchy node. pNode can be a
# consolidation or a leaf in any hierarchy of the Merch SKU dimension.
#
# Builds a subset of leaf descendants via TM1FILTERBYLEVEL+DESCENDANTS MDX.
# Subset lives on the dim's default hierarchy (derived from MDX). Iterates
# the subset and dispatches the seeder per leaf via ExecuteProcess
# (synchronous, prolog-only).
#
#### CHANGE HISTORY:
### 2026-05-04  Steve Waterbury  Initial creation
#EndRegion

cDimSKU = 'Merch SKU';
cDimVer = 'Merch Version';
cWorker = 'Merch.Calc.SeedReceiptsByTargetWOS';

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | Node=' | pNode | ' | Hierarchy=' | pHierarchy | ' | Overwrite=' | pOverwrite);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX(cDimVer, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version missing: ' | pVersion);
  ProcessError;
ENDIF;
IF(pNode @= '');
  LogOutput('ERROR', cProcessName | ' | pNode required');
  ProcessError;
ENDIF;
IF(pHierarchy @= '');
  pHierarchy = cDimSKU;
ENDIF;
IF(HierarchyExists(cDimSKU, pHierarchy) = 0);
  LogOutput('ERROR', cProcessName | ' | Hierarchy missing: ' | pHierarchy);
  ProcessError;
ENDIF;
IF(pOverwrite @= '');
  pOverwrite = 'N';
ENDIF;
IF(pOverwrite @<> 'Y' & pOverwrite @<> 'N');
  LogOutput('ERROR', cProcessName | ' | pOverwrite must be Y or N');
  ProcessError;
ENDIF;

sSubName = 'TI_SeedReceiptsHier';
IF(SubsetExists(cDimSKU, sSubName) = 1);
  SubsetDestroy(cDimSKU, sSubName);
ENDIF;
sMdx = 'TM1FILTERBYLEVEL({DESCENDANTS([' | cDimSKU | '].[' | pHierarchy | '].[' | pNode | '])}, 0)';
SubsetCreateByMDX(sSubName, sMdx);

nSize = SubsetGetSize(cDimSKU, sSubName);
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | Resolved ' | TRIM(STR(nSize, 10, 0)) | ' leaf SKUs below ' | pNode | ' (' | pHierarchy | ')');
ENDIF;

i = 1;
nDispatched = 0;
WHILE(i <= nSize);
  sSku = SubsetGetElementName(cDimSKU, sSubName, i);
  IF(bLogDebug = 1);
    LogOutput('DEBUG', cProcessName | ' | DISPATCH | i=' | TRIM(STR(i, 10, 0)) | ' | SKU=' | sSku);
  ENDIF;
  ExecuteProcess(cWorker,
    'pVersion', pVersion,
    'pSKU', sSku,
    'pCategory', '',
    'pOverwrite', pOverwrite);
  nDispatched = nDispatched + 1;
  i = i + 1;
END;

IF(SubsetExists(cDimSKU, sSubName) = 1);
  SubsetDestroy(cDimSKU, sSubName);
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Dispatched=' | TRIM(STR(nDispatched, 10, 0)));
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
