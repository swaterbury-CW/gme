#   2026-04-30 | Steve Waterbury | Initial commit — seeds Placeholder L4/Vendor/Franchise Values dims from Merch SKU attributes

sCubeAttr = '}ElementAttributes_Merch SKU';
sViewName = '}PLI_PreSeed_V';

IF(DIMIX('Placeholder L4 Values', 'Any') = 0);
  DimensionElementInsertDirect('Placeholder L4 Values', '', 'Any', 'S');
ENDIF;
IF(DIMIX('Placeholder Vendor Values', 'Any') = 0);
  DimensionElementInsertDirect('Placeholder Vendor Values', '', 'Any', 'S');
ENDIF;
IF(DIMIX('Placeholder Franchise Values', 'Any') = 0);
  DimensionElementInsertDirect('Placeholder Franchise Values', '', 'Any', 'S');
ENDIF;

OnMinorErrorDoItemSkip = 1;

IF(ViewExists(sCubeAttr, sViewName) = 1);
  ViewDestroy(sCubeAttr, sViewName);
ENDIF;
sMDX = 'SELECT {[}ElementAttributes_Merch SKU].[SGM_Category]} ON COLUMNS, ';
sMDX = sMDX | 'NON EMPTY {TM1FILTERBYLEVEL([Merch SKU].[Merch SKU].MEMBERS, 0)} ON ROWS ';
sMDX = sMDX | 'FROM [}ElementAttributes_Merch SKU]';
ViewCreateByMDX(sCubeAttr, sViewName, sMDX, 1);
ViewExtractSkipZeroesSet(sCubeAttr, sViewName, 0);

DatasourceType = 'VIEW';
DatasourceNameForServer = sCubeAttr;
DatasourceCubeview = sViewName;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vSKU @= '');
  ItemReject('vSKU empty');
ENDIF;
IF(DIMIX('Merch SKU', vSKU) = 0);
  ItemSkip;
ENDIF;
sCat = ATTRS('Merch SKU', vSKU, 'SGM_Category');
IF(pCategoryFilter @<> '' & sCat @<> pCategoryFilter);
  ItemSkip;
ENDIF;
sL4 = ATTRS('Merch SKU', vSKU, 'Level_4');
sVen = ATTRS('Merch SKU', vSKU, 'Vendor_Name');
sFran = ATTRS('Merch SKU', vSKU, 'Franchise_Name');
IF(sL4 @= '');
  sL4 = 'Any';
ENDIF;
IF(sVen @= '');
  sVen = 'Any';
ENDIF;
IF(sFran @= '');
  sFran = 'Any';
ENDIF;
IF(DIMIX('Placeholder L4 Values', sL4) = 0);
  DimensionElementInsertDirect('Placeholder L4 Values', '', sL4, 'S');
ENDIF;
IF(DIMIX('Placeholder Vendor Values', sVen) = 0);
  DimensionElementInsertDirect('Placeholder Vendor Values', '', sVen, 'S');
ENDIF;
IF(DIMIX('Placeholder Franchise Values', sFran) = 0);
  DimensionElementInsertDirect('Placeholder Franchise Values', '', sFran, 'S');
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists('}ElementAttributes_Merch SKU', '}PLI_PreSeed_V') = 1);
  ViewDestroy('}ElementAttributes_Merch SKU', '}PLI_PreSeed_V');
ENDIF;

#endregion