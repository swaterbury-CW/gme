#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# PROCESS: Merch.Load.PromoSettings.VG
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-06
# LAST UPDATE: 2026-05-27
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | Creation - load Video Game promo CSV; auto-assign JIRA tickets to next free PROMO-NNNN. Design plan 706781065f9f.
#   2026-05-07 | Steve Waterbury | v3 commit (verified via PROMO-0006 mapping after PROMO-0001..0005 were already used by ClearancePromos seed).
#   2026-05-08 | Steve Waterbury | Emit Override Begin/End Date in ISO YYYY-MM-DD so Settings DAYNO succeeds; PERM literal 9999-12-31. Design plan 52f7d463ed97.
#   2026-05-27 | Steve Waterbury | Auto-grow PROMO-NNNN pool when no free slot exists (was: ProcessError). Fixes Prod abort at CSV line 440, JIRA PPM-15278. Max-suffix tracked inside the existing per-row WHILE walk. Design plan 64d0dd95f1e6.
#EndRegion

cProcessName = GetProcessName();
cCube = 'Merch Promo Settings';
cDimPromo = 'Merch Promo ID';
cAttrJIRA = 'JIRA_Ticket';
cPromoRoot = 'All Promos';

sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;

IF(pVersion @= '');
  pVersion = 'Forecast';
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion);
  ProcessError;
ENDIF;

nLoaded = 0;
nSkipped = 0;
nNewPromos = 0;
nGrownSlots = 0;
nDimSize = DIMSIZ(cDimPromo);

Datasourcetype = 'CHARACTERDELIMITED';

LogOutput('INFO', cProcessName | ' | START | Version=' | pVersion);

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sJIRA = TRIM(vJIRA);
IF(sJIRA @= '');
  ItemSkip;
ENDIF;

sSKU = TRIM(vSKU);
IF(sSKU @= '');
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;
IF(DIMIX('Merch SKU', sSKU) = 0);
  LogOutput('WARN', cProcessName | ' | SKU not in dim: ' | sSKU);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

sPromoID = '';
sFirstFree = '';
nMaxSuffix = 0;
j = 1;
WHILE(j <= nDimSize & sPromoID @= '');
  sCand = DIMNM(cDimPromo, j);
  IF(SUBST(sCand, 1, 6) @= 'PROMO-');
    nN = NUMBR(SUBST(sCand, 7, LONG(sCand) - 6));
    IF(nN > nMaxSuffix);
      nMaxSuffix = nN;
    ENDIF;
    sExisting = ATTRS(cDimPromo, sCand, cAttrJIRA);
    IF(sExisting @= sJIRA);
      sPromoID = sCand;
    ELSEIF(sExisting @= '' & sFirstFree @= '');
      sFirstFree = sCand;
    ENDIF;
  ENDIF;
  j = j + 1;
END;
IF(sPromoID @= '');
  IF(sFirstFree @= '');
    nNewNum = nMaxSuffix + 1;
    sNewNum = TRIM(STR(nNewNum, 12, 0));
    WHILE(LONG(sNewNum) < 4);
      sNewNum = '0' | sNewNum;
    END;
    sFirstFree = 'PROMO-' | sNewNum;
    DimensionElementInsert(cDimPromo, '', sFirstFree, 'N');
    DimensionElementComponentAdd(cDimPromo, cPromoRoot, sFirstFree, 1);
    nDimSize = DIMSIZ(cDimPromo);
    nGrownSlots = nGrownSlots + 1;
    LogOutput('INFO', cProcessName | ' | POOL_GROW | new slot ' | sFirstFree);
  ENDIF;
  sPromoID = sFirstFree;
  AttrPutS(sJIRA, cDimPromo, sPromoID, cAttrJIRA);
  nNewPromos = nNewPromos + 1;
  LogOutput('INFO', cProcessName | ' | NEW_PROMO | JIRA=' | sJIRA | ' -> ' | sPromoID);
ENDIF;

sPromoName = TRIM(vDescription);

sPromoPrice = TRIM(vPromoPrice);
IF(LONG(sPromoPrice) > 0 & SUBST(sPromoPrice, 1, 1) @= '$');
  sPromoPrice = SUBST(sPromoPrice, 2, LONG(sPromoPrice) - 1);
ENDIF;
WHILE(SCAN(',', sPromoPrice) > 0);
  nC = SCAN(',', sPromoPrice);
  sPromoPrice = SUBST(sPromoPrice, 1, nC - 1) | SUBST(sPromoPrice, nC + 1, LONG(sPromoPrice) - nC);
END;
sPromoPrice = TRIM(sPromoPrice);

sBER = TRIM(vBER);
IF(LONG(sBER) > 0 & SUBST(sBER, 1, 1) @= '$');
  sBER = SUBST(sBER, 2, LONG(sBER) - 1);
ENDIF;
WHILE(SCAN(',', sBER) > 0);
  nC = SCAN(',', sBER);
  sBER = SUBST(sBER, 1, nC - 1) | SUBST(sBER, nC + 1, LONG(sBER) - nC);
END;
sBER = TRIM(sBER);

sIn = TRIM(vBeginDate);
IF(UPPER(sIn) @= 'PERM');
  sBeginDate = '9999-12-31';
ELSEIF(SCAN('/', sIn) = 0);
  sBeginDate = '';
ELSE;
  n1 = SCAN('/', sIn);
  sMM = SUBST(sIn, 1, n1 - 1);
  sRest = SUBST(sIn, n1 + 1, LONG(sIn) - n1);
  n2 = SCAN('/', sRest);
  IF(n2 = 0);
    sBeginDate = '';
  ELSE;
    sDD = SUBST(sRest, 1, n2 - 1);
    sYYYY = SUBST(sRest, n2 + 1, LONG(sRest) - n2);
    IF(LONG(sMM) = 1);
      sMM = '0' | sMM;
    ENDIF;
    IF(LONG(sDD) = 1);
      sDD = '0' | sDD;
    ENDIF;
    IF(LONG(sYYYY) = 4 & LONG(sMM) = 2 & LONG(sDD) = 2);
      sBeginDate = sYYYY | '-' | sMM | '-' | sDD;
    ELSE;
      sBeginDate = '';
    ENDIF;
  ENDIF;
ENDIF;

sIn = TRIM(vEndDate);
IF(UPPER(sIn) @= 'PERM');
  sEndDate = '9999-12-31';
ELSEIF(SCAN('/', sIn) = 0);
  sEndDate = '';
ELSE;
  n1 = SCAN('/', sIn);
  sMM = SUBST(sIn, 1, n1 - 1);
  sRest = SUBST(sIn, n1 + 1, LONG(sIn) - n1);
  n2 = SCAN('/', sRest);
  IF(n2 = 0);
    sEndDate = '';
  ELSE;
    sDD = SUBST(sRest, 1, n2 - 1);
    sYYYY = SUBST(sRest, n2 + 1, LONG(sRest) - n2);
    IF(LONG(sMM) = 1);
      sMM = '0' | sMM;
    ENDIF;
    IF(LONG(sDD) = 1);
      sDD = '0' | sDD;
    ENDIF;
    IF(LONG(sYYYY) = 4 & LONG(sMM) = 2 & LONG(sDD) = 2);
      sEndDate = sYYYY | '-' | sMM | '-' | sDD;
    ELSE;
      sEndDate = '';
    ENDIF;
  ENDIF;
ENDIF;

sActive = '0';
IF(TRIM(vEnableStatus) @= 'Active');
  sActive = '1';
ENDIF;
sProOnly = '0';
IF(SUBST(UPPER(TRIM(vProExclusive)), 1, 1) @= 'Y');
  sProOnly = '1';
ENDIF;

IF(sPromoName @<> '');
  IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override Promo Name') = 0);
    LogOutput('WARN', cProcessName | ' | CANT_WRITE Override Promo Name | ' | pVersion | '|' | sSKU | '|' | sPromoID);
  ELSE;
    CellPutS(sPromoName, cCube, pVersion, sSKU, sPromoID, 'Override Promo Name');
    nLoaded = nLoaded + 1;
  ENDIF;
ENDIF;

IF(sPromoPrice @<> '');
  IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override Promo Price') = 0);
    LogOutput('WARN', cProcessName | ' | CANT_WRITE Override Promo Price');
  ELSE;
    CellPutS(sPromoPrice, cCube, pVersion, sSKU, sPromoID, 'Override Promo Price');
    nLoaded = nLoaded + 1;
  ENDIF;
ENDIF;

IF(sBER @<> '');
  IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override BER') = 0);
    LogOutput('WARN', cProcessName | ' | CANT_WRITE Override BER');
  ELSE;
    CellPutS(sBER, cCube, pVersion, sSKU, sPromoID, 'Override BER');
    nLoaded = nLoaded + 1;
  ENDIF;
ENDIF;

IF(sBeginDate @<> '');
  IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override Begin Date') = 0);
    LogOutput('WARN', cProcessName | ' | CANT_WRITE Override Begin Date');
  ELSE;
    CellPutS(sBeginDate, cCube, pVersion, sSKU, sPromoID, 'Override Begin Date');
    nLoaded = nLoaded + 1;
  ENDIF;
ENDIF;

IF(sEndDate @<> '');
  IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override End Date') = 0);
    LogOutput('WARN', cProcessName | ' | CANT_WRITE Override End Date');
  ELSE;
    CellPutS(sEndDate, cCube, pVersion, sSKU, sPromoID, 'Override End Date');
    nLoaded = nLoaded + 1;
  ENDIF;
ENDIF;

IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override Active') = 0);
  LogOutput('WARN', cProcessName | ' | CANT_WRITE Override Active');
ELSE;
  CellPutS(sActive, cCube, pVersion, sSKU, sPromoID, 'Override Active');
  nLoaded = nLoaded + 1;
ENDIF;

IF(CellIsUpdateable(cCube, pVersion, sSKU, sPromoID, 'Override Pro Only') = 0);
  LogOutput('WARN', cProcessName | ' | CANT_WRITE Override Pro Only');
ELSE;
  CellPutS(sProOnly, cCube, pVersion, sSKU, sPromoID, 'Override Pro Only');
  nLoaded = nLoaded + 1;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
LogOutput('INFO', cProcessName | ' | END | Loaded=' | TRIM(STR(nLoaded,12,0)) | ' | Skipped=' | TRIM(STR(nSkipped,12,0)) | ' | NewPromos=' | TRIM(STR(nNewPromos,12,0)) | ' | GrownSlots=' | TRIM(STR(nGrownSlots,12,0)));

#endregion