cProcessName = GetProcessName();
LogOutput('INFO', 'START ' | cProcessName | ' V=' | pVersion | ' Cat=' | pPreOwnedCategory);

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pVersion: ' | pVersion);
  ProcessError;
ENDIF;
IF(pPreOwnedCategory @= '' % DIMIX('Merch PreOwned Category', pPreOwnedCategory) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pPreOwnedCategory: ' | pPreOwnedCategory);
  ProcessError;
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
ExecuteProcess('PreOwned.Calc.SubmitToPlanReporting.Forecast_temp', 'pVersion', pVersion, 'pPreOwnedCategory', pPreOwnedCategory);
ExecuteProcess('PreOwned.Calc.SubmitToPlanReporting.Inventory_temp', 'pVersion', pVersion, 'pPreOwnedCategory', pPreOwnedCategory);
LogOutput('INFO', 'END ' | cProcessName);

#endregion