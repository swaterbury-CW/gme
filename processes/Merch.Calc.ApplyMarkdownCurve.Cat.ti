#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-13
# LAST UPDATE: 2026-05-13
# CHANGED BY: Steve Waterbury
# COMMENTS: Per-Roles-parent markdown worker. DESCENDANTS([Merch SKU].[Roles].[pRole]) MDX scope.
# CHANGE HISTORY:
#   2026-05-13 | Steve Waterbury | Initial creation (plan 46c8263071d6)
#EndRegion

sProcess = GetProcessName();
sLogLevel = CellGetS('ProcessControl', sProcess, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

cForecastCube = 'Merch Forecast';
cCurveCube = 'Merch Curve';
cAssignCube = 'Merch Curve Assignment';
cDimSKU = 'Merch SKU';
cDimTime = 'Merch Time Period';

sVersion = pVersion;
sFiscalYear = pFiscalYear;
IF(sVersion @= '');
  LogOutput('ERROR', sProcess | ' | pVersion empty');
  ProcessError;
ENDIF;
IF(sFiscalYear @= '');
  LogOutput('ERROR', sProcess | ' | pFiscalYear empty');
  ProcessError;
ENDIF;
IF(pRole @= '');
  LogOutput('ERROR', sProcess | ' | pRole empty');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', sVersion) = 0);
  LogOutput('ERROR', sProcess | ' | Version not found');
  ProcessError;
ENDIF;

sFYShort = Subst(sFiscalYear, 3, 2);
nWeeksInTargetFY = 52;
IF(DIMIX(cDimTime, 'FY' | sFYShort | '-W53') > 0);
  nWeeksInTargetFY = 53;
ENDIF;

nSKUsWithCurve = 0;
nSKUsSkipped = 0;
nCellsWritten = 0;
nCellsCleared = 0;
nCellsSkipped = 0;

nStart = NOW;
LogOutput('INFO', 'TIMING START: ' | sProcess | ' | V=' | sVersion | ' | FY=' | sFiscalYear | ' | Role=' | pRole);

sView = 'TI_ApplyMDCurveRole_' | TRIM(STR(NOW, 15, 0));
IF(ViewExists(cAssignCube, sView) = 1);
  ViewDestroy(cAssignCube, sView);
ENDIF;
sMDX = 'SELECT {[Merch Curve Assignment Measure].[Merch Curve Assignment Measure].[Applied Markdown Curve]} ON COLUMNS, '
     | '{DESCENDANTS([Merch SKU].[Roles].[' | pRole | '], , LEAVES)} ON ROWS '
     | 'FROM [Merch Curve Assignment] WHERE ([Merch Version].[Merch Version].[' | sVersion | '])';
ViewCreateByMDX(cAssignCube, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cAssignCube, sView, 0);
ViewExtractSkipZeroesSet(cAssignCube, sView, 0);
DatasourceType = 'VIEW';
DatasourceNameForServer = cAssignCube;
DatasourceCubeview = sView;
LogOutput('INFO', 'TIMING VIEW READY: ' | sProcess | ' | Role=' | pRole | ' | BuildSec=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)));

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sSKU = vMerch_SKU;
IF(DTYPE(cDimSKU, sSKU) @<> 'N');
  ItemSkip;
ENDIF;
sMDCurveName = CellGetS(cAssignCube, sVersion, sSKU, 'Applied Markdown Curve');
nMDStartDate = CellGetN(cAssignCube, sVersion, sSKU, 'Applied Markdown Start Date');
nMDEndDate = CellGetN(cAssignCube, sVersion, sSKU, 'Applied Markdown End Date');
IF(sMDCurveName @= '' % nMDStartDate = 0 % nMDEndDate = 0);
  nSKUsSkipped = nSKUsSkipped + 1;
  ItemSkip;
ENDIF;
IF(DIMIX('Merch Curve Name', sMDCurveName) = 0);
  LogOutput('WARN', sProcess | ' | Curve not found: ' | sMDCurveName);
  ItemSkip;
ENDIF;
nSKUsWithCurve = nSKUsWithCurve + 1;
nWkIdx = 1;
While(nWkIdx <= nWeeksInTargetFY);
  IF(nWkIdx < 10);
    sWkStr = '0' | TRIM(STR(nWkIdx,2,0));
  ELSE;
    sWkStr = TRIM(STR(nWkIdx,2,0));
  ENDIF;
  sFiscalWeek = 'FY' | sFYShort | '-W' | sWkStr;
  IF(DIMIX(cDimTime, sFiscalWeek) > 0);
    nWeekStartSerial = ATTRN(cDimTime, sFiscalWeek, 'Start_Date');
    IF(nWeekStartSerial > 0 & nWeekStartSerial >= nMDStartDate & nWeekStartSerial <= nMDEndDate);
      IF(CellIsUpdateable(cForecastCube, sVersion, sFiscalWeek, sSKU, 'Markdown %') = 1);
        CellPutN(0, cForecastCube, sVersion, sFiscalWeek, sSKU, 'Markdown %');
        nCellsCleared = nCellsCleared + 1;
      ENDIF;
    ENDIF;
  ENDIF;
  nWkIdx = nWkIdx + 1;
End;
nRelativeWeek = 0;
nWkIdx = 1;
While(nWkIdx <= nWeeksInTargetFY);
  IF(nWkIdx < 10);
    sWkStr = '0' | TRIM(STR(nWkIdx,2,0));
  ELSE;
    sWkStr = TRIM(STR(nWkIdx,2,0));
  ENDIF;
  sFiscalWeek = 'FY' | sFYShort | '-W' | sWkStr;
  IF(DIMIX(cDimTime, sFiscalWeek) > 0);
    nWeekStartSerial = ATTRN(cDimTime, sFiscalWeek, 'Start_Date');
    IF(nWeekStartSerial > 0 & nWeekStartSerial >= nMDStartDate & nWeekStartSerial <= nMDEndDate);
      nRelativeWeek = nRelativeWeek + 1;
      sRelCW = 'Week ' | TRIM(STR(nRelativeWeek, 2, 0));
      IF(DIMIX('Merch Curve Week', sRelCW) > 0);
        nMDPct = CellGetN(cCurveCube, sMDCurveName, sRelCW, 'Markdown %');
        IF(nMDPct > 0);
          IF(CellIsUpdateable(cForecastCube, sVersion, sFiscalWeek, sSKU, 'Markdown %') = 1);
            CellPutN(nMDPct, cForecastCube, sVersion, sFiscalWeek, sSKU, 'Markdown %');
            nCellsWritten = nCellsWritten + 1;
          ELSE;
            nCellsSkipped = nCellsSkipped + 1;
          ENDIF;
        ENDIF;
      ENDIF;
    ENDIF;
  ENDIF;
  nWkIdx = nWkIdx + 1;
End;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cAssignCube, sView) = 1);
  ViewDestroy(cAssignCube, sView);
ENDIF;
LogOutput('INFO', 'TIMING END: ' | sProcess | ' | Role=' | pRole | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's | SKUs=' | TRIM(STR(nSKUsWithCurve,10,0)) | ' Written=' | TRIM(STR(nCellsWritten,10,0)));

#endregion