#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-04-21
# LAST UPDATE: 2026-04-21
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Additive build of Merch PreOwned Category. TM1CubeView on attribute cube.
# CHANGE HISTORY:
#   2026-04-21 | Steve Waterbury | Initial creation
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | cProcessName | ' | pHierarchy=' | pHierarchy); ENDIF;

cCatDim = 'Merch PreOwned Category';
cRoot = 'All PreOwned Categories';
cAttrCube = '}ElementAttributes_Merch SKU';
nCatsInserted = 0;
nCount = 0;

AttrInsert(cCatDim, '', 'SGM_Category_Group', 'S');
IF(DIMIX(cCatDim, cRoot) = 0);
  DimensionElementInsertDirect(cCatDim, '', cRoot, 'C');
ENDIF;

IF(pHierarchy @= 'SGM_Category');
  sRowMDX = 'FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[SGM_Category])}, 1)}, LEFT([Merch SKU].[SGM_Category].CurrentMember.Name, 9) = ''Pre-Owned'' OR LEFT([Merch SKU].[SGM_Category].CurrentMember.Name, 8) = ''Preowned'')';
ELSEIF(pHierarchy @= 'Category_Name');
  sRowMDX = 'FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Category_Name])}, 1)}, LEFT([Merch SKU].[Category_Name].CurrentMember.Name, 8) = ''Preowned'' OR [Merch SKU].[Category_Name].CurrentMember.Name = ''Modern Retro'')';
ELSE;
  LogOutput('ERROR', cProcessName | ' | unknown pHierarchy=' | pHierarchy);
  sRowMDX = '{}';
ENDIF;

sView = 'TI_POCatBuild_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[}ElementAttributes_Merch SKU].[Caption]} ON COLUMNS, {' | sRowMDX | '} ON ROWS FROM [}ElementAttributes_Merch SKU]';
IF(ViewExists(cAttrCube, sView) = 1); ViewDestroy(cAttrCube, sView); ENDIF;
ViewCreateByMDX(cAttrCube, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cAttrCube, sView, 0);
ViewExtractSkipZeroesSet(cAttrCube, sView, 0);
ViewExtractSkipRuleValuesSet(cAttrCube, sView, 0);

DatasourceType = 'VIEW';
DatasourceNameForServer = cAttrCube;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
sCatVal = vMerch_SKU;
IF(sCatVal @= ''); ItemSkip; ENDIF;
nCount = nCount + 1;

IF(DIMIX(cCatDim, sCatVal) = 0);
  DimensionElementInsertDirect(cCatDim, '', sCatVal, 'N');
  DimensionElementComponentAddDirect(cCatDim, cRoot, sCatVal, 1);
  nCatsInserted = nCatsInserted + 1;
ENDIF;

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vMerch_SKU @= ''); ItemSkip; ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cAttrCube, sView) = 1); ViewDestroy(cAttrCube, sView); ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | pHierarchy=' | pHierarchy | ' | Count=' | TRIM(STR(nCount, 10, 0)) | ' | Cats+=' | TRIM(STR(nCatsInserted, 10, 0)));
ENDIF;

#endregion