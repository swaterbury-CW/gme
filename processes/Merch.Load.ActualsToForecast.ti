#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-02
# LAST UPDATE: 2026-06-04
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Loads Merch Actuals data into Merch Forecast Actual version.
# When period is the LCP week, also writes Forecast Opening Inventory for next week.
# On-Order is NOT loaded into closed periods (End_Date<=LCP): forward/open planning
# measure that would inflate the closed Ending Inventory roll (EI = OI - Sales +
# Receipts + On-Order). Existing closed On-Order in the Actual version is cleared.
#### CHANGE HISTORY:
### 2026-04-02  Steve Waterbury  Creation
### 2026-04-15  Steve Waterbury  OI prefill from Actuals EI; channel hardcoded
### 2026-04-17  Steve Waterbury  Fix OI lookup via Next Week attribute; ItemSkip guards
### 2026-06-04  Steve Waterbury  Exclude + ViewZeroOut On-Order in closed periods (End_Date<=LCP) so it does not inflate the closed EI roll
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0; IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
bLogDebug = 0; IF(sLogLevel @= 'DEBUG'); bLogDebug = 1; ENDIF;

IF(pTimePeriod @= ''); LogOutput('ERROR', cProcessName | ' | pTimePeriod is empty'); ProcessError; ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0); LogOutput('ERROR', cProcessName | ' | Time period not found: ' | pTimePeriod); ProcessError; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | cProcessName | ' | TimePeriod=' | pTimePeriod); ENDIF;

cSrcCube = 'Merch Actuals';
cDstCube = 'Merch Forecast';
cVersion = 'Actual';
cChannel = 'All Channels';
cMeasDim = 'Merch Actuals Measure';
nCellsWritten = 0; nSkipped = 0; nRecordCount = 0; nOIPrefilled = 0;

nLCP = ATTRN('Merch Version', 'Forecast', 'Last_Closed_Period');

#Region : Clear closed-period On-Order in Actual version
IF(nLCP > 0 & DIMIX('Merch Forecast Measure', 'On-Order') > 0);
  sClrView = 'TI_AtoFClr_' | TRIM(STR(NOW, 15, 0));
  sClrMDX = 'SELECT {[Merch Forecast Measure].[Merch Forecast Measure].[On-Order]} ON COLUMNS, NON EMPTY CROSSJOIN({FILTER({TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[Merch Time Period].[' | pTimePeriod | '])}, 0)}, ATTRN([Merch Time Period].[Merch Time Period].CURRENTMEMBER, "End_Date") <= ' | TRIM(STR(nLCP, 15, 0)) | ')}, {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}) ON ROWS FROM [Merch Forecast] WHERE ([Merch Version].[Merch Version].[Actual])';
  ViewCreateByMDX(cDstCube, sClrView, sClrMDX, 1);
  ViewZeroOut(cDstCube, sClrView);
  IF(ViewExists(cDstCube, sClrView) = 1); ViewDestroy(cDstCube, sClrView); ENDIF;
ENDIF;
#EndRegion

sView = 'TI_ActualsToForecast_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Actuals Measure])}, 0)} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[' | pTimePeriod | '])}, 0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} ON ROWS FROM [Merch Actuals] WHERE ([Merch Channel].[' | cChannel | '])';
ViewCreateByMDX(cSrcCube, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cSrcCube, sView, 0);
ViewExtractSkipZeroesSet(cSrcCube, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cSrcCube;
DatasourceCubeview = sView;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nRecordCount = nRecordCount + 1;
sForecastMeasure = ATTRS(cMeasDim, vMerch_Actuals_Measure, 'Forecast Measure Map');
IF(sForecastMeasure @= ''); nSkipped = nSkipped + 1; ItemSkip; ENDIF;
IF(DIMIX('Merch Forecast Measure', sForecastMeasure) = 0); nSkipped = nSkipped + 1; ItemSkip; ENDIF;

# On-Order must not be loaded into closed periods (forward/open planning measure;
# would inflate the closed Ending Inventory roll). Cleared in Prolog; skipped here.
IF(sForecastMeasure @= 'On-Order' & ATTRN('Merch Time Period', vMerch_Time_Period, 'End_Date') <= nLCP);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

# main load: write Actuals -> Forecast at Actual version
nVal = Value;
IF(nVal = 0); ItemSkip; ENDIF;
IF(CellIsUpdateable(cDstCube, cVersion, vMerch_Time_Period, vMerch_SKU, sForecastMeasure) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;
CellPutN(nVal, cDstCube, cVersion, vMerch_Time_Period, vMerch_SKU, sForecastMeasure);
nCellsWritten = nCellsWritten + 1;

# OI prefill (unchanged): for the LCP week + Calc Units, write Actuals EI to next week Forecast OI.
IF(nLCP > 0 & sForecastMeasure @= 'Calc Units' & ATTRN('Merch Time Period', vMerch_Time_Period, 'End_Date') = nLCP);
  sNextWeek = ATTRS('Merch Time Period', vMerch_Time_Period, 'Next Week');
  IF(sNextWeek @<> '' & DIMIX('Merch Time Period', sNextWeek) > 0);
    nActualEI = CellGetN(cSrcCube, vMerch_SKU, vMerch_Time_Period, cChannel, 'location_inventory_quantity_ending');
    IF(nActualEI <> 0);
      IF(CellIsUpdateable(cDstCube, 'Forecast', sNextWeek, vMerch_SKU, 'Opening Inventory') = 0);
        nSkipped = nSkipped + 1;
        ItemSkip;
      ENDIF;
      CellPutN(nActualEI, cDstCube, 'Forecast', sNextWeek, vMerch_SKU, 'Opening Inventory');
      nOIPrefilled = nOIPrefilled + 1;
    ENDIF;
  ENDIF;
ENDIF;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSrcCube, sView) = 1); ViewDestroy(cSrcCube, sView); ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'END: ' | cProcessName | ' | Records=' | TRIM(STR(nRecordCount, 10, 0)) | ' | Written=' | TRIM(STR(nCellsWritten, 10, 0)) | ' | Skipped=' | TRIM(STR(nSkipped, 10, 0)) | ' | OIPrefilled=' | TRIM(STR(nOIPrefilled, 10, 0))); ENDIF;
#endregion