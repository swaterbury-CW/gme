#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-22
# LAST UPDATE: 2026-06-09
# CHANGED BY : Steve Waterbury
# COMMENTS: Clears placeholder forecast input measures scoped to user's }Groups membership.
# CHANGE HISTORY:
#   2026-04-21 | Steve Waterbury | }Groups dim threaded; ProcessError; optional pGroup override
#   2026-05-07 | Steve Waterbury | Unified MDX; MDX-axis var order; Value->Numeric; nVal=Value
#   2026-05-11 | Steve Waterbury | Qualified Merch Version hierarchy in WHERE MDX
#   2026-06-09 | Steve Waterbury | Added 'Receipts' to cleared measure set (PH cleanup left receipts; plan a240cabb67e4); LogOutput 3-arg
#EndRegion

cProcessName = GetProcessName();
sCube = 'Merch Placeholder Forecast';
sDimPH = 'Merch Placeholder SKU';
sDimCat = 'Merch Category';
sVersion = pVersion;

sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | START | V=' | pVersion | ' PH=' | pPlaceholderSKU | ' Cat=' | pCategory | ' pGroup=' | pGroup, 1);
ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid version', 1);
  ProcessError;
ENDIF;
IF(pPlaceholderSKU @= '');
  LogOutput('ERROR', cProcessName | ' | pPlaceholderSKU empty', 1);
  ProcessError;
ENDIF;
IF(DIMIX(sDimPH, pPlaceholderSKU) = 0);
  LogOutput('ERROR', cProcessName | ' | PH SKU not found', 1);
  ProcessError;
ENDIF;
IF(pCategory @<> '');
  IF(DIMIX(sDimCat, pCategory) = 0);
    LogOutput('ERROR', cProcessName | ' | Invalid category', 1);
    ProcessError;
  ENDIF;
ENDIF;

sGroup = '';
IF(pGroup @<> '');
  IF(DIMIX('}Groups', pGroup) = 0);
    LogOutput('ERROR', cProcessName | ' | Invalid pGroup', 1);
    ProcessError;
  ENDIF;
  sGroup = pGroup;
ELSE;
  sUser = TM1User();
  nG = 1; nGroupCount = DIMSIZ('}Groups');
  WHILE(nG <= nGroupCount);
    sG = DIMNM('}Groups', nG);
    IF(sG @<> 'ADMIN' & sG @<> 'SecurityAdmin' & sG @<> 'DataAdmin' & sG @<> 'OperationsAdmin' & sG @<> 'Read Only');
      IF(CellGetN('}ClientGroups', sUser, sG) = 1);
        sGroup = sG;
        nG = nGroupCount;
      ENDIF;
    ENDIF;
    nG = nG + 1;
  END;
  IF(sGroup @= '');
    LogOutput('ERROR', cProcessName | ' | No functional group for user: ' | sUser, 1);
    ProcessError;
  ENDIF;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | Group=' | sGroup, 1);
ENDIF;

sViewName = 'TI_ClearPH';
sMeasureSet = '{[Merch Forecast Measure].[Build/Debuild],[Merch Forecast Measure].[Category Build],[Merch Forecast Measure].[Promo Build],[Merch Forecast Measure].[Adjustment Units],[Merch Forecast Measure].[Buy Units],[Merch Forecast Measure].[Markdown %],[Merch Forecast Measure].[Rate Adjustment],[Merch Forecast Measure].[Price Adjustment],[Merch Forecast Measure].[Level],[Merch Forecast Measure].[Seasonality],[Merch Forecast Measure].[Velocity],[Merch Forecast Measure].[Regime],[Merch Forecast Measure].[Receipts]}';
IF(pCategory @<> '');
  sCatSet = '{[Merch Category].[' | pCategory | ']}';
ELSE;
  sCatSet = '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Category])}, 0)}';
ENDIF;
sMDX = 'SELECT NON EMPTY ' | sMeasureSet | ' ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} * ' | sCatSet | ' ON ROWS FROM [Merch Placeholder Forecast] WHERE ([Merch Version].[Merch Version].[' | sVersion | '], [Merch Placeholder SKU].[' | pPlaceholderSKU | '], [}Groups].[' | sGroup | '])';
IF(ViewExists(sCube, sViewName) = 1);
  ViewDestroy(sCube, sViewName);
ENDIF;
ViewCreateByMDX(sCube, sViewName, sMDX, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = sCube;
DatasourceCubeview = sViewName;

nCellsCleared = 0;
nCellsSkipped = 0;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vPHSKU @= '');
  ItemReject('Empty PHSKU row');
ENDIF;
IF(pCategory @<> '');
  sCategory = pCategory;
ELSE;
  sCategory = vCategory;
ENDIF;
IF(sCategory @= '');
  ItemReject('Empty category');
ENDIF;

nVal = Value;
IF(nVal <> 0);
  IF(CellIsUpdateable(sCube, vVersion, vTimePeriod, sCategory, vPHSKU, sGroup, vMeasure) = 1);
    CellPutN(0, sCube, vVersion, vTimePeriod, sCategory, vPHSKU, sGroup, vMeasure);
    nCellsCleared = nCellsCleared + 1;
  ELSE;
    nCellsSkipped = nCellsSkipped + 1;
  ENDIF;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(sCube, sViewName) = 1);
  ViewDestroy(sCube, sViewName);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | END | Grp=' | sGroup | ' Cleared=' | TRIM(STR(nCellsCleared, 10, 0)) | ' Skipped=' | TRIM(STR(nCellsSkipped, 10, 0)), 1);
ENDIF;

#endregion