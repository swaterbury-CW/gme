#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-17
# LAST UPDATE: 2026-05-17
# CHANGED BY: Steve Waterbury
# COMMENTS:
# One-off orchestrator for Lock 3/9/2026 BQ load into Merch Forecast.
# Prolog (in order): add Merch Version element 'Last Lock - 03-09-2026' via
#   DimensionElementInsertDirect (immediate commit), set Version_Type='Static'
#   on }ElementAttributes_Merch Version so Merch Forecast rules pass through
#   and CellPutN writes succeed on rule-LHS measures (Calc Units, etc.),
#   then run API.BigQuery.Export against lock_3_9_2026 table.
# Epilog: loops up to 100 pages, FileExists guard, dispatches to .Page_temp.
# CHANGE HISTORY:
#   2026-05-17 | Steve Waterbury | Initial one-off load
#   2026-05-17 | Steve Waterbury | Switch dim insert to DimensionElementInsertDirect in Prolog
#   2026-05-17 | Steve Waterbury | Set Version_Type='Static' so rule-LHS measures are writable
#EndRegion

cProcessName = GetProcessName();
cVersion = 'Last Lock - 03-09-2026';
cBaseFile = 'lock_3_9_2026_bq';
cPageProc = 'Merch.Load.Lock.BQ.Page_temp';
cQuery = 'SELECT * FROM `merchplanning-suite-prod-062.planninganalytics.lock_3_9_2026`';
cAttrCube = '}ElementAttributes_Merch Version';

#Region : Logging
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'INFO';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | cVersion | ' | BaseFile=' | cBaseFile);
ENDIF;

#Region : Add Merch Version element + flag as Static (immediate commit)
IF(DIMIX('Merch Version', cVersion) = 0);
  DimensionElementInsertDirect('Merch Version', '', cVersion, 'N');
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcessName | ' | Added Merch Version element: ' | cVersion);
  ENDIF;
ENDIF;
IF(CellIsUpdateable(cAttrCube, cVersion, 'Version_Type') = 1);
  CellPutS('Static', cAttrCube, cVersion, 'Version_Type');
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcessName | ' | Set Version_Type=Static on ' | cVersion);
  ENDIF;
ELSE;
  LogOutput('ERROR', cProcessName | ' | Version_Type attribute not updateable for ' | cVersion);
  ProcessError;
ENDIF;
#EndRegion

#Region : Run BQ Export
ExecuteProcess('API.BigQuery.Export', 'pQuery', cQuery, 'pOutputFile', cBaseFile, 'pMaxResults', '50000');
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | BigQuery export complete');
ENDIF;
#EndRegion
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
# Empty - structural insert + attribute write moved to Prolog (immediate commit on v12 SaaS).
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
# Orchestrator has no datasource; dispatch loop lives in Epilog.
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Dispatch Pages
nPagesRun = 0;
nPage = 1;
WHILE(nPage <= 100);
  sPageFile = cBaseFile | '_page_' | TRIM(STR(nPage, 5, 0)) | '.json';
  IF(FileExists(sPageFile) = 1);
    nRC = ExecuteProcess(cPageProc, 'pVersion', cVersion, 'pFile', sPageFile);
    IF(nRC <> 0);
      LogOutput('ERROR', cProcessName | ' | Page ' | TRIM(STR(nPage, 5, 0)) | ' RC=' | TRIM(STR(nRC, 10, 0)));
    ELSE;
      nPagesRun = nPagesRun + 1;
    ENDIF;
  ENDIF;
  nPage = nPage + 1;
END;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | PagesRun=' | TRIM(STR(nPagesRun, 5, 0)));
ENDIF;
#endregion