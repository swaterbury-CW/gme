#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-06
# LAST UPDATE: 2026-05-06
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | v3: drop bogus ProcessExit; let empty subset yield empty view
#EndRegion

cSkuDim = 'Merch SKU';
cCategoryAttr = 'SGM_Category';
cProcessName = GetProcessName();
nCellsCopied = 0;
nStart = NOW;

IF(pCubeName @= '' % pSourceVersion @= '' % pTargetVersion @= '' % pCategory @= '');
  LogOutput('ERROR', cProcessName | ' | Missing param');
  ProcessError;
ENDIF;
IF(CubeExists(pCubeName) = 0);
  LogOutput('ERROR', cProcessName | ' | Cube missing: ' | pCubeName);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pSourceVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Source missing: ' | pSourceVersion);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Category', pCategory) = 0);
  LogOutput('ERROR', cProcessName | ' | Category missing: ' | pCategory);
  ProcessError;
ENDIF;

sSkuSubset = 'TI_TPSKUcat_' | TRIM(STR(NOW, 15, 0)) | '_' | TRIM(STR(DIMIX('Merch Category', pCategory), 6, 0));
IF(SubsetExists(cSkuDim, sSkuSubset) = 1);
  SubsetDestroy(cSkuDim, sSkuSubset);
ENDIF;
sSubMDX = '{FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}, [Merch SKU].[Merch SKU].CurrentMember.Properties(' | CHAR(34) | cCategoryAttr | CHAR(34) | ')=' | CHAR(34) | pCategory | CHAR(34) | ')}';
SubsetCreateByMDX(sSkuSubset, sSubMDX, cSkuDim, 0);

nSubSize = SubsetGetSize(cSkuDim, sSkuSubset);

sTargetVersionType = ATTRS('Merch Version', pTargetVersion, 'Version_Type');
nSkipRuleCalcs = 1;
IF(sTargetVersionType @= 'Static');
  nSkipRuleCalcs = 0;
ENDIF;

LogOutput('INFO', 'TIMING START: ' | cProcessName | ' | Cube=' | pCubeName | ' | Cat=' | pCategory | ' | SubSize=' | TRIM(STR(nSubSize, 12, 0)) | ' | Src=' | pSourceVersion | ' | Tgt=' | pTargetVersion);

cDimVer = TABDIM(pCubeName, 1);
cDimTP = TABDIM(pCubeName, 2);
cDimSKU = TABDIM(pCubeName, 3);
cDimMeasure = TABDIM(pCubeName, 4);

sView = 'TI_CopyTPSKUcat_' | TRIM(STR(NOW, 15, 0)) | '_' | TRIM(STR(DIMIX('Merch Category', pCategory), 6, 0));
sMDX = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimMeasure | '].[' | cDimMeasure | '])}, 0)} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimTP | '].[' | cDimTP | '])}, 0)}, {TM1SubsetToSet([' | cDimSKU | '].[' | cDimSKU | '], ' | CHAR(34) | sSkuSubset | CHAR(34) | ')}) ON ROWS FROM [' | pCubeName | '] WHERE ([' | cDimVer | '].[' | cDimVer | '].[' | pSourceVersion | '])';

ViewCreateByMDX(pCubeName, sView, sMDX, 1);
ViewExtractSkipCalcsSet(pCubeName, sView, nSkipRuleCalcs);
ViewExtractSkipZeroesSet(pCubeName, sView, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = pCubeName;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sMeasType = DTYPE(cDimMeasure, vMeasure);
IF(sMeasType @<> 'N' & sMeasType @<> 'S' & sMeasType @<> 'C');
  ItemReject('Bad measure type: ' | sMeasType);
ENDIF;

IF(sMeasType @= 'S');
  IF(Value @= '');
    ItemSkip;
  ENDIF;
  IF(CellIsUpdateable(pCubeName, pTargetVersion, vTP, vSKU, vMeasure) = 0);
    ItemSkip;
  ENDIF;
  CellPutS(Value, pCubeName, pTargetVersion, vTP, vSKU, vMeasure);
  nCellsCopied = nCellsCopied + 1;
  ItemSkip;
ENDIF;

nVal = NUMBR(Value);
IF(nVal = 0);
  ItemSkip;
ENDIF;
IF(CellIsUpdateable(pCubeName, pTargetVersion, vTP, vSKU, vMeasure) = 0);
  ItemSkip;
ENDIF;
CellPutN(nVal, pCubeName, pTargetVersion, vTP, vSKU, vMeasure);
nCellsCopied = nCellsCopied + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(pCubeName, sView) = 1);
  ViewDestroy(pCubeName, sView);
ENDIF;
IF(SubsetExists(cSkuDim, sSkuSubset) = 1);
  SubsetDestroy(cSkuDim, sSkuSubset);
ENDIF;
LogOutput('INFO', 'TIMING END: ' | cProcessName | ' | Cube=' | pCubeName | ' | Cat=' | pCategory | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's | Cells=' | TRIM(STR(nCellsCopied, 12, 0)));

#endregion