#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-22
# LAST UPDATE: 2026-05-14
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-03-22 | Steve Waterbury | Creation - RunProcess orchestrator
#   2026-03-23 | Steve Waterbury | Refactored to }Cubes TM1DimensionSubset datasource
#   2026-04-01 | Steve Waterbury | Applied guardrails header template
#   2026-05-14 | Steve Waterbury | Add Merch Forecast routing branch to .Forecast orchestrator (design plan 393b7b1fdbfb)
#EndRegion

cProcessName = GetProcessName();

sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG'); bLogDebug = 1; ENDIF;

IF(pSourceVersion @= '' % pTargetVersion @= '');
  LogOutput('ERROR', cProcessName | ' | Missing parameters');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pSourceVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Source version not found: ' | pSourceVersion);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pTargetVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Target version not found: ' | pTargetVersion);
  ProcessError;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | ' | pSourceVersion | ' -> ' | pTargetVersion);
ENDIF;

nCubesDispatched = 0;

sSubset = 'TI_VersionCopy_' | TRIM(STR(NOW, 15, 0));
SubsetCreateByMDX(sSubset, '{TM1SUBSETALL([}Cubes])}', '}Cubes', 0);

DatasourceType = 'SUBSET';
DatasourceNameForServer = '}Cubes';
DatasourceDimensionSubset = sSubset;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sCubeName = vCube;

IF(SUBST(sCubeName, 1, 1) @= '}');
    IF(bLogDebug = 1);
        LogOutput('DEBUG', cProcessName | ' | Skipping system cube: ' | sCubeName);
    ENDIF;
ELSE;

IF(sCubeName @= 'Merch Forecast');
    RunProcess('Merch.Version.Copy.Forecast', 'pSourceVersion', pSourceVersion, 'pTargetVersion', pTargetVersion, 'pCategoryFilter', '');
    nCubesDispatched = nCubesDispatched + 1;
    IF(bLogDebug = 1);
        LogOutput('DEBUG', cProcessName | ' | Routed Merch Forecast to .Forecast orchestrator');
    ENDIF;
ELSE;

nDimCount = CubeDimensionCountGet(sCubeName);
nDimIdx = 1;
bHasVersion = 0;
WHILE(nDimIdx <= nDimCount);
    IF(TABDIM(sCubeName, nDimIdx) @= 'Merch Version');
        bHasVersion = 1;
        nDimIdx = nDimCount;
    ENDIF;
    nDimIdx = nDimIdx + 1;
END;

IF(bHasVersion = 1);
    IF(nDimCount = 5);
        RunProcess('Merch.Version.Copy.5Dim', 'pCubeName', sCubeName, 'pSourceVersion', pSourceVersion, 'pTargetVersion', pTargetVersion);
        nCubesDispatched = nCubesDispatched + 1;
    ELSEIF(nDimCount = 4);
        RunProcess('Merch.Version.Copy.TPSKU', 'pCubeName', sCubeName, 'pSourceVersion', pSourceVersion, 'pTargetVersion', pTargetVersion);
        nCubesDispatched = nCubesDispatched + 1;
    ELSEIF(nDimCount = 3);
        RunProcess('Merch.Version.Copy.SKU', 'pCubeName', sCubeName, 'pSourceVersion', pSourceVersion, 'pTargetVersion', pTargetVersion);
        nCubesDispatched = nCubesDispatched + 1;
    ELSE;
        LogOutput('WARN', cProcessName | ' | Unsupported dim count ' | TRIM(STR(nDimCount, 2, 0)) | ' for cube: ' | sCubeName);
    ENDIF;
ENDIF;

ENDIF;

ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
SubsetDestroy('}Cubes', sSubset);

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Cubes dispatched=' | TRIM(STR(nCubesDispatched, 10, 0)));
ENDIF;

#endregion