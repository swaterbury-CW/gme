#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-04-19
# LAST UPDATE: 2026-04-21
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Orchestrator for pre-owned inventory load: zero-out + 2 per-hierarchy passes. No datasource.
# CHANGE HISTORY:
#   2026-04-19 | Steve Waterbury | Initial InventoryActualsFromMerch
#   2026-04-21 | Steve Waterbury | Refactor to orchestrator; fresh re-create to drop legacy datasource
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | cProcessName | ' | P=' | pTimePeriod | ' | V=' | pVersion); ENDIF;

IF(pTimePeriod @= '');
  LogOutput('ERROR', cProcessName | ' | pTimePeriod is required');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid period: ' | pTimePeriod);
  ProcessError;
ENDIF;
IF(pVersion @= ''); pVersion = 'Actual'; ENDIF;

cTargetCube = 'Merch PreOwned Inventory';

sZeroView = 'TI_POInv_Zero_' | TRIM(STR(NOW, 15, 0));
sZeroMdx = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch PreOwned Inventory Measure])}, 0)} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL(DESCENDANTS([Merch Time Period].[Merch Time Period].[' | pTimePeriod | ']), 0)}, {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch PreOwned Category])}, 0)}) ON ROWS FROM [Merch PreOwned Inventory] WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';

IF(ViewExists(cTargetCube, sZeroView) = 1); ViewDestroy(cTargetCube, sZeroView); ENDIF;
ViewCreateByMDX(cTargetCube, sZeroView, sZeroMdx, 1);
ViewZeroOut(cTargetCube, sZeroView);
ViewDestroy(cTargetCube, sZeroView);
IF(bLogInfo = 1); LogOutput('INFO', cProcessName | ' | zero-out complete'); ENDIF;

nRC1 = ExecuteProcess('PreOwned.Load.InventoryActualsFromMerch.Hier', 'pTimePeriod', pTimePeriod, 'pVersion', pVersion, 'pHierarchy', 'SGM_Category');
IF(nRC1 <> 0); LogOutput('ERROR', cProcessName | ' | SGM_Category pass rc=' | TRIM(STR(nRC1, 10, 0))); ENDIF;

nRC2 = ExecuteProcess('PreOwned.Load.InventoryActualsFromMerch.Hier', 'pTimePeriod', pTimePeriod, 'pVersion', pVersion, 'pHierarchy', 'Category_Name');
IF(nRC2 <> 0); LogOutput('ERROR', cProcessName | ' | Category_Name pass rc=' | TRIM(STR(nRC2, 10, 0))); ENDIF;

IF(bLogInfo = 1); LogOutput('INFO', 'END: ' | cProcessName | ' | RC1=' | TRIM(STR(nRC1, 10, 0)) | ' | RC2=' | TRIM(STR(nRC2, 10, 0))); ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

