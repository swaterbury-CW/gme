#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-06
# LAST UPDATE: 2026-05-06
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | Initial v1 - hit rule conflict on Promo Name / Promo Type.
#   2026-05-06 | Steve Waterbury | v2 - write Override-prefixed measures only.
#   2026-05-06 | Steve Waterbury | v3 - add pVersion parameter (was hardcoded 'Forecast').
cProcessName = GetProcessName();
cCube = 'Merch Promo Settings';
sVersion = pVersion;
IF(sVersion @= '');
  sVersion = 'Forecast';
ENDIF;
IF(DIMIX('Merch Version', sVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pVersion: ' | sVersion);
  ProcessError;
ENDIF;
cVersion = sVersion;
nRecordCount = 0;
nCellsWritten = 0;
DataSourceType = 'JSON';
DatasourceNameForServer = pPageFile;
DataSourceJsonRootPointer = '/rows';
DataSourceJsonVariableMapping = JsonAdd('{}', 'vRow', StringToJson('/f'));

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
cCube = 'Merch Promo Settings';
sPromo = JsonGet(vRow, '/0/v');
sStart = JsonGet(vRow, '/1/v');
sEnd   = JsonGet(vRow, '/2/v');
sOffer = JsonGet(vRow, '/3/v');
sSku   = JsonGet(vRow, '/4/v');
sColor = JsonGet(vRow, '/5/v');
sDisc  = JsonGet(vRow, '/6/v');
IF(SUBST(sPromo,1,1) @= '"');
  sPromo = SUBST(sPromo,2,LONG(sPromo)-2);
ENDIF;
IF(SUBST(sStart,1,1) @= '"');
  sStart = SUBST(sStart,2,LONG(sStart)-2);
ENDIF;
IF(SUBST(sEnd,1,1) @= '"');
  sEnd = SUBST(sEnd,2,LONG(sEnd)-2);
ENDIF;
IF(SUBST(sOffer,1,1) @= '"');
  sOffer = SUBST(sOffer,2,LONG(sOffer)-2);
ENDIF;
IF(SUBST(sSku,1,1) @= '"');
  sSku = SUBST(sSku,2,LONG(sSku)-2);
ENDIF;
IF(SUBST(sColor,1,1) @= '"');
  sColor = SUBST(sColor,2,LONG(sColor)-2);
ENDIF;
IF(SUBST(sDisc,1,1) @= '"');
  sDisc = SUBST(sDisc,2,LONG(sDisc)-2);
ENDIF;
IF(sSku @= '' % sSku @= 'null');
  ItemSkip;
ENDIF;
IF(DIMIX('Merch SKU', sSku) = 0);
  ItemSkip;
ENDIF;
sPromoSlot = '';
nSlot = 1;
WHILE(nSlot <= 50 & sPromoSlot @= '');
  IF(nSlot < 10);
    sCand = 'PROMO-000' | TRIM(STR(nSlot, 5, 0));
  ELSE;
    sCand = 'PROMO-00' | TRIM(STR(nSlot, 5, 0));
  ENDIF;
  IF(DIMIX('Merch Promo ID', sCand) = 0);
    nSlot = 51;
  ELSE;
    sExisting = CellGetS(cCube, cVersion, sSku, sCand, 'Override Promo Type');
    IF(sExisting @= '');
      sPromoSlot = sCand;
    ELSE;
      nSlot = nSlot + 1;
    ENDIF;
  ENDIF;
END;
IF(sPromoSlot @= '');
  ItemSkip;
ENDIF;
sPromoName = 'Clearance #' | sPromo | ' ' | sColor | ' ' | sDisc | '%';
IF(CellIsUpdateable(cCube, cVersion, sSku, sPromoSlot, 'Override Promo Name') = 1);
  CellPutS(sPromoName, cCube, cVersion, sSku, sPromoSlot, 'Override Promo Name');
ENDIF;
IF(CellIsUpdateable(cCube, cVersion, sSku, sPromoSlot, 'Override Promo Type') = 1);
  CellPutS('Clearance', cCube, cVersion, sSku, sPromoSlot, 'Override Promo Type');
ENDIF;
IF(CellIsUpdateable(cCube, cVersion, sSku, sPromoSlot, 'Override Active') = 1);
  CellPutS('1', cCube, cVersion, sSku, sPromoSlot, 'Override Active');
ENDIF;
IF(CellIsUpdateable(cCube, cVersion, sSku, sPromoSlot, 'Override Begin Date') = 1);
  CellPutS(sStart, cCube, cVersion, sSku, sPromoSlot, 'Override Begin Date');
ENDIF;
IF(CellIsUpdateable(cCube, cVersion, sSku, sPromoSlot, 'Override End Date') = 1);
  CellPutS(sEnd, cCube, cVersion, sSku, sPromoSlot, 'Override End Date');
ENDIF;
IF(CellIsUpdateable(cCube, cVersion, sSku, sPromoSlot, 'Override Discount Pct') = 1);
  CellPutS(sDisc, cCube, cVersion, sSku, sPromoSlot, 'Override Discount Pct');
ENDIF;
nRecordCount = nRecordCount + 1;
nCellsWritten = nCellsWritten + 6;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion