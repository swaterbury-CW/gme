#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-06-18
# LAST UPDATE: 2026-07-13
# CHANGED BY : Steve Waterbury
# COMMENTS: Resets the Merch Forecast promo footprint (Promo %->0, Promo Build->1, Backend Adjustment->0) for cells with a winner in Merch Promo Winner Scratch. Markdown % preserved. View-driven. pSKU any Merch SKU Roles node; blank = all Roles leaves.
# CHANGE HISTORY:
#   2026-06-19 | Steve Waterbury | WS4: reset target Markdown %->Promo % (Markdown % is the preserved markdown input)
#   2026-07-13 | Steve Waterbury | pSKU any Merch SKU Roles node -> leaf DESCENDANTS; blank pSKU scopes all Roles leaves (whole engine on Roles hierarchy)
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | SKU=' | pSKU, 1);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required', 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(DTYPE('Merch Version', pVersion) @<> 'N');
  LogOutput('ERROR', cProcessName | ' | Version must be a leaf element: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(pSKU @<> '');
  IF(HierarchyElementExists('Merch SKU', 'Roles', pSKU) = 0);
    LogOutput('ERROR', cProcessName | ' | SKU node not found in Merch SKU Roles hierarchy: ' | pSKU, 1);
    ProcessError;
  ENDIF;
ENDIF;

cScratch = 'Merch Promo Winner Scratch';
cForecast = 'Merch Forecast';
cWinnerMeasDim = 'Merch Promo Winner Measure';
nResetCount = 0;

IF(pSKU @= '');
  sSKUSet = 'TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Roles])}, 0)';
ELSE;
  sSKUSet = 'TM1FILTERBYLEVEL({DESCENDANTS([Merch SKU].[Roles].[' | pSKU | '])}, 0)';
ENDIF;

sView = 'TI_PromoReset_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[' | cWinnerMeasDim | '].[Has Winner]} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* ' | sSKUSet | ' ON ROWS '
  | 'FROM [' | cScratch | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
IF(ViewExists(cScratch, sView) = 1);
  ViewDestroy(cScratch, sView);
ENDIF;
ViewCreateByMDX(cScratch, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cScratch, sView, 0);
ViewExtractSkipZeroesSet(cScratch, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cScratch;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(Value = 0);
  ItemSkip;
ENDIF;

sSKU = vMerch_SKU;
sTime = vMerch_Time_Period;

IF(DIMIX('Merch SKU', sSKU) = 0);
  ItemReject('Source SKU not found in Merch SKU dim: ' | sSKU);
ENDIF;
IF(DIMIX('Merch Time Period', sTime) = 0);
  ItemReject('Source Time Period not found: ' | sTime);
ENDIF;

IF(CellIsUpdateable(cForecast, pVersion, sTime, sSKU, 'Backend Adjustment') = 1);
  CellPutN(0, cForecast, pVersion, sTime, sSKU, 'Promo %');
  CellPutN(1, cForecast, pVersion, sTime, sSKU, 'Promo Build');
  CellPutN(0, cForecast, pVersion, sTime, sSKU, 'Backend Adjustment');
  nResetCount = nResetCount + 1;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cScratch, sView) = 1);
  ViewDestroy(cScratch, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Reset=' | TRIM(STR(nResetCount, 10, 0)), 1);
ENDIF;

#endregion