#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-06-03
# CHANGED BY : Steve Waterbury
# COMMENTS: GPG/PRP-eligible attach actuals -> Merch New Hardware Warranty by SGM category.
# CHANGE HISTORY:
#   2026-06-03 | Steve Waterbury | Initial creation. Design plan 389a9daaa3ec.
#EndRegion

cSourceCube = 'Merch Actuals';
cTargetCube = 'Merch New Hardware Warranty';
cCatDim = 'Merch New Hardware Category';
nCellsCopied = 0;
nSkipped = 0;

sCats = '[Merch SKU].[SGM_Category].[Controller],[Merch SKU].[SGM_Category].[Audio],[Merch SKU].[SGM_Category].[Chargers / Cables],[Merch SKU].[SGM_Category].[Memory],[Merch SKU].[SGM_Category].[Misc Accessories],[Merch SKU].[SGM_Category].[PC],[Merch SKU].[SGM_Category].[PS5 Hardware],[Merch SKU].[SGM_Category].[Switch Hardware],[Merch SKU].[SGM_Category].[Switch 2 Hardware],[Merch SKU].[SGM_Category].[Xbox Series X Hardware],[Merch SKU].[SGM_Category].[AR/VR Hardware],[Merch SKU].[SGM_Category].[Other VG Hardware],[Merch SKU].[SGM_Category].[PS5 Software],[Merch SKU].[SGM_Category].[PS4 Software],[Merch SKU].[SGM_Category].[Switch Software],[Merch SKU].[SGM_Category].[Switch 2 Software],[Merch SKU].[SGM_Category].[Xbox Series X Software],[Merch SKU].[SGM_Category].[Xbox One Software],[Merch SKU].[SGM_Category].[Other VG Software]';
sSku = 'TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER({' | sCats | '}, ALL, RECURSIVE)}, 0)';
sMeas = '{[Merch Actuals Measure].[Merch Actuals Measure].[attachment_count],[Merch Actuals Measure].[Merch Actuals Measure].[attachment_amount],[Merch Actuals Measure].[Merch Actuals Measure].[location_sales_quantity]}';
sTime = '{TM1FILTERBYLEVEL(DESCENDANTS([Merch Time Period].[Merch Time Period].[' | pTimePeriod | ']),0)}';
sChan = '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel].[Merch Channel])},0)}';
sViewName = 'TI_NHW_Act_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT NON EMPTY ' | sMeas | ' ON COLUMNS, NON EMPTY CROSSJOIN(CROSSJOIN({' | sSku | '},' | sTime | '),' | sChan | ') ON ROWS FROM [Merch Actuals]';

IF(ViewExists(cSourceCube, sViewName) = 1); ViewDestroy(cSourceCube, sViewName); ENDIF;
ViewCreateByMDX(cSourceCube, sViewName, sMDX, 1);
ViewExtractSkipCalcsSet(cSourceCube, sViewName, 0);
ViewSuppressZeroesSet(cSourceCube, sViewName, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cSourceCube;
DatasourceCubeview = sViewName;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(DTYPE('Merch Time Period', vTimePeriod) @<> 'N');
  ItemSkip;
ENDIF;

sG = UPPER(ATTRS('Merch SKU', vSKU, 'GPG_Eligible'));
sP = UPPER(ATTRS('Merch SKU', vSKU, 'PRP_Eligible'));
bEl = 0;
IF(sG @= 'Y' % sG @= 'TRUE' % sP @= 'Y' % sP @= 'TRUE');
  bEl = 1;
ENDIF;
IF(bEl = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

sCat = ATTRS('Merch SKU', vSKU, 'SGM_Category');
IF(DIMIX(cCatDim, sCat) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

sM = '';
IF(vMeasure @= 'attachment_count');
  sM = 'Attach Count';
ENDIF;
IF(vMeasure @= 'attachment_amount');
  sM = 'Attach Amount';
ENDIF;
IF(vMeasure @= 'location_sales_quantity');
  sM = 'Sales Units';
ENDIF;
IF(sM @= '');
  ItemSkip;
ENDIF;

IF(Value = 0);
  ItemSkip;
ENDIF;
sCh = vChannel;
IF(ELLEV('Merch Channel', sCh) <> 0);
  ItemSkip;
ENDIF;
IF(CellIsUpdateable(cTargetCube, pVersion, vTimePeriod, sCat, sCh, sM) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

nPrev = CellGetN(cTargetCube, pVersion, vTimePeriod, sCat, sCh, sM);
CellPutN(nPrev + Value, cTargetCube, pVersion, vTimePeriod, sCat, sCh, sM);
nCellsCopied = nCellsCopied + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSourceCube, sViewName) = 1); ViewDestroy(cSourceCube, sViewName); ENDIF;

#endregion