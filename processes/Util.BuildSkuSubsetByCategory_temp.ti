cProcessName = GetProcessName();

IF(pCategory @= '' % pSubsetName @= '');
  LogOutput('ERROR', cProcessName | ' | Missing param');
  ProcessError;
ENDIF;

IF(SubsetExists('Merch SKU', pSubsetName) = 1);
  SubsetDestroy('Merch SKU', pSubsetName);
ENDIF;

sMDX = '{FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}, [Merch SKU].[Merch SKU].CurrentMember.Properties(' | CHAR(34) | 'SGM_Category' | CHAR(34) | ')=' | CHAR(34) | pCategory | CHAR(34) | ')}';

SubsetCreateByMDX(pSubsetName, sMDX, 'Merch SKU', 0);

nSize = SubsetGetSize('Merch SKU', pSubsetName);
LogOutput('INFO', cProcessName | ' | Subset built: ' | pSubsetName | ' Cat=' | pCategory | ' Size=' | TRIM(STR(nSize, 12, 0)));

#endregion
