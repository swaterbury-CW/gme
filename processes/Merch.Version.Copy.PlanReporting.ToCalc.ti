#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-06-24
# LAST UPDATE: 2026-06-24
# CHANGED BY : Steve Waterbury
# COMMENTS: Fan-out orchestrator: copy pSourceVersion (default Actual) -> every Calculated Merch Version in
#  Merch Plan Reporting IN PARALLEL via RunProcess(Merch.Version.Copy.PlanReporting) + WaitForAllJobs.
#  No datasource; dispatch loop in Epilog (canonical v12 orchestrator pattern). Each child gets a unique
#  pPartIdx so copy view/subset names never collide. Design plan bb17626fc2af.
#### CHANGE HISTORY:
###   2026-06-24 | Steve Waterbury | Initial. Design plan bb17626fc2af.
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;

sSrc = pSourceVersion;
IF(sSrc @= ''); sSrc = 'Actual'; ENDIF;
IF(DIMIX('Merch Version', sSrc) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pSourceVersion: ' | sSrc, 1);
  ProcessError;
ENDIF;
nClear = pClear;
sJobIDs = '';
nPartIdx = 0;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START ' | cProcessName | ' | Source=' | sSrc | ' | Clear=' | TRIM(STR(nClear, 3, 0)), 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
nVerDim = DIMSIZ('Merch Version');
iVer = 1;
WHILE(iVer <= nVerDim);
  sVer = DIMNM('Merch Version', iVer);
  IF(ELLEV('Merch Version', sVer) = 0 & ATTRS('Merch Version', sVer, 'Version_Type') @= 'Calculated' & sVer @<> sSrc);
    nPartIdx = nPartIdx + 1;
    sJobId = RunProcess('Merch.Version.Copy.PlanReporting', 'pSourceVersion', sSrc, 'pTargetVersion', sVer, 'pClear', nClear, 'pPartIdx', nPartIdx);
    IF(sJobIDs @= '');
      sJobIDs = sJobId;
    ELSE;
      sJobIDs = sJobIDs | ',' | sJobId;
    ENDIF;
  ENDIF;
  iVer = iVer + 1;
END;
IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END ' | cProcessName | ' | Dispatched=' | TRIM(STR(nPartIdx, 10, 0)), 1);
ENDIF;

#endregion