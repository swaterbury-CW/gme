#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-06-24
# LAST UPDATE: 2026-06-29
# CHANGED BY : Steve Waterbury
# COMMENTS: Version-driven fan-out: copy pSourceVersion (default Actual) -> Calculated Merch Versions in
#  Merch Plan Reporting. Prolog builds the calc-version subset via MDX attribute filter (Version_Type=
#  Calculated, minus source) and registers it as a TM1DimensionSubset datasource. The Data tab iterates
#  that subset and RunProcess-es Merch.Version.Copy.PlanReporting per version with pTimePeriod scope +
#  pPartIdx; Epilog WaitForAllJobs. No Epilog dispatch loop, no per-week jobs -> crash-safe.
#### CHANGE HISTORY:
###   2026-06-24 | Steve Waterbury | Per-(version,week) Epilog fan-out + scope params. Plan a9c50221d826.
###   2026-06-29 | Steve Waterbury | REWRITE: version-driven subset-DS Data-tab dispatch (no Epilog loop, no per-week jobs). Plan a9c50221d826.
#EndRegion
cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

sSrc = pSourceVersion;
IF(sSrc @= '');
  sSrc = 'Actual';
ENDIF;
IF(DIMIX('Merch Version', sSrc) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pSourceVersion: ' | sSrc, 1);
  ProcessError;
ENDIF;
IF(pTimePeriod @<> '' & DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pTimePeriod: ' | pTimePeriod, 1);
  ProcessError;
ENDIF;
nClear = pClear;

cVerDim = 'Merch Version';
sSub = 'TI_CopyPRToCalc_' | TRIM(STR(NOW, 15, 0));
IF(SubsetExists(cVerDim, sSub) = 1);
  SubsetDestroy(cVerDim, sSub);
ENDIF;
IF(pTargetVersion @<> '');
  SubsetCreateByMDX(sSub, '{[Merch Version].[Merch Version].[' | pTargetVersion | ']}');
ELSE;
  SubsetCreateByMDX(sSub, '{EXCEPT({FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Version].[Merch Version])}, 0)}, [Merch Version].[Merch Version].CurrentMember.Properties("Version_Type") = "Calculated")}, {[Merch Version].[Merch Version].[' | sSrc | ']})}');
ENDIF;

DatasourceType = 'SUBSET';
DatasourceNameForServer = cVerDim;
DatasourceDimensionSubset = sSub;

nPartIdx = 0;
nDispatched = 0;
sJobIDs = '';
IF(bLogInfo = 1);
  LogOutput('INFO', 'START ' | cProcessName | ' | Source=' | sSrc | ' | Target=' | pTargetVersion | ' | Scope=' | pTimePeriod | ' | Clear=' | TRIM(STR(nClear, 3, 0)), 1);
ENDIF;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sVer = vMerch_Version;
IF(sVer @= '');
  ItemReject('empty version');
ENDIF;
nPartIdx = nPartIdx + 1;
sJobId = RunProcess('Merch.Version.Copy.PlanReporting', 'pSourceVersion', sSrc, 'pTargetVersion', sVer, 'pClear', nClear, 'pPartIdx', nPartIdx, 'pTimePeriod', pTimePeriod);
IF(sJobIDs @= '');
  sJobIDs = sJobId;
ELSE;
  sJobIDs = sJobIDs | ',' | sJobId;
ENDIF;
nDispatched = nDispatched + 1;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;
IF(SubsetExists(cVerDim, sSub) = 1);
  SubsetDestroy(cVerDim, sSub);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END ' | cProcessName | ' | Dispatched=' | TRIM(STR(nDispatched, 10, 0)), 1);
ENDIF;
#endregion