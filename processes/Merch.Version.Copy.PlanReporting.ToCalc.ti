#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-06-24
# LAST UPDATE: 2026-06-30
# CHANGED BY : Steve Waterbury
# COMMENTS: Period-subset parallel fan-out: copy pSourceVersion (default Actual) -> Calculated Merch Versions in Merch Plan Reporting, one async .Week worker per (week x calc version) over the scoped pTimePeriod. Data-tab TM1DimensionSubset over Merch Time Period drives the fan-out; Epilog WaitForAllJobs.
#### CHANGE HISTORY:
###   2026-06-30 | Steve Waterbury | Period-subset parallel fan-out across weeks x calc versions.
#EndRegion
cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

sWorkerLog = CellGetS('ProcessControl', 'Merch.Version.Copy.PlanReporting.Week', 'LoggingLevel');

sSrc = pSourceVersion;
IF(sSrc @= '');
  sSrc = 'Actual';
ENDIF;
IF(DIMIX('Merch Version', sSrc) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pSourceVersion: ' | sSrc, 1);
  ProcessError;
ENDIF;
IF(pTimePeriod @<> '' & DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pTimePeriod: ' | pTimePeriod, 1);
  ProcessError;
ENDIF;
nClear = pClear;

cVerDim = 'Merch Version';
sSubVer = 'TI_CopyPRToCalc_ver_' | TRIM(STR(NOW, 15, 0));
IF(SubsetExists(cVerDim, sSubVer) = 1);
  SubsetDestroy(cVerDim, sSubVer);
ENDIF;
IF(pTargetVersion @<> '');
  SubsetCreateByMDX(sSubVer, '{[Merch Version].[Merch Version].[' | pTargetVersion | ']}');
ELSE;
  SubsetCreateByMDX(sSubVer, '{EXCEPT({FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Version].[Merch Version])}, 0)}, [Merch Version].[Merch Version].CurrentMember.Properties("Version_Type") = "Calculated")}, {[Merch Version].[Merch Version].[' | sSrc | ']})}');
ENDIF;
nVerCount = SubsetGetSize(cVerDim, sSubVer);

cTPDim = 'Merch Time Period';
sSubTP = 'TI_CopyPRToCalc_tp_' | TRIM(STR(NOW, 15, 0));
IF(SubsetExists(cTPDim, sSubTP) = 1);
  SubsetDestroy(cTPDim, sSubTP);
ENDIF;
IF(pTimePeriod @<> '');
  SubsetCreateByMDX(sSubTP, '{TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[Merch Time Period].[' | pTimePeriod | '])}, 0)}');
ELSE;
  SubsetCreateByMDX(sSubTP, '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period].[Merch Time Period])}, 0)}');
ENDIF;

DatasourceType = 'SUBSET';
DatasourceNameForServer = cTPDim;
DatasourceDimensionSubset = sSubTP;

cCols = '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Plan Reporting Measure].[Merch Plan Reporting Measure])},0)}';
nPartIdx = 0;
nDispatched = 0;
sJobIDs = '';
IF(bLogInfo = 1);
  LogOutput('INFO', 'START ' | cProcessName | ' | Source=' | sSrc | ' | Target=' | pTargetVersion | ' | Scope=' | pTimePeriod | ' | Versions=' | TRIM(STR(nVerCount, 6, 0)) | ' | Clear=' | TRIM(STR(nClear, 3, 0)), 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sWk = vMerch_Time_Period;
IF(sWk @= '');
  ItemReject('empty week');
ENDIF;

cRows = '{[Merch Time Period].[Merch Time Period].[' | sWk | ']} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])},0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel].[Merch Channel])},0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Lifecycle].[Merch Lifecycle])},0)}';

nI = 1;
WHILE(nI <= nVerCount);
  sVer = SubsetGetElementName(cVerDim, sSubVer, nI);
  IF(sVer @<> '');
    sLoadMDX = 'SELECT NON EMPTY ' | cCols | ' ON COLUMNS, NON EMPTY ' | cRows | ' ON ROWS FROM [Merch Plan Reporting] WHERE ([Merch Version].[Merch Version].[' | sSrc | '])';
    sClearMDX = 'SELECT NON EMPTY ' | cCols | ' ON COLUMNS, NON EMPTY ' | cRows | ' ON ROWS FROM [Merch Plan Reporting] WHERE ([Merch Version].[Merch Version].[' | sVer | '])';
    nPartIdx = nPartIdx + 1;
    sJobId = RunProcess('Merch.Version.Copy.PlanReporting.Week', 'pSourceVersion', sSrc, 'pTargetVersion', sVer, 'pLoadMDX', sLoadMDX, 'pClearMDX', sClearMDX, 'pClear', nClear, 'pPartIdx', nPartIdx, 'pLogLevel', sWorkerLog);
    IF(sJobIDs @= '');
      sJobIDs = sJobId;
    ELSE;
      sJobIDs = sJobIDs | ',' | sJobId;
    ENDIF;
    nDispatched = nDispatched + 1;
  ENDIF;
  nI = nI + 1;
END;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;
IF(SubsetExists(cVerDim, sSubVer) = 1);
  SubsetDestroy(cVerDim, sSubVer);
ENDIF;
IF(SubsetExists(cTPDim, sSubTP) = 1);
  SubsetDestroy(cTPDim, sSubTP);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END ' | cProcessName | ' | Dispatched=' | TRIM(STR(nDispatched, 10, 0)), 1);
ENDIF;

#endregion