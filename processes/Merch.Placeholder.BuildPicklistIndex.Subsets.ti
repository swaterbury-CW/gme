sCatDim = 'Merch Category';
sSubset = '}PLI_S_O';

nRunId = NUMBR(pRunId);
IF(nRunId <= 0);
  nRunId = INT(NOW * 86400);
ENDIF;
sRunIdStr = TRIM(STR(nRunId, 12, 0));

OnMinorErrorDoItemSkip = 1;

IF(SubsetExists(sCatDim, sSubset) = 1);
  SubsetDestroy(sCatDim, sSubset);
ENDIF;
IF(pCategoryFilter @<> '');
  IF(DIMIX(sCatDim, pCategoryFilter) = 0);
    ProcessError;
  ENDIF;
  SubsetCreate(sCatDim, sSubset);
  SubsetElementInsert(sCatDim, sSubset, pCategoryFilter, 0);
ELSE;
  sMDX = '{TM1FILTERBYLEVEL([Merch Category].MEMBERS, 0)}';
  SubsetCreatebyMDX(sSubset, sMDX);
ENDIF;

DatasourceType = 'SUBSET';
DatasourceNameForServer = sCatDim;
DatasourceDimensionSubset = sSubset;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vCategory @= '');
  ItemSkip;
ENDIF;
IF(DTYPE('Merch Category', vCategory) @<> 'N');
  ItemSkip;
ENDIF;
RunProcess(pWorkerName, 'pCategory', vCategory, 'pRunId', sRunIdStr);

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(SubsetExists('Merch Category', '}PLI_S_O') = 1);
  SubsetDestroy('Merch Category', '}PLI_S_O');
ENDIF;

#endregion