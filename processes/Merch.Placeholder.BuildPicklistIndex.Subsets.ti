#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-30
# LAST UPDATE: 2026-05-17
# CHANGED BY : Steve Waterbury
# CHANGE HISTORY:
#   2026-04-30 | Steve Waterbury | Initial commit - Subsets dispatcher
#   2026-05-17 | Steve Waterbury | Phase-2-style refactor: NULL DS + Epilog dispatch + WaitForAllJobs barrier.

cProcessName = GetProcessName();
nDispatches = 0;
sJobIDs = '';

sCatDim = 'Merch Category';
sSubset = '}PLI_S_O';

nRunId = NUMBR(pRunId);
IF(nRunId <= 0);
  nRunId = INT(NOW * 86400);
ENDIF;
sRunIdStr = TRIM(STR(nRunId, 12, 0));

OnMinorErrorDoItemSkip = 1;

IF(SubsetExists(sCatDim, sSubset) = 1);
  SubsetDestroy(sCatDim, sSubset);
ENDIF;
IF(pCategoryFilter @<> '');
  IF(DIMIX(sCatDim, pCategoryFilter) = 0);
    LogOutput('ERROR', cProcessName | ' | bad pCategoryFilter: ' | pCategoryFilter);
    ProcessError;
  ENDIF;
  SubsetCreate(sCatDim, sSubset);
  SubsetElementInsert(sCatDim, sSubset, pCategoryFilter, 0);
ELSE;
  sMDX = '{TM1FILTERBYLEVEL([Merch Category].MEMBERS, 0)}';
  SubsetCreatebyMDX(sSubset, sMDX);
ENDIF;

DatasourceType = 'NULL';

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
nCatCount = SubsetGetSize(sCatDim, sSubset);
nIdx = 1;

WHILE(nIdx <= nCatCount);
  sCat = SubsetGetElementName(sCatDim, sSubset, nIdx);
  IF(sCat @<> '');
    IF(DTYPE(sCatDim, sCat) @= 'N');
      sJobId = RunProcess(pWorkerName, 'pCategory', sCat, 'pRunId', sRunIdStr);
      IF(sJobIDs @= ''); sJobIDs = sJobId; ELSE; sJobIDs = sJobIDs | ',' | sJobId; ENDIF;
      nDispatches = nDispatches + 1;
    ENDIF;
  ENDIF;
  nIdx = nIdx + 1;
END;

IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;

IF(SubsetExists(sCatDim, sSubset) = 1);
  SubsetDestroy(sCatDim, sSubset);
ENDIF;

#endregion