#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-03-22
# LAST UPDATE: 2026-04-26
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-03-22 | Steve Waterbury | Creation
#   2026-04-01 | Steve Waterbury | Header + ProcessControl logging
#   2026-04-26 | Steve Waterbury | Allow Actual
#   2026-04-26 | Steve Waterbury | Use DimensionElementInsertDirect: required for same-transaction visibility to chained ExecuteProcess(Merch.Version.Copy) which validates the new target. Non-Direct queues for end-of-transaction commit and the chained sub-process cannot see the element.
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pVersionName @= '');
  LogOutput('ERROR','Empty');
  ProcessError;
ENDIF;
IF(pVersionType @<> 'Calculated' & pVersionType @<> 'Static' & pVersionType @<> 'Actual');
  LogOutput('ERROR','Invalid type');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersionName) > 0);
  LogOutput('ERROR','Already exists');
  ProcessError;
ENDIF;
IF(pCopyFrom @<> '' & DIMIX('Merch Version', pCopyFrom) = 0);
  LogOutput('ERROR','Source missing');
  ProcessError;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'START Create_temp: ' | pVersionName);
ENDIF;

DimensionElementInsertDirect('Merch Version', '', pVersionName, 'N');
AttrPutS(pVersionType, 'Merch Version', pVersionName, 'Version_Type');

IF(pCopyFrom @<> '');
  ExecuteProcess('Merch.Version.Copy', 'pSourceVersion', pCopyFrom, 'pTargetVersion', pVersionName);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(bLogInfo = 1);
  LogOutput('INFO', 'END Create_temp: ' | pVersionName);
ENDIF;

#endregion