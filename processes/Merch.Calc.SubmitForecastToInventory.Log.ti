#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****

#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-16
# LAST UPDATE: 2026-04-01
# COMMENTS:
# Logs forecast submission metadata to Merch Forecast Submission Log.
# Records user, date, count, and scope for each SKU submitted.
# Called by Merch.Calc.SubmitForecastToInventory via RunProcess.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-03-16         Steve Waterbury    Initial creation
### 2026-04-01         Steve Waterbury    Applied guardrails header template
### 2026-04-01         Steve Waterbury    Code formatting: multi-line IF/ENDIF blocks
#
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pSKUElement @= '' % HierarchyElementExists( 'Merch SKU', 'Roles', pSKUElement ) = 0);
    LogOutput('ERROR', cProcessName | ' | Invalid pSKUElement: ' | pSKUElement);
    ProcessQuit;
ENDIF;

sUser = TM1User();
sDateStr = TIMST(NOW, '\Y-\m-\d');
nToday = DAYNO(sDateStr);

sSubset = 'TI_SubmitLog_' | TRIM(STR(NOW, 15, 0));
IF(DTYPE('Merch SKU', pSKUElement) @= 'C');
    SubsetCreateByMDX(sSubset,
        '{TM1FILTERBYLEVEL({DESCENDANTS([Merch SKU].[roles].[' | pSKUElement | '])}, 0)}',
        'Merch SKU', 0);
ELSE;
    SubsetCreateByMDX(sSubset, '{[Merch SKU].[roles].[' | pSKUElement | ']}', 'Merch SKU', 0);
ENDIF;

DatasourceType = 'SUBSET';
DatasourceNameForServer = 'Merch SKU';
DatasourceDimensionSubset = sSubset;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
sLogCube = 'Merch Forecast Submission Log';
CellPutS(sUser, sLogCube, pVersion, vSKU, 'Last Submitted By');
CellPutN(nToday, sLogCube, pVersion, vSKU, 'Last Submitted Date');
nCount = CellGetN(sLogCube, pVersion, vSKU, 'Submission Count');
CellPutN(nCount + 1, sLogCube, pVersion, vSKU, 'Submission Count');
CellPutS(pSKUElement, sLogCube, pVersion, vSKU, 'Last Submitted Scope');

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****
SubsetDestroy('Merch SKU', sSubset);
IF(bLogInfo = 1);
    LogOutput('INFO', 'END: ' | cProcessName | ' | Logged for ' | pSKUElement | ' by ' | sUser);
ENDIF;

#endregion