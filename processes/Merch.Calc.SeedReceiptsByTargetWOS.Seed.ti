#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-07-13
# LAST UPDATE: 2026-07-13
# CHANGED BY : Steve Waterbury
# COMMENTS: Per-Roles-node seed sub-orchestrator. Loops leaf SKUs under pNode and ExecuteProcess-es Merch.Calc.SeedReceiptsByTargetWOS per SKU (serial, in this process's transaction). Invoked as a child RunProcess by .Hierarchy so seeded receipts COMMIT at this process completion, before the post-receipt WOS recompute.
# CHANGE HISTORY:
#   2026-07-13 | Steve Waterbury | Initial - seed loop extracted from .Hierarchy for commit-before-WOS
#EndRegion

cDimSKU = 'Merch SKU';
cDimVer = 'Merch Version';
cWorker = 'Merch.Calc.SeedReceiptsByTargetWOS';
cHierRoles = 'Roles';

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required', 1);
  ProcessError;
ENDIF;
IF(DIMIX(cDimVer, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version missing: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(pNode @= '');
  LogOutput('ERROR', cProcessName | ' | pNode required', 1);
  ProcessError;
ENDIF;
IF(pHierarchy @= '');
  pHierarchy = cHierRoles;
ENDIF;
IF(pHierarchy @<> cHierRoles);
  LogOutput('ERROR', cProcessName | ' | pHierarchy must be Roles: ' | pHierarchy, 1);
  ProcessError;
ENDIF;
IF(HierarchyElementExists(cDimSKU, cHierRoles, pNode) = 0);
  LogOutput('ERROR', cProcessName | ' | pNode not in Roles hier: ' | pNode, 1);
  ProcessError;
ENDIF;
IF(pOverwrite @= '');
  pOverwrite = 'N';
ENDIF;
IF(pOverwrite @<> 'Y' & pOverwrite @<> 'N');
  LogOutput('ERROR', cProcessName | ' | pOverwrite must be Y or N', 1);
  ProcessError;
ENDIF;

sSubName = 'TI_SeedRcptSeed_' | TRIM(STR(NOW, 15, 0));
IF(HierarchySubsetExists(cDimSKU, cHierRoles, sSubName) = 1);
  HierarchySubsetDestroy(cDimSKU, cHierRoles, sSubName);
ENDIF;
sMdx = 'TM1FILTERBYLEVEL({DESCENDANTS([' | cDimSKU | '].[' | cHierRoles | '].[' | pNode | '])}, 0)';
SubsetCreateByMDX(sSubName, sMdx);

nSize = HierarchySubsetGetSize(cDimSKU, cHierRoles, sSubName);
i = 1;
nDispatched = 0;
WHILE(i <= nSize);
  sSku = HierarchySubsetGetElementName(cDimSKU, cHierRoles, sSubName, i);
  ExecuteProcess(cWorker, 'pVersion', pVersion, 'pSKU', sSku, 'pCategory', '', 'pOverwrite', pOverwrite);
  nDispatched = nDispatched + 1;
  i = i + 1;
END;

IF(HierarchySubsetExists(cDimSKU, cHierRoles, sSubName) = 1);
  HierarchySubsetDestroy(cDimSKU, cHierRoles, sSubName);
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Node=' | pNode | ' | Dispatched=' | TRIM(STR(nDispatched, 10, 0)), 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
