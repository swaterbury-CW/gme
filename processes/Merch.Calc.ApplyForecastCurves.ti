#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-03-19
# LAST UPDATE: 2026-05-19
# CHANGED BY: Steve Waterbury
# COMMENTS: Native Roles fan-out plus explicit HierarchyElementExists guard on resolved sRoot.
# CHANGE HISTORY:
#   2026-03-19 | Steve Waterbury | Initial
#   2026-05-13 | Steve Waterbury | Native fan-out via HierarchySubset* family
#   2026-05-19 | Steve Waterbury | Explicit Roles-hier validation on sRoot (plan 6353aa33bf4d)
#EndRegion
DatasourceType = 'NULL';
sProcess = GetProcessName();
sVersion = pVersion;
IF(sVersion @= '');
  LogOutput('ERROR', sProcess | ' | pVersion empty');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', sVersion) = 0);
  LogOutput('ERROR', sProcess | ' | Version not found');
  ProcessError;
ENDIF;
IF(ATTRS('Merch Version', sVersion, 'Version_Type') @<> 'Calculated');
  LogOutput('ERROR', sProcess | ' | Not Calculated');
  ProcessError;
ENDIF;
sRoot = pRole;
IF(sRoot @= '');
  sRoot = 'Director';
ENDIF;
IF(HierarchyElementExists('Merch SKU', 'Roles', sRoot) = 0);
  LogOutput('ERROR', sProcess | ' | bad SKU (not in Roles hier): ' | sRoot);
  ProcessError;
ENDIF;
nStart = NOW;
LogOutput('INFO', 'TIMING START: ' | sProcess | ' | V=' | sVersion | ' | Root=' | sRoot);

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
sSubRoles = 'TI_OrchFC_' | TRIM(STR(NOW, 15, 0));
IF(HierarchySubsetExists('Merch SKU', 'Roles', sSubRoles) = 1);
  HierarchySubsetDestroy('Merch SKU', 'Roles', sSubRoles);
ENDIF;
sMDX = '{FILTER({DESCENDANTS([Merch SKU].[Roles].[' | sRoot | '])}, [Merch SKU].[Roles].CurrentMember.LEVEL.ORDINAL = 4)}';
SubsetCreateByMDX(sSubRoles, sMDX);
nSubSize = HierarchySubsetGetSize('Merch SKU', 'Roles', sSubRoles);
nDispatched = 0;
IF(nSubSize = 0);
  RunProcess('Merch.Calc.ApplyForecastCurves.Cat', 'pVersion', sVersion, 'pRole', sRoot);
  nDispatched = 1;
ELSE;
  nIdx = 1;
  WHILE(nIdx <= nSubSize);
    sChild = HierarchySubsetGetElementName('Merch SKU', 'Roles', sSubRoles, nIdx);
    RunProcess('Merch.Calc.ApplyForecastCurves.Cat', 'pVersion', sVersion, 'pRole', sChild);
    nDispatched = nDispatched + 1;
    nIdx = nIdx + 1;
  END;
ENDIF;
nDummy = WaitForInternalJobs();
IF(HierarchySubsetExists('Merch SKU', 'Roles', sSubRoles) = 1);
  HierarchySubsetDestroy('Merch SKU', 'Roles', sSubRoles);
ENDIF;
LogOutput('INFO', 'TIMING END: ' | sProcess | ' | Root=' | sRoot | ' | Dispatched=' | TRIM(STR(nDispatched,10,0)) | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's');

#endregion