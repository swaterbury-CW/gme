#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Header
#############################
# PROCESS    : Merch.Calc.SetFirstForecastPeriod
# DEVELOPER  : Steve Waterbury
# CREATED    : 2026-04-14
# LAST UPDATE: 2026-04-14
# CHANGED BY : Steve Waterbury
# PURPOSE    : Finds first forecast period for a Calculated version.
#              Iterates leaf weeks via datasource, writes first where
#              Start_Date > Last_Closed_Period to First_Forecast_Period.
#
#### CHANGE HISTORY:
### 2026-04-14  Steve Waterbury  Initial creation
#EndRegion

#Region : Logging
sLogLevel = 'OFF';
IF(CubeExists('ProcessControl') = 1);
  sLogLevel = CellGetS('ProcessControl', GetProcessName(), 'LogLevel');
  IF(sLogLevel @= '');
    sLogLevel = 'OFF';
  ENDIF;
ENDIF;
#EndRegion

#Region : Validation
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', GetProcessName() | ' | Version not found: ' | pVersion);
  ProcessBreak;
ENDIF;
IF(ATTRS('Merch Version', pVersion, 'Version_Type') @<> 'Calculated');
  LogOutput('ERROR', GetProcessName() | ' | Version ' | pVersion | ' is not Calculated');
  ProcessBreak;
ENDIF;
nLastClosed = ATTRN('Merch Version', pVersion, 'Last_Closed_Period');
IF(nLastClosed = 0);
  LogOutput('ERROR', GetProcessName() | ' | No Last_Closed_Period for ' | pVersion);
  ProcessBreak;
ENDIF;
#EndRegion

sFirstFound = 'N';

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sElem = vElement;
IF(sFirstFound @= 'Y');
  ITEMSKIP;
ENDIF;
IF(SUBST(sElem, 1, 4) @= 'Thru');
  ITEMSKIP;
ENDIF;
IF(DTYPE('Merch Time Period', sElem) @<> 'N');
  ITEMSKIP;
ENDIF;
nStartDate = ATTRN('Merch Time Period', sElem, 'Start_Date');
IF(nStartDate > nLastClosed);
  AttrPutS(sElem, 'Merch Version', pVersion, 'First_Forecast_Period');
  sFirstFound = 'Y';
  IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
    LogOutput('INFO', GetProcessName() | ' | ' | pVersion | ' First_Forecast_Period = ' | sElem);
  ENDIF;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(sFirstFound @= 'N');
  LogOutput('ERROR', GetProcessName() | ' | Could not find first forecast period for ' | pVersion);
ENDIF;

#endregion