#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-16
# LAST UPDATE: 2026-04-29
# CHANGED BY : Steve Waterbury
#### CHANGE HISTORY:
###  2026-04-29  Steve Waterbury  Fix DTYPE 'AN' check
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | V=' | pVersion);
ENDIF;

cCube = 'Merch Version SKU Attributes';
cSrcCube = '}ElementAttributes_Merch SKU';
cAttrDim = '}ElementAttributes_Merch SKU';
cMeasDim = 'Merch Version SKU Attribute Measure';
IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion empty');
  ProcessBreak;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion);
  ProcessBreak;
ENDIF;

sView = 'TI_LoadAttr_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT NON EMPTY {TM1SUBSETALL([}ElementAttributes_Merch SKU])} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU])}, 0)} ON ROWS FROM [}ElementAttributes_Merch SKU]';
ViewCreateByMDX(cSrcCube, sView, sMDX, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cSrcCube;
DatasourceCubeview = sView;
nLoaded = 0;
OnMinorErrorDoItemSkip = 1;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
cCube = 'Merch Version SKU Attributes';
cAttrDim = '}ElementAttributes_Merch SKU';
cMeasDim = 'Merch Version SKU Attribute Measure';
sSKU = vSKU;
sAttr = vAttr;
IF(sSKU @= '' % sAttr @= '');
  ItemSkip;
ENDIF;

IF(DIMIX(cMeasDim, sAttr) = 0);
  ItemSkip;
ENDIF;

sType = DTYPE(cAttrDim, sAttr);
IF(sType @= 'N' % sType @= 'AN');
  IF(NUMBR(Value) <> 0);
    IF(CellIsUpdateable(cCube, pVersion, sSKU, sAttr) = 1);
      CellPutN(NUMBR(Value), cCube, pVersion, sSKU, sAttr);
    ELSE;
      ItemReject('RO: ' | sSKU | '|' | sAttr);
    ENDIF;
  ENDIF;
ELSE;
  IF(Value @<> '');
    IF(CellIsUpdateable(cCube, pVersion, sSKU, sAttr) = 1);
      CellPutS(Value, cCube, pVersion, sSKU, sAttr);
    ELSE;
      ItemReject('RO: ' | sSKU | '|' | sAttr);
    ENDIF;
  ENDIF;
ENDIF;
nLoaded = nLoaded + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSrcCube, sView) = 1);
  ViewDestroy(cSrcCube, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Cells=' | TRIM(STR(nLoaded, 10, 0)));
ENDIF;

#endregion