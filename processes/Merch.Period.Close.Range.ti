#region Prolog
#****Begin: Generated Statements***
DatasourceType = 'SUBSET';
#****End: Generated Statements****
#=============================================================
# PROCESS: Merch.Period.Close.Range
# PURPOSE: Close multiple weeks by dispatching Merch.Period.Close per element of a Merch Time Period subset.
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-14
# LAST UPDATE: 2026-05-14
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-14 | Steve Waterbury | Initial; direct DatasourceDimensionSubset override (caller orders input subset)
#=============================================================

cProcessName = GetProcessName();

sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
    sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
    bLogInfo = 1;
ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
    LogOutput('ERROR', cProcessName | ' | pVersion "' | pVersion | '" not found.');
    ProcessError;
ENDIF;
IF(ATTRS('Merch Version', pVersion, 'Version_Type') @<> 'Calculated');
    LogOutput('ERROR', cProcessName | ' | pVersion not Calculated');
    ProcessError;
ENDIF;

IF(pSubsetName @= '');
    LogOutput('ERROR', cProcessName | ' | pSubsetName blank');
    ProcessError;
ENDIF;
IF(SubsetExists('Merch Time Period', pSubsetName) = 0);
    LogOutput('ERROR', cProcessName | ' | Subset "' | pSubsetName | '" not found on Merch Time Period');
    ProcessError;
ENDIF;
IF(SubsetGetSize('Merch Time Period', pSubsetName) = 0);
    LogOutput('ERROR', cProcessName | ' | Subset "' | pSubsetName | '" is empty');
    ProcessError;
ENDIF;

nStart = NOW;
LogOutput('INFO', 'TIMING START: ' | cProcessName | ' | V=' | pVersion | ' | Subset=' | pSubsetName);

DatasourceNameForServer  = 'Merch Time Period';
DatasourceDimensionSubset = pSubsetName;

nOK = 0;
nFail = 0;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nRC = ExecuteProcess('Merch.Period.Close',
    'pVersion',       pVersion,
    'pTargetPeriod',  vMerch_Time_Period);

IF(nRC = ProcessExitNormal());
    nOK = nOK + 1;
ELSE;
    nFail = nFail + 1;
    LogOutput('ERROR', cProcessName | ' | child failed: ' | vMerch_Time_Period | ' | rc=' | TRIM(STR(nRC, 10, 0)));
    IF(pStopOnError @= '1');
        ProcessError;
    ENDIF;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
LogOutput('INFO', 'TIMING END: ' | cProcessName | ' | OK=' | TRIM(STR(nOK, 10, 0)) | ' | Fail=' | TRIM(STR(nFail, 10, 0)) | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's');

#endregion