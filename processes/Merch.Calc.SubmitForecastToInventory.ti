#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-28
# LAST UPDATE: 2026-06-19
# CHANGED BY : Steve Waterbury
# COMMENTS: ORCHESTRATOR. Forecast -> Plan Reporting submission, partitioned by Merch SKU Roles L4.
#  Dispatch is DATASOURCE-driven: a TM1DimensionSubset over Merch SKU:Roles (Roles-L4 subset built
#  here in Prolog). The Data tab iterates the nodes and RunProcess-es the .Cat worker per node with a
#  unique pPartIdx (row counter). pUseRunProcess=1 -> parallel; 0 -> serial. Epilog joins via
#  WaitForInternalJobs, then runs PlanReportingWOS.Orch (stored WOS) and the .Log summary.
#### CHANGE HISTORY:
### 2026-06-09  Steve Waterbury  Roles-L4 parallel orchestrator. Design plan 24d10f22516f.
### 2026-06-12  Steve Waterbury  pPartIdx per worker. Design plan 256a1f584537.
### 2026-06-19  Steve Waterbury  Epilog invokes PlanReportingWOS.Orch (stored WOS). Design plan 908774392cf2.
### 2026-06-19  Steve Waterbury  REWRITE: datasource-driven .Cat dispatch (TM1DimensionSubset Roles-L4) per standard; Data-tab RunProcess + row-counter pPartIdx. Design plan 908774392cf2.
#EndRegion
cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
sJobIDs = '';
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

nUseRun = NUMBR(pUseRunProcess);

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pVersion: ' | pVersion, 1);
  ProcessError;
ENDIF;
sRoot = pSKUElement;
IF(sRoot @= '');
  sRoot = 'Director';
ENDIF;
IF(HierarchyElementExists('Merch SKU', 'Roles', sRoot) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pSKUElement (not in Roles hier): ' | sRoot, 1);
  ProcessError;
ENDIF;

nPartIdx = 0;
nDispatched = 0;
nStart = NOW;

sSub = 'TI_SubmitOrchSub_' | TRIM(STR(NOW, 15, 0));
IF(HierarchySubsetExists('Merch SKU', 'Roles', sSub) = 1);
  HierarchySubsetDestroy('Merch SKU', 'Roles', sSub);
ENDIF;
sMDX = '{FILTER({DESCENDANTS([Merch SKU].[Roles].[' | sRoot | '])}, [Merch SKU].[Roles].CurrentMember.LEVEL.ORDINAL = 4)}';
SubsetCreateByMDX(sSub, sMDX);

DatasourceType = 'SUBSET';
DatasourceNameForServer = 'Merch SKU:Roles';
DatasourceDimensionSubset = sSub;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START ' | cProcessName | ' V=' | pVersion | ' Root=' | sRoot | ' Parallel=' | TRIM(STR(nUseRun,1,0)), 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nPartIdx = nPartIdx + 1;
sNode = vMerch_SKU;
IF(sNode @= '');
  ItemReject('empty node');
ENDIF;
IF(nUseRun = 1);
  sJobId = RunProcess('Merch.Calc.SubmitForecastToInventory.Cat', 'pVersion', pVersion, 'pSKUElement', sNode, 'pPartIdx', nPartIdx);
  IF(sJobIDs @= '');
    sJobIDs = sJobId;
  ELSE;
    sJobIDs = sJobIDs | ',' | sJobId;
  ENDIF;
ELSE;
  nRC = ExecuteProcess('Merch.Calc.SubmitForecastToInventory.Cat', 'pVersion', pVersion, 'pSKUElement', sNode, 'pPartIdx', nPartIdx);
ENDIF;
nDispatched = nDispatched + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(nDispatched = 0);
  IF(nUseRun = 1);
    sJobId = RunProcess('Merch.Calc.SubmitForecastToInventory.Cat', 'pVersion', pVersion, 'pSKUElement', sRoot, 'pPartIdx', 1);
    IF(sJobIDs @= ''); sJobIDs = sJobId; ELSE; sJobIDs = sJobIDs | ',' | sJobId; ENDIF;
  ELSE;
    nRC = ExecuteProcess('Merch.Calc.SubmitForecastToInventory.Cat', 'pVersion', pVersion, 'pSKUElement', sRoot, 'pPartIdx', 1);
  ENDIF;
  nDispatched = 1;
ENDIF;
IF(nUseRun = 1);
  IF(sJobIDs @<> '');
    WaitForAllJobs(sJobIDs);
  ENDIF;
ENDIF;
IF(HierarchySubsetExists('Merch SKU', 'Roles', sSub) = 1);
  HierarchySubsetDestroy('Merch SKU', 'Roles', sSub);
ENDIF;
ExecuteProcess('Merch.Calc.SubmitForecastToInventory.Log', 'pVersion', pVersion, 'pSKUElement', sRoot);
IF(bLogInfo = 1);
  LogOutput('INFO', 'END ' | cProcessName | ' Root=' | sRoot | ' Dispatched=' | TRIM(STR(nDispatched, 10, 0)), 1);
ENDIF;
#endregion