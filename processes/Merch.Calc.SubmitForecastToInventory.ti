#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-28
# CHANGED BY : Steve Waterbury
# COMMENTS: ORCHESTRATOR. Multithreaded forecast -> Plan Reporting submission. Fans out across Roles L4
#  nodes under pSKUElement (blank => 'Director'), RunProcess .Cat per partition with a unique pPartIdx,
#  WaitForInternalJobs, then .Log once.
#### CHANGE HISTORY:
### 2026-06-09  Steve Waterbury  Roles-L4 parallel orchestrator. Design plan 24d10f22516f.
### 2026-06-12  Steve Waterbury  FIX: pass unique pPartIdx per worker (DIMIX-based view name collided). Design plan 256a1f584537.
#EndRegion
DatasourceType = 'NULL';
cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pVersion: ' | pVersion, 1);
  ProcessError;
ENDIF;
sRoot = pSKUElement;
IF(sRoot @= ''); sRoot = 'Director'; ENDIF;
IF(HierarchyElementExists('Merch SKU', 'Roles', sRoot) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pSKUElement (not in Roles hier): ' | sRoot, 1);
  ProcessError;
ENDIF;
nStart = NOW;
IF(bLogInfo = 1); LogOutput('INFO', 'START ' | cProcessName | ' V=' | pVersion | ' Root=' | sRoot, 1); ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
sSub = 'TI_OrchSubmitFC_' | TRIM(STR(NOW, 15, 0));
IF(HierarchySubsetExists('Merch SKU', 'Roles', sSub) = 1);
  HierarchySubsetDestroy('Merch SKU', 'Roles', sSub);
ENDIF;
sMDX = '{FILTER({DESCENDANTS([Merch SKU].[Roles].[' | sRoot | '])}, [Merch SKU].[Roles].CurrentMember.LEVEL.ORDINAL = 4)}';
SubsetCreateByMDX(sSub, sMDX);
nSubSize = HierarchySubsetGetSize('Merch SKU', 'Roles', sSub);
nDispatched = 0;
IF(nSubSize = 0);
  RunProcess('Merch.Calc.SubmitForecastToInventory.Cat', 'pVersion', pVersion, 'pSKUElement', sRoot, 'pPartIdx', 1);
  nDispatched = 1;
ELSE;
  nIdx = 1;
  WHILE(nIdx <= nSubSize);
    sChild = HierarchySubsetGetElementName('Merch SKU', 'Roles', sSub, nIdx);
    RunProcess('Merch.Calc.SubmitForecastToInventory.Cat', 'pVersion', pVersion, 'pSKUElement', sChild, 'pPartIdx', nIdx);
    nDispatched = nDispatched + 1;
    nIdx = nIdx + 1;
  END;
ENDIF;
nDummy = WaitForInternalJobs();
IF(HierarchySubsetExists('Merch SKU', 'Roles', sSub) = 1);
  HierarchySubsetDestroy('Merch SKU', 'Roles', sSub);
ENDIF;
RunProcess('Merch.Calc.SubmitForecastToInventory.Log', 'pVersion', pVersion, 'pSKUElement', sRoot);
nDummy = WaitForInternalJobs();
IF(bLogInfo = 1);
  LogOutput('INFO', 'END ' | cProcessName | ' Root=' | sRoot | ' Dispatched=' | TRIM(STR(nDispatched, 10, 0)) | ' Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's', 1);
ENDIF;

#endregion