#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-04-21
# LAST UPDATE: 2026-04-21
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Per-hierarchy worker for PreOwned inventory load. 4-dim target; MDX axis
# order vars: vSKU, vTimePeriod, vMeasure, vChannel, Value.
# CHANGE HISTORY:
#   2026-04-21 | Steve Waterbury | Initial creation
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | cProcessName | ' | P=' | pTimePeriod | ' | V=' | pVersion | ' | H=' | pHierarchy); ENDIF;

cSourceCube = 'Merch Actuals';
cTargetCube = 'Merch PreOwned Inventory';
cCategoryDim = 'Merch PreOwned Category';
cActualsMeasureDim = 'Merch Actuals Measure';
cTargetMeasureDim = 'Merch PreOwned Inventory Measure';
cMapAttribute = 'PreOwned Inventory Measure Map';
nCellsCopied = 0;
nSkipped = 0;

IF(pHierarchy @= 'SGM_Category');
  sCatMDX = 'FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[SGM_Category])}, 1)}, LEFT([Merch SKU].[SGM_Category].CurrentMember.Name, 9) = ''Pre-Owned'' OR LEFT([Merch SKU].[SGM_Category].CurrentMember.Name, 8) = ''Preowned'')';
ELSEIF(pHierarchy @= 'Category_Name');
  sCatMDX = 'FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Category_Name])}, 1)}, LEFT([Merch SKU].[Category_Name].CurrentMember.Name, 8) = ''Preowned'' OR [Merch SKU].[Category_Name].CurrentMember.Name = ''Modern Retro'')';
ELSE;
  LogOutput('ERROR', cProcessName | ' | unknown pHierarchy=' | pHierarchy);
  sCatMDX = '{}';
ENDIF;

sMeasMDX = 'FILTER({TM1SUBSETALL([Merch Actuals Measure])}, [}ElementAttributes_Merch Actuals Measure].([PreOwned Inventory Measure Map]) <> '''')';

sViewName = 'TI_POInv_' | TRIM(STR(NOW, 15, 0));
sMdxQuery = 'SELECT NON EMPTY {' | sCatMDX | '} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL(DESCENDANTS([Merch Time Period].[Merch Time Period].[' | pTimePeriod | ']), 0)}, {' | sMeasMDX | '}) ON ROWS FROM [Merch Actuals] WHERE ([Merch Channel].[Merch Channel].[All Channels])';

IF(ViewExists(cSourceCube, sViewName) = 1); ViewDestroy(cSourceCube, sViewName); ENDIF;
ViewCreateByMDX(cSourceCube, sViewName, sMdxQuery, 1);
ViewExtractSkipCalcsSet(cSourceCube, sViewName, 0);
ViewSuppressZeroesSet(cSourceCube, sViewName, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = cSourceCube;
DatasourceCubeview = sViewName;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(DTYPE('Merch Time Period', vTimePeriod) @<> 'N');
  ItemSkip;
ENDIF;

sCategory = vSKU;
IF(DIMIX(cCategoryDim, sCategory) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

sMappedMeasure = ATTRS(cActualsMeasureDim, vMeasure, cMapAttribute);
IF(sMappedMeasure @= '');
  ItemSkip;
ENDIF;
IF(DIMIX(cTargetMeasureDim, sMappedMeasure) = 0);
  ItemReject('mapped measure missing in target dim: ' | sMappedMeasure);
ENDIF;

IF(Value = 0);
  ItemSkip;
ENDIF;
IF(CellIsUpdateable(cTargetCube, pVersion, vTimePeriod, sCategory, sMappedMeasure) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

CellPutN(Value, cTargetCube, pVersion, vTimePeriod, sCategory, sMappedMeasure);
nCellsCopied = nCellsCopied + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSourceCube, sViewName) = 1); ViewDestroy(cSourceCube, sViewName); ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'END: ' | cProcessName | ' | Cells=' | TRIM(STR(nCellsCopied, 10, 0)) | ' | Skipped=' | TRIM(STR(nSkipped, 10, 0))); ENDIF;

#endregion