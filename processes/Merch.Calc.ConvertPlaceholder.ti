#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-22
# LAST UPDATE: 2026-05-11
# CHANGED BY : Steve Waterbury
# COMMENTS: Converts placeholder forecast cells to a real Merch SKU.
# CHANGE HISTORY:
#   2026-04-21 | Steve Waterbury | Added pGroup
#   2026-05-07 | Steve Waterbury | Renamed datasource vars to MDX-axis order
#   2026-05-11 | Steve Waterbury | Qualified Merch Version hierarchy in WHERE MDX (multi-hier ambiguity fix)
#EndRegion

cProcessName = GetProcessName();
sSrcCube = 'Merch Placeholder Forecast';
sTgtCube = 'Merch Forecast';
sMapCube = 'Merch Placeholder Mapping';
sDimPH = 'Merch Placeholder SKU';
sDimSKU = 'Merch SKU';
sDimCat = 'Merch Category';
sVersion = pVersion;

sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | START | V=' | pVersion | ' PH=' | pPlaceholderSKU | ' TGT=' | pTargetSKU | ' Cat=' | pCategory | ' Grp=' | pGroup);
ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid version');
  ProcessError;
ENDIF;
IF(pPlaceholderSKU @= '');
  LogOutput('ERROR', cProcessName | ' | pPlaceholderSKU empty');
  ProcessError;
ENDIF;
IF(DIMIX(sDimPH, pPlaceholderSKU) = 0);
  LogOutput('ERROR', cProcessName | ' | PH not found');
  ProcessError;
ENDIF;
IF(pCategory @= '');
  LogOutput('ERROR', cProcessName | ' | pCategory required');
  ProcessError;
ENDIF;
IF(DIMIX(sDimCat, pCategory) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid category');
  ProcessError;
ENDIF;
IF(pGroup @= '');
  LogOutput('ERROR', cProcessName | ' | pGroup required');
  ProcessError;
ENDIF;
IF(DIMIX('}Groups', pGroup) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid pGroup');
  ProcessError;
ENDIF;

sCategory = pCategory;
sTarget = pTargetSKU;
IF(sTarget @= '');
  sTarget = CellGetS(sMapCube, sVersion, sCategory, pPlaceholderSKU, pGroup, 'Target SKU');
ENDIF;
IF(sTarget @= '');
  LogOutput('ERROR', cProcessName | ' | No target SKU');
  ProcessError;
ENDIF;
IF(DIMIX(sDimSKU, sTarget) = 0);
  LogOutput('ERROR', cProcessName | ' | Target not in Merch SKU');
  ProcessError;
ENDIF;

sViewName = 'TI_ConvertPH';
sMDX = 'SELECT NON EMPTY {TM1FILTERBYLEVEL(TM1SUBSETALL([Merch Forecast Measure].[Merch Forecast Measure]), 0)} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period].[Merch Time Period])}, 0)} ON ROWS FROM [Merch Placeholder Forecast] WHERE ([Merch Version].[Merch Version].[' | sVersion | '], [Merch Category].[' | sCategory | '], [Merch Placeholder SKU].[' | pPlaceholderSKU | '], [}Groups].[' | pGroup | '])';
IF(ViewExists(sSrcCube, sViewName) = 1);
  ViewDestroy(sSrcCube, sViewName);
ENDIF;
ViewCreateByMDX(sSrcCube, sViewName, sMDX, 1);
ViewExtractSkipZeroesSet(sSrcCube, sViewName, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = sSrcCube;
DatasourceCubeview = sViewName;
nCellsCopied = 0;
nCellsSkipped = 0;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vPHSKU @= '');
  ItemReject('Empty PHSKU row');
ENDIF;
IF(DTYPE('Merch Placeholder SKU', vPHSKU) @= 'C');
  ItemSkip;
ENDIF;

nVal = Value;
IF(nVal = 0);
  ItemSkip;
ENDIF;
IF(CellIsUpdateable(sTgtCube, vVersion, vTimePeriod, sTarget, vMeasure) = 0);
  nCellsSkipped = nCellsSkipped + 1;
  ItemSkip;
ENDIF;
CellPutN(nVal, sTgtCube, vVersion, vTimePeriod, sTarget, vMeasure);
nCellsCopied = nCellsCopied + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(sSrcCube, sViewName) = 1);
  ViewDestroy(sSrcCube, sViewName);
ENDIF;

IF(CellIsUpdateable(sMapCube, sVersion, sCategory, pPlaceholderSKU, pGroup, 'Conversion Status') = 1);
  CellPutS('Converted', sMapCube, sVersion, sCategory, pPlaceholderSKU, pGroup, 'Conversion Status');
ENDIF;
IF(CellIsUpdateable(sMapCube, sVersion, sCategory, pPlaceholderSKU, pGroup, 'Conversion Date') = 1);
  CellPutN(DAYNO(TODAY(1)), sMapCube, sVersion, sCategory, pPlaceholderSKU, pGroup, 'Conversion Date');
ENDIF;

AttrPutS('N', sDimPH, pPlaceholderSKU, 'Active');

IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | END | ' | pPlaceholderSKU | '/' | pGroup | ' -> ' | sTarget | ' | Copied=' | TRIM(STR(nCellsCopied, 10, 0)) | ' Skipped=' | TRIM(STR(nCellsSkipped, 10, 0)));
ENDIF;

#endregion