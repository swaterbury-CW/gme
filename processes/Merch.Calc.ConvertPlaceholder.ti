#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-22
# LAST UPDATE: 2026-08-26
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Blends every placeholder mapped to ONE target SKU into that target's Merch Forecast row.
# Merch.Calc.StagePlaceholderConversion stages the additive components into
# }Merch Placeholder Conversion; this worker sums numerators and denominators across the
# contributing groups per OPEN week and divides ONCE, so a rate is never averaged.
#
# Selling rates are NOT written. Merch Version SKU Attributes owns Full Price AUR (Base AUR)
# and Base AUC (AUC); the placeholder deviation is carried by Rate Adjustment for revenue and
# Other AUC Adjustment for cost, so Revenue and Cost land on the blend at the target's own
# rates. Receipt AUC Override is the one rate override still written.
#
# Closed weeks are never touched. Opening Inventory is never written. Promo % is zeroed. Supply
# measures are co-owned with the receipt and WOS seeders and are never cleared here. See the KB
# architecture doc for the full derivation.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-04-21         Steve Waterbury    Added pGroup
### 2026-05-20         Steve Waterbury    Roles guard on the target SKU
### 2026-08-21         Steve Waterbury    Rewrite: blend all mapped placeholders via the staging cube
### 2026-08-23         Steve Waterbury    Closed-period guard: never write or revert a closed week
### 2026-08-26         Steve Waterbury    Rates stay in MVSA; deviation on Rate Adjustment + Other AUC Adjustment
#
#EndRegion

#Region : Logging
cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'INFO';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
#EndRegion

#Region : Constants
sStgCube = '}Merch Placeholder Conversion';
sTgtCube = 'Merch Forecast';
sMapCube = 'Merch Placeholder Mapping';
sAttrCube = 'Merch Version SKU Attributes';
sDimVer = 'Merch Version';
sDimTP = 'Merch Time Period';
sDimSKU = 'Merch SKU';
sDimCat = 'Merch Category';
sDimPH = 'Merch Placeholder SKU';
sDimGrp = '}Groups';
cRolesHier = 'Roles';
cAllCat = 'All Categories';
cAllPH = 'All Placeholder SKUs';

# The same attribute names the Merch Forecast rate rules read, so worker and rule resolve the
# same element.
cAttrAUR = 'Base AUR';
cAttrAUC = 'AUC';

nPartIdx = pPartIdx;
sSubName = 'TI_ConvPH_' | TRIM(STR(nPartIdx, 12, 0));

nWeeks = 0;
nConverted = 0;
nReverted = 0;
nSkipped = 0;
nNoUnits = 0;
nClosedSkipped = 0;
nNoRateBase = 0;
#EndRegion

#Region : Validation - all of it BEFORE the temp subset exists, so ProcessError is safe
IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion is required', 1);
  ProcessError;
ENDIF;
IF(DIMIX(sDimVer, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | version not found: ' | pVersion, 1);
  ProcessError;
ENDIF;
sVersionType = ATTRS(sDimVer, pVersion, 'Version_Type');
IF(sVersionType @<> 'Calculated');
  LogOutput('ERROR', cProcessName | ' | version is not Calculated so the target rates would not respond: ' | pVersion | ' is ' | sVersionType, 1);
  ProcessError;
ENDIF;

# The closed-period boundary for this version, read at RUN TIME.
nLastClosed = ATTRN(sDimVer, pVersion, 'Last_Closed_Period');

# Target resolution. An explicit pTargetSKU is the multi-placeholder path; the original
# single-placeholder signature still resolves its target from the mapping row.
sTarget = pTargetSKU;
IF(sTarget @= '');
  IF(pCategory @= '' % pPlaceholderSKU @= '' % pGroup @= '');
    LogOutput('ERROR', cProcessName | ' | pTargetSKU is empty and pCategory / pPlaceholderSKU / pGroup were not all supplied, so no target can be resolved', 1);
    ProcessError;
  ENDIF;
  IF(DIMIX(sDimCat, pCategory) = 0);
    LogOutput('ERROR', cProcessName | ' | category not found: ' | pCategory, 1);
    ProcessError;
  ENDIF;
  IF(DIMIX(sDimPH, pPlaceholderSKU) = 0);
    LogOutput('ERROR', cProcessName | ' | placeholder SKU not found: ' | pPlaceholderSKU, 1);
    ProcessError;
  ENDIF;
  IF(DIMIX(sDimGrp, pGroup) = 0);
    LogOutput('ERROR', cProcessName | ' | group not found: ' | pGroup, 1);
    ProcessError;
  ENDIF;
  sTarget = CellGetS(sMapCube, pVersion, pCategory, pPlaceholderSKU, pGroup, 'Target SKU');
ENDIF;
IF(sTarget @= '');
  LogOutput('ERROR', cProcessName | ' | no target SKU to convert into', 1);
  ProcessError;
ENDIF;

# Merch SKU is multi-hierarchy, so DIMIX alone is not sufficient. Report the two failure modes
# distinctly: absent from the dimension, versus present but outside the Roles rollup.
nTgtAnywhere = DIMIX(sDimSKU, sTarget);
nTgtInRoles = HierarchyElementExists(sDimSKU, cRolesHier, sTarget);
IF(nTgtInRoles = 0);
  IF(nTgtAnywhere = 0);
    LogOutput('ERROR', cProcessName | ' | target SKU not found in ' | sDimSKU | ': ' | sTarget, 1);
  ELSE;
    LogOutput('ERROR', cProcessName | ' | target SKU ' | sTarget | ' exists in ' | sDimSKU | ' but NOT in the ' | cRolesHier | ' hierarchy, so it cannot be converted into', 1);
  ENDIF;
  ProcessError;
ENDIF;

# The target's own catalogue rates - the baseline every per-week deviation is measured against.
# Read once: this cube has no time dimension. A missing Base AUR is logged rather than fatal,
# because a receipts-only placeholder has no revenue to express; the per-week solve counts the
# weeks it actually could not carry.
nAttrAUR = CellGetN(sAttrCube, pVersion, sTarget, cAttrAUR);
nAttrAUC = CellGetN(sAttrCube, pVersion, sTarget, cAttrAUC);
IF(nAttrAUR = 0);
  LogOutput('ERROR', cProcessName | ' | target ' | sTarget | ' has no ' | cAttrAUR | ' in ' | sAttrCube | ', so any placeholder revenue on it cannot be expressed as a Rate Adjustment', 1);
ENDIF;

# Contributing groups: the orchestrator supplies the full comma-delimited list, a
# single-placeholder caller supplies its own group, and an interactive caller falls back to the
# functional group resolved from }ClientGroups.
sGroups = pGroups;
IF(sGroups @= '');
  sGroups = pGroup;
ENDIF;
IF(sGroups @= '');
  sUser = TM1User();
  nG = 1;
  nGroupCount = DIMSIZ(sDimGrp);
  WHILE(nG <= nGroupCount);
    sG = DIMNM(sDimGrp, nG);
    IF(sG @<> 'ADMIN' & sG @<> 'SecurityAdmin' & sG @<> 'DataAdmin' & sG @<> 'OperationsAdmin' & sG @<> 'Read Only');
      IF(CellGetN('}ClientGroups', sUser, sG) = 1);
        sGroups = sG;
        nG = nGroupCount;
      ENDIF;
    ENDIF;
    nG = nG + 1;
  END;
ENDIF;
IF(sGroups @= '');
  LogOutput('ERROR', cProcessName | ' | no contributing group supplied and none resolved for the caller', 1);
  ProcessError;
ENDIF;

# Validate every name in the list before a single cell is written.
sChk = sGroups;
WHILE(LONG(sChk) > 0);
  nCommaChk = SCAN(',', sChk);
  IF(nCommaChk > 0);
    sOneChk = TRIM(SUBST(sChk, 1, nCommaChk - 1));
    sChk = TRIM(SUBST(sChk, nCommaChk + 1, LONG(sChk) - nCommaChk));
  ELSE;
    sOneChk = TRIM(sChk);
    sChk = '';
  ENDIF;
  IF(sOneChk @<> '');
    IF(DIMIX(sDimGrp, sOneChk) = 0);
      LogOutput('ERROR', cProcessName | ' | group not found in ' | sDimGrp | ': ' | sOneChk, 1);
      ProcessError;
    ENDIF;
  ENDIF;
END;
#EndRegion

#Region : Iterate every leaf week through a dimension subset datasource
IF(SubsetExists(sDimTP, sSubName) = 1);
  SubsetDestroy(sDimTP, sSubName);
ENDIF;
sSubMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDimTP | '].[' | sDimTP | '])}, 0)}';
SubsetCreateByMDX(sSubName, sSubMDX);
DatasourceType = 'SUBSET';
DatasourceNameForServer = sDimTP;
DatasourceDimensionSubset = sSubName;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | START | version=' | pVersion | ' | target=' | sTarget | ' | groups=' | sGroups | ' | attrAUR=' | TRIM(STR(nAttrAUR, 18, 6)) | ' | attrAUC=' | TRIM(STR(nAttrAUC, 18, 6)) | ' | lastClosed=' | TRIM(STR(nLastClosed, 12, 0)), 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sWk = vMerch_Time_Period;
IF(sWk @= '');
  ItemSkip;
ENDIF;
IF(DTYPE(sDimTP, sWk) @<> 'N');
  ItemSkip;
ENDIF;
nWeeks = nWeeks + 1;

#Region : CLOSED PERIOD GUARD
# The rate gates already STET on a closed week, but Adjustment Units is a raw INPUT consolidated
# into Units, so writing it into a closed week silently changes reported history. Closed periods
# belong to the actuals and period-close machinery. This guard sits BEFORE the contribution gate,
# so a closed week is never written AND never handed back either.
IF(nLastClosed <> 0);
  IF(ATTRN(sDimTP, sWk, 'End_Date') <= nLastClosed);
    nClosedSkipped = nClosedSkipped + 1;
    ItemSkip;
  ENDIF;
ENDIF;
#EndRegion

#Region : Cheap contribution gate - three reads per group across a nine year calendar
nUnits = 0;
nBDW = 0;
nReceipts = 0;
sRemain = sGroups;
WHILE(LONG(sRemain) > 0);
  nComma = SCAN(',', sRemain);
  IF(nComma > 0);
    sGrp = TRIM(SUBST(sRemain, 1, nComma - 1));
    sRemain = TRIM(SUBST(sRemain, nComma + 1, LONG(sRemain) - nComma));
  ELSE;
    sGrp = TRIM(sRemain);
    sRemain = '';
  ENDIF;
  IF(sGrp @<> '');
    nUnits = nUnits + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp, 'Units');
    nBDW = nBDW + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp, 'BD Weight');
    nReceipts = nReceipts + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp, 'Receipts');
  ENDIF;
END;

nHasContribution = 0;
IF(nUnits <> 0 % nBDW <> 0 % nReceipts <> 0);
  nHasContribution = 1;
ENDIF;

# A week with no contribution is only touched if Receipt AUC Override is still non-zero, meaning
# this chain converted it on an earlier run and now has to hand it back. NARROWER than before:
# the three selling-rate Overrides that also marked a converted week are gone, so a converted
# week that planned no receipts is not detected here. The orchestrated path clears every open
# week through Merch.Calc.ConvertPlaceholder.ClearTargets first, so this only affects a direct
# single-placeholder call.
nWasConverted = 0;
IF(nHasContribution = 0);
  IF(CellGetN(sTgtCube, pVersion, sWk, sTarget, 'Receipt AUC Override') <> 0);
    nWasConverted = 1;
  ENDIF;
  IF(nWasConverted = 0);
    ItemSkip;
  ENDIF;
ENDIF;
#EndRegion

#Region : Writability guard per PAT-001. Adjustment Units is deliberately NOT checked here - its
# rule gates on Opening Inventory + Receipts + On-Order > 0, so a target that only becomes
# writable once its receipts land would be skipped wrongly. It is guarded at its own write.
IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Rate Adjustment') = 0 % CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Seasonality') = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;
#EndRegion

#Region : Previously converted, no contribution left - hand the week back to the planner
IF(nHasContribution = 0);
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Receipt AUC Override');
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Adjustment Units') = 1);
    CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Adjustment Units');
  ENDIF;
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Markdown %');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Promo %');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Rate Adjustment');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Price Adjustment');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Backend Adjustment');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Other AUC Adjustment');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Seasonality');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Velocity');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Regime');
  CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Promo Build');
  nReverted = nReverted + 1;
  ItemSkip;
ENDIF;
#EndRegion

#Region : Accumulate every numerator and denominator across the contributing groups
# Opening Inventory is staged for audit but never accumulated - it is rule-derived on Merch
# Forecast. The staged 'Cost' measure is no longer read: it only ever fed Sales AUC Override, and
# Sales AUC is now left to its own weighted-average inventory rule, which the converted receipts
# and Receipt AUC feed. Cost is preserved through Base Cost + Backend Cost + Other Cost Adjustment.
nBaseRev = 0;
nBaseCost = 0;
nMdRev = 0;
nBackCost = 0;
nOtherCost = 0;
nPriceAdjDlr = 0;
nRevAdj = 0;
nRcptDlr = 0;
nCalcU = 0;
nCBW = 0;
nWS = 0;
nWSV = 0;
nWSVR = 0;
nWSVRP = 0;
nOO = 0;
nOOD = 0;
nInvAdjD = 0;
nInvAdj = 0;
nRes = 0;
sRemain2 = sGroups;
WHILE(LONG(sRemain2) > 0);
  nComma2 = SCAN(',', sRemain2);
  IF(nComma2 > 0);
    sGrp2 = TRIM(SUBST(sRemain2, 1, nComma2 - 1));
    sRemain2 = TRIM(SUBST(sRemain2, nComma2 + 1, LONG(sRemain2) - nComma2));
  ELSE;
    sGrp2 = TRIM(sRemain2);
    sRemain2 = '';
  ENDIF;
  IF(sGrp2 @<> '');
    nBaseRev = nBaseRev + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Base Revenue');
    nBaseCost = nBaseCost + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Base Cost');
    nMdRev = nMdRev + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Markdown Revenue');
    nBackCost = nBackCost + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Backend Cost');
    nOtherCost = nOtherCost + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Other Cost Adjustment');
    nPriceAdjDlr = nPriceAdjDlr + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Price Adj Dollars');
    nRevAdj = nRevAdj + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Revenue Adjustment');
    nRcptDlr = nRcptDlr + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Receipt Dollars');
    nCalcU = nCalcU + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Calc Units');
    nCBW = nCBW + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'CB Weighted Calc');
    nWS = nWS + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'BD W_S');
    nWSV = nWSV + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'BD W_SV');
    nWSVR = nWSVR + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'BD W_SVR');
    nWSVRP = nWSVRP + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'BD W_SVRP');
    nOO = nOO + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'On-Order');
    nOOD = nOOD + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'On-Order Dollars');
    nInvAdjD = nInvAdjD + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Inv Adjustment Dollars');
    nInvAdj = nInvAdj + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Inventory Adjustment');
    nRes = nRes + CellGetN(sStgCube, pVersion, sWk, sTarget, cAllCat, cAllPH, sGrp2, 'Reservations');
  ENDIF;
END;
#EndRegion

#Region : Divide ONCE. TI division is not zero-safe - the forgiving backslash operator is
# rules-only - and sums across contributors can cancel, so every denominator is tested.
nMdPct = 0;
IF(nBaseRev <> 0);
  nMdPct = nMdRev / nBaseRev;
ENDIF;

nBackAdj = 0;
nPriceAdj = 0;
IF(nUnits <> 0);
  nBackAdj = nBackCost / nUnits;
  nPriceAdj = nPriceAdjDlr / nUnits;
ENDIF;

nRcptAUC = 0;
IF(nReceipts <> 0);
  nRcptAUC = nRcptDlr / nReceipts;
ENDIF;

nCatBuild = 0;
IF(nCalcU <> 0);
  nCatBuild = nCBW / nCalcU;
ENDIF;
#EndRegion

#Region : REVENUE DEVIATION -> Rate Adjustment
# Merch Forecast builds revenue per unit as
#   Full Price AUR * (1 - Markdown %) * (1 + Rate Adjustment) + Price Adjustment
# with Full Price AUR from Merch Version SKU Attributes and Promo % held at 0. Solving for Rate
# Adjustment against the placeholder's own revenue per unit lands total Revenue exactly on the
# blend without touching the target's catalogue rate.
nRateAdj = 0;
IF(nUnits <> 0);
  nTgtRevPU = (nBaseRev - nMdRev + nRevAdj) / nUnits;
  nRateBase = nAttrAUR * (1 - nMdPct);
  IF(nRateBase <> 0);
    nRateAdj = (nTgtRevPU - nRateBase - nPriceAdj) / nRateBase;
  ELSE;
    IF(nTgtRevPU <> 0);
      nNoRateBase = nNoRateBase + 1;
      LogOutput('ERROR', cProcessName | ' | ' | sWk | ' | target=' | sTarget | ' | Full Price AUR after markdown is 0, so revenue of ' | TRIM(STR(nTgtRevPU, 18, 6)) | ' per unit cannot be carried by Rate Adjustment', 1);
    ENDIF;
  ENDIF;
ENDIF;
#EndRegion

#Region : COST DEVIATION -> Other AUC Adjustment
# Base Cost is Units * Base AUC and Base AUC now comes from Merch Version SKU Attributes, so the
# gap between the placeholder's blended base cost and the target's own is carried here alongside
# the placeholder's own other-cost component. Backend Adjustment is untouched, so
# Cost = Units * attrAUC + Backend Cost + Other Cost Adjustment reproduces the staged total.
nOtherAdj = 0;
IF(nUnits <> 0);
  nOtherAdj = ((nBaseCost + nOtherCost) / nUnits) - nAttrAUC;
ENDIF;
#EndRegion

#Region : Drivers telescope out of the staged chain. When BD W_S is zero every contributor had
# all four drivers zero, so all four stay zero - the forecast rule reads all-four-zero as
# Build/Debuild 0, the correct 'no build' answer rather than a neutral 1.
nSeas = 0;
nVel = 0;
nReg = 0;
nPB = 0;
IF(nBDW <> 0);
  nSeas = nWS / nBDW;
  IF(nWS <> 0);
    nVel = nWSV / nWS;
  ENDIF;
  IF(nWSV <> 0);
    nReg = nWSVR / nWSV;
  ENDIF;
  IF(nWSVR <> 0);
    nPB = nWSVRP / nWSVR;
  ENDIF;
ENDIF;
#EndRegion

#Region : Write the converted week - supply inputs FIRST
# The Adjustment Units rule gates on Opening Inventory + Receipts + On-Order > 0, so receipts have
# to land before the units or the cell refuses the write on an empty target. Each of these is
# shared with the receipt and WOS seeders, so it is written only where the placeholder actually
# planned it and is never cleared by this worker.
IF(nReceipts <> 0);
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Receipts') = 1);
    CellPutN(nReceipts, sTgtCube, pVersion, sWk, sTarget, 'Receipts');
  ENDIF;
ENDIF;
IF(nOO <> 0);
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'On-Order') = 1);
    CellPutN(nOO, sTgtCube, pVersion, sWk, sTarget, 'On-Order');
  ENDIF;
ENDIF;
IF(nOOD <> 0);
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'On-Order Dollars') = 1);
    CellPutN(nOOD, sTgtCube, pVersion, sWk, sTarget, 'On-Order Dollars');
  ENDIF;
ENDIF;
IF(nInvAdjD <> 0);
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Inv Adjustment Dollars') = 1);
    CellPutN(nInvAdjD, sTgtCube, pVersion, sWk, sTarget, 'Inv Adjustment Dollars');
  ENDIF;
ENDIF;
IF(nInvAdj <> 0);
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Inventory Adjustment') = 1);
    CellPutN(nInvAdj, sTgtCube, pVersion, sWk, sTarget, 'Inventory Adjustment');
  ENDIF;
ENDIF;
IF(nRes <> 0);
  IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Reservations') = 1);
    CellPutN(nRes, sTgtCube, pVersion, sWk, sTarget, 'Reservations');
  ENDIF;
ENDIF;
#EndRegion

#Region : Receipt valuation, then the units, then the direct inputs
CellPutN(nRcptAUC, sTgtCube, pVersion, sWk, sTarget, 'Receipt AUC Override');

IF(CellIsUpdateable(sTgtCube, pVersion, sWk, sTarget, 'Adjustment Units') = 1);
  CellPutN(nUnits, sTgtCube, pVersion, sWk, sTarget, 'Adjustment Units');
ELSE;
  nNoUnits = nNoUnits + 1;
ENDIF;

CellPutN(nMdPct, sTgtCube, pVersion, sWk, sTarget, 'Markdown %');
CellPutN(0, sTgtCube, pVersion, sWk, sTarget, 'Promo %');
CellPutN(nRateAdj, sTgtCube, pVersion, sWk, sTarget, 'Rate Adjustment');
CellPutN(nPriceAdj, sTgtCube, pVersion, sWk, sTarget, 'Price Adjustment');
CellPutN(nBackAdj, sTgtCube, pVersion, sWk, sTarget, 'Backend Adjustment');
CellPutN(nOtherAdj, sTgtCube, pVersion, sWk, sTarget, 'Other AUC Adjustment');
CellPutN(nSeas, sTgtCube, pVersion, sWk, sTarget, 'Seasonality');
CellPutN(nVel, sTgtCube, pVersion, sWk, sTarget, 'Velocity');
CellPutN(nReg, sTgtCube, pVersion, sWk, sTarget, 'Regime');
CellPutN(nPB, sTgtCube, pVersion, sWk, sTarget, 'Promo Build');
IF(nCalcU <> 0);
  CellPutN(nCatBuild, sTgtCube, pVersion, sWk, sTarget, 'Category Build');
ENDIF;
nConverted = nConverted + 1;
#EndRegion

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(SubsetExists(sDimTP, sSubName) = 1);
  SubsetDestroy(sDimTP, sSubName);
ENDIF;

#Region : Stamp the mapping row for a single-placeholder call. When the orchestrator drives this
# worker it stamps every contributing row itself, because it knows which rows fed which target.
IF(pCategory @<> '' & pPlaceholderSKU @<> '' & pGroup @<> '' & nConverted > 0);
  IF(CellIsUpdateable(sMapCube, pVersion, pCategory, pPlaceholderSKU, pGroup, 'Conversion Status') = 1);
    CellPutS('Converted', sMapCube, pVersion, pCategory, pPlaceholderSKU, pGroup, 'Conversion Status');
  ENDIF;
  IF(CellIsUpdateable(sMapCube, pVersion, pCategory, pPlaceholderSKU, pGroup, 'Conversion Date') = 1);
    CellPutN(DAYNO(TODAY(1)), sMapCube, pVersion, pCategory, pPlaceholderSKU, pGroup, 'Conversion Date');
  ENDIF;
  AttrPutS('N', sDimPH, pPlaceholderSKU, 'Active');
ENDIF;
#EndRegion

IF(nSkipped > 0);
  LogOutput('ERROR', cProcessName | ' | SKIPPED ' | TRIM(STR(nSkipped, 12, 0)) | ' week(s): the target Rate Adjustment or driver cells were not updateable', 1);
ENDIF;
IF(nNoUnits > 0);
  LogOutput('ERROR', cProcessName | ' | ' | TRIM(STR(nNoUnits, 12, 0)) | ' week(s) took rates and drivers but NOT units: Adjustment Units was not updateable, which means the target had no inventory, receipts or on-order in that week', 1);
ENDIF;
IF(nNoRateBase > 0);
  LogOutput('ERROR', cProcessName | ' | ' | TRIM(STR(nNoRateBase, 12, 0)) | ' week(s) carried NO revenue: Full Price AUR after markdown was 0 for target ' | sTarget, 1);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | END | version=' | pVersion | ' | target=' | sTarget | ' | groups=' | sGroups | ' | attrAUR=' | TRIM(STR(nAttrAUR, 18, 6)) | ' | attrAUC=' | TRIM(STR(nAttrAUC, 18, 6)) | ' | lastClosed=' | TRIM(STR(nLastClosed, 12, 0)) | ' | weeksScanned=' | TRIM(STR(nWeeks, 12, 0)) | ' | weeksClosedSkipped=' | TRIM(STR(nClosedSkipped, 12, 0)) | ' | weeksConverted=' | TRIM(STR(nConverted, 12, 0)) | ' | weeksHandedBack=' | TRIM(STR(nReverted, 12, 0)) | ' | weeksNoRateBase=' | TRIM(STR(nNoRateBase, 12, 0)), 1);
ENDIF;

#endregion