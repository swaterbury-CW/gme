#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-06-29
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Week-parallel orchestrator. Per week (under pTimePeriod) builds clear+load MDX and passes them to
#  Merch.Load.ActualsToPlanReporting.Week. Then WOS.Orch(Actual) + .ToCalc(Actual, pTimePeriod).
#### CHANGE HISTORY:
###   2026-04-20 | Steve Waterbury | Initial creation
###   2026-06-24 | Steve Waterbury | Week-parallel orchestrator (.Week workers + .ToCalc). Plan bb17626fc2af.
###   2026-06-24 | Steve Waterbury | Build/pass per-week clear+load MDX so workers are subset-free. Plan 2ad6c3e4230e.
###   2026-06-29 | Steve Waterbury | Pass pTimePeriod into ToCalc so copy-to-calc is scoped to loaded weeks. Plan a9c50221d826.
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;

IF(pTimePeriod @= '');
  LogOutput('ERROR', cProcessName | ' | pTimePeriod required', 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Time period not found: ' | pTimePeriod, 1);
  ProcessError;
ENDIF;

cTimeDim = 'Merch Time Period';
cVersion = 'Actual';
sJobIDs = '';
nPartIdx = 0;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | TimePeriod=' | pTimePeriod, 1);
ENDIF;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
nTimeSize = DIMSIZ(cTimeDim);
iT = 1;
WHILE(iT <= nTimeSize);
  sWk = DIMNM(cTimeDim, iT);
  IF(ELLEV(cTimeDim, sWk) = 0 & (sWk @= pTimePeriod % ELISANC(cTimeDim, pTimePeriod, sWk) = 1));
    nPartIdx = nPartIdx + 1;
    sClrMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Plan Reporting Measure].[Merch Plan Reporting Measure])}, 0)} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}, CROSSJOIN({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel].[Merch Channel])}, 0)}, {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Lifecycle].[Merch Lifecycle])}, 0)})) ON ROWS FROM [Merch Plan Reporting] WHERE ([Merch Version].[Merch Version].[' | cVersion | '], [Merch Time Period].[Merch Time Period].[' | sWk | '])';
    sLoadMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Actuals Measure])}, 0)} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[' | sWk | '])}, 0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel])}, 0)} ON ROWS FROM [Merch Actuals]';
    sJobId = RunProcess('Merch.Load.ActualsToPlanReporting.Week', 'pPartIdx', nPartIdx, 'pClearMDX', sClrMDX, 'pLoadMDX', sLoadMDX);
    IF(sJobIDs @= '');
      sJobIDs = sJobId;
    ELSE;
      sJobIDs = sJobIDs | ',' | sJobId;
    ENDIF;
  ENDIF;
  iT = iT + 1;
END;
IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;

ExecuteProcess('Merch.Calc.PlanReportingWOS.Orch', 'pVersion', 'Actual', 'pSKUElement', 'Director', 'pSKU', '', 'pTargetMeasure', 'WOS', 'pUseRunProcess', '1');
ExecuteProcess('Merch.Version.Copy.PlanReporting.ToCalc', 'pSourceVersion', 'Actual', 'pTimePeriod', pTimePeriod, 'pClear', 1);

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | WeeksDispatched=' | TRIM(STR(nPartIdx, 10, 0)), 1);
ENDIF;
#endregion