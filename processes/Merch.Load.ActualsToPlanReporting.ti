#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-04-20
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Loads Merch Actuals data into Merch Plan Reporting (Actual version).
# Measures via Forecast Measure Map attribute on Merch Actuals Measure.
# Lifecycle resolved from SKU attribute Lifecycle_Status_Description;
# Active fallback if blank or unmapped.
# Iterates all leaf channels (no channel aggregation).
#
#### CHANGE HISTORY:
###   2026-04-20 | Steve Waterbury | Initial creation
#
#EndRegion

cProcessName = GetProcessName();

#Region : Logging
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG'); bLogDebug = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | cProcessName | ' | TimePeriod=' | pTimePeriod); ENDIF;
#EndRegion

#Region : Validate
IF(pTimePeriod @= '');
  LogOutput('ERROR', cProcessName | ' | pTimePeriod required');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Time period not found: ' | pTimePeriod);
  ProcessError;
ENDIF;
#EndRegion

#Region : Constants
cSrcCube = 'Merch Actuals';
cDstCube = 'Merch Plan Reporting';
cVersion = 'Actual';
cMeasDim = 'Merch Actuals Measure';
cTgtMeasDim = 'Merch Plan Reporting Measure';
cLifecycleDim = 'Merch Lifecycle';
cSKUDim = 'Merch SKU';
cDefaultLifecycle = 'Active';
cMapAttribute = 'Forecast Measure Map';
cLifecycleAttr = 'Lifecycle_Status_Description';
nCellsWritten = 0;
nSkipped = 0;
nRecordCount = 0;
#EndRegion

#Region : Build VIEW
sView = 'TI_ActToPR_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Actuals Measure])}, 0)} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[' | pTimePeriod | '])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel])}, 0)} ON ROWS '
  | 'FROM [Merch Actuals]';
ViewCreateByMDX(cSrcCube, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cSrcCube, sView, 0);
ViewExtractSkipZeroesSet(cSrcCube, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cSrcCube;
DatasourceCubeview = sView;
#EndRegion
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nRecordCount = nRecordCount + 1;

sMeasure = ATTRS(cMeasDim, vMerch_Actuals_Measure, cMapAttribute);
IF(sMeasure @= '');
  ItemSkip;
ENDIF;
IF(DIMIX(cTgtMeasDim, sMeasure) = 0);
  ItemReject('Mapped measure not in target dim: ' | sMeasure);
ENDIF;

sLifecycle = ATTRS(cSKUDim, vMerch_SKU, cLifecycleAttr);
IF(sLifecycle @= '');
  sLifecycle = cDefaultLifecycle;
ENDIF;
IF(DIMIX(cLifecycleDim, sLifecycle) = 0);
  sLifecycle = cDefaultLifecycle;
ENDIF;
IF(DTYPE(cLifecycleDim, sLifecycle) @<> 'N');
  sLifecycle = cDefaultLifecycle;
ENDIF;

nVal = Value;
IF(nVal = 0);
  ItemSkip;
ENDIF;

IF(CellIsUpdateable(cDstCube, cVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Channel, sLifecycle, sMeasure) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

CellPutN(nVal, cDstCube, cVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Channel, sLifecycle, sMeasure);
nCellsWritten = nCellsWritten + 1;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSrcCube, sView) = 1);
  ViewDestroy(cSrcCube, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Records=' | TRIM(STR(nRecordCount, 10, 0)) | ' | Written=' | TRIM(STR(nCellsWritten, 10, 0)) | ' | Skipped=' | TRIM(STR(nSkipped, 10, 0)));
ENDIF;
#endregion