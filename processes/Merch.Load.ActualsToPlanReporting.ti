#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-06-24
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Week-parallel orchestrator: dispatches Merch.Load.ActualsToPlanReporting.Week per leaf week under
#  pTimePeriod (RunProcess + WaitForAllJobs), then recomputes Actual WOS (Merch.Calc.PlanReportingWOS.Orch)
#  and propagates Actual -> all Calculated versions in parallel (Merch.Version.Copy.PlanReporting.ToCalc).
#  No datasource; dispatch + joins live in the Epilog. Each week worker gets a unique pPartIdx.
#### CHANGE HISTORY:
###   2026-04-20 | Steve Waterbury | Initial creation
###   2026-06-19 | Steve Waterbury | Epilog: Actual->calc PR copy loop; 3-arg LogOutput. Plan 908774392cf2.
###   2026-06-20 | Steve Waterbury | Epilog: WOS recompute before copy. Plan 908774392cf2.
###   2026-06-24 | Steve Waterbury | Attribute-driven clear-before-load. Plan 8f6ff1437676.
###   2026-06-24 | Steve Waterbury | REWRITE: week-parallel orchestrator (.Week workers + parallel .ToCalc). Plan bb17626fc2af.
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;

IF(pTimePeriod @= '');
  LogOutput('ERROR', cProcessName | ' | pTimePeriod required', 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0);
  LogOutput('ERROR', cProcessName | ' | Time period not found: ' | pTimePeriod, 1);
  ProcessError;
ENDIF;

cTimeDim = 'Merch Time Period';
sJobIDs = '';
nPartIdx = 0;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | TimePeriod=' | pTimePeriod, 1);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
# Fan out one per-week worker per leaf week under pTimePeriod (parallel direct load into PR Actual; each worker clears its own week-slice first).
nTimeSize = DIMSIZ(cTimeDim);
iT = 1;
WHILE(iT <= nTimeSize);
  sWk = DIMNM(cTimeDim, iT);
  IF(ELLEV(cTimeDim, sWk) = 0 & (sWk @= pTimePeriod % ELISANC(cTimeDim, pTimePeriod, sWk) = 1));
    nPartIdx = nPartIdx + 1;
    sJobId = RunProcess('Merch.Load.ActualsToPlanReporting.Week', 'pTimePeriod', sWk, 'pPartIdx', nPartIdx);
    IF(sJobIDs @= '');
      sJobIDs = sJobId;
    ELSE;
      sJobIDs = sJobIDs | ',' | sJobId;
    ENDIF;
  ENDIF;
  iT = iT + 1;
END;
IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;

# Recompute Actual WOS across the full tree (parallel), then propagate Actual -> all Calculated versions in parallel.
ExecuteProcess('Merch.Calc.PlanReportingWOS.Orch', 'pVersion', 'Actual', 'pSKUElement', 'Director', 'pSKU', '', 'pTargetMeasure', 'WOS', 'pUseRunProcess', '1');
ExecuteProcess('Merch.Version.Copy.PlanReporting.ToCalc', 'pSourceVersion', 'Actual', 'pClear', 1);

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | WeeksDispatched=' | TRIM(STR(nPartIdx, 10, 0)), 1);
ENDIF;

#endregion