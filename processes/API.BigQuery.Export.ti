#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****

#==========================================================================
# PROCESS:    API.BigQuery.Export
# PURPOSE:    Query Google BigQuery via REST API and write results to files
# DEVELOPER:  Steve Waterbury
# DATE:       2026-03-25
#
# CHANGE HISTORY:
# 2026-03-25 | Steve Waterbury | Initial creation
# 2026-03-27 | Steve Waterbury | startIndex-based pagination. Writes
#              page_1.json..page_N.json to handle result sets > 1 page.
#              pOutputFile is now the base name (e.g. 'SKU_bq' produces
#              SKU_bq_page_1.json, SKU_bq_page_2.json, etc.)
#              Also writes pOutputFile_pages.txt with the page count.
### 2026-04-01         Steve Waterbury    Code formatting: multi-line IF blocks, NumberToString -> STR
#
# PARAMETERS:
#   pQuery       - BigQuery SQL query to execute
#   pOutputFile  - Base name for output files (no extension)
#   pMaxResults  - Rows per page (default '50000')
#==========================================================================

sProcess = GetProcessName();
sLogLevel = CellGetS('ProcessControl', sProcess, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo  = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo  = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;

IF(pQuery @= '');
  LogOutput('ERROR', sProcess | ' | pQuery is empty.');
  ProcessError;
ENDIF;
IF(pOutputFile @= '');
  LogOutput('ERROR', sProcess | ' | pOutputFile is empty.');
  ProcessError;
ENDIF;
IF(pMaxResults @= '');
  pMaxResults = '50000';
ENDIF;

# --- Read GCP credentials ---
sClientEmail = CellGetS('}GCP_Service_Account', 'client_email', 'Value');
sPrivateKey  = CellGetS('}GCP_Service_Account', 'private_key', 'Value');
sProjectId   = CellGetS('}GCP_Service_Account', 'project_id', 'Value');
sTokenURI    = CellGetS('}GCP_Service_Account', 'token_uri', 'Value');
IF(sClientEmail @= '' % sPrivateKey @= '' % sProjectId @= '');
  LogOutput('ERROR', sProcess | ' | GCP credentials missing.');
  ProcessError;
ENDIF;
IF(sTokenURI @= '');
  sTokenURI = 'https://oauth2.googleapis.com/token';
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | Starting BigQuery export for project: ' | sProjectId);
ENDIF;

# ===========================================================
# STEP 1: JWT + Token exchange
# ===========================================================
sPayload = JsonAdd('{}', 'iss', StringToJson(sClientEmail));
sPayload = JsonAdd(sPayload, 'sub', StringToJson(sClientEmail));
sPayload = JsonAdd(sPayload, 'aud', StringToJson(sTokenURI));
sPayload = JsonAdd(sPayload, 'scope', StringToJson('https://www.googleapis.com/auth/bigquery.readonly'));
sPayload = JsonAdd(sPayload, 'iat', 0);
sPayload = JsonAdd(sPayload, 'exp', 3600);
sJWT = JwtCreate('RS256', sPayload, sPrivateKey, '');
IF(sJWT @= '');
  LogOutput('ERROR', sProcess | ' | JwtCreate failed.');
  ProcessError;
ENDIF;

sTokenBody = 'grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer&assertion=' | sJWT;
ExecuteHttpRequest('POST', sTokenURI, '-h Content-Type:application/x-www-form-urlencoded', '-d ' | sTokenBody);
nStatusCode = HttpResponseGetStatusCode();
IF(nStatusCode <> 200);
  LogOutput('ERROR', sProcess | ' | Token exchange failed HTTP ' | TRIM(STR(nStatusCode, 10, 0)));
  ProcessError;
ENDIF;
sTokenResponse = HttpResponseGetBody();
sToken = JsonGet(sTokenResponse, 'access_token');
IF(SUBST(sToken, 1, 1) @= '"');
  sToken = SUBST(sToken, 2, LONG(sToken) - 2);
ENDIF;
IF(sToken @= '');
  LogOutput('ERROR', sProcess | ' | No access_token.');
  ProcessError;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | OAuth2 token acquired.');
ENDIF;

# ===========================================================
# STEP 2: Submit query (maxResults=0)
# ===========================================================
sQueryURL = 'https://bigquery.googleapis.com/bigquery/v2/projects/' | sProjectId | '/queries';
sQueryBody = '{"query":"' | pQuery | '","useLegacySql":false,"maxResults":0}';
ExecuteHttpRequest('POST', sQueryURL, '-h Authorization: Bearer ' | sToken, '-h Content-Type: application/json', '-d ' | sQueryBody);
nStatusCode = HttpResponseGetStatusCode();
IF(nStatusCode <> 200);
  LogOutput('ERROR', sProcess | ' | Query failed HTTP ' | TRIM(STR(nStatusCode, 10, 0)) | ' | ' | HttpResponseGetBody());
  ProcessError;
ENDIF;
sQueryResponse = HttpResponseGetBody();
sJobComplete = JsonGet(sQueryResponse, 'jobComplete');
IF(SUBST(sJobComplete, 1, 1) @= '"');
  sJobComplete = SUBST(sJobComplete, 2, LONG(sJobComplete) - 2);
ENDIF;
sJobRef = JsonGet(sQueryResponse, 'jobReference');
sJobId = JsonGet(sJobRef, 'jobId');
IF(SUBST(sJobId, 1, 1) @= '"');
  sJobId = SUBST(sJobId, 2, LONG(sJobId) - 2);
ENDIF;
IF(sJobId @= '');
  LogOutput('ERROR', sProcess | ' | Failed to extract jobId.');
  ProcessError;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | jobId: ' | sJobId | ' | jobComplete: ' | sJobComplete);
ENDIF;

# ===========================================================
# STEP 3: Poll until complete
# ===========================================================
sPollURL = 'https://bigquery.googleapis.com/bigquery/v2/projects/' | sProjectId | '/queries/' | sJobId | '?maxResults=0';
nPollCount = 0;
WHILE(sJobComplete @<> 'true' & nPollCount < 60);
  nPollCount = nPollCount + 1;
  Sleep(2000);
  ExecuteHttpRequest('GET', sPollURL, '-h Authorization: Bearer ' | sToken);
  nStatusCode = HttpResponseGetStatusCode();
  IF(nStatusCode <> 200);
    LogOutput('ERROR', sProcess | ' | Poll failed HTTP ' | TRIM(STR(nStatusCode, 10, 0)));
    ProcessError;
  ENDIF;
  sQueryResponse = HttpResponseGetBody();
  sJobComplete = JsonGet(sQueryResponse, 'jobComplete');
  IF(SUBST(sJobComplete, 1, 1) @= '"');
    sJobComplete = SUBST(sJobComplete, 2, LONG(sJobComplete) - 2);
  ENDIF;
END;
IF(sJobComplete @<> 'true');
  LogOutput('ERROR', sProcess | ' | Query did not complete.');
  ProcessError;
ENDIF;

sTotalRows = JsonGet(sQueryResponse, 'totalRows');
IF(SUBST(sTotalRows, 1, 1) @= '"');
  sTotalRows = SUBST(sTotalRows, 2, LONG(sTotalRows) - 2);
ENDIF;
IF(sTotalRows @= '');
  sTotalRows = '0';
ENDIF;
nTotalRows = StringToNumber(sTotalRows);
nPageSize = StringToNumber(pMaxResults);

IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | Total rows: ' | sTotalRows | ' | Page size: ' | pMaxResults);
ENDIF;

# ===========================================================
# STEP 4: Fetch pages using startIndex
#   Each page written to pOutputFile_page_N.json
#   startIndex = (pageNum - 1) * pageSize
# ===========================================================
sBaseURL = 'https://bigquery.googleapis.com/bigquery/v2/projects/' | sProjectId | '/queries/' | sJobId;
nStartIndex = 0;
nPageNum = 0;

WHILE(nStartIndex < nTotalRows);
  nPageNum = nPageNum + 1;
  sPageFile = pOutputFile | '_page_' | TRIM(STR(nPageNum, 5, 0)) | '.json';
  sFetchURL = sBaseURL | '?maxResults=' | pMaxResults | '&startIndex=' | TRIM(STR(nStartIndex, 10, 0));

  IF(bLogInfo = 1);
    LogOutput('INFO', sProcess | ' | Fetching page ' | TRIM(STR(nPageNum, 10, 0)) | ' (startIndex=' | TRIM(STR(nStartIndex, 10, 0)) | ') -> ' | sPageFile);
  ENDIF;

  ExecuteHttpRequest('GET', sFetchURL, '-h Authorization: Bearer ' | sToken, '-o ' | sPageFile);
  nStatusCode = HttpResponseGetStatusCode();
  IF(nStatusCode <> 200);
    LogOutput('ERROR', sProcess | ' | Page ' | TRIM(STR(nPageNum, 10, 0)) | ' fetch failed HTTP ' | TRIM(STR(nStatusCode, 10, 0)));
    ProcessError;
  ENDIF;

  nStartIndex = nStartIndex + nPageSize;
END;

IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | Wrote ' | TRIM(STR(nPageNum, 10, 0)) | ' page files for ' | sTotalRows | ' rows.');
  LogOutput('INFO', sProcess | ' | Process completed successfully.');
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion