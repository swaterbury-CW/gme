#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-14
# LAST UPDATE: 2026-05-17
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-14 | Steve Waterbury | Initial: Merch Category fan-out for Extract workers
#   2026-05-14 | Steve Waterbury | BUGFIX: SubsetName= -> DatasourceDimensionSubset= per canonical SyncAttributeNames
#   2026-05-17 | Steve Waterbury | Phase 2: Refactor to canonical v12 parallel pattern. Runtime DatasourceType='NULL' overrides static TM1DimensionSubset config; dispatch loop moved to Epilog with sJobId = RunProcess(...) accumulation and WaitForAllJobs(sJobIDs) barrier. Fixes extract/reload race where 258 children exceeded WaitForInternalJobs.
#EndRegion

cProcessName = GetProcessName();
nDispatches = 0;
sJobIDs = '';

IF(pSourceVersion @= '' % pLY @= '' % pCY @= '' % pNY @= '' % pBatchTag @= '');
  LogOutput('ERROR', cProcessName | ' | missing param');
  ProcessError;
ENDIF;

sCatSubset = 'TI_VerCopyCat_' | TRIM(STR(NOW, 15, 0));
IF(SubsetExists('Merch Category', sCatSubset) = 1);
  SubsetDestroy('Merch Category', sCatSubset);
ENDIF;

IF(pCategoryFilter @<> '');
  IF(DIMIX('Merch Category', pCategoryFilter) = 0);
    LogOutput('ERROR', cProcessName | ' | bad pCategoryFilter: ' | pCategoryFilter);
    ProcessError;
  ENDIF;
  SubsetCreateByMDX(sCatSubset, '{[Merch Category].[Merch Category].[' | pCategoryFilter | ']}');
ELSE;
  SubsetCreateByMDX(sCatSubset, '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Category].[Merch Category])}, 0)}');
ENDIF;

# Override any static datasource — orchestrator has no per-row work; dispatch lives in Epilog.
DatasourceType = 'NULL';

nStart = NOW;
LogOutput('INFO', 'TIMING START: ' | cProcessName | ' | Src=' | pSourceVersion | ' | Years=' | pLY | '/' | pCY | '/' | pNY);

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
nCatCount = SubsetGetSize('Merch Category', sCatSubset);
nIdx = 1;

WHILE(nIdx <= nCatCount);
  sCat = SubsetGetElementName('Merch Category', sCatSubset, nIdx);

  sJobId = RunProcess('Merch.Version.Copy.Forecast.Extract', 'pSourceVersion', pSourceVersion, 'pCategory', sCat, 'pFiscalYear', pLY, 'pBatchTag', pBatchTag);
  IF(sJobIDs @= ''); sJobIDs = sJobId; ELSE; sJobIDs = sJobIDs | ',' | sJobId; ENDIF;
  nDispatches = nDispatches + 1;

  sJobId = RunProcess('Merch.Version.Copy.Forecast.Extract', 'pSourceVersion', pSourceVersion, 'pCategory', sCat, 'pFiscalYear', pCY, 'pBatchTag', pBatchTag);
  IF(sJobIDs @= ''); sJobIDs = sJobId; ELSE; sJobIDs = sJobIDs | ',' | sJobId; ENDIF;
  nDispatches = nDispatches + 1;

  sJobId = RunProcess('Merch.Version.Copy.Forecast.Extract', 'pSourceVersion', pSourceVersion, 'pCategory', sCat, 'pFiscalYear', pNY, 'pBatchTag', pBatchTag);
  IF(sJobIDs @= ''); sJobIDs = sJobId; ELSE; sJobIDs = sJobIDs | ',' | sJobId; ENDIF;
  nDispatches = nDispatches + 1;

  nIdx = nIdx + 1;
END;

# Hard barrier: wait for all dispatched job IDs to complete before this orchestrator returns.
IF(sJobIDs @<> '');
  WaitForAllJobs(sJobIDs);
ENDIF;

IF(SubsetExists('Merch Category', sCatSubset) = 1);
  SubsetDestroy('Merch Category', sCatSubset);
ENDIF;

IF(CellIsUpdateable('ProcessControl', cProcessName, 'SubsetCount') = 0);
  LogOutput('ERROR', cProcessName | ' | ProcessControl.SubsetCount not updateable');
ELSE;
  CellPutN(nDispatches, 'ProcessControl', cProcessName, 'SubsetCount');
ENDIF;

LogOutput('INFO', 'TIMING END: ' | cProcessName | ' | Dispatches=' | TRIM(STR(nDispatches, 12, 0)) | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's');

#endregion