#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-08-28
# LAST UPDATE: 2026-08-28
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-08-28 | Steve Waterbury | Initial: per-category worker for the Copy.TPSKU fan-out
#   2026-08-28 | Steve Waterbury | Stack TP * one category on ROWS; ON 2 dropped the dimension from the view
#
# One partition of Merch.Version.Copy.TPSKU: copies a SINGLE element of the cube's
# third dimension. Identical to Copy.TPSKU except the category set on the row stack
# carries one member instead of every leaf.
#
# NO ProcessControl READ OR WRITE. Workers log; they do not touch shared control cubes.
#EndRegion

cProcessName = GetProcessName();
nCellsCopied = 0;

# Local numeric copies - a p-prefixed parameter must not appear in a numeric context.
nSkipParam = pSkipCalcs;
nPartIdx = pPartIdx;

#Region : Validation - ALL of it before the first ViewCreate so ProcessError is legal
IF(pCubeName @= '' % pSourceVersion @= '' % pTargetVersion @= '' % pCategory @= '');
  LogOutput('ERROR', cProcessName | ' | missing param', 1);
  ProcessError;
ENDIF;
IF(CubeExists(pCubeName) = 0);
  LogOutput('ERROR', cProcessName | ' | cube missing: ' | pCubeName, 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pSourceVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | bad source version: ' | pSourceVersion, 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pTargetVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | bad target version: ' | pTargetVersion, 1);
  ProcessError;
ENDIF;

cDimVer = TABDIM(pCubeName, 1);
cDimTP = TABDIM(pCubeName, 2);
cDimSKU = TABDIM(pCubeName, 3);
cDimMeasure = TABDIM(pCubeName, 4);

IF(DIMIX(cDimSKU, pCategory) = 0);
  LogOutput('ERROR', cProcessName | ' | pCategory not in ' | cDimSKU | ': ' | pCategory, 1);
  ProcessError;
ENDIF;
#EndRegion

sTargetVersionType = TRIM(ATTRS('Merch Version', pTargetVersion, 'Version_Type'));
IF(nSkipParam >= 0);
  nSkipRuleCalcs = nSkipParam;
  sSkipSource = 'param';
ELSE;
  nSkipRuleCalcs = 1;
  IF(sTargetVersionType @= 'Static');
    nSkipRuleCalcs = 0;
  ENDIF;
  sSkipSource = 'inferred';
ENDIF;

nStart = NOW;

# VIEW NAME from pPartIdx plus a seconds token. NEVER from pCategory - category names
# are free text. NEVER from TRIM(STR(NOW,15,0)) alone, which is the DAY serial.
nRunSec = INT((nStart - INT(nStart)) * 86400);
IF(nRunSec <= 0);
  nRunSec = 1;
ENDIF;
IF(nPartIdx <= 0);
  nPartIdx = nRunSec;
ENDIF;
sView = 'TI_CopyTPSKUCat_' | TRIM(STR(INT(nStart), 15, 0)) | 'x' | TRIM(STR(nRunSec, 6, 0)) | '_' | TRIM(STR(nPartIdx, 10, 0));

LogOutput('INFO', 'TIMING START: ' | cProcessName | ' | Cube=' | pCubeName | ' | Cat=' | pCategory | ' | Part=' | TRIM(STR(nPartIdx, 10, 0)) | ' | Src=' | pSourceVersion | ' | Tgt=' | pTargetVersion | ' | SkipCalcs=' | TRIM(STR(nSkipRuleCalcs, 1, 0)) | ' (' | sSkipSource | ') | View=' | sView, 1);

# STACKED ON ROWS with the * operator. The category is a ONE-MEMBER SET inside the
# stack, not a separate axis - a TM1 view has only COLUMNS and ROWS plus titles, and a
# third axis does not scope the extract. Keeping the category on the row stack rather
# than pinning it in WHERE preserves the variable binding: a TM1CubeView binds in
# MDX-axis order, so measure (columns) then TP, Category (rows) matches the registered
# vMeasure/vTP/vSKU and the Data tab needs no edit.
sMDX = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimMeasure | '].[' | cDimMeasure | '])}, 0)} ON COLUMNS, ';
sMDX = sMDX | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimTP | '].[' | cDimTP | '])}, 0)}';
sMDX = sMDX | ' * {[' | cDimSKU | '].[' | cDimSKU | '].[' | pCategory | ']} ON ROWS ';
sMDX = sMDX | 'FROM [' | pCubeName | '] ';
sMDX = sMDX | 'WHERE ([' | cDimVer | '].[' | cDimVer | '].[' | pSourceVersion | '])';

IF(ViewExists(pCubeName, sView) = 1);
  ViewDestroy(pCubeName, sView);
ENDIF;
ViewCreateByMDX(pCubeName, sView, sMDX, 1);
ViewExtractSkipCalcsSet(pCubeName, sView, nSkipRuleCalcs);
ViewExtractSkipZeroesSet(pCubeName, sView, 1);
LogOutput('INFO', 'TIMING VIEW READY: ' | cProcessName | ' | Cat=' | pCategory | ' | BuildSec=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)), 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = pCubeName;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sMeasType = DTYPE(cDimMeasure, vMeasure);
IF(sMeasType @<> 'N' & sMeasType @<> 'S' & sMeasType @<> 'C');
    ItemReject('Bad data: unknown measure type ' | sMeasType);
ENDIF;

IF(sMeasType @= 'S');
    IF(Value @= '');
        ItemSkip;
    ENDIF;
    IF(CellIsUpdateable(pCubeName, pTargetVersion, vTP, vSKU, vMeasure) = 0);
        ItemSkip;
    ENDIF;
    CellPutS(Value, pCubeName, pTargetVersion, vTP, vSKU, vMeasure);
    nCellsCopied = nCellsCopied + 1;
    ItemSkip;
ENDIF;

nVal = NUMBR(Value);
IF(nVal = 0);
    ItemSkip;
ENDIF;
IF(CellIsUpdateable(pCubeName, pTargetVersion, vTP, vSKU, vMeasure) = 0);
    ItemSkip;
ENDIF;
CellPutN(nVal, pCubeName, pTargetVersion, vTP, vSKU, vMeasure);
nCellsCopied = nCellsCopied + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(pCubeName, sView) = 1);
  ViewDestroy(pCubeName, sView);
ENDIF;
LogOutput('INFO', 'TIMING END: ' | cProcessName | ' | Cube=' | pCubeName | ' | Cat=' | pCategory | ' | Part=' | TRIM(STR(nPartIdx, 10, 0)) | ' | Tgt=' | pTargetVersion | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's | Cells=' | TRIM(STR(nCellsCopied, 12, 0)), 1);

#endregion