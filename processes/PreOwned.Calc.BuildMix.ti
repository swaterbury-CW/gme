#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-04-13
# LAST UPDATE : 2026-05-11
# CHANGED BY  : Steve Waterbury
# COMMENTS: View-driven BuildMix in-place. Calls BuildScope to refresh the
#  Merch PreOwned BuildMix Scope cube, then bulk-extracts the 8 *Calc
#  rule-derived measures from Merch PreOwned Forecast (NON EMPTY drops
#  out-of-scope rows because the rule returns 0 when Scope Flag=0), and
#  writes one CellPutN per row into the stored input measure.
# CHANGE HISTORY:
#   2026-04-30 | Steve Waterbury | Variable list reordered to MDX-axis-order so vMerch_PreOwned_Forecast_Measure actually receives the column dim element name on each iteration
#   2026-05-11 | Steve Waterbury | Qualify Merch Version hierarchy in ViewCreateByMDX WHERE
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' V=' | pVersion);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Invalid version');
  ProcessError;
ENDIF;

nRC = ExecuteProcess('PreOwned.Calc.BuildMix.BuildScope', 'pVersion', pVersion);
IF(nRC <> ProcessExitNormal());
  LogOutput('ERROR', cProcessName | ' | BuildScope failed RC=' | TRIM(STR(nRC, 5, 0)));
  ProcessError;
ENDIF;

sCubeForecast = 'Merch PreOwned Forecast';
nWritten = 0;

sView = 'TI_BuildMix_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[Merch PreOwned Forecast Measure].[Sales Mix Calc], [Merch PreOwned Forecast Measure].[Trade Mix Calc], [Merch PreOwned Forecast Measure].[Margin Mix Calc], [Merch PreOwned Forecast Measure].[AUR Mix Calc], [Merch PreOwned Forecast Measure].[AUT Mix Calc], [Merch PreOwned Forecast Measure].[AUR Calc], [Merch PreOwned Forecast Measure].[AUT Calc], [Merch PreOwned Forecast Measure].[Margin Pct Calc]} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])},0)} * FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch PreOwned Category])},0)}, [Merch PreOwned Category].CurrentMember.Properties(''SGM_Category_Group'') <> '''') ON ROWS FROM [Merch PreOwned Forecast] WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
IF(ViewExists(sCubeForecast, sView) = 1);
  ViewDestroy(sCubeForecast, sView);
ENDIF;
ViewCreateByMDX(sCubeForecast, sView, sMDX, 1);
ViewExtractSkipCalcsSet(sCubeForecast, sView, 0);
ViewExtractSkipZeroesSet(sCubeForecast, sView, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = sCubeForecast;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sVer  = vMerch_Version;
sWeek = vMerch_Time_Period;
sCat  = vMerch_PreOwned_Category;
sMeas = vMerch_PreOwned_Forecast_Measure;
nVal  = vValue;

IF(sVer @= '');
  ItemReject('vMerch_Version is empty');
ENDIF;
IF(sWeek @= '' % sCat @= '' % sMeas @= '');
  ItemSkip;
ENDIF;

sTarget = '';
IF(sMeas @= 'Sales Mix Calc');
  sTarget = 'Sales Mix Pct';
ENDIF;
IF(sMeas @= 'Trade Mix Calc');
  sTarget = 'Trade Mix Pct';
ENDIF;
IF(sMeas @= 'Margin Mix Calc');
  sTarget = 'Margin Mix Pct';
ENDIF;
IF(sMeas @= 'AUR Mix Calc');
  sTarget = 'AUR Mix Pct';
ENDIF;
IF(sMeas @= 'AUT Mix Calc');
  sTarget = 'AUT Mix Pct';
ENDIF;
IF(sMeas @= 'AUR Calc');
  sTarget = 'AUR';
ENDIF;
IF(sMeas @= 'AUT Calc');
  sTarget = 'AUT';
ENDIF;
IF(sMeas @= 'Margin Pct Calc');
  sTarget = 'Margin Pct';
ENDIF;
IF(sTarget @= '');
  ItemSkip;
ENDIF;

IF(CellIsUpdateable(sCubeForecast, sVer, sWeek, sCat, sTarget) = 1);
  CellPutN(nVal, sCubeForecast, sVer, sWeek, sCat, sTarget);
  nWritten = nWritten + 1;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(sCubeForecast, sView) = 1);
  ViewDestroy(sCubeForecast, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' V=' | pVersion | ' Writes=' | TRIM(STR(nWritten, 10, 0)));
ENDIF;

#endregion