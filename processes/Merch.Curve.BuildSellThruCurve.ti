#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-04-24
# LAST UPDATE: 2026-06-02
# CHANGED BY : Steve Waterbury
# COMMENTS   : Sell Thru curve generator. Optional pSourceElement validated against Roles hier.
# CHANGE HISTORY:
#   2026-04-24 | Steve Waterbury | Initial
#   2026-05-10 | Steve Waterbury | Velocity per-week + attribute writes
#   2026-05-20 | Steve Waterbury | pSourceElement check via HierarchyElementExists Roles
#   2026-06-02 | Steve Waterbury | Removed Has_Level write (Level dropped as curve type, plan c1cd290268f6)
#EndRegion

cProcessName = GetProcessName();
cCube = 'Merch Curve';
cNameDim = 'Merch Curve Name';
cShapeDim = 'Merch Curve Shape';
cSKUDim = 'Merch SKU';
cTPDim = 'Merch Time Period';
cVersionDim = 'Merch Version';
cAttrCurveType = 'Curve Type';
cAnchorWeek = 'Week 1';
cMeasTargetEnd = 'Target Ending Inventory Pct';
cMeasDuration = 'Duration Weeks';
cMeasShape = 'Curve Shape';
cMeasPct = 'Target Inventory Pct';
cMeasBD = 'Build/Debuild';
cMeasVelocity = 'Velocity';
cShapeStraight = 'Straight Line';
cShapeLog = 'Logarithmic';
cShapeExp = 'Exponential';
cShapeS = 'S-Curve';
cWeekPrefix = 'Week ';
cSellThru = 'Sell Thru';
cDateFmt = '\Y-\m-\d';
nLn10 = 2.302585092994046;

sLogLevel = 'OFF';
IF(CubeExists('ProcessControl') = 1);
  sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
  IF(sLogLevel @= '');
    sLogLevel = 'OFF';
  ENDIF;
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pCurveName @= '');
  LogOutput('ERROR', cProcessName | ' | pCurveName required');
  ProcessError;
ENDIF;
IF(DIMIX(cNameDim, pCurveName) = 0);
  DimensionElementInsertDirect(cNameDim, '', pCurveName, 'N');
ENDIF;

nTargetEnd = pTargetEndingInventoryPct;
nDuration = pDurationWeeks;
sShape = pCurveShape;

IF(nDuration <= 0 % nDuration > 52);
  LogOutput('ERROR', cProcessName | ' | Invalid pDurationWeeks');
  ProcessError;
ENDIF;
IF(nTargetEnd < 0 % nTargetEnd > 1);
  LogOutput('ERROR', cProcessName | ' | Invalid pTargetEndingInventoryPct');
  ProcessError;
ENDIF;
IF(sShape @= '');
  LogOutput('ERROR', cProcessName | ' | pCurveShape required');
  ProcessError;
ENDIF;
IF(sShape @<> cShapeStraight & sShape @<> cShapeLog & sShape @<> cShapeExp & sShape @<> cShapeS);
  LogOutput('ERROR', cProcessName | ' | Invalid pCurveShape: ' | sShape);
  ProcessError;
ENDIF;
IF(DIMIX(cShapeDim, sShape) = 0);
  LogOutput('ERROR', cProcessName | ' | pCurveShape not in dim');
  ProcessError;
ENDIF;

nStartPct = pStartingInventoryPct;
IF(nStartPct <= 0);
  nStartPct = 1;
ENDIF;
IF(nStartPct > 1);
  LogOutput('ERROR', cProcessName | ' | Invalid pStartingInventoryPct');
  ProcessError;
ENDIF;
IF(nStartPct < nTargetEnd);
  LogOutput('ERROR', cProcessName | ' | pStartingInventoryPct must be >= pTargetEndingInventoryPct');
  ProcessError;
ENDIF;

nSteepness = pSCurveSteepness;
IF(nSteepness <= 0);
  nSteepness = 10;
ENDIF;
nExpFloor = pExponentialFloor;
IF(nExpFloor <= 0);
  nExpFloor = 0.0001;
ENDIF;
IF(nExpFloor >= 1);
  LogOutput('ERROR', cProcessName | ' | pExponentialFloor must be in (0,1)');
  ProcessError;
ENDIF;
nWStart = pWeekStart;
IF(nWStart <= 0);
  nWStart = 1;
ENDIF;
nWEnd = pWeekEnd;
IF(nWEnd <= 0);
  nWEnd = nDuration;
ENDIF;
IF(nWStart > nWEnd);
  LogOutput('ERROR', cProcessName | ' | pWeekStart > pWeekEnd');
  ProcessError;
ENDIF;
IF(nWStart > 52 % nWEnd > 52);
  LogOutput('ERROR', cProcessName | ' | pWeekStart/pWeekEnd out of range');
  ProcessError;
ENDIF;

IF(pClearFirst = 1);
  nClr = 1;
  WHILE(nClr <= 52);
    sClrWk = cWeekPrefix | NumberToString(nClr);
    IF(CellIsUpdateable(cCube, pCurveName, sClrWk, cMeasPct) = 1);
      CellPutN(0, cCube, pCurveName, sClrWk, cMeasPct);
    ENDIF;
    IF(CellIsUpdateable(cCube, pCurveName, sClrWk, cMeasBD) = 1);
      CellPutN(0, cCube, pCurveName, sClrWk, cMeasBD);
    ENDIF;
    IF(CellIsUpdateable(cCube, pCurveName, sClrWk, cMeasVelocity) = 1);
      CellPutN(0, cCube, pCurveName, sClrWk, cMeasVelocity);
    ENDIF;
    nClr = nClr + 1;
  END;
ENDIF;

IF(CellIsUpdateable(cCube, pCurveName, cAnchorWeek, cMeasTargetEnd) = 1);
  CellPutN(nTargetEnd, cCube, pCurveName, cAnchorWeek, cMeasTargetEnd);
ENDIF;
IF(CellIsUpdateable(cCube, pCurveName, cAnchorWeek, cMeasDuration) = 1);
  CellPutN(nDuration, cCube, pCurveName, cAnchorWeek, cMeasDuration);
ENDIF;
IF(CellIsUpdateable(cCube, pCurveName, cAnchorWeek, cMeasShape) = 1);
  CellPutS(sShape, cCube, pCurveName, cAnchorWeek, cMeasShape);
ENDIF;

nDelta = nStartPct - nTargetEnd;
nK = nSteepness / nDuration;
nMid = nDuration / 2;
nF0 = 1 / (1 + EXP(-nK * (0 - nMid)));
nFN = 1 / (1 + EXP(-nK * (nDuration - nMid)));
nFRange = nFN - nF0;
nLogDenom = LOG(nDuration + 1);
nLnStart = 0;
IF(nStartPct > 0);
  nLnStart = LOG(nStartPct) * nLn10;
ENDIF;
nExpLnTarget = 0;
IF(nTargetEnd > 0);
  nExpLnTarget = LOG(nTargetEnd) * nLn10;
ELSE;
  nExpLnTarget = LOG(nExpFloor) * nLn10;
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
nPrev = nStartPct;
nW = 1;
WHILE(nW <= 52);
  sWeek = cWeekPrefix | NumberToString(nW);
  IF(nW <= nDuration);
    IF(sShape @= cShapeStraight);
      nPct = nStartPct - (nW / nDuration) * nDelta;
    ELSEIF(sShape @= cShapeLog);
      nPct = nStartPct - (LOG(nW + 1) / nLogDenom) * nDelta;
    ELSEIF(sShape @= cShapeExp);
      nPct = EXP(nLnStart + (nW / nDuration) * (nExpLnTarget - nLnStart));
    ELSEIF(sShape @= cShapeS);
      nFw = 1 / (1 + EXP(-nK * (nW - nMid)));
      nPct = nStartPct - nDelta * ((nFw - nF0) / nFRange);
    ELSE;
      nPct = 0;
    ENDIF;
  ELSE;
    nPct = nTargetEnd;
  ENDIF;
  IF(nPrev <> 0);
    nBD = nPct / nPrev;
  ELSE;
    nBD = 1;
  ENDIF;
  IF(nW >= nWStart & nW <= nWEnd);
    IF(CellIsUpdateable(cCube, pCurveName, sWeek, cMeasPct) = 1);
      CellPutN(nPct, cCube, pCurveName, sWeek, cMeasPct);
    ENDIF;
    IF(CellIsUpdateable(cCube, pCurveName, sWeek, cMeasBD) = 1);
      CellPutN(nBD, cCube, pCurveName, sWeek, cMeasBD);
    ENDIF;
    IF(CellIsUpdateable(cCube, pCurveName, sWeek, cMeasVelocity) = 1);
      CellPutN(nBD, cCube, pCurveName, sWeek, cMeasVelocity);
    ENDIF;
  ENDIF;
  nPrev = nPct;
  nW = nW + 1;
END;

AttrPutS(cSellThru, cNameDim, pCurveName, cAttrCurveType);
AttrPutN(1, cNameDim, pCurveName, 'Has_Velocity');
AttrPutN(0, cNameDim, pCurveName, 'Has_Seasonality');
AttrPutN(0, cNameDim, pCurveName, 'Has_Regime');
AttrPutN(0, cNameDim, pCurveName, 'Has_Markdown');
AttrPutS(TIMST(NOW(), cDateFmt), cNameDim, pCurveName, 'Created Date');
AttrPutN(NOW(), cNameDim, pCurveName, 'Created_Date_Serial');
AttrPutS(TM1User(), cNameDim, pCurveName, 'Created By');

IF(pDescription @<> '');
  AttrPutS(pDescription, cNameDim, pCurveName, 'Description');
ENDIF;

IF(pSourceElement @<> '' & HierarchyElementExists(cSKUDim, 'Roles', pSourceElement) = 1);
  IF(DTYPE(cSKUDim, pSourceElement) @= 'N');
    AttrPutS(pSourceElement, cNameDim, pCurveName, 'Source SKU');
  ELSE;
    AttrPutS(pSourceElement, cNameDim, pCurveName, 'Source Category');
  ENDIF;
ENDIF;

IF(pSourceVersion @<> '' & DIMIX(cVersionDim, pSourceVersion) > 0);
  AttrPutS(pSourceVersion, cNameDim, pCurveName, 'Source Version');
ENDIF;

IF(pSourceStartPeriod @<> '' & DIMIX(cTPDim, pSourceStartPeriod) > 0);
  AttrPutS(pSourceStartPeriod, cNameDim, pCurveName, 'Source Start Period');
  AttrPutN(ATTRN(cTPDim, pSourceStartPeriod, 'Start_Date_Serial'), cNameDim, pCurveName, 'Source_Start_Period_Serial');
ENDIF;
IF(pSourceEndPeriod @<> '' & DIMIX(cTPDim, pSourceEndPeriod) > 0);
  AttrPutS(pSourceEndPeriod, cNameDim, pCurveName, 'Source End Period');
  AttrPutN(ATTRN(cTPDim, pSourceEndPeriod, 'End_Date_Serial'), cNameDim, pCurveName, 'Source_End_Period_Serial');
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | END ' | pCurveName);
ENDIF;

#endregion