#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-30
# LAST UPDATE: 2026-05-04
# CHANGED BY : Steve Waterbury
# CHANGE HISTORY:
#   2026-04-30 | Steve Waterbury | Initial commit
#   2026-04-30 | Steve Waterbury | Refactor v4 - stable Id attribute design
#   2026-05-04 | Steve Waterbury | Twin-dim move: sSKUDim -> '}Merch SKU Picklist'

sCat = pCategory;
nRunId = NUMBR(pRunId);

sCube = '}Merch Placeholder Picklist Index';
sHelperCube = '}Merch Placeholder Picklist';
sKeyDim = 'Placeholder Picklist Key';
sCatDim = 'Merch Category';
sVDim = 'Placeholder Vendor Values';
sL4Dim = 'Placeholder L4 Values';
sFDim = 'Placeholder Franchise Values';
sSKUDim = '}Merch SKU Picklist';

IF(sCat @= '');
  ProcessError;
ENDIF;
IF(DIMIX(sCatDim, sCat) = 0);
  ProcessError;
ENDIF;
IF(nRunId <= 0);
  ProcessError;
ENDIF;

OnMinorErrorDoItemSkip = 1;

IF(DIMIX(sKeyDim, 'Vendor') = 0);
  DimensionElementInsertDirect(sKeyDim, '', 'Vendor', 'S');
ENDIF;
IF(DIMIX(sKeyDim, 'L4') = 0);
  DimensionElementInsertDirect(sKeyDim, '', 'L4', 'S');
ENDIF;

nCatId = ATTRN(sCatDim, sCat, 'Id');
IF(nCatId = 0);
  nCatId = DIMIX(sCatDim, sCat);
  AttrPutN(nCatId, sCatDim, sCat, 'Id');
ENDIF;
sCatIdStr = TRIM(STR(nCatId, 12, 0));

sViewName = '}PLI_S_' | sCat;
IF(ViewExists(sCube, sViewName) = 1);
  ViewDestroy(sCube, sViewName);
ENDIF;
sMDX = 'SELECT {[Merch Category].[Merch Category].[' | sCat | ']} ON COLUMNS, ';
sMDX = sMDX | 'NON EMPTY {[Placeholder L4 Values].[Placeholder L4 Values].MEMBERS}';
sMDX = sMDX | ' * {[Placeholder Vendor Values].[Placeholder Vendor Values].MEMBERS}';
sMDX = sMDX | ' * {[Placeholder Franchise Values].[Placeholder Franchise Values].MEMBERS}';
sMDX = sMDX | ' * {TM1FILTERBYLEVEL([Merch SKU].[Merch SKU].MEMBERS, 0)} ON ROWS ';
sMDX = sMDX | 'FROM [' | sCube | ']';
ViewCreateByMDX(sCube, sViewName, sMDX, 1);
ViewExtractSkipZeroesSet(sCube, sViewName, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = sCube;
DatasourceCubeview = sViewName;

sVSubCat = 'PLI_V_C' | sCatIdStr;
sL4SubCat = 'PLI_L_C' | sCatIdStr;

nLast = CellGetN(sHelperCube, sCat, 'Vendor', 'BuildRunId');
IF(nLast <> nRunId);
  IF(SubsetExists(sVDim, sVSubCat) = 1);
    SubsetDestroy(sVDim, sVSubCat);
  ENDIF;
  SubsetCreate(sVDim, sVSubCat);
  IF(CellIsUpdateable(sHelperCube, sCat, 'Vendor', 'Options') = 1);
    CellPutS('subset:' | sVDim | ':' | sVSubCat, sHelperCube, sCat, 'Vendor', 'Options');
  ENDIF;
  IF(CellIsUpdateable(sHelperCube, sCat, 'Vendor', 'BuildRunId') = 1);
    CellPutN(nRunId, sHelperCube, sCat, 'Vendor', 'BuildRunId');
  ENDIF;
ENDIF;

nLast = CellGetN(sHelperCube, sCat, 'L4', 'BuildRunId');
IF(nLast <> nRunId);
  IF(SubsetExists(sL4Dim, sL4SubCat) = 1);
    SubsetDestroy(sL4Dim, sL4SubCat);
  ENDIF;
  SubsetCreate(sL4Dim, sL4SubCat);
  IF(CellIsUpdateable(sHelperCube, sCat, 'L4', 'Options') = 1);
    CellPutS('subset:' | sL4Dim | ':' | sL4SubCat, sHelperCube, sCat, 'L4', 'Options');
  ENDIF;
  IF(CellIsUpdateable(sHelperCube, sCat, 'L4', 'BuildRunId') = 1);
    CellPutN(nRunId, sHelperCube, sCat, 'L4', 'BuildRunId');
  ENDIF;
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vSKU @= '');
  ItemSkip;
ENDIF;

nL4Id = ATTRN(sL4Dim, vL4, 'Id');
IF(nL4Id = 0);
  nL4Id = DIMIX(sL4Dim, vL4);
  AttrPutN(nL4Id, sL4Dim, vL4, 'Id');
ENDIF;
sL4IdStr = TRIM(STR(nL4Id, 12, 0));

nVId = ATTRN(sVDim, vVendor, 'Id');
IF(nVId = 0);
  nVId = DIMIX(sVDim, vVendor);
  AttrPutN(nVId, sVDim, vVendor, 'Id');
ENDIF;
sVIdStr = TRIM(STR(nVId, 12, 0));

nFId = ATTRN(sFDim, vFranchise, 'Id');
IF(nFId = 0);
  nFId = DIMIX(sFDim, vFranchise);
  AttrPutN(nFId, sFDim, vFranchise, 'Id');
ENDIF;
sFIdStr = TRIM(STR(nFId, 12, 0));

IF(SubsetElementExists(sVDim, sVSubCat, vVendor) = 0);
  SubsetElementInsert(sVDim, sVSubCat, vVendor, 0);
ENDIF;
IF(SubsetElementExists(sL4Dim, sL4SubCat, vL4) = 0);
  SubsetElementInsert(sL4Dim, sL4SubCat, vL4, 0);
ENDIF;

sKey = 'L:' | vL4;
IF(DIMIX(sKeyDim, sKey) = 0);
  DimensionElementInsertDirect(sKeyDim, '', sKey, 'S');
ENDIF;
sSub = 'PLI_VbyL_C' | sCatIdStr | '~L' | sL4IdStr;
nLast = CellGetN(sHelperCube, sCat, sKey, 'BuildRunId');
IF(nLast <> nRunId);
  IF(SubsetExists(sVDim, sSub) = 1);
    SubsetDestroy(sVDim, sSub);
  ENDIF;
  SubsetCreate(sVDim, sSub);
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'Options') = 1);
    CellPutS('subset:' | sVDim | ':' | sSub, sHelperCube, sCat, sKey, 'Options');
  ENDIF;
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'BuildRunId') = 1);
    CellPutN(nRunId, sHelperCube, sCat, sKey, 'BuildRunId');
  ENDIF;
ENDIF;
IF(SubsetElementExists(sVDim, sSub, vVendor) = 0);
  SubsetElementInsert(sVDim, sSub, vVendor, 0);
ENDIF;

sKey = 'S:' | vVendor;
IF(DIMIX(sKeyDim, sKey) = 0);
  DimensionElementInsertDirect(sKeyDim, '', sKey, 'S');
ENDIF;
sSub = 'PLI_SbyV_C' | sCatIdStr | '~V' | sVIdStr;
nLast = CellGetN(sHelperCube, sCat, sKey, 'BuildRunId');
IF(nLast <> nRunId);
  IF(SubsetExists(sSKUDim, sSub) = 1);
    SubsetDestroy(sSKUDim, sSub);
  ENDIF;
  SubsetCreate(sSKUDim, sSub);
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'Options') = 1);
    CellPutS('subset:' | sSKUDim | ':' | sSub, sHelperCube, sCat, sKey, 'Options');
  ENDIF;
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'BuildRunId') = 1);
    CellPutN(nRunId, sHelperCube, sCat, sKey, 'BuildRunId');
  ENDIF;
ENDIF;
IF(SubsetElementExists(sSKUDim, sSub, vSKU) = 0);
  SubsetElementInsert(sSKUDim, sSub, vSKU, 0);
ENDIF;

sKey = 'V:' | vVendor | '|L:' | vL4;
IF(DIMIX(sKeyDim, sKey) = 0);
  DimensionElementInsertDirect(sKeyDim, '', sKey, 'S');
ENDIF;
sSub = 'PLI_FbyVL_C' | sCatIdStr | '~V' | sVIdStr | '~L' | sL4IdStr;
nLast = CellGetN(sHelperCube, sCat, sKey, 'BuildRunId');
IF(nLast <> nRunId);
  IF(SubsetExists(sFDim, sSub) = 1);
    SubsetDestroy(sFDim, sSub);
  ENDIF;
  SubsetCreate(sFDim, sSub);
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'Options') = 1);
    CellPutS('subset:' | sFDim | ':' | sSub, sHelperCube, sCat, sKey, 'Options');
  ENDIF;
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'BuildRunId') = 1);
    CellPutN(nRunId, sHelperCube, sCat, sKey, 'BuildRunId');
  ENDIF;
ENDIF;
IF(SubsetElementExists(sFDim, sSub, vFranchise) = 0);
  SubsetElementInsert(sFDim, sSub, vFranchise, 0);
ENDIF;

sKey = 'F:' | vFranchise | '|V:' | vVendor | '|L:' | vL4;
IF(DIMIX(sKeyDim, sKey) = 0);
  DimensionElementInsertDirect(sKeyDim, '', sKey, 'S');
ENDIF;
sSub = 'PLI_SbyFVL_C' | sCatIdStr | '~F' | sFIdStr | '~V' | sVIdStr | '~L' | sL4IdStr;
nLast = CellGetN(sHelperCube, sCat, sKey, 'BuildRunId');
IF(nLast <> nRunId);
  IF(SubsetExists(sSKUDim, sSub) = 1);
    SubsetDestroy(sSKUDim, sSub);
  ENDIF;
  SubsetCreate(sSKUDim, sSub);
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'Options') = 1);
    CellPutS('subset:' | sSKUDim | ':' | sSub, sHelperCube, sCat, sKey, 'Options');
  ENDIF;
  IF(CellIsUpdateable(sHelperCube, sCat, sKey, 'BuildRunId') = 1);
    CellPutN(nRunId, sHelperCube, sCat, sKey, 'BuildRunId');
  ENDIF;
ENDIF;
IF(SubsetElementExists(sSKUDim, sSub, vSKU) = 0);
  SubsetElementInsert(sSKUDim, sSub, vSKU, 0);
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
sViewCleanup = '}PLI_S_' | pCategory;
IF(ViewExists('}Merch Placeholder Picklist Index', sViewCleanup) = 1);
  ViewDestroy('}Merch Placeholder Picklist Index', sViewCleanup);
ENDIF;

#endregion