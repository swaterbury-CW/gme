#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#==========================================================================
# PROCESS:     API.BigQuery.Insert.Extract.MerchForecast
# DEVELOPER:   Steve Waterbury
# CREATED ON:  2026-05-07
# LAST UPDATE: 2026-05-07
# CHANGED BY:  Steve Waterbury
# PURPOSE:     Extract a Merch Forecast cube view to a JSONL file (one BQ
#              insertAll row per line). Consumed by API.BigQuery.Insert.
# CHANGE HISTORY:
#   2026-05-07 | Steve Waterbury | Initial creation. Reverse of API.BigQuery.Export.
#
# PARAMETERS:
#   pView        - Cube view name on Merch Forecast.
#   pOutputFile  - JSONL output path, e.g. './merch_forecast_bq.jsonl'.
#==========================================================================

DatasourceType = 'VIEW';
DatasourceNameForServer = 'Merch Forecast';

sProcess = GetProcessName();
sLogLevel = CellGetS('ProcessControl', sProcess, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pView @= '');
  LogOutput('ERROR', sProcess | ' | pView is empty.');
  ProcessError;
ENDIF;
IF(pOutputFile @= '');
  LogOutput('ERROR', sProcess | ' | pOutputFile is empty.');
  ProcessError;
ENDIF;

DatasourceCubeview = pView;
nRows = 0;

IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | START | view=' | pView | ' | output=' | pOutputFile);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(DType('Merch Forecast Measure', vMeasure) @= 'S');
  ItemSkip;
ENDIF;

nVal = CellGetN('Merch Forecast', vVersion, vTimePeriod, vSKU, vMeasure);

sRow = '{"insertId":' | StringToJson(sProcess | ':' | TRIM(STR(nRows, 10, 0)))
     | ',"json":{"merch_version":' | StringToJson(vVersion)
     | ',"merch_time_period":' | StringToJson(vTimePeriod)
     | ',"merch_sku":' | StringToJson(vSKU)
     | ',"merch_forecast_measure":' | StringToJson(vMeasure)
     | ',"value":' | TRIM(STR(nVal, 25, 6))
     | '}}';

ASCIIOutput(pOutputFile, sRow);
nRows = nRows + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(CellIsUpdateable('ProcessControl', sProcess, 'SubsetCount') = 1);
  CellPutN(nRows, 'ProcessControl', sProcess, 'SubsetCount');
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', sProcess | ' | END | rows=' | TRIM(STR(nRows, 10, 0)) | ' | output=' | pOutputFile);
ENDIF;

#endregion