#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON: 2026-05-07
# LAST UPDATE: 2026-05-07
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Maintain alternate hierarchy 'Budget Rollup' on Merch Version. Per leaf
# version, group it under 'Budget Rollup - <Budget_Version>' if attr non-empty.
# Idempotent: destroys + recreates the alt hierarchy on every run.
# Iteration uses SUBSET datasource (TM1DimensionSubset) per v12 SaaS guardrails;
# per-element insert/link work lives in the Metadata tab.
# *Direct functions used intentionally for in-process structural rebuild — this
# process holds the alt hierarchy under exclusive control end-to-end (HierarchyDestroy
# then HierarchyCreate at start) so transactional non-Direct semantics are not needed.
# CHANGE HISTORY:
#   2026-05-07 | Steve Waterbury | Initial creation (verified via _temp EP1 v2 plan 3207fd8a5772)
#EndRegion

#Region : Constants
cDim      = 'Merch Version';
cHier     = 'Budget Rollup';
cAttr     = 'Budget_Version';
cRoot     = 'Budget Rollup';
cPrefix   = 'Budget Rollup - ';
cProcName = GetProcessName();
cSubset   = 'TI_RBR_Leaves_' | TRIM(STR(NOW, 15, 0));
nGroups   = 0;
nLeaves   = 0;
nSkipped  = 0;
#EndRegion

#Region : Logging Configuration
sLogLevel = CellGetS('ProcessControl', cProcName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcName);
ENDIF;
#EndRegion

#Region : Validate dimension
IF(DimensionExists(cDim) = 0);
  LogOutput('ERROR', cProcName | ' | Dimension not found: ' | cDim);
  ProcessError;
ENDIF;
#EndRegion

#Region : Destroy + recreate alt hierarchy
IF(HierarchyExists(cDim, cHier) = 1);
  IF(bLogInfo = 1);
    LogOutput('INFO', cProcName | ' | Destroying existing hierarchy: ' | cHier);
  ENDIF;
  HierarchyDestroy(cDim, cHier);
ENDIF;
HierarchyCreate(cDim, cHier);
HierarchyElementInsertDirect(cDim, cHier, '', cRoot, 'C');
#EndRegion

#Region : Build leaf-only subset for Metadata-tab iteration
IF(SubsetExists(cDim, cSubset) = 1);
  SubsetDestroy(cDim, cSubset);
ENDIF;
SubsetCreateByMDX(cSubset, '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Version].[Merch Version])}, 0)}', cDim, 0);

DatasourceType            = 'SUBSET';
DatasourceNameForServer   = cDim;
DatasourceDimensionSubset = cSubset;
#EndRegion

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Per-leaf rebuild (V1 auto-bound to element name from subset)
sElem = V1;
sBudget = ATTRS(cDim, sElem, cAttr);
IF(sBudget @= '');
  nSkipped = nSkipped + 1;
ELSE;
  sParent = cPrefix | sBudget;
  IF(HierarchyElementExists(cDim, cHier, sParent) = 0);
    HierarchyElementInsertDirect(cDim, cHier, '', sParent, 'C');
    HierarchyElementComponentAddDirect(cDim, cHier, cRoot, sParent, 1);
    nGroups = nGroups + 1;
  ENDIF;
  IF(HierarchyElementExists(cDim, cHier, sElem) = 0);
    HierarchyElementInsertDirect(cDim, cHier, '', sElem, 'N');
  ENDIF;
  HierarchyElementComponentAddDirect(cDim, cHier, sParent, sElem, 1);
  nLeaves = nLeaves + 1;
ENDIF;
#EndRegion

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(SubsetExists(cDim, cSubset) = 1);
  SubsetDestroy(cDim, cSubset);
ENDIF;
LogOutput('INFO', 'END: ' | cProcName | ' | Groups=' | TRIM(STR(nGroups, 5, 0)) | ' Leaves=' | TRIM(STR(nLeaves, 5, 0)) | ' Skipped=' | TRIM(STR(nSkipped, 5, 0)));
CubeProcessFeeders( 'Merch Forecast' );
CubeProcessFeeders( 'Merch Plan Reporting' );


#endregion