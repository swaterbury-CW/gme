#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-06-24
# LAST UPDATE: 2026-06-24
# CHANGED BY : Steve Waterbury
# COMMENTS: Per-week worker for week-parallel ActualsToPlanReporting. Receives clear+load MDX prebuilt by
#  the orchestrator (pClearMDX/pLoadMDX) so NO per-worker measure iteration or shared-dim subset creation
#  (kills parallel metadata-lock contention). Falls back to self-building from pTimePeriod. Clear is
#  MDX-based (ViewCreateByMDX + ViewZeroOut, NO subsets) in both paths. pPartIdx uniquifies view names.
#### CHANGE HISTORY:
###   2026-06-24 | Steve Waterbury | Initial week-parallel worker. Plan bb17626fc2af.
###   2026-06-24 | Steve Waterbury | Subset-free: accept orchestrator-prebuilt MDX; MDX-based clear (no subsets). Plan 2ad6c3e4230e.
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;

nPartIdx = pPartIdx;
IF(nPartIdx <= 0); nPartIdx = 1; ENDIF;
sSfx = TRIM(STR(nPartIdx, 15, 0));

cSrcCube = 'Merch Actuals';
cDstCube = 'Merch Plan Reporting';
cVersion = 'Actual';
cMeasDim = 'Merch Actuals Measure';
cTgtMeasDim = 'Merch Plan Reporting Measure';
cLifecycleDim = 'Merch Lifecycle';
cSKUDim = 'Merch SKU';
cDefaultLifecycle = 'Active';
cMapAttribute = 'Forecast Measure Map';
cLifecycleAttr = 'Lifecycle_Status_Description';
nCellsWritten = 0;
nSkipped = 0;
nRecordCount = 0;

sClrMDX = pClearMDX;
sLoadMDX = pLoadMDX;

# Fallback: orchestrator did not pass prebuilt MDX -> self-build from pTimePeriod (still NO subsets).
IF(sLoadMDX @= '');
  IF(pTimePeriod @= '');
    LogOutput('ERROR', cProcessName | ' | need pLoadMDX or pTimePeriod', 1);
    ProcessError;
  ENDIF;
  IF(DIMIX('Merch Time Period', pTimePeriod) = 0);
    LogOutput('ERROR', cProcessName | ' | Time period not found: ' | pTimePeriod, 1);
    ProcessError;
  ENDIF;
  sMeMembers = '';
  nAMsz = DIMSIZ(cMeasDim);
  iAM = 1;
  WHILE(iAM <= nAMsz);
    sAMe = DIMNM(cMeasDim, iAM);
    IF(ELLEV(cMeasDim, sAMe) = 0);
      sTgt = ATTRS(cMeasDim, sAMe, cMapAttribute);
      IF(sTgt @<> '' & DIMIX(cTgtMeasDim, sTgt) > 0);
        sMbr = '[' | cTgtMeasDim | '].[' | cTgtMeasDim | '].[' | sTgt | ']';
        IF(SCAN(sMbr, sMeMembers) = 0);
          IF(sMeMembers @= ''); sMeMembers = sMbr; ELSE; sMeMembers = sMeMembers | ',' | sMbr; ENDIF;
        ENDIF;
      ENDIF;
    ENDIF;
    iAM = iAM + 1;
  END;
  IF(sMeMembers @<> '');
    sClrMDX = 'SELECT {' | sMeMembers | '} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}, CROSSJOIN({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel].[Merch Channel])}, 0)}, {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Lifecycle].[Merch Lifecycle])}, 0)})) ON ROWS FROM [Merch Plan Reporting] WHERE ([Merch Version].[Merch Version].[' | cVersion | '], [Merch Time Period].[Merch Time Period].[' | pTimePeriod | '])';
  ENDIF;
  sLoadMDX = 'SELECT {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Actuals Measure])}, 0)} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({DESCENDANTS([Merch Time Period].[' | pTimePeriod | '])}, 0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} * {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Channel])}, 0)} ON ROWS FROM [Merch Actuals]';
ENDIF;

# Clear-before-load (MDX-based, NO subsets) - zeroes this week's Actual footprint over mapped measures.
IF(sClrMDX @<> '');
  sClrV = 'TI_ATPRwk_clr_' | sSfx;
  IF(ViewExists(cDstCube, sClrV) = 1); ViewDestroy(cDstCube, sClrV); ENDIF;
  ViewCreateByMDX(cDstCube, sClrV, sClrMDX, 1);
  ViewExtractSkipCalcsSet(cDstCube, sClrV, 1);
  ViewExtractSkipZeroesSet(cDstCube, sClrV, 1);
  ViewZeroOut(cDstCube, sClrV);
  IF(ViewExists(cDstCube, sClrV) = 1); ViewDestroy(cDstCube, sClrV); ENDIF;
ENDIF;

# Load view from (passed or built) MDX.
sView = 'TI_ATPRwk_' | sSfx;
IF(ViewExists(cSrcCube, sView) = 1); ViewDestroy(cSrcCube, sView); ENDIF;
ViewCreateByMDX(cSrcCube, sView, sLoadMDX, 1);
ViewExtractSkipCalcsSet(cSrcCube, sView, 0);
ViewExtractSkipZeroesSet(cSrcCube, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cSrcCube;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nRecordCount = nRecordCount + 1;

sMeasure = ATTRS(cMeasDim, vMerch_Actuals_Measure, cMapAttribute);
IF(sMeasure @= '');
  ItemSkip;
ENDIF;
IF(DIMIX(cTgtMeasDim, sMeasure) = 0);
  ItemReject('Mapped measure not in target dim: ' | sMeasure);
ENDIF;

sLifecycle = ATTRS(cSKUDim, vMerch_SKU, cLifecycleAttr);
IF(sLifecycle @= '');
  sLifecycle = cDefaultLifecycle;
ENDIF;
IF(DIMIX(cLifecycleDim, sLifecycle) = 0);
  sLifecycle = cDefaultLifecycle;
ENDIF;
IF(DTYPE(cLifecycleDim, sLifecycle) @<> 'N');
  sLifecycle = cDefaultLifecycle;
ENDIF;

nVal = Value;
IF(nVal = 0);
  ItemSkip;
ENDIF;

IF(CellIsUpdateable(cDstCube, cVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Channel, sLifecycle, sMeasure) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;

CellPutN(nVal, cDstCube, cVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Channel, sLifecycle, sMeasure);
nCellsWritten = nCellsWritten + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cSrcCube, sView) = 1);
  ViewDestroy(cSrcCube, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END.Week: ' | cProcessName | ' | Part=' | sSfx | ' | Records=' | TRIM(STR(nRecordCount, 10, 0)) | ' | Written=' | TRIM(STR(nCellsWritten, 10, 0)) | ' | Skipped=' | TRIM(STR(nSkipped, 10, 0)), 1);
ENDIF;

#endregion