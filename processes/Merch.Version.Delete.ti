#region Prolog

#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-22
# LAST UPDATE: 2026-04-01
# COMMENTS:
# Merch.Version.Delete — Removes a version element and all its data.
# Cannot delete the Actual version.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-03-22         Steve Waterbury    Creation
### 2026-04-01         Steve Waterbury    Applied guardrails header template
### 2026-04-01         Steve Waterbury    Added ProcessControl logging init
### 2026-04-01         Steve Waterbury    Code formatting: multi-line logging init
#
#EndRegion

cProcessName = GetProcessName();

#Region : Logging Init
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
#EndRegion

#Region : Validation
IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion is empty');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion);
  ProcessError;
ENDIF;
IF(ATTRS('Merch Version', pVersion, 'Version_Type') @= 'Actual');
  LogOutput('ERROR', cProcessName | ' | Cannot delete the Actual version');
  ProcessError;
ENDIF;
#EndRegion

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Deleting version ' | pVersion);
ENDIF;

### Delete the element — TM1 automatically clears all associated cube data
DimensionElementDeleteDirect('Merch Version', pVersion);

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Version=' | pVersion | ' deleted');
ENDIF;

#endregion