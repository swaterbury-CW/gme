#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-06-03
# LAST UPDATE: 2026-06-03
# CHANGED BY : Steve Waterbury
# COMMENTS: Clears Merch Forecast Receipts scoped by version, Roles node, and period range. Forecast weeks only — never clears closed/actual periods. PAW-invokable. Companion to Merch.Calc.SeedReceiptsByTargetWOS.
# CHANGE HISTORY:
#   2026-06-03 | Steve Waterbury | Initial (plan 0d18472d8377)
#   2026-06-03 | Steve Waterbury | Forecast-only floor: clamp start to first open week (LCP+7); closed/actual periods never cleared (plan 34e7c8176a08).
#EndRegion

cCubeForecast = 'Merch Forecast';
cDimVersion   = 'Merch Version';
cDimSKU       = 'Merch SKU';
cDimTP        = 'Merch Time Period';
cHierRoles    = 'Roles';
cAttrLCP      = 'Last_Closed_Period';
cAttrStart    = 'Start_Date';
cMeasReceipts = 'Receipts';

cProcessName = GetProcessName();
bLogInfo = 0;
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX(cDimVersion, pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version missing: ' | pVersion);
  ProcessError;
ENDIF;

IF(pNode @<> '');
  IF(HierarchyElementExists(cDimSKU, cHierRoles, pNode) = 0);
    LogOutput('ERROR', cProcessName | ' | pNode not in Roles hier: ' | pNode);
    ProcessError;
  ENDIF;
  sNodeSet = 'TM1FILTERBYLEVEL({DESCENDANTS([Merch SKU].[Roles].[' | pNode | '])},0)';
ELSE;
  sNodeSet = 'TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Roles])},0)';
ENDIF;

# Forecast-only floor: first open week Start_Date = LCP+7. Closed/actual weeks (Start_Date <= LCP) are never cleared.
nLCP = ATTRN(cDimVersion, pVersion, cAttrLCP);
IF(nLCP > 0);
  nFloorSerial = nLCP + 7;
ELSE;
  nFloorSerial = 0;
ENDIF;

IF(pStartPeriod @<> '');
  IF(DIMIX(cDimTP, pStartPeriod) = 0);
    LogOutput('ERROR', cProcessName | ' | pStartPeriod not a period: ' | pStartPeriod);
    ProcessError;
  ENDIF;
  nStartSerial = ATTRN(cDimTP, pStartPeriod, cAttrStart);
  IF(nStartSerial = 0);
    LogOutput('ERROR', cProcessName | ' | pStartPeriod has no Start_Date: ' | pStartPeriod);
    ProcessError;
  ENDIF;
ELSE;
  IF(nLCP = 0);
    LogOutput('ERROR', cProcessName | ' | Last_Closed_Period not set; pStartPeriod required');
    ProcessError;
  ENDIF;
  nStartSerial = nFloorSerial;
ENDIF;

IF(pEndPeriod @<> '');
  IF(DIMIX(cDimTP, pEndPeriod) = 0);
    LogOutput('ERROR', cProcessName | ' | pEndPeriod not a period: ' | pEndPeriod);
    ProcessError;
  ENDIF;
  nEndSerial = ATTRN(cDimTP, pEndPeriod, cAttrStart);
  IF(nEndSerial = 0);
    LogOutput('ERROR', cProcessName | ' | pEndPeriod has no Start_Date: ' | pEndPeriod);
    ProcessError;
  ENDIF;
ELSE;
  nEndSerial = 99999999;
ENDIF;

IF(nStartSerial > nEndSerial);
  LogOutput('ERROR', cProcessName | ' | pStartPeriod after pEndPeriod');
  ProcessError;
ENDIF;

# Apply forecast-only floor AFTER the ordering check: a closed-period start is raised to the first open week.
IF(nStartSerial < nFloorSerial);
  nStartSerial = nFloorSerial;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | Node=' | pNode | ' | StartSerial=' | TRIM(STR(nStartSerial,15,0)) | ' | EndSerial=' | TRIM(STR(nEndSerial,15,0)) | ' | Floor=' | TRIM(STR(nFloorSerial,15,0)));
ENDIF;

sViewName = 'TI_ClearReceipts';
IF(ViewExists(cCubeForecast, sViewName) = 1);
  ViewDestroy(cCubeForecast, sViewName);
ENDIF;
sMdx = 'SELECT {[Merch Forecast Measure].[Merch Forecast Measure].[Receipts]} ON COLUMNS, NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period].[Merch Time Period])},0)} * {' | sNodeSet | '} ON ROWS FROM [Merch Forecast] WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
ViewCreateByMDX(cCubeForecast, sViewName, sMdx, 1);
ViewExtractSkipCalcsSet(cCubeForecast, sViewName, 0);
ViewExtractSkipZeroesSet(cCubeForecast, sViewName, 1);
ViewSuppressZeroesSet(cCubeForecast, sViewName, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = cCubeForecast;
DatasourceCubeview = sViewName;

nCleared = 0;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sTP  = vMerch_Time_Period;
sSKU = vMerch_SKU;

nDate = ATTRN(cDimTP, sTP, cAttrStart);
IF(nDate < nStartSerial % nDate > nEndSerial);
  ItemSkip;
ENDIF;

IF(CellIsUpdateable(cCubeForecast, pVersion, sTP, sSKU, cMeasReceipts) = 0);
  ItemSkip;
ENDIF;

CellPutN(0, cCubeForecast, pVersion, sTP, sSKU, cMeasReceipts);
nCleared = nCleared + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cCubeForecast, sViewName) = 1);
  ViewDestroy(cCubeForecast, sViewName);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Cleared=' | TRIM(STR(nCleared, 10, 0)));
ENDIF;

#endregion