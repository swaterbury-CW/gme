#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER:    Steve Waterbury
# CREATED ON:   2026-05-04
# LAST UPDATE:  2026-05-04
# CHANGED BY:   Steve Waterbury
# COMMENTS: Sync flat leaves of Merch SKU into control twin }Merch SKU Picklist.
#   Datasource: TM1DimensionSubset on Merch SKU (dynamic leaves subset).
#   Data tab: idempotent DimensionElementInsertDirect on twin dim.
#   Epilog: sweep twin dim, drop any element no longer present in Merch SKU.
#   Called at end of Merch.Dim.LoadSKUHierarchy.BQ.
#   *Direct variants used intentionally - bulk-load context inside dedicated
#   sync process; no concurrent writers, exclusive on twin dim.
# CHANGE HISTORY:
#   2026-05-04 | Steve Waterbury | Initial creation
#EndRegion

#Region : Logging
cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'INFO';
ENDIF;
bLogInfo = 0;
bLogDebug = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | START');
ENDIF;
#EndRegion

#Region : Constants and validation
cSrcDim = 'Merch SKU';
cTgtDim = '}Merch SKU Picklist';
cIterSub = 'MSP_Sync_Run_' | TRIM(STR(INT(NOW * 86400), 15, 0));

IF(DimensionExists(cTgtDim) = 0);
  LogOutput('ERROR', cProcessName | ' | target dim does not exist: ' | cTgtDim);
  ProcessError;
ENDIF;
#EndRegion

#Region : Build dynamic iteration subset of Merch SKU leaves
IF(SubsetExists(cSrcDim, cIterSub) = 1);
  SubsetDestroy(cSrcDim, cIterSub);
ENDIF;
SubsetCreatebyMDX(cIterSub, '{TM1FILTERBYLEVEL([Merch SKU].[Merch SKU].MEMBERS, 0)}');

DatasourceType = 'SUBSET';
DatasourceNameForServer = cSrcDim;
DatasourceDimensionSubset = cIterSub;
#EndRegion

#Region : Counters
nInserted = 0;
nDeleted = 0;
#EndRegion

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sSKU = vMerch_SKU;
IF(sSKU @= '');
  ItemSkip;
ENDIF;
IF(DIMIX(cTgtDim, sSKU) = 0);
  DimensionElementInsertDirect(cTgtDim, '', sSKU, 'N');
  nInserted = nInserted + 1;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Destroy iter subset on source
IF(SubsetExists(cSrcDim, cIterSub) = 1);
  SubsetDestroy(cSrcDim, cIterSub);
ENDIF;
#EndRegion

#Region : Sweep target dim - delete elements no longer in Merch SKU
nTgtSize = DIMSIZ(cTgtDim);
nIdx = nTgtSize;
WHILE(nIdx >= 1);
  sEl = DIMNM(cTgtDim, nIdx);
  IF(DIMIX(cSrcDim, sEl) = 0);
    DimensionElementDeleteDirect(cTgtDim, sEl);
    nDeleted = nDeleted + 1;
  ENDIF;
  nIdx = nIdx - 1;
END;
#EndRegion

#Region : Record final count for verification
nFinalCount = DIMSIZ(cTgtDim);
IF(CellIsUpdateable('ProcessControl', cProcessName, 'SubsetCount') = 1);
  CellPutN(nFinalCount, 'ProcessControl', cProcessName, 'SubsetCount');
ENDIF;
#EndRegion

#Region : Epilog logging
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | END | inserted=' | TRIM(STR(nInserted, 10, 0)) | ' | deleted=' | TRIM(STR(nDeleted, 10, 0)) | ' | total=' | TRIM(STR(nFinalCount, 10, 0)));
ENDIF;
#EndRegion

#endregion