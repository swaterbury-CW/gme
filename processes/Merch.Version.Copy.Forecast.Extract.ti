#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-14
# CHANGED BY: Steve Waterbury
# CHANGE HISTORY:
#   2026-05-14 | Steve Waterbury | Initial (DESCENDANTS for TP)
#EndRegion

cProcessName = GetProcessName();
nRowsWritten = 0;
nCalcUnitsSum = 0;

IF(pSourceVersion @= '' % pCategory @= '' % pFiscalYear @= '' % pBatchTag @= '');
  LogOutput('ERROR', cProcessName | ' | missing param');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pSourceVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | bad source version');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Category', pCategory) = 0);
  LogOutput('ERROR', cProcessName | ' | bad category');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Time Period', pFiscalYear) = 0);
  LogOutput('ERROR', cProcessName | ' | bad fiscal year');
  ProcessError;
ENDIF;

sCatSafe = pCategory;
nPos = SCAN(' ', sCatSafe);
WHILE(nPos > 0);
  sCatSafe = SUBST(sCatSafe, 1, nPos - 1) | '_' | SUBST(sCatSafe, nPos + 1, LONG(sCatSafe) - nPos);
  nPos = SCAN(' ', sCatSafe);
END;
nPos = SCAN('/', sCatSafe);
WHILE(nPos > 0);
  sCatSafe = SUBST(sCatSafe, 1, nPos - 1) | '-' | SUBST(sCatSafe, nPos + 1, LONG(sCatSafe) - nPos);
  nPos = SCAN('/', sCatSafe);
END;

sFile = './version_copy/' | pBatchTag | '_' | pSourceVersion | '_' | sCatSafe | '_' | pFiscalYear | '.csv';
sView = 'TI_ForecastExtract_' | TRIM(STR(NOW, 15, 0));

sMDX = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Forecast Measure].[Merch Forecast Measure])}, 0)} ON COLUMNS, '
     | 'NON EMPTY CROSSJOIN('
     | '{DESCENDANTS([Merch Time Period].[Merch Time Period].[' | pFiscalYear | '], , LEAVES)}, '
     | '{FILTER({TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}, '
     | '[Merch SKU].[Merch SKU].CurrentMember.Properties(' | CHAR(34) | 'SGM_Category' | CHAR(34) | ')=' | CHAR(34) | pCategory | CHAR(34) | ')}'
     | ') ON ROWS '
     | 'FROM [Merch Forecast] '
     | 'WHERE ([Merch Version].[Merch Version].[' | pSourceVersion | '])';

IF(ViewExists('Merch Forecast', sView) = 1);
  ViewDestroy('Merch Forecast', sView);
ENDIF;
ViewCreateByMDX('Merch Forecast', sView, sMDX, 1);
ViewExtractSkipCalcsSet('Merch Forecast', sView, 1);
ViewExtractSkipZeroesSet('Merch Forecast', sView, 1);

DatasourceType = 'VIEW';
DatasourceNameForServer = 'Merch Forecast';
DatasourceCubeview = sView;
DatasourceASCIIDelimiter = ',';
DatasourceASCIIQuoteCharacter = '"';

nStart = NOW;
LogOutput('INFO', 'TIMING START: ' | cProcessName | ' | Src=' | pSourceVersion | ' | Cat=' | pCategory | ' | FY=' | pFiscalYear);

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
sMeasType = DTYPE('Merch Forecast Measure', vMerch_Forecast_Measure);

IF(sMeasType @= 'S');
  sVal = CellGetS('Merch Forecast', pSourceVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure);
  IF(sVal @= '');
    ItemSkip;
  ENDIF;
  ASCIIOutput(sFile, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure, sVal, 'S');
  nRowsWritten = nRowsWritten + 1;
  ItemSkip;
ENDIF;

IF(sMeasType @<> 'N');
  ItemSkip;
ENDIF;

nVal = CellGetN('Merch Forecast', pSourceVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure);
IF(nVal = 0);
  ItemSkip;
ENDIF;

IF(vMerch_Forecast_Measure @= 'Calc Units');
  nCalcUnitsSum = nCalcUnitsSum + nVal;
ENDIF;

ASCIIOutput(sFile, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure, TRIM(STR(nVal, 25, 6)), 'N');
nRowsWritten = nRowsWritten + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists('Merch Forecast', sView) = 1);
  ViewDestroy('Merch Forecast', sView);
ENDIF;

IF(CellIsUpdateable('ProcessControl', cProcessName, 'SubsetCount') = 0);
  LogOutput('ERROR', cProcessName | ' | ProcessControl.SubsetCount not updateable');
ELSE;
  CellPutN(nCalcUnitsSum, 'ProcessControl', cProcessName, 'SubsetCount');
ENDIF;

LogOutput('INFO', 'TIMING END: ' | cProcessName | ' | Rows=' | TRIM(STR(nRowsWritten, 12, 0)) | ' | Sum=' | TRIM(STR(nCalcUnitsSum, 25, 2)) | ' | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's');

#endregion