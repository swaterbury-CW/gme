#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-24
# LAST UPDATE: 2026-04-01
# COMMENTS:
# Closes the next open period by copying the Forecast vs Actual
# BD transition ratio into regular Build/Debuild, then advancing
# the Last Closed Period serial.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-03-24         Steve Waterbury    Initial creation for GME-Dev (v12 SaaS)
### 2026-03-31         Steve Waterbury    Start_Date_Serial -> Start_Date; Last_Closed_Period_Serial -> Last_Closed_Period
### 2026-04-01         Steve Waterbury    Applied guardrails header template
#
#EndRegion

cProcessName = GetProcessName();

### -- Standard logging init from ProcessControl --
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
    sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
    bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
    bLogDebug = 1;
ENDIF;

IF(bLogInfo = 1);
    LogOutput('INFO', 'START: ' | cProcessName | ' | pVersion=' | pVersion | ' | pTargetPeriod=' | pTargetPeriod);
ENDIF;

### -- Initialize counters --
nSKUsTransitioned = 0;
nFeedWrites = 0;
nErrors = 0;

### -- Validate pVersion --
IF(DIMIX('Merch Version', pVersion) = 0);
    LogOutput('ERROR', cProcessName | ' | pVersion "' | pVersion | '" not found in Merch Version dimension.');
    ProcessQuit;
ENDIF;

sVersionType = ATTRS('Merch Version', pVersion, 'Version_Type');
IF(sVersionType @<> 'Calculated');
    LogOutput('ERROR', cProcessName | ' | pVersion "' | pVersion | '" has Version_Type="' | sVersionType | '", expected "Calculated".');
    ProcessQuit;
ENDIF;

### -- Validate pTargetPeriod --
IF(pTargetPeriod @= '');
    LogOutput('ERROR', cProcessName | ' | pTargetPeriod is blank. Provide a valid week element.');
    ProcessQuit;
ENDIF;

IF(DIMIX('Merch Time Period', pTargetPeriod) = 0);
    LogOutput('ERROR', cProcessName | ' | pTargetPeriod "' | pTargetPeriod | '" not found in Merch Time Period dimension.');
    ProcessQuit;
ENDIF;

IF(DTYPE('Merch Time Period', pTargetPeriod) @<> 'N');
    LogOutput('ERROR', cProcessName | ' | pTargetPeriod "' | pTargetPeriod | '" is not a leaf (N-type) element.');
    ProcessQuit;
ENDIF;

### -- Validate pTargetPeriod is the first open week --
nLastClosedSerial = ATTRN('Merch Version', pVersion, 'Last_Closed_Period');
nTargetStartSerial = ATTRN('Merch Time Period', pTargetPeriod, 'Start_Date');

IF(nLastClosedSerial = 0);
    ### No periods closed yet
    IF(bLogDebug = 1);
        LogOutput('DEBUG', cProcessName | ' | No periods closed yet. Closing first period: ' | pTargetPeriod);
    ENDIF;
ELSE;
    sPrevWeekCheck = ATTRS('Merch Time Period', pTargetPeriod, 'Previous Week');
    IF(sPrevWeekCheck @= '');
        LogOutput('ERROR', cProcessName | ' | pTargetPeriod "' | pTargetPeriod | '" has no Previous Week attribute. Cannot validate sequence.');
        ProcessQuit;
    ENDIF;
    nPrevStartSerial = ATTRN('Merch Time Period', sPrevWeekCheck, 'Start_Date');
    IF(nPrevStartSerial > nLastClosedSerial);
        LogOutput('ERROR', cProcessName | ' | pTargetPeriod "' | pTargetPeriod | '" is not the next open week. Previous week "' | sPrevWeekCheck | '" (serial=' | TRIM(STR(nPrevStartSerial, 15, 0)) | ') > Last_Closed_Period (' | TRIM(STR(nLastClosedSerial, 15, 0)) | ').');
        ProcessQuit;
    ENDIF;
ENDIF;

### -- Get Previous Week for datasource view --
sPrevWeek = ATTRS('Merch Time Period', pTargetPeriod, 'Previous Week');

### -- Build datasource view --
sView = 'TI_PeriodClose_' | TRIM(STR(NOW, 15, 0));

sMDX = 'SELECT {[Merch Forecast Measure].[Units]} ON COLUMNS, '
     | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU])}, 0)} ON ROWS '
     | 'FROM [Merch Forecast] WHERE ([Merch Version].[Actual], [Merch Time Period].[' | sPrevWeek | '])';

ViewCreate('Merch Forecast', sView, 0);
ViewMDXSet('Merch Forecast', sView, sMDX);

DatasourceType = 'VIEW';
DatasourceNameForServer = 'Merch Forecast';
DatasourceCubeview = sView;

IF(bLogDebug = 1);
    LogOutput('DEBUG', cProcessName | ' | View=' | sView | ' | PrevWeek=' | sPrevWeek);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data

#****Begin: Generated Statements***
#****End: Generated Statements****
### -- Data Tab: Copy transition BD for each SKU with actual units --

nTransitionBD = CellGetN('Merch Forecast', pVersion, pTargetPeriod, vSKU, 'Forecast vs Actual BD');

IF(nTransitionBD <> 0);
    IF(CellIsUpdateable('Merch Forecast', pVersion, pTargetPeriod, vSKU, 'Build/Debuild') = 1);
        CellPutN(nTransitionBD, 'Merch Forecast', pVersion, pTargetPeriod, vSKU, 'Build/Debuild');
        nSKUsTransitioned = nSKUsTransitioned + 1;
    ELSE;
        LogOutput('WARN', cProcessName | ' | Skipped rule-calculated BD cell: ' | pVersion | '|' | pTargetPeriod | '|' | vSKU);
    ENDIF;
ENDIF;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
### -- Update Last Closed Period, load actuals, populate feed cube, cleanup --

nEndDateSerial = ATTRN('Merch Time Period', pTargetPeriod, 'End_Date');
AttrPutN(nEndDateSerial, 'Merch Version', pVersion, 'Last_Closed_Period');

### Load actuals for the closed period — also seeds first forecast OI from Actual EI
ExecuteProcess('Merch.Load.ActualsToForecast', 'pTimePeriod', pTargetPeriod);

### Populate }Merch Closed Period Feed for newly closed period
ExecuteProcess('Merch.Feed.LoadClosedPeriods', 'pVersion', pVersion, 'pPeriod', pTargetPeriod);

ViewDestroy('Merch Forecast', sView);

IF(bLogInfo = 1);
    LogOutput('INFO', 'END: ' | cProcessName | ' | Version=' | pVersion | ' | Period=' | pTargetPeriod | ' | SKUs transitioned=' | TRIM(STR(nSKUsTransitioned, 10, 0)));
ENDIF;
#endregion