#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-25
# LAST UPDATE: 2026-04-15
# COMMENTS:
# NRF 4-5-4 Fiscal Calendar Builder.
# Fiscal year starts on the Sunday closest to February 1 (NRF standard).
# Supports 53-week years when the gap to the next FY start is 371 days.
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-03-25         Steve Waterbury    Changed anchor from Feb 1 to Feb 2
### 2026-03-30         Steve Waterbury    Corrected anchor to NRF standard; added 53-week year support
### 2026-03-31         Steve Waterbury    Removed _Serial and string date attributes
### 2026-04-01         Steve Waterbury    Applied guardrails header template
### 2026-04-15         Steve Waterbury    Added First/Last Leaf Week for seasons and fiscal year
### 2026-04-15         Steve Waterbury    Added Next Week attribute population
#
#EndRegion

#Region : Logging
sLogLevel = CellGetS('ProcessControl', GetProcessName(), 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0; bLogDebug = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(sLogLevel @= 'DEBUG'); bLogDebug = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | GetProcessName()); ENDIF;
#EndRegion

cProcessName = GetProcessName();
cDim = 'Merch Time Period';
nStartYear = StringToNumber(pStartYear);
nEndYear = StringToNumber(pEndYear);
IF(nStartYear = 0 % nEndYear = 0); LogOutput('ERROR', cProcessName | ' | Invalid params'); ProcessError; ENDIF;
IF(nEndYear < nStartYear); LogOutput('ERROR', cProcessName | ' | pEndYear < pStartYear'); ProcessError; ENDIF;

IF(DimensionExists(cDim) = 0); DimensionCreate(cDim); ENDIF;
AttrInsert(cDim, '', 'Fiscal Year', 'S');
AttrInsert(cDim, '', 'Week Number', 'N');
AttrInsert(cDim, '', 'Start_Date', 'N');
AttrInsert(cDim, '', 'End_Date', 'N');
AttrInsert(cDim, '', 'Fiscal Month', 'S');
AttrInsert(cDim, '', 'Fiscal Quarter', 'S');
AttrInsert(cDim, '', 'Season', 'S');
AttrInsert(cDim, '', 'Caption', 'A');
AttrInsert(cDim, '', 'Previous Week', 'S');
AttrInsert(cDim, '', 'Next Week', 'S');
AttrInsert(cDim, '', 'Previous Period', 'S');
AttrInsert(cDim, '', 'Prior Cumulative', 'S');
AttrInsert(cDim, '', 'First Leaf Week', 'S');
AttrInsert(cDim, '', 'Last Leaf Week', 'S');

nRefSunday = DayNo('2024-12-29');

nYear = nStartYear;
While(nYear <= nEndYear);
  sYear = TRIM(STR(nYear, 4, 0));
  sFeb1 = sYear | '-02-01';
  nFeb1Serial = DayNo(sFeb1);
  nDaysFromSunday = nFeb1Serial - nRefSunday;
  nRem = nDaysFromSunday - (INT(nDaysFromSunday / 7) * 7);
  IF(nRem <= 3); nFirstSunday = nFeb1Serial - nRem;
  ELSE; nFirstSunday = nFeb1Serial + (7 - nRem); ENDIF;

  sNextYear = TRIM(STR(nYear + 1, 4, 0));
  nNextFeb1 = DayNo(sNextYear | '-02-01');
  nNextDays = nNextFeb1 - nRefSunday;
  nNextRem = nNextDays - (INT(nNextDays / 7) * 7);
  IF(nNextRem <= 3); nNextFirstSunday = nNextFeb1 - nNextRem;
  ELSE; nNextFirstSunday = nNextFeb1 + (7 - nNextRem); ENDIF;
  nTotalWeeks = (nNextFirstSunday - nFirstSunday) / 7;

  sYY = Subst(sYear, 3, 2);
  sFY = 'FY' | sYY;
  sFYLong = 'FY' | sYear;

  IF(bLogInfo = 1); LogOutput('INFO', cProcessName | ' | ' | sFYLong | ' starts=' | TimSt(nFirstSunday, '\Y-\m-\d') | ' weeks=' | TRIM(STR(nTotalWeeks, 2, 0))); ENDIF;

  IF(DIMIX(cDim, sFYLong) = 0); DimensionElementInsertDirect(cDim, '', sFYLong, 'C'); ENDIF;
  sSpring = sFY | '-Spring';
  sFall = sFY | '-Fall';
  IF(DIMIX(cDim, sSpring) = 0); DimensionElementInsertDirect(cDim, '', sSpring, 'C'); ENDIF;
  IF(DIMIX(cDim, sFall) = 0); DimensionElementInsertDirect(cDim, '', sFall, 'C'); ENDIF;
  DimensionElementComponentAddDirect(cDim, sFYLong, sSpring, 1);
  DimensionElementComponentAddDirect(cDim, sFYLong, sFall, 1);

  nQ = 1;
  WHILE(nQ <= 4);
    sQ = sFY | '-Q' | TRIM(STR(nQ, 1, 0));
    IF(DIMIX(cDim, sQ) = 0); DimensionElementInsertDirect(cDim, '', sQ, 'C'); ENDIF;
    IF(nQ <= 2); DimensionElementComponentAddDirect(cDim, sSpring, sQ, 1);
    ELSE; DimensionElementComponentAddDirect(cDim, sFall, sQ, 1); ENDIF;
    nQ = nQ + 1;
  END;

  nM = 1;
  WHILE(nM <= 12);
    IF(nM < 10); sMM = '0' | TRIM(STR(nM, 1, 0)); ELSE; sMM = TRIM(STR(nM, 2, 0)); ENDIF;
    sMonth = sFY | '-M' | sMM;
    IF(DIMIX(cDim, sMonth) = 0); DimensionElementInsertDirect(cDim, '', sMonth, 'C'); ENDIF;
    nQtr = INT((nM - 1) / 3) + 1;
    DimensionElementComponentAddDirect(cDim, sFY | '-Q' | TRIM(STR(nQtr, 1, 0)), sMonth, 1);
    sMonthName = '';
    IF(nM = 1); sMonthName = 'February'; ENDIF; IF(nM = 2); sMonthName = 'March'; ENDIF;
    IF(nM = 3); sMonthName = 'April'; ENDIF; IF(nM = 4); sMonthName = 'May'; ENDIF;
    IF(nM = 5); sMonthName = 'June'; ENDIF; IF(nM = 6); sMonthName = 'July'; ENDIF;
    IF(nM = 7); sMonthName = 'August'; ENDIF; IF(nM = 8); sMonthName = 'September'; ENDIF;
    IF(nM = 9); sMonthName = 'October'; ENDIF; IF(nM = 10); sMonthName = 'November'; ENDIF;
    IF(nM = 11); sMonthName = 'December'; ENDIF; IF(nM = 12); sMonthName = 'January'; ENDIF;
    AttrPutS(sMonthName | ' ' | sFY, cDim, sMonth, 'Caption');
    nM = nM + 1;
  END;

  nCleanWk = 1;
  WHILE(nCleanWk <= 53);
    IF(nCleanWk < 10); sCleanWkNum = '0' | TRIM(STR(nCleanWk, 1, 0)); ELSE; sCleanWkNum = TRIM(STR(nCleanWk, 2, 0)); ENDIF;
    sCleanElem = sFY | '-W' | sCleanWkNum;
    IF(DIMIX(cDim, sCleanElem) > 0);
      nCleanM = 1;
      WHILE(nCleanM <= 12);
        IF(nCleanM < 10); sCleanMM = '0' | TRIM(STR(nCleanM, 1, 0)); ELSE; sCleanMM = TRIM(STR(nCleanM, 2, 0)); ENDIF;
        sCleanMonth = sFY | '-M' | sCleanMM;
        IF(DIMIX(cDim, sCleanMonth) > 0);
          IF(ELISCOMP(cDim, sCleanMonth, sCleanElem) > 0);
            DimensionElementComponentDeleteDirect(cDim, sCleanMonth, sCleanElem);
          ENDIF;
        ENDIF;
        nCleanM = nCleanM + 1;
      END;
    ENDIF;
    nCleanWk = nCleanWk + 1;
  END;

  nWeek = 1;
  While(nWeek <= nTotalWeeks);
    nWeekStartSerial = nFirstSunday + ((nWeek - 1) * 7);
    nWeekEndSerial = nWeekStartSerial + 6;
    IF(nWeek < 10); sWeekNum = '0' | TRIM(STR(nWeek, 1, 0)); ELSE; sWeekNum = TRIM(STR(nWeek, 2, 0)); ENDIF;
    sElement = sFY | '-W' | sWeekNum;
    sStartDate = TimSt(nWeekStartSerial, '\Y-\m-\d');
    sEndDate = TimSt(nWeekEndSerial, '\Y-\m-\d');
    IF(DIMIX(cDim, sElement) = 0); DimensionElementInsertDirect(cDim, '', sElement, 'N'); ENDIF;

    nFiscalMonth = 0;
    IF(nWeek >= 1 & nWeek <= 4); nFiscalMonth = 1; ENDIF;
    IF(nWeek >= 5 & nWeek <= 9); nFiscalMonth = 2; ENDIF;
    IF(nWeek >= 10 & nWeek <= 13); nFiscalMonth = 3; ENDIF;
    IF(nWeek >= 14 & nWeek <= 17); nFiscalMonth = 4; ENDIF;
    IF(nWeek >= 18 & nWeek <= 22); nFiscalMonth = 5; ENDIF;
    IF(nWeek >= 23 & nWeek <= 26); nFiscalMonth = 6; ENDIF;
    IF(nWeek >= 27 & nWeek <= 30); nFiscalMonth = 7; ENDIF;
    IF(nWeek >= 31 & nWeek <= 35); nFiscalMonth = 8; ENDIF;
    IF(nWeek >= 36 & nWeek <= 39); nFiscalMonth = 9; ENDIF;
    IF(nWeek >= 40 & nWeek <= 43); nFiscalMonth = 10; ENDIF;
    IF(nWeek >= 44 & nWeek <= 48); nFiscalMonth = 11; ENDIF;
    IF(nWeek >= 49); nFiscalMonth = 12; ENDIF;

    IF(nFiscalMonth < 10); sFiscalMM = '0' | TRIM(STR(nFiscalMonth, 1, 0)); ELSE; sFiscalMM = TRIM(STR(nFiscalMonth, 2, 0)); ENDIF;
    DimensionElementComponentAddDirect(cDim, sFY | '-M' | sFiscalMM, sElement, 1);
    nQtr = INT((nFiscalMonth - 1) / 3) + 1;
    IF(nFiscalMonth <= 6); sSeason = 'Spring'; ELSE; sSeason = 'Fall'; ENDIF;

    AttrPutS(sFYLong, cDim, sElement, 'Fiscal Year');
    AttrPutN(nWeek, cDim, sElement, 'Week Number');
    AttrPutN(nWeekStartSerial, cDim, sElement, 'Start_Date');
    AttrPutN(nWeekEndSerial, cDim, sElement, 'End_Date');
    AttrPutS('M' | sFiscalMM, cDim, sElement, 'Fiscal Month');
    AttrPutS('Q' | TRIM(STR(nQtr, 1, 0)), cDim, sElement, 'Fiscal Quarter');
    AttrPutS(sSeason, cDim, sElement, 'Season');
    AttrPutS(sStartDate, cDim, sElement, 'Caption');

    # Previous Week
    IF(nWeek > 1);
      IF(nWeek - 1 < 10); sPrevWkNum = '0' | TRIM(STR(nWeek - 1, 1, 0)); ELSE; sPrevWkNum = TRIM(STR(nWeek - 1, 2, 0)); ENDIF;
      AttrPutS(sFY | '-W' | sPrevWkNum, cDim, sElement, 'Previous Week');
    ELSE;
      nPriorFYNum = nYear - 1;
      IF(nPriorFYNum >= nStartYear);
        sPriorYY = Subst(TRIM(STR(nPriorFYNum, 4, 0)), 3, 2);
        sPriorFY = 'FY' | sPriorYY;
        IF(DIMIX(cDim, sPriorFY | '-W53') > 0); AttrPutS(sPriorFY | '-W53', cDim, sElement, 'Previous Week');
        ELSE; AttrPutS(sPriorFY | '-W52', cDim, sElement, 'Previous Week'); ENDIF;
      ELSE;
        AttrPutS('', cDim, sElement, 'Previous Week');
      ENDIF;
    ENDIF;

    # Next Week
    IF(nWeek < nTotalWeeks);
      nNextWk = nWeek + 1;
      IF(nNextWk < 10); sNextWkNum = '0' | TRIM(STR(nNextWk, 1, 0)); ELSE; sNextWkNum = TRIM(STR(nNextWk, 2, 0)); ENDIF;
      AttrPutS(sFY | '-W' | sNextWkNum, cDim, sElement, 'Next Week');
    ELSE;
      nNextFYNum = nYear + 1;
      IF(nNextFYNum <= nEndYear);
        sNextYY = Subst(TRIM(STR(nNextFYNum, 4, 0)), 3, 2);
        sNextFY = 'FY' | sNextYY;
        AttrPutS(sNextFY | '-W01', cDim, sElement, 'Next Week');
      ELSE;
        AttrPutS('', cDim, sElement, 'Next Week');
      ENDIF;
    ENDIF;

    nWeek = nWeek + 1;
  End;

  nM = 1;
  WHILE(nM <= 12);
    IF(nM < 10); sMM = '0' | TRIM(STR(nM, 1, 0)); ELSE; sMM = TRIM(STR(nM, 2, 0)); ENDIF;
    sMonthElem = sFY | '-M' | sMM;
    nFirstWk = 0; nLastWk = 0;
    IF(nM = 1); nFirstWk = 1; nLastWk = 4; ENDIF; IF(nM = 2); nFirstWk = 5; nLastWk = 9; ENDIF;
    IF(nM = 3); nFirstWk = 10; nLastWk = 13; ENDIF; IF(nM = 4); nFirstWk = 14; nLastWk = 17; ENDIF;
    IF(nM = 5); nFirstWk = 18; nLastWk = 22; ENDIF; IF(nM = 6); nFirstWk = 23; nLastWk = 26; ENDIF;
    IF(nM = 7); nFirstWk = 27; nLastWk = 30; ENDIF; IF(nM = 8); nFirstWk = 31; nLastWk = 35; ENDIF;
    IF(nM = 9); nFirstWk = 36; nLastWk = 39; ENDIF; IF(nM = 10); nFirstWk = 40; nLastWk = 43; ENDIF;
    IF(nM = 11); nFirstWk = 44; nLastWk = 48; ENDIF; IF(nM = 12); nFirstWk = 49; nLastWk = 52; ENDIF;
    IF(nM = 12 & nTotalWeeks = 53); nLastWk = 53; ENDIF;
    IF(nFirstWk < 10); sFirstWkStr = '0' | TRIM(STR(nFirstWk, 1, 0)); ELSE; sFirstWkStr = TRIM(STR(nFirstWk, 2, 0)); ENDIF;
    IF(nLastWk < 10); sLastWkStr = '0' | TRIM(STR(nLastWk, 1, 0)); ELSE; sLastWkStr = TRIM(STR(nLastWk, 2, 0)); ENDIF;
    AttrPutS(sFY | '-W' | sFirstWkStr, cDim, sMonthElem, 'First Leaf Week');
    AttrPutS(sFY | '-W' | sLastWkStr, cDim, sMonthElem, 'Last Leaf Week');
    IF(nM > 1);
      IF(nM - 1 < 10); sPrevMM = '0' | TRIM(STR(nM - 1, 1, 0)); ELSE; sPrevMM = TRIM(STR(nM - 1, 2, 0)); ENDIF;
      AttrPutS(sFY | '-M' | sPrevMM, cDim, sMonthElem, 'Previous Period');
    ELSE; AttrPutS('', cDim, sMonthElem, 'Previous Period'); ENDIF;
    nM = nM + 1;
  END;

  nQ = 1;
  WHILE(nQ <= 4);
    sQElem = sFY | '-Q' | TRIM(STR(nQ, 1, 0));
    nQFirstWk = 0; nQLastWk = 0;
    IF(nQ = 1); nQFirstWk = 1; nQLastWk = 13; ENDIF; IF(nQ = 2); nQFirstWk = 14; nQLastWk = 26; ENDIF;
    IF(nQ = 3); nQFirstWk = 27; nQLastWk = 39; ENDIF; IF(nQ = 4); nQFirstWk = 40; nQLastWk = 52; ENDIF;
    IF(nQ = 4 & nTotalWeeks = 53); nQLastWk = 53; ENDIF;
    IF(nQFirstWk < 10); sQFirstStr = '0' | TRIM(STR(nQFirstWk, 1, 0)); ELSE; sQFirstStr = TRIM(STR(nQFirstWk, 2, 0)); ENDIF;
    sQLastStr = TRIM(STR(nQLastWk, 2, 0));
    AttrPutS(sFY | '-W' | sQFirstStr, cDim, sQElem, 'First Leaf Week');
    AttrPutS(sFY | '-W' | sQLastStr, cDim, sQElem, 'Last Leaf Week');
    IF(nQ > 1); AttrPutS(sFY | '-Q' | TRIM(STR(nQ - 1, 1, 0)), cDim, sQElem, 'Previous Period');
    ELSE; AttrPutS('', cDim, sQElem, 'Previous Period'); ENDIF;
    nQ = nQ + 1;
  END;

  # Season First/Last Leaf Week
  AttrPutS(sFY | '-W01', cDim, sSpring, 'First Leaf Week');
  AttrPutS(sFY | '-W26', cDim, sSpring, 'Last Leaf Week');
  AttrPutS(sFY | '-W27', cDim, sFall, 'First Leaf Week');
  IF(nTotalWeeks = 53);
    AttrPutS(sFY | '-W53', cDim, sFall, 'Last Leaf Week');
  ELSE;
    AttrPutS(sFY | '-W52', cDim, sFall, 'Last Leaf Week');
  ENDIF;

  # Fiscal Year First/Last Leaf Week
  AttrPutS(sFY | '-W01', cDim, sFYLong, 'First Leaf Week');
  IF(nTotalWeeks = 53);
    AttrPutS(sFY | '-W53', cDim, sFYLong, 'Last Leaf Week');
  ELSE;
    AttrPutS(sFY | '-W52', cDim, sFYLong, 'Last Leaf Week');
  ENDIF;

  nYear = nYear + 1;
End;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog

#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Epilog Logging
IF( bLogInfo = 1 );
    LogOutput( 'INFO', 'END: ' | GetProcessName() | ' | Fiscal years built from ' | pStartYear | ' to ' | pEndYear );
ENDIF;
#EndRegion

#endregion