#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-03
# LAST UPDATE: 2026-06-04
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Copies Actual version data to a Calculated version for closed periods.
# Datasource variables registered in VIEW AXIS ORDER (Measure COLUMNS, Time x SKU
# ROWS, Version WHERE) = [Measure, Time, SKU, Version, Value], per ActualsToForecast.
# Closed periods in calc versions must NOT carry planning Receipts/On-Order:
# excluded from copy and zeroed out (ViewZeroOut clears On-Order; closed Receipts
# are rule-locked by 'Receipts Lock' STET and are left frozen). EI (stored) untouched.
#### CHANGE HISTORY:
### 2026-04-03  Steve Waterbury  Initial creation
### 2026-04-18  Steve Waterbury  pTimePeriod DESCENDANTS scope; End_Date guard
### 2026-05-20  Steve Waterbury  Bypass LCP attr lets forward-looking actuals flow past LCP
### 2026-06-04  Steve Waterbury  Fixed datasource var order to axis-order [Measure,Time,SKU,Version,Value] (was mis-bound cube-order, silently failing the copy); exclude+ViewZeroOut Receipts/On-Order in closed calc periods; EI untouched
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0; IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'START: ' | cProcessName | ' | Cube=' | pCubeName | ' | Target=' | pTargetVersion | ' | Period=' | pTimePeriod); ENDIF;

IF(pCubeName @= ''); LogOutput('ERROR', cProcessName | ' | pCubeName required'); ProcessError; ENDIF;
IF(pTargetVersion @= ''); LogOutput('ERROR', cProcessName | ' | pTargetVersion required'); ProcessError; ENDIF;
IF(pTimePeriod @= ''); LogOutput('ERROR', cProcessName | ' | pTimePeriod required'); ProcessError; ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0); LogOutput('ERROR', cProcessName | ' | TimePeriod missing'); ProcessError; ENDIF;
IF(DIMIX('Merch Version', pTargetVersion) = 0); LogOutput('ERROR', cProcessName | ' | Version missing'); ProcessError; ENDIF;
IF(ATTRS('Merch Version', pTargetVersion, 'Version_Type') @<> 'Calculated');
  LogOutput('ERROR', cProcessName | ' | Version not Calculated');
  ProcessError;
ENDIF;

nLCP = ATTRN('Merch Version', pTargetVersion, 'Last_Closed_Period');
nCellsCopied = 0; nSkipped = 0; nRecordCount = 0;

sBypassMeasures = ';';
nActMeasSize = DIMSIZ('Merch Actuals Measure');
nBPx = 1;
WHILE(nBPx <= nActMeasSize);
  sActMeas = DIMNM('Merch Actuals Measure', nBPx);
  IF(ATTRN('Merch Actuals Measure', sActMeas, 'Bypass LCP') = 1);
    sDstMeas = ATTRS('Merch Actuals Measure', sActMeas, 'Forecast Measure Map');
    IF(sDstMeas @<> '');
      sBypassMeasures = sBypassMeasures | sDstMeas | ';';
    ENDIF;
  ENDIF;
  nBPx = nBPx + 1;
END;
IF(bLogInfo = 1); LogOutput('INFO', cProcessName | ' | BypassSet=' | sBypassMeasures); ENDIF;

cDimVersion = TABDIM(pCubeName, 1);
cDimTime = TABDIM(pCubeName, 2);
cDimProduct = TABDIM(pCubeName, 3);
cDimMeasure = TABDIM(pCubeName, 4);

#Region : Clear closed-period Receipts/On-Order in target calc version
IF(nLCP > 0 & DIMIX(cDimMeasure, 'Receipts') > 0 & DIMIX(cDimMeasure, 'On-Order') > 0);
  sClrView = 'TI_ActToCalcClr_' | TRIM(STR(NOW, 15, 0));
  sClrMDX = 'SELECT {[' | cDimMeasure | '].[' | cDimMeasure | '].[Receipts],[' | cDimMeasure | '].[' | cDimMeasure | '].[On-Order]} ON COLUMNS, NON EMPTY CROSSJOIN({FILTER({TM1FILTERBYLEVEL({DESCENDANTS([' | cDimTime | '].[' | cDimTime | '].[' | pTimePeriod | '])}, 0)}, ATTRN([' | cDimTime | '].[' | cDimTime | '].CURRENTMEMBER, "End_Date") <= ' | TRIM(STR(nLCP, 15, 0)) | ')}, {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimProduct | '].[' | cDimProduct | '])}, 0)}) ON ROWS FROM [' | pCubeName | '] WHERE ([' | cDimVersion | '].[' | cDimVersion | '].[' | pTargetVersion | '])';
  ViewCreateByMDX(pCubeName, sClrView, sClrMDX, 1);
  ViewZeroOut(pCubeName, sClrView);
  IF(ViewExists(pCubeName, sClrView) = 1); ViewDestroy(pCubeName, sClrView); ENDIF;
ENDIF;
#EndRegion

sViewName = 'TI_ActToCalc_' | TRIM(STR(NOW, 15, 0));
sMdxQuery = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimMeasure | '].[' | cDimMeasure | '])}, 0)} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL({DESCENDANTS([' | cDimTime | '].[' | cDimTime | '].[' | pTimePeriod | '])}, 0)}, {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimProduct | '].[' | cDimProduct | '])}, 0)}) ON ROWS FROM [' | pCubeName | '] WHERE ([' | cDimVersion | '].[' | cDimVersion | '].[Actual])';
ViewCreateByMDX(pCubeName, sViewName, sMdxQuery, 1);
ViewExtractSkipCalcsSet(pCubeName, sViewName, 0);
ViewExtractSkipZeroesSet(pCubeName, sViewName, 1);
ViewSuppressZeroesSet(pCubeName, sViewName, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = pCubeName;
DatasourceCubeview = sViewName;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nRecordCount = nRecordCount + 1;
nVal = Value;
IF(nVal = 0); ItemSkip; ENDIF;
nEndDate = ATTRN(cDimTime, vMerch_Time_Period, 'End_Date');
bBypass = 0;
IF(SCAN(';' | vMerch_Forecast_Measure | ';', sBypassMeasures) > 0); bBypass = 1; ENDIF;
IF(bBypass = 0 & nEndDate > nLCP); nSkipped = nSkipped + 1; ItemSkip; ENDIF;
IF(nEndDate <= nLCP & (vMerch_Forecast_Measure @= 'Receipts' % vMerch_Forecast_Measure @= 'On-Order'));
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;
IF(CellIsUpdateable(pCubeName, pTargetVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure) = 0);
  nSkipped = nSkipped + 1;
  ItemSkip;
ENDIF;
CellPutN(nVal, pCubeName, pTargetVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure);
nCellsCopied = nCellsCopied + 1;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(pCubeName, sViewName) = 1); ViewDestroy(pCubeName, sViewName); ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'END: Records=' | TRIM(STR(nRecordCount, 10, 0)) | ' Copied=' | TRIM(STR(nCellsCopied, 10, 0)) | ' Skipped=' | TRIM(STR(nSkipped, 10, 0))); ENDIF;

#endregion