#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-03
# LAST UPDATE: 2026-06-24
# CHANGED BY : Steve Waterbury
# CHANGE HISTORY:
#   2026-04-03 | Steve Waterbury | Initial creation
#   2026-06-04 | Steve Waterbury | axis-order datasource vars; closed Receipts/On-Order ViewZeroOut
#   2026-06-24 | Steve Waterbury | Attribute-driven two-region clear-before-load; closed-skip via bypass set (no hardcoded measure names)
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= ''); sLogLevel = 'OFF'; ENDIF;
bLogInfo = 0; IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG'); bLogInfo = 1; ENDIF;

IF(pCubeName @= ''); LogOutput('ERROR', cProcessName | ' | pCubeName required', 1); ProcessError; ENDIF;
IF(pTargetVersion @= ''); LogOutput('ERROR', cProcessName | ' | pTargetVersion required', 1); ProcessError; ENDIF;
IF(pTimePeriod @= ''); LogOutput('ERROR', cProcessName | ' | pTimePeriod required', 1); ProcessError; ENDIF;
IF(DIMIX('Merch Time Period', pTimePeriod) = 0); LogOutput('ERROR', cProcessName | ' | TimePeriod missing', 1); ProcessError; ENDIF;
IF(DIMIX('Merch Version', pTargetVersion) = 0); LogOutput('ERROR', cProcessName | ' | Version missing', 1); ProcessError; ENDIF;
IF(ATTRS('Merch Version', pTargetVersion, 'Version_Type') @<> 'Calculated'); LogOutput('ERROR', cProcessName | ' | Version not Calculated', 1); ProcessError; ENDIF;

nLCP = ATTRN('Merch Version', pTargetVersion, 'Last_Closed_Period');
nCellsCopied = 0; nSkipped = 0; nRecordCount = 0;

sBypassMeasures = ';';
nActMeasSize = DIMSIZ('Merch Actuals Measure');
nBPx = 1;
WHILE(nBPx <= nActMeasSize);
  sActMeas = DIMNM('Merch Actuals Measure', nBPx);
  IF(ATTRN('Merch Actuals Measure', sActMeas, 'Bypass LCP') = 1);
    sDstMeas = ATTRS('Merch Actuals Measure', sActMeas, 'Forecast Measure Map');
    IF(sDstMeas @<> ''); sBypassMeasures = sBypassMeasures | sDstMeas | ';'; ENDIF;
  ENDIF;
  nBPx = nBPx + 1;
END;

cDimVersion = TABDIM(pCubeName, 1);
cDimTime = TABDIM(pCubeName, 2);
cDimProduct = TABDIM(pCubeName, 3);
cDimMeasure = TABDIM(pCubeName, 4);

# Build mapped-measure buckets from attributes only (no hardcoded names)
sBypassMembers = '';
sClosedMembers = '';
nAM = 1;
WHILE(nAM <= nActMeasSize);
  sAM = DIMNM('Merch Actuals Measure', nAM);
  sDst = ATTRS('Merch Actuals Measure', sAM, 'Forecast Measure Map');
  IF(sDst @<> '' & DIMIX(cDimMeasure, sDst) > 0);
    sMbr = '[' | cDimMeasure | '].[' | cDimMeasure | '].[' | sDst | ']';
    IF(ATTRN('Merch Actuals Measure', sAM, 'Bypass LCP') = 1);
      IF(sBypassMembers @= ''); sBypassMembers = sMbr; ELSE; sBypassMembers = sBypassMembers | ',' | sMbr; ENDIF;
    ELSE;
      IF(sClosedMembers @= ''); sClosedMembers = sMbr; ELSE; sClosedMembers = sClosedMembers | ',' | sMbr; ENDIF;
    ENDIF;
  ENDIF;
  nAM = nAM + 1;
END;

# Clear Region A: non-bypass measures in CLOSED weeks (End_Date <= LCP)
IF(nLCP > 0 & sClosedMembers @<> '');
  sClrA = 'TI_ATC_ClrClosed_' | TRIM(STR(NOW, 15, 0));
  sMdxA = 'SELECT {' | sClosedMembers | '} ON COLUMNS, NON EMPTY CROSSJOIN({FILTER({TM1FILTERBYLEVEL({DESCENDANTS([' | cDimTime | '].[' | cDimTime | '].[' | pTimePeriod | '])}, 0)}, ATTRN([' | cDimTime | '].[' | cDimTime | '].CURRENTMEMBER, "End_Date") <= ' | TRIM(STR(nLCP, 15, 0)) | ')}, {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimProduct | '].[' | cDimProduct | '])}, 0)}) ON ROWS FROM [' | pCubeName | '] WHERE ([' | cDimVersion | '].[' | cDimVersion | '].[' | pTargetVersion | '])';
  ViewCreateByMDX(pCubeName, sClrA, sMdxA, 1);
  ViewZeroOut(pCubeName, sClrA);
  IF(ViewExists(pCubeName, sClrA) = 1); ViewDestroy(pCubeName, sClrA); ENDIF;
ENDIF;

# Clear Region B: bypass measures in OPEN weeks (End_Date > LCP)
IF(sBypassMembers @<> '');
  sClrB = 'TI_ATC_ClrOpen_' | TRIM(STR(NOW, 15, 0));
  sMdxB = 'SELECT {' | sBypassMembers | '} ON COLUMNS, NON EMPTY CROSSJOIN({FILTER({TM1FILTERBYLEVEL({DESCENDANTS([' | cDimTime | '].[' | cDimTime | '].[' | pTimePeriod | '])}, 0)}, ATTRN([' | cDimTime | '].[' | cDimTime | '].CURRENTMEMBER, "End_Date") > ' | TRIM(STR(nLCP, 15, 0)) | ')}, {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimProduct | '].[' | cDimProduct | '])}, 0)}) ON ROWS FROM [' | pCubeName | '] WHERE ([' | cDimVersion | '].[' | cDimVersion | '].[' | pTargetVersion | '])';
  ViewCreateByMDX(pCubeName, sClrB, sMdxB, 1);
  ViewZeroOut(pCubeName, sClrB);
  IF(ViewExists(pCubeName, sClrB) = 1); ViewDestroy(pCubeName, sClrB); ENDIF;
ENDIF;

sViewName = 'TI_ActToCalc_' | TRIM(STR(NOW, 15, 0));
sMdxQuery = 'SELECT NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimMeasure | '].[' | cDimMeasure | '])}, 0)} ON COLUMNS, NON EMPTY CROSSJOIN({TM1FILTERBYLEVEL({DESCENDANTS([' | cDimTime | '].[' | cDimTime | '].[' | pTimePeriod | '])}, 0)}, {TM1FILTERBYLEVEL({TM1SUBSETALL([' | cDimProduct | '].[' | cDimProduct | '])}, 0)}) ON ROWS FROM [' | pCubeName | '] WHERE ([' | cDimVersion | '].[' | cDimVersion | '].[Actual])';
ViewCreateByMDX(pCubeName, sViewName, sMdxQuery, 1);
ViewExtractSkipCalcsSet(pCubeName, sViewName, 0);
ViewExtractSkipZeroesSet(pCubeName, sViewName, 1);
ViewSuppressZeroesSet(pCubeName, sViewName, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = pCubeName;
DatasourceCubeview = sViewName;
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
nRecordCount = nRecordCount + 1;
nVal = Value;
IF(nVal = 0); ItemSkip; ENDIF;
nEndDate = ATTRN(cDimTime, vMerch_Time_Period, 'End_Date');
bBypass = 0;
IF(SCAN(';' | vMerch_Forecast_Measure | ';', sBypassMeasures) > 0); bBypass = 1; ENDIF;
IF(bBypass = 0 & nEndDate > nLCP); nSkipped = nSkipped + 1; ItemSkip; ENDIF;
IF(bBypass = 1 & nEndDate <= nLCP); nSkipped = nSkipped + 1; ItemSkip; ENDIF;
IF(CellIsUpdateable(pCubeName, pTargetVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure) = 0); nSkipped = nSkipped + 1; ItemSkip; ENDIF;
CellPutN(nVal, pCubeName, pTargetVersion, vMerch_Time_Period, vMerch_SKU, vMerch_Forecast_Measure);
nCellsCopied = nCellsCopied + 1;
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(pCubeName, sViewName) = 1); ViewDestroy(pCubeName, sViewName); ENDIF;
IF(bLogInfo = 1); LogOutput('INFO', 'END: ' | cProcessName | ' | Records=' | TRIM(STR(nRecordCount, 10, 0)) | ' Copied=' | TRIM(STR(nCellsCopied, 10, 0)) | ' Skipped=' | TRIM(STR(nSkipped, 10, 0)), 1); ENDIF;
#endregion