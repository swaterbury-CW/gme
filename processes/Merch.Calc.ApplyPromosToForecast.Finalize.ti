#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-06-19
# CHANGED BY : Steve Waterbury
# COMMENTS: Phase 2 of promo->forecast push. Writes Promo % (promo layer) off the marked-down base FP*(1-Markdown %). Markdown % is the preserved markdown input (not overwritten). Optional pSKU scope.
# CHANGE HISTORY:
#   2026-04-20 | Steve Waterbury | Initial creation
#   2026-05-08 | Steve Waterbury | Lock-skip guard Promo Build->Backend Adjustment
#   2026-05-11 | Steve Waterbury | Qualify Merch Version hierarchy in ViewCreateByMDX WHERE
#   2026-06-18 | Steve Waterbury | Add pSKU scope on source view; LogOutput 3-arg
#   2026-06-19 | Steve Waterbury | WS4: write Promo % (not Markdown %); compute off marked-down base FP*(1-Markdown %)
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion | ' | SKU=' | pSKU, 1);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required', 1);
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(DTYPE('Merch Version', pVersion) @<> 'N');
  LogOutput('ERROR', cProcessName | ' | Version must be a leaf element: ' | pVersion, 1);
  ProcessError;
ENDIF;
IF(pSKU @<> '');
  IF(DIMIX('Merch SKU', pSKU) = 0);
    LogOutput('ERROR', cProcessName | ' | SKU not found: ' | pSKU, 1);
    ProcessError;
  ENDIF;
  IF(ELLEV('Merch SKU', pSKU) <> 0);
    LogOutput('ERROR', cProcessName | ' | SKU must be a leaf element: ' | pSKU, 1);
    ProcessError;
  ENDIF;
ENDIF;

cScratch = 'Merch Promo Winner Scratch';
cForecast = 'Merch Forecast';
cWinnerMeasDim = 'Merch Promo Winner Measure';
nForecastWrites = 0;
nTuplesProcessed = 0;
nSkippedLock = 0;

IF(pSKU @= '');
  sSKUSet = 'TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)';
ELSE;
  sSKUSet = '{[Merch SKU].[Merch SKU].[' | pSKU | ']}';
ENDIF;

sView = 'TI_PromoFinal_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[' | cWinnerMeasDim | '].[Has Winner]} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* ' | sSKUSet | ' ON ROWS '
  | 'FROM [' | cScratch | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
ViewCreateByMDX(cScratch, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cScratch, sView, 0);
ViewExtractSkipZeroesSet(cScratch, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cScratch;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(Value = 0);
  ItemSkip;
ENDIF;

sSKU = vMerch_SKU;
sTime = vMerch_Time_Period;

IF(DIMIX('Merch SKU', sSKU) = 0);
  ItemReject('Source SKU not found in Merch SKU dim: ' | sSKU);
ENDIF;
IF(DIMIX('Merch Time Period', sTime) = 0);
  ItemReject('Source Time Period not found: ' | sTime);
ENDIF;

IF(CellIsUpdateable(cForecast, pVersion, sTime, sSKU, 'Backend Adjustment') = 0);
  nSkippedLock = nSkippedLock + 1;
  ItemSkip;
ENDIF;

nTuplesProcessed = nTuplesProcessed + 1;

nMinBlended = CellGetN(cScratch, pVersion, sTime, sSKU, 'Min Blended AUR');
nWinPct = CellGetN(cScratch, pVersion, sTime, sSKU, 'Winner Pct of Week');
nWinBER = CellGetN(cScratch, pVersion, sTime, sSKU, 'Winner BER');
nWinLift = CellGetN(cScratch, pVersion, sTime, sSKU, 'Winner Effective Lift');

nFPAUR = CellGetN(cForecast, pVersion, sTime, sSKU, 'Full Price AUR');
nMarkdownLayer = CellGetN(cForecast, pVersion, sTime, sSKU, 'Markdown %');
nMarkedDownBase = nFPAUR * (1 - nMarkdownLayer);
nEffWeekAUR = nMinBlended * nWinPct + nMarkedDownBase * (1 - nWinPct);
nPromoPct = 0;
IF(nMarkedDownBase <> 0);
  nPromoPct = (nMarkedDownBase - nEffWeekAUR) \ nMarkedDownBase;
ENDIF;
nPromoBuild = 1 + nWinLift;
nBackendAdj = nWinBER * nWinPct;

CellPutN(nPromoPct, cForecast, pVersion, sTime, sSKU, 'Promo %');
CellPutN(nPromoBuild, cForecast, pVersion, sTime, sSKU, 'Promo Build');
CellPutN(nBackendAdj, cForecast, pVersion, sTime, sSKU, 'Backend Adjustment');
nForecastWrites = nForecastWrites + 3;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cScratch, sView) = 1);
  ViewDestroy(cScratch, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Version=' | pVersion | ' | SKU=' | pSKU | ' | Tuples=' | TRIM(STR(nTuplesProcessed, 10, 0)) | ' | Writes=' | TRIM(STR(nForecastWrites, 10, 0)) | ' | SkippedLocked=' | TRIM(STR(nSkippedLock, 10, 0)), 1);
ENDIF;

#endregion