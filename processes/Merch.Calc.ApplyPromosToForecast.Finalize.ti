#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-20
# LAST UPDATE: 2026-05-11
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Phase 2 of promo->forecast push.
# CHANGE HISTORY:
#   2026-04-20  Steve Waterbury  Initial creation
#   2026-05-08  Steve Waterbury  Lock-skip guard 'Promo Build'->'Backend Adjustment' (STET trumps catchall on Promo Build; Backend Adjustment honors Sellable_Flag gate).
#   2026-05-11  Steve Waterbury  Qualify Merch Version hierarchy in ViewCreateByMDX WHERE (Forecast leaf exists in both Merch Version and Budget Rollup hierarchies)
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
bLogDebug = 0;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName | ' | Version=' | pVersion);
ENDIF;

IF(pVersion @= '');
  LogOutput('ERROR', cProcessName | ' | pVersion required');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', cProcessName | ' | Version not found: ' | pVersion);
  ProcessError;
ENDIF;
IF(DTYPE('Merch Version', pVersion) @<> 'N');
  LogOutput('ERROR', cProcessName | ' | Version must be a leaf element: ' | pVersion);
  ProcessError;
ENDIF;

cScratch = 'Merch Promo Winner Scratch';
cForecast = 'Merch Forecast';
cWinnerMeasDim = 'Merch Promo Winner Measure';
nForecastWrites = 0;
nTuplesProcessed = 0;
nSkippedLock = 0;

sView = 'TI_PromoFinal_' | TRIM(STR(NOW, 15, 0));
sMDX = 'SELECT {[' | cWinnerMeasDim | '].[Has Winner]} ON COLUMNS, '
  | 'NON EMPTY {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch Time Period])}, 0)} '
  | '* {TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)} ON ROWS '
  | 'FROM [' | cScratch | '] '
  | 'WHERE ([Merch Version].[Merch Version].[' | pVersion | '])';
ViewCreateByMDX(cScratch, sView, sMDX, 1);
ViewExtractSkipCalcsSet(cScratch, sView, 0);
ViewExtractSkipZeroesSet(cScratch, sView, 1);
DatasourceType = 'VIEW';
DatasourceNameForServer = cScratch;
DatasourceCubeview = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(Value = 0);
  ItemSkip;
ENDIF;

sSKU = vMerch_SKU;
sTime = vMerch_Time_Period;

IF(DIMIX('Merch SKU', sSKU) = 0);
  ItemReject('Source SKU not found in Merch SKU dim: ' | sSKU);
ENDIF;
IF(DIMIX('Merch Time Period', sTime) = 0);
  ItemReject('Source Time Period not found: ' | sTime);
ENDIF;

IF(CellIsUpdateable(cForecast, pVersion, sTime, sSKU, 'Backend Adjustment') = 0);
  nSkippedLock = nSkippedLock + 1;
  ItemSkip;
ENDIF;

nTuplesProcessed = nTuplesProcessed + 1;

nMinBlended = CellGetN(cScratch, pVersion, sTime, sSKU, 'Min Blended AUR');
nWinPct = CellGetN(cScratch, pVersion, sTime, sSKU, 'Winner Pct of Week');
nWinBER = CellGetN(cScratch, pVersion, sTime, sSKU, 'Winner BER');
nWinLift = CellGetN(cScratch, pVersion, sTime, sSKU, 'Winner Effective Lift');

nFPAUR = CellGetN(cForecast, pVersion, sTime, sSKU, 'Full Price AUR');
nEffWeekAUR = nMinBlended * nWinPct + nFPAUR * (1 - nWinPct);
nMarkdownPct = 0;
IF(nFPAUR <> 0);
  nMarkdownPct = (nFPAUR - nEffWeekAUR) \ nFPAUR;
ENDIF;
nPromoBuild = 1 + nWinLift;
nBackendAdj = nWinBER * nWinPct;

CellPutN(nMarkdownPct, cForecast, pVersion, sTime, sSKU, 'Markdown %');
CellPutN(nPromoBuild, cForecast, pVersion, sTime, sSKU, 'Promo Build');
CellPutN(nBackendAdj, cForecast, pVersion, sTime, sSKU, 'Backend Adjustment');
nForecastWrites = nForecastWrites + 3;

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(ViewExists(cScratch, sView) = 1);
  ViewDestroy(cScratch, sView);
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | Version=' | pVersion | ' | Tuples=' | TRIM(STR(nTuplesProcessed, 10, 0)) | ' | Writes=' | TRIM(STR(nForecastWrites, 10, 0)) | ' | SkippedLocked=' | TRIM(STR(nSkippedLock, 10, 0)));
ENDIF;
#endregion