#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# ============================================================
# DEVELOPER    : Steve Waterbury
# CREATED ON   : 2026-05-06
# LAST UPDATE  : 2026-05-06
# CHANGED BY   : Steve Waterbury
# CHANGE HISTORY:
#   2026-05-06 | Steve Waterbury | Initial Security Overlay refresh.
# ============================================================
# Process : Merch.Security.RefreshOverlays
# Purpose : Refresh }SecurityOverlayGlobal_<pCube>. Idempotent.
# Params  : pCube (String, required).
# ============================================================

sProc = GetProcessName();

IF( CubeExists( 'ProcessControl' ) = 1 );
    sLogLevel = CellGetS( 'ProcessControl', sProc, 'Logging Level' );
ELSE;
    sLogLevel = '';
ENDIF;
IF( sLogLevel @= '' );
    sLogLevel = 'INFO';
ENDIF;
bLogInfo  = IF( sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG', 1, 0 );
bLogDebug = IF( sLogLevel @= 'DEBUG', 1, 0 );

IF( bLogInfo = 1 );
    LogOutput( 'INFO', 'START: ' | sProc | ' | LogLevel=' | sLogLevel | ' | pCube=' | pCube );
ENDIF;

IF( TRIM( pCube ) @= '' );
    LogOutput( 'ERROR', sProc | ' | pCube parameter is required' );
    ProcessQuit;
ENDIF;
IF( CubeExists( pCube ) = 0 );
    LogOutput( 'ERROR', sProc | ' | Cube does not exist: ' | pCube );
    ProcessQuit;
ENDIF;

bHasTime  = 0;
sDimAddr  = '';
nDim      = 1;
sDim      = TABDIM( pCube, nDim );
WHILE( sDim @<> '' );
    IF( sDim @= 'Merch Version' % sDim @= 'Merch Time Period' );
        sFlag = '1';
    ELSE;
        sFlag = '0';
    ENDIF;
    IF( sDim @= 'Merch Time Period' );
        bHasTime = 1;
    ENDIF;
    IF( nDim = 1 );
        sDimAddr = sFlag;
    ELSE;
        sDimAddr = sDimAddr | ':' | sFlag;
    ENDIF;
    nDim = nDim + 1;
    sDim = TABDIM( pCube, nDim );
END;

sOverlayCube = '}SecurityOverlayGlobal_' | pCube;
IF( CubeExists( sOverlayCube ) = 0 );
    IF( bLogInfo = 1 );
        LogOutput( 'INFO', sProc | ' | Creating overlay cube: ' | sOverlayCube | ' | DimensionMap=' | sDimAddr );
    ENDIF;
    SecurityOverlayCreateGlobalDefault( pCube, sDimAddr );
ENDIF;

sVerSub = 'tmp_RefreshOverlay_Versions';
IF( SubsetExists( 'Merch Version', sVerSub ) = 1 );
    SubsetDestroy( 'Merch Version', sVerSub );
ENDIF;
SubsetCreateByMDX( sVerSub, '{TM1FILTERBYLEVEL([Merch Version].[Merch Version].Members, 0)}', 'Merch Version', 1 );

IF( bHasTime = 1 );
    sPerSub = 'tmp_RefreshOverlay_Periods';
    IF( SubsetExists( 'Merch Time Period', sPerSub ) = 1 );
        SubsetDestroy( 'Merch Time Period', sPerSub );
    ENDIF;
    SubsetCreateByMDX( sPerSub, '{TM1FILTERBYLEVEL([Merch Time Period].[Merch Time Period].Members, 0)}', 'Merch Time Period', 1 );
ENDIF;

nCellsLocked   = 0;
nCellsUnlocked = 0;
nVerProcessed  = 0;

nVerCount = SubsetGetSize( 'Merch Version', sVerSub );
IF( bHasTime = 1 );
    nPerCount = SubsetGetSize( 'Merch Time Period', sPerSub );
ELSE;
    nPerCount = 0;
ENDIF;

nVer = 1;
WHILE( nVer <= nVerCount );
    sVer = SubsetGetElementName( 'Merch Version', sVerSub, nVer );

    sVerType    = TRIM( ATTRS( 'Merch Version', sVer, 'Version_Type' ) );
    nLastClosed = ATTRN( 'Merch Version', sVer, 'Last_Closed_Period' );
    nLockAll    = IF( sVerType @= 'Actual' % sVerType @= 'Static', 1, 0 );

    IF( bHasTime = 1 );
        nPer = 1;
        WHILE( nPer <= nPerCount );
            sPer = SubsetGetElementName( 'Merch Time Period', sPerSub, nPer );

            IF( nLockAll = 1 );
                nState = 1;
            ELSE;
                IF( nLastClosed > 0 );
                    nStart = ATTRN( 'Merch Time Period', sPer, 'Start_Date_Serial' );
                    IF( nStart > 0 & nStart <= nLastClosed );
                        nState = 1;
                    ELSE;
                        nState = 0;
                    ENDIF;
                ELSE;
                    nState = 0;
                ENDIF;
            ENDIF;
            SecurityOverlayGlobalLockCell( nState, pCube, sVer, sPer );
            IF( nState = 1 );
                nCellsLocked = nCellsLocked + 1;
            ELSE;
                nCellsUnlocked = nCellsUnlocked + 1;
            ENDIF;
            nPer = nPer + 1;
        END;
    ELSE;
        SecurityOverlayGlobalLockCell( nLockAll, pCube, sVer );
        IF( nLockAll = 1 );
            nCellsLocked = nCellsLocked + 1;
        ELSE;
            nCellsUnlocked = nCellsUnlocked + 1;
        ENDIF;
    ENDIF;

    nVerProcessed = nVerProcessed + 1;
    IF( bLogDebug = 1 );
        LogOutput( 'DEBUG', sProc | ' | Version=' | sVer | ' | Type=' | sVerType | ' | LastClosed=' | NUMBERTOSTRING( nLastClosed ) | ' | LockedRunning=' | NUMBERTOSTRING( nCellsLocked ) );
    ENDIF;

    nVer = nVer + 1;
END;

IF( SubsetExists( 'Merch Version', sVerSub ) = 1 );
    SubsetDestroy( 'Merch Version', sVerSub );
ENDIF;
IF( bHasTime = 1 );
    IF( SubsetExists( 'Merch Time Period', sPerSub ) = 1 );
        SubsetDestroy( 'Merch Time Period', sPerSub );
    ENDIF;
ENDIF;

IF( bLogInfo = 1 );
    LogOutput( 'INFO', 'END: ' | sProc | ' | Cube=' | pCube | ' | VersionsProcessed=' | NUMBERTOSTRING( nVerProcessed ) | ' | CellsLocked=' | NUMBERTOSTRING( nCellsLocked ) | ' | CellsUnlocked=' | NUMBERTOSTRING( nCellsUnlocked ) );
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion