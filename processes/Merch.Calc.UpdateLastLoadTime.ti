#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-05-05
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Stamps the current server time into Merch Settings (Last Load Time, Value_String).
# Called from Merch.Load.Actuals.BQ-LoadAllWeeks epilog after every actuals refresh.
#### CHANGE HISTORY:
### 2026-05-05  Steve Waterbury  Initial creation
#EndRegion

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | cProcessName);
ENDIF;

IF(CubeExists('Merch Settings') = 0);
  LogOutput('ERROR', cProcessName | ' | Merch Settings cube missing');
  ProcessQuit;
ENDIF;

sNow = TIMST(NOW, '\Y-\m-\d \h:\i:\s');
IF(CellIsUpdateable('Merch Settings', 'Last Load Time', 'Value_String') = 1);
  CellPutS(sNow, 'Merch Settings', 'Last Load Time', 'Value_String');
ELSE;
  LogOutput('ERROR', cProcessName | ' | (Last Load Time, Value_String) not updateable');
  ProcessQuit;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | cProcessName | ' | LastLoadTime=' | sNow);
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
