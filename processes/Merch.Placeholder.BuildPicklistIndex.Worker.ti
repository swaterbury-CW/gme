#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-30
# LAST UPDATE: 2026-04-30
# CHANGED BY : Steve Waterbury
# CHANGE HISTORY:
#   2026-04-30 | Steve Waterbury | Initial commit — per-category Picklist Index cell writer

sSKUDim = 'Merch SKU';
sCube = '}Merch Placeholder Picklist Index';
sCubeAttr = '}ElementAttributes_Merch SKU';
sL4Dim = 'Placeholder L4 Values';
sVDim = 'Placeholder Vendor Values';
sFDim = 'Placeholder Franchise Values';

IF(pCategory @= '');
  ProcessError;
ENDIF;
IF(DIMIX('Merch Category', pCategory) = 0);
  ProcessError;
ENDIF;

OnMinorErrorDoItemSkip = 1;

sViewName = '}PLI_W_' | pCategory;
IF(ViewExists(sCubeAttr, sViewName) = 1);
  ViewDestroy(sCubeAttr, sViewName);
ENDIF;
sMDX = 'SELECT {[}ElementAttributes_Merch SKU].[SGM_Category]} ON COLUMNS, ';
sMDX = sMDX | 'NON EMPTY {TM1FILTERBYLEVEL([Merch SKU].[Merch SKU].MEMBERS, 0)} ON ROWS ';
sMDX = sMDX | 'FROM [}ElementAttributes_Merch SKU]';
ViewCreateByMDX(sCubeAttr, sViewName, sMDX, 1);
ViewExtractSkipZeroesSet(sCubeAttr, sViewName, 0);

DatasourceType = 'VIEW';
DatasourceNameForServer = sCubeAttr;
DatasourceCubeview = sViewName;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(pCategory @= '');
  ItemReject('pCategory empty');
ENDIF;
IF(vSKU @= '');
  ItemReject('vSKU empty');
ENDIF;
IF(DIMIX('Merch SKU', vSKU) = 0);
  ItemSkip;
ENDIF;
sCat = ATTRS('Merch SKU', vSKU, 'SGM_Category');
IF(sCat @<> pCategory);
  ItemSkip;
ENDIF;
sL4 = ATTRS('Merch SKU', vSKU, 'Level_4');
sVen = ATTRS('Merch SKU', vSKU, 'Vendor_Name');
sFran = ATTRS('Merch SKU', vSKU, 'Franchise_Name');
IF(sL4 @= '');
  sL4 = 'Any';
ENDIF;
IF(sVen @= '');
  sVen = 'Any';
ENDIF;
IF(sFran @= '');
  sFran = 'Any';
ENDIF;
IF(DIMIX(sL4Dim, sL4) = 0);
  ItemSkip;
ENDIF;
IF(DIMIX(sVDim, sVen) = 0);
  ItemSkip;
ENDIF;
IF(DIMIX(sFDim, sFran) = 0);
  ItemSkip;
ENDIF;
IF(CellIsUpdateable(sCube, pCategory, sL4, sVen, sFran, vSKU) = 0);
  ItemSkip;
ENDIF;
CellPutN(1, sCube, pCategory, sL4, sVen, sFran, vSKU);

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
sViewCleanup = '}PLI_W_' | pCategory;
IF(ViewExists('}ElementAttributes_Merch SKU', sViewCleanup) = 1);
  ViewDestroy('}ElementAttributes_Merch SKU', sViewCleanup);
ENDIF;

#endregion