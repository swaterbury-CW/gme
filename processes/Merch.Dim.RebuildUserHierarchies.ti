#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-05-01
# LAST UPDATE: 2026-05-01
# CHANGED BY : Steve Waterbury
# CHANGE HISTORY:
#   2026-05-01 | Steve Waterbury | v3 — single 'User Rollups' alt hier on Merch SKU; reads Override (stored) cells; user-typed group names become C-children of slot Cs H1-H5.

sCube = 'Merch User Hierarchy Assignment';
sDim = 'Merch SKU';
sAltHier = 'User Rollups';
OnMinorErrorDoItemSkip = 1;
nRowCount = 0;
sTouchedGroups = '|';
sTouchedSkus = '|';

IF(HierarchyExists(sDim, sAltHier) = 1);
  HierarchyDestroy(sDim, sAltHier);
ENDIF;
HierarchyCreate(sDim, sAltHier);
HierarchyElementInsert(sDim, sAltHier, '', 'H1', 'C');
HierarchyElementInsert(sDim, sAltHier, '', 'H2', 'C');
HierarchyElementInsert(sDim, sAltHier, '', 'H3', 'C');
HierarchyElementInsert(sDim, sAltHier, '', 'H4', 'C');
HierarchyElementInsert(sDim, sAltHier, '', 'H5', 'C');

sViewName = '}MUH_Build_v3';
IF(ViewExists(sCube, sViewName) = 1);
  ViewDestroy(sCube, sViewName);
ENDIF;
sMDX = 'SELECT ';
sMDX = sMDX | '{[Merch User Hierarchy Measure].[Merch User Hierarchy Measure].[Override Hierarchy 1],';
sMDX = sMDX | ' [Merch User Hierarchy Measure].[Merch User Hierarchy Measure].[Override Hierarchy 2],';
sMDX = sMDX | ' [Merch User Hierarchy Measure].[Merch User Hierarchy Measure].[Override Hierarchy 3],';
sMDX = sMDX | ' [Merch User Hierarchy Measure].[Merch User Hierarchy Measure].[Override Hierarchy 4],';
sMDX = sMDX | ' [Merch User Hierarchy Measure].[Merch User Hierarchy Measure].[Override Hierarchy 5]} ON COLUMNS, ';
sMDX = sMDX | 'NON EMPTY {CROSSJOIN(';
sMDX = sMDX | '[Merch SKU].[Merch SKU].MEMBERS,';
sMDX = sMDX | '[}Clients].[}Clients].MEMBERS)} ON ROWS ';
sMDX = sMDX | 'FROM [Merch User Hierarchy Assignment]';
ViewCreateByMDX(sCube, sViewName, sMDX, 1);
ViewExtractSkipZeroesSet(sCube, sViewName, 0);

DatasourceType = 'VIEW';
DatasourceNameForServer = sCube;
DatasourceCubeview = sViewName;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
nRowCount = nRowCount + 1;

IF(vValue @= '');
  ItemSkip;
ENDIF;
IF(SUBST(vClient, 1, 1) @= '}');
  ItemSkip;
ENDIF;
IF(vSKU @= '');
  ItemSkip;
ENDIF;

nMLen = LONG(vMeasure);
IF(nMLen < 1);
  ItemSkip;
ENDIF;
sSlot = SUBST(vMeasure, nMLen, 1);
sSlotKey = 'H' | sSlot;

sGroupMarker = '|' | sSlotKey | ':' | vValue | '|';
IF(SCAN(sGroupMarker, sTouchedGroups) = 0);
  sTouchedGroups = sTouchedGroups | sSlotKey | ':' | vValue | '|';
  IF(HierarchyElementExists(sDim, sAltHier, vValue) = 0);
    HierarchyElementInsert(sDim, sAltHier, '', vValue, 'C');
  ENDIF;
  HierarchyElementComponentAdd(sDim, sAltHier, sSlotKey, vValue, 1);
ENDIF;

sSkuMarker = '|' | vValue | ':' | vSKU | '|';
IF(SCAN(sSkuMarker, sTouchedSkus) = 0);
  sTouchedSkus = sTouchedSkus | vValue | ':' | vSKU | '|';
  IF(HierarchyElementExists(sDim, sAltHier, vSKU) = 0);
    HierarchyElementInsert(sDim, sAltHier, '', vSKU, 'N');
  ENDIF;
  HierarchyElementComponentAdd(sDim, sAltHier, vValue, vSKU, 1);
ENDIF;

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
LogOutput('info', 'Merch.Dim.RebuildUserHierarchies: rows iterated = ' | TRIM(STR(nRowCount, 10, 0)));
sViewCleanup = '}MUH_Build_v3';
IF(ViewExists('Merch User Hierarchy Assignment', sViewCleanup) = 1);
  ViewDestroy('Merch User Hierarchy Assignment', sViewCleanup);
ENDIF;

#endregion