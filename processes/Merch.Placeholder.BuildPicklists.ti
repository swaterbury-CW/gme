cProcessName = GetProcessName();
nStart = NOW;

LogOutput('INFO', cProcessName | ' | START | CategoryFilter=' | pCategoryFilter);

ExecuteProcess('Merch.Placeholder.BuildPicklistIndex.PreSeed', 'pCategoryFilter', pCategoryFilter);
LogOutput('INFO', cProcessName | ' | Stage 1 done: PreSeed');

sRunIdStr = TRIM(STR(INT(NOW * 86400), 12, 0));

ExecuteProcess('Merch.Placeholder.BuildPicklistIndex', 'pWorkerName', 'Merch.Placeholder.BuildPicklistIndex.Worker', 'pCategoryFilter', pCategoryFilter);
LogOutput('INFO', cProcessName | ' | Stage 2 done: BuildPicklistIndex');

ExecuteProcess('Merch.Placeholder.BuildPicklistIndex.Subsets', 'pWorkerName', 'Merch.Placeholder.BuildPicklistIndex.Subsets.Worker', 'pCategoryFilter', pCategoryFilter, 'pRunId', sRunIdStr);
LogOutput('INFO', cProcessName | ' | Stage 3 done: BuildPicklistIndex.Subsets');

LogOutput('INFO', cProcessName | ' | END | Elapsed=' | TRIM(STR((NOW - nStart) * 86400, 12, 1)) | 's');

