#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-26
# LAST UPDATE: 2026-05-10
# CHANGED BY : Steve Waterbury
# COMMENTS:
# Copies SKU dimension attributes into Merch Version SKU Attributes.
# Mapping is dynamic via Source_Attribute alias reverse-lookup + exact-name fallback.
#
#### CHANGE HISTORY:
### 2026-03-26  Steve Waterbury  Initial creation
### 2026-04-01  Steve Waterbury  Applied guardrails header template; multi-line IF
### 2026-04-25  Steve Waterbury  Fix Street_Date attr; add ETA; ItemReject; explicit Datasourcetype; hierarchy-qualified MDX
### 2026-05-01  Steve Waterbury  Seed GPG_Eligible + PRP_Eligible into versioned cube
### 2026-05-02  Steve Waterbury  Mirror Is_Replenishable -> Is Replenishable
### 2026-05-06  Steve Waterbury  Convert to VIEW datasource; per-version ZeroOut
### 2026-05-10  Steve Waterbury  Replace hard-coded mapping with Source_Attribute-driven dynamic loop
#EndRegion

sLogLevel = CellGetS('ProcessControl', GetProcessName(), 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'OFF';
ENDIF;
bLogInfo = 0;
bLogDebug = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(sLogLevel @= 'DEBUG');
  bLogDebug = 1;
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'START: ' | GetProcessName() | ' | pVersion=' | pVersion);
ENDIF;

IF(DIMIX('Merch Version', pVersion) = 0);
  LogOutput('ERROR', GetProcessName() | ' | Invalid pVersion: ' | pVersion);
  ProcessError;
ENDIF;

sMeasDim  = 'Merch Version SKU Attribute Measure';
sAttrDim  = '}ElementAttributes_Merch SKU';
sAttrCube = '}ElementAttributes_Merch SKU';

sMapAttrs   = '';
sMapMeas    = '';
sMapNumeric = '';
nMapCount   = 0;

nAttrCount = DIMSIZ(sAttrDim);
nIdx = 1;
WHILE(nIdx <= nAttrCount);
  sAttr = DIMNM(sAttrDim, nIdx);
  IF(sAttr @<> '');
    sTarget = '';
    nMeasCount = DIMSIZ(sMeasDim);
    nMeasIdx = 1;
    WHILE(nMeasIdx <= nMeasCount);
      sM = DIMNM(sMeasDim, nMeasIdx);
      IF(DTYPE(sMeasDim, sM) @<> 'C' & ATTRS(sMeasDim, sM, 'Source_Attribute') @= sAttr);
        sTarget = sM;
        nMeasIdx = nMeasCount + 1;
      ELSE;
        nMeasIdx = nMeasIdx + 1;
      ENDIF;
    END;
    IF(sTarget @= '' & DIMIX(sMeasDim, sAttr) > 0);
      IF(DTYPE(sMeasDim, sAttr) @<> 'C');
        sTarget = sAttr;
      ENDIF;
    ENDIF;
    IF(sTarget @<> '');
      sIsNum = '0';
      IF(DTYPE(sMeasDim, sTarget) @= 'N');
        sIsNum = '1';
      ENDIF;
      sMapAttrs   = sMapAttrs   | sAttr   | ';';
      sMapMeas    = sMapMeas    | sTarget | ';';
      sMapNumeric = sMapNumeric | sIsNum  | ';';
      nMapCount = nMapCount + 1;
      IF(bLogDebug = 1);
        LogOutput('DEBUG', 'MAP: ' | sAttr | ' -> ' | sTarget | ' (N=' | sIsNum | ')');
      ENDIF;
    ELSE;
      IF(bLogDebug = 1);
        LogOutput('DEBUG', 'SKIP attr (no target): ' | sAttr);
      ENDIF;
    ENDIF;
  ENDIF;
  nIdx = nIdx + 1;
END;

IF(bLogInfo = 1);
  LogOutput('INFO', GetProcessName() | ' | resolved mapping count=' | NumberToString(nMapCount));
ENDIF;

IF(nMapCount = 0);
  LogOutput('ERROR', GetProcessName() | ' | No attributes resolved to target measures');
  ProcessError;
ENDIF;

sCube  = 'Merch Version SKU Attributes';
sZSKU  = 'temp_PopVerSKUAttr_ZSKU';
sZMeas = 'temp_PopVerSKUAttr_ZMeas';
sZVer  = 'temp_PopVerSKUAttr_ZVer';
sZView = 'temp_PopVerSKUAttr_ZView';

IF(SubsetExists('Merch SKU', sZSKU) = 1);
  SubsetDestroy('Merch SKU', sZSKU);
ENDIF;
SubsetCreateByMDX(sZSKU, '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}');

IF(SubsetExists('Merch Version', sZVer) = 1);
  SubsetDestroy('Merch Version', sZVer);
ENDIF;
SubsetCreate('Merch Version', sZVer);
SubsetElementInsert('Merch Version', sZVer, pVersion, 0);

IF(SubsetExists(sMeasDim, sZMeas) = 1);
  SubsetDestroy(sMeasDim, sZMeas);
ENDIF;
SubsetCreate(sMeasDim, sZMeas);
sRest = sMapMeas;
WHILE(LONG(sRest) > 0);
  nPos = SCAN(';', sRest);
  IF(nPos = 0);
    sRest = '';
  ELSE;
    sTok = SUBST(sRest, 1, nPos - 1);
    IF(sTok @<> '');
      SubsetElementInsert(sMeasDim, sZMeas, sTok, 0);
    ENDIF;
    sRest = SUBST(sRest, nPos + 1, LONG(sRest) - nPos);
  ENDIF;
END;

IF(ViewExists(sCube, sZView) = 1);
  ViewDestroy(sCube, sZView);
ENDIF;
ViewCreate(sCube, sZView);
ViewSubsetAssign(sCube, sZView, 'Merch Version', sZVer);
ViewSubsetAssign(sCube, sZView, 'Merch SKU', sZSKU);
ViewSubsetAssign(sCube, sZView, sMeasDim, sZMeas);
ViewExtractSkipCalcsSet(sCube, sZView, 1);
ViewExtractSkipRuleValuesSet(sCube, sZView, 1);
ViewZeroOut(sCube, sZView);

ViewDestroy(sCube, sZView);
SubsetDestroy('Merch Version', sZVer);
SubsetDestroy(sMeasDim, sZMeas);
SubsetDestroy('Merch SKU', sZSKU);

sSubSKU  = 'temp_PopVerSKUAttr_RSKU';
sSubAttr = 'temp_PopVerSKUAttr_RAttr';
sView    = 'temp_PopVerSKUAttr_RView';

IF(SubsetExists('Merch SKU', sSubSKU) = 1);
  SubsetDestroy('Merch SKU', sSubSKU);
ENDIF;
SubsetCreateByMDX(sSubSKU, '{TM1FILTERBYLEVEL({TM1SUBSETALL([Merch SKU].[Merch SKU])}, 0)}');

IF(SubsetExists(sAttrDim, sSubAttr) = 1);
  SubsetDestroy(sAttrDim, sSubAttr);
ENDIF;
SubsetCreate(sAttrDim, sSubAttr);
sRest = sMapAttrs;
WHILE(LONG(sRest) > 0);
  nPos = SCAN(';', sRest);
  IF(nPos = 0);
    sRest = '';
  ELSE;
    sTok = SUBST(sRest, 1, nPos - 1);
    IF(sTok @<> '');
      SubsetElementInsert(sAttrDim, sSubAttr, sTok, 0);
    ENDIF;
    sRest = SUBST(sRest, nPos + 1, LONG(sRest) - nPos);
  ENDIF;
END;

IF(ViewExists(sAttrCube, sView) = 1);
  ViewDestroy(sAttrCube, sView);
ENDIF;
ViewCreate(sAttrCube, sView);
ViewSubsetAssign(sAttrCube, sView, 'Merch SKU', sSubSKU);
ViewSubsetAssign(sAttrCube, sView, sAttrDim, sSubAttr);
ViewExtractSkipCalcsSet(sAttrCube, sView, 1);
ViewExtractSkipRuleValuesSet(sAttrCube, sView, 1);
ViewExtractSkipZeroesSet(sAttrCube, sView, 1);

Datasourcetype          = 'VIEW';
DatasourceNameForServer = sAttrCube;
DatasourceCubeview      = sView;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(vSKU @= '');
  ItemSkip;
ENDIF;
IF(DTYPE('Merch SKU', vSKU) @<> 'N');
  ItemSkip;
ENDIF;

sKey = ';' | vAttr | ';';
sLook = ';' | sMapAttrs;
nPos = SCAN(sKey, sLook);
IF(nPos = 0);
  ItemSkip;
ENDIF;
nTokenIdx = 0;
nP = 1;
WHILE(nP <= nPos);
  IF(SUBST(sLook, nP, 1) @= ';');
    nTokenIdx = nTokenIdx + 1;
  ENDIF;
  nP = nP + 1;
END;

sTarget = '';
sRest = sMapMeas;
nT = 0;
WHILE(LONG(sRest) > 0);
  nP = SCAN(';', sRest);
  IF(nP = 0);
    sRest = '';
  ELSE;
    nT = nT + 1;
    IF(nT = nTokenIdx);
      sTarget = SUBST(sRest, 1, nP - 1);
      sRest = '';
    ELSE;
      sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
    ENDIF;
  ENDIF;
END;

sIsNum = '0';
sRest = sMapNumeric;
nT = 0;
WHILE(LONG(sRest) > 0);
  nP = SCAN(';', sRest);
  IF(nP = 0);
    sRest = '';
  ELSE;
    nT = nT + 1;
    IF(nT = nTokenIdx);
      sIsNum = SUBST(sRest, 1, nP - 1);
      sRest = '';
    ELSE;
      sRest = SUBST(sRest, nP + 1, LONG(sRest) - nP);
    ENDIF;
  ENDIF;
END;

IF(sTarget @= '');
  ItemSkip;
ENDIF;

IF(CellIsUpdateable(sCube, pVersion, vSKU, sTarget) = 0);
  LogOutput('ERROR', GetProcessName() | ' | Not updateable: ' | pVersion | ' / ' | vSKU | ' / ' | sTarget);
  ItemSkip;
ENDIF;

IF(sIsNum @= '1');
  CellPutN(NUMBR(Value), sCube, pVersion, vSKU, sTarget);
ELSE;
  CellPutS(Value, sCube, pVersion, vSKU, sTarget);
ENDIF;


#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
sAttrCube = '}ElementAttributes_Merch SKU';
sAttrDim  = '}ElementAttributes_Merch SKU';
sSubSKU  = 'temp_PopVerSKUAttr_RSKU';
sSubAttr = 'temp_PopVerSKUAttr_RAttr';
sView    = 'temp_PopVerSKUAttr_RView';

IF(ViewExists(sAttrCube, sView) = 1);
  ViewDestroy(sAttrCube, sView);
ENDIF;
IF(SubsetExists('Merch SKU', sSubSKU) = 1);
  SubsetDestroy('Merch SKU', sSubSKU);
ENDIF;
IF(SubsetExists(sAttrDim, sSubAttr) = 1);
  SubsetDestroy(sAttrDim, sSubAttr);
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', 'END: ' | GetProcessName() | ' | pVersion=' | pVersion);
ENDIF;

#endregion