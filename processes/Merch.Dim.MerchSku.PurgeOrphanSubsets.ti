#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
# DEVELOPER:    Steve Waterbury
# CREATED ON:   2026-05-04
# LAST UPDATE:  2026-05-04
# CHANGED BY:   Steve Waterbury
# CHANGE HISTORY:
#   2026-05-04 | Steve Waterbury | v1: PL_ + 3 PLI patterns
#   2026-05-04 | Steve Waterbury | v2: added PLI_SbyV_ rule
#   2026-05-04 | Steve Waterbury | v3: simplified to PL_ + PLI_Sby* umbrella for twin-dim cutover

cProcessName = GetProcessName();
sLogLevel = CellGetS('ProcessControl', cProcessName, 'LoggingLevel');
IF(sLogLevel @= '');
  sLogLevel = 'INFO';
ENDIF;
bLogInfo = 0;
IF(sLogLevel @= 'INFO' % sLogLevel @= 'DEBUG');
  bLogInfo = 1;
ENDIF;
IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | START | pMode=' | pMode);
ENDIF;

sMode = pMode;
IF(sMode @<> 'AUDIT' & sMode @<> 'DELETE');
  LogOutput('ERROR', cProcessName | ' | invalid pMode (AUDIT or DELETE): ' | pMode);
  ProcessError;
ENDIF;

cIterDim = '}Subsets_Merch SKU';
cIterSub = 'PurgeOrphan_Run_' | TRIM(STR(INT(NOW * 86400), 15, 0));
cTargetDim = 'Merch SKU';
cAuditFile = 'audit_merchsku_orphan_subsets.txt';

IF(SubsetExists(cIterDim, cIterSub) = 1);
  SubsetDestroy(cIterDim, cIterSub);
ENDIF;
SubsetCreatebyMDX(cIterSub, '{TM1SUBSETALL([}Subsets_Merch SKU])}');

DatasourceType = 'SUBSET';
DatasourceNameForServer = cIterDim;
DatasourceDimensionSubset = cIterSub;

nTotalSeen = 0;
nOrphanPL = 0;
nOrphanPLI = 0;
nDeleted = 0;
nFailed = 0;

IF(sMode @= 'AUDIT');
  ASCIIOutput(cAuditFile, 'subset_name', 'category', 'size');
ENDIF;

#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
sName = vSubsets_Merch_SKU;
nTotalSeen = nTotalSeen + 1;

IF(sName @= '');
  ItemSkip;
ENDIF;

bOrphan = 0;

If(SCAN( 'SGM', trim(sname) )<>0);
    bOrphan = 1;
endif;

IF(bOrphan = 0);
  ItemSkip;
ENDIF;


    SubsetDestroy(cTargetDim, sName);

#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****


#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
IF(SubsetExists(cIterDim, cIterSub) = 1);
  SubsetDestroy(cIterDim, cIterSub);
ENDIF;

nTotalOrphans = nOrphanPL + nOrphanPLI;

IF(CellIsUpdateable('ProcessControl', cProcessName, 'SubsetCount') = 1);
  CellPutN(nTotalOrphans, 'ProcessControl', cProcessName, 'SubsetCount');
ENDIF;

IF(bLogInfo = 1);
  LogOutput('INFO', cProcessName | ' | END | mode=' | sMode | ' | total=' | TRIM(STR(nTotalSeen, 10, 0)) | ' | orphans=' | TRIM(STR(nTotalOrphans, 10, 0)) | ' | PL_=' | TRIM(STR(nOrphanPL, 10, 0)) | ' | PLI=' | TRIM(STR(nOrphanPLI, 10, 0)) | ' | Deleted=' | TRIM(STR(nDeleted, 10, 0)) | ' | Failed=' | TRIM(STR(nFailed, 10, 0)));
ENDIF;

#endregion