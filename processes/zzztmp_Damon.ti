#region Prolog
#****Begin: Generated Statements***
#****End: Generated Statements****
#Region : Process Header
#############################
##~~ Start Process ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-15
# LAST UPDATE: 2026-04-15
# COMMENTS:
# Create Subsets in SGM Category Hierarchy
#
#### CHANGE HISTORY:
### MODIFICATION DATE  CHANGED BY         COMMENT
### 2026-04-15         Damon Shuai    Initial creation
#
#EndRegion

################################################################################################# 
#Region Process Declarations
### Process Parameters

### Declare Constants
cDimSrc = 'Merch SKU';
cDimTgt = 'Merch SKU';
cHierSrc = pHierarchy;
cHierTgt = pHierarchy;
cAttrName = pAttribute;

### Declare Strings

### Create Random String
sTempName = GetProcessName();
sTempName = '}TI_' | sTempName | NumberToString(Int(Rand() * 1000000));
sSubName = sTempName | '_Source';

#EndRegion Process Declarations 
################################################################################################# 
### Create Subset
sMDX = '{EXCEPT(DRILLDOWNMEMBER({[Merch SKU].[SGM_Category].[All SGM_Category]} 
        , {[Merch SKU].[SGM_Category].[All SGM_Category]} , RECURSIVE) 
        , {[Merch SKU].[SGM_Category].[All SGM_Category]} , ALL)}';
HierarchySubsetCreate(cDimSrc, cHierSrc, sSubName, 1);
HierarchySubsetMDXSet(cDimSrc, cHierSrc, sSubName, sMDX);

### Declare Data Source
DataSourceType = 'SUBSET';
DataSourceNameForServer = cDimSrc|':'|cHierSrc;
DatasourceDimensionSubset = sSubName;
#EndRegion - DataSource
### End Prolog ###
#endregion
#region Metadata
#****Begin: Generated Statements***
#****End: Generated Statements****
# Loop Category
sTmpMDX = 'TM1FILTERBYLEVEL(DISTINCT(DESCENDANTS(['|cDimSrc|'].['|cHierSrc|'].['|vMerchSKUSGM_Category|'])) , 0)';
IF (SCAN('/', vMerchSKUSGM_Category) <> 0);
  nPos = SCAN('/', vMerchSKUSGM_Category);
  vMerchSKUSub = DELET(vMerchSKUSGM_Category, nPos, 1);
ELSE;
  vMerchSKUSub = vMerchSKUSGM_Category;
ENDIF;
sTmpSubName = TRIM(vMerchSKUSub)|'_TmpSubset';
HierarchySubsetCreate(cDimSrc, cHierSrc, sTmpSubName, 1);
HierarchySubsetMDXSet(cDimSrc, cHierSrc, sTmpSubName, sTmpMDX);
nTotal = HierarchySubsetGetSize(cDimSrc, cHierSrc, sTmpSubName);
n = 1;
WHILE(n <= nTotal);
  sTmpChild = HierarchySubsetGetElementName(cDimSrc, cHierSrc, sTmpSubName, n);
  sAttrValue = ElementAttrS(cDimSrc, cHierSrc, sTmpChild, cAttrName);
  IF (sAttrValue @<> '');
    sSubNameTgt = 'All '|vMerchSKUSub|' SKUs ('|sAttrValue|' '|cAttrName|')';
    IF (pMode = 0);
      IF (HierarchySubsetExists(cDimTgt, cHierTgt, sSubNameTgt) <> 0);
        HierarchySubsetDestroy(cDimTgt, cHierTgt, sSubNameTgt);
      ENDIF;
    ELSEIF (pMode = 1);
      IF (HierarchySubsetExists(cDimTgt, cHierTgt, sSubNameTgt) = 0);
        HierarchySubsetCreate(cDimTgt, cHierTgt, sSubNameTgt, 0);
      ENDIF;
      sSubMDX = HierarchySubsetMDXGet(cDimTgt, cHierTgt, sSubNameTgt);
      IF (sSubMDX @= '');
        sSubMDX = '{FILTER(TM1FILTERBYLEVEL(DISTINCT(DESCENDANTS(['|cDimTgt|'].['|cHierTgt|'].['|vMerchSKUSGM_Category|'])) , 0) 
        , (['|cDimTgt|'].['|cHierTgt|'].CURRENTMEMBER.PROPERTIES("'|cAttrName|'") = "'|sAttrValue|'"))}';
        HierarchySubsetMDXSet(cDimTgt, cHierTgt, sSubNameTgt, sSubMDX);
      ENDIF;
    ENDIF;
  ENDIF;
  n = n + 1;
END;
#endregion
#region Data
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion
#region Epilog
#****Begin: Generated Statements***
#****End: Generated Statements****
#endregion