#Region : Start Mode
['Start Mode'] = S:
  IF(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Start Mode') @<> '',
    DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Start Mode'),
    CellValueS('Merch Curve Assignment',
               'Merch Version':!Merch Version,
               'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
               'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)
  );
#EndRegion

#Region : Applied Start Date
['Applied Start Date'] = N:
  IF(LONG(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Start Date')) = 10,
    DAYNO(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Start Date')),
    CellValueN('Merch Curve Assignment',
               'Merch Version':!Merch Version,
               'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
               'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)
  );

['Applied Start Date'] = C:
  IF(LONG(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Start Date')) = 10,
    DAYNO(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Start Date')),
    CellValueN('Merch Curve Assignment',
               'Merch Version':!Merch Version,
               'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
               'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)
  );
#EndRegion

