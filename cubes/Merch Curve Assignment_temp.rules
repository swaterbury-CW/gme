SKIPCHECK;
#Region : Rule Header
# CUBE: Merch Curve Assignment_temp
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-08
# LAST UPDATE: 2026-05-08
# COMMENTS: v3 pattern. Each Applied measure: own Override if present, else CellValue lookup at parent SKU under 'Roles' alt-hierarchy with full 'Merch SKU':'Roles':<elem> triple addressing. Date Overrides stored as YYYY-MM-DD (10 chars); DAYNO accepts ISO directly.
# CHANGE HISTORY:
#   2026-05-08 | Steve Waterbury | v1 CellValueS/N pattern (terminal IF + Hier:Elem). Design plan 753e148f4afe.
#   2026-05-08 | Steve Waterbury | v2 — dropped terminal IF; full 'Merch SKU':'Roles':<elem> triple. Design plan 68364d901c30.
#   2026-05-08 | Steve Waterbury | v3 — Override dates are YYYY-MM-DD (LONG=10), pass to DAYNO directly. Design plan 7649a8d45049.
#EndRegion

#Region : Applied Category Build Curve
['Applied Category Build Curve'] = S:
  IF(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Category Build Curve') @<> '',
    DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Category Build Curve'),
    CellValueS('Merch Curve Assignment',
               'Merch Version':!Merch Version,
               'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
               'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)
  );
#EndRegion

#Region : Applied Markdown Curve
['Applied Markdown Curve'] = S:
  IF(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Markdown Curve') @<> '',
    DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override Markdown Curve'),
    CellValueS('Merch Curve Assignment',
               'Merch Version':!Merch Version,
               'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
               'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)
  );
#EndRegion

