SKIPCHECK;
FEEDSTRINGS;
#Region : Rule Header
# CUBE: Merch Rate Target
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-05-22
# CHANGE HISTORY:
#   2026-05-22 | Steve Waterbury | Initial — Roles cascade per 10 base measures.
#   2026-05-25 | Steve Waterbury | Cascade fix: Applied + Expected unqualified (no =N:/=C:); mirrors Merch Curve Assignment.
#EndRegion

#Region : Non-Calculated Gate
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',0,CONTINUE);
#EndRegion

#Region : Build/Debuild
['Build/Debuild Current']=N:DB('Merch Forecast',!Merch Version,!Merch Time Period,!Merch SKU,'Build/Debuild');
['Build/Debuild Current']=C:DB('Merch Forecast',!Merch Version,!Merch Time Period,!Merch SKU,'Build/Debuild');
['Build/Debuild Applied']=IF(DB('Merch Rate Target',!Merch Version,!Merch Time Period,!Merch SKU,'Build/Debuild Override')@<>'',NUMBR(DB('Merch Rate Target',!Merch Version,!Merch Time Period,!Merch SKU,'Build/Debuild Override')),IF(ElementParent('Merch SKU','Roles',!Merch SKU,1)@='',['Build/Debuild Current'],CellValueN('Merch Rate Target','Merch Version':!Merch Version,'Merch Time Period':!Merch Time Period,'Merch SKU':'Roles':ElementParent('Merch SKU','Roles',!Merch SKU,1),'Merch Rate Target Measure':!Merch Rate Target Measure)));
['Build/Debuild Expected']=IF(DB('Merch Rate Target',!Merch Version,!Merch Time Period,!Merch SKU,'Build/Debuild Override')@<>'',NUMBR(DB('Merch Rate Target',!Merch Version,!Merch Time Period,!Merch SKU,'Build/Debuild Override')),IF(ElementParent('Merch SKU','Roles',!Merch SKU,1)@='',['Build/Debuild Current'],['Build/Debuild Current']*(CellValueN('Merch Rate Target','Merch Version':!Merch Version,'Merch Time Period':!Merch Time Period,'Merch SKU':'Roles':ElementParent('Merch SKU','Roles',!Merch SKU,1),'Merch Rate Target Measure':!Merch Rate Target Measure)\DB('Merch Rate Target',!Merch Version,!Merch Time Period,ElementParent('Merch SKU','Roles',!Merch SKU,1),'Build/Debuild Current'))));
#EndRegion

