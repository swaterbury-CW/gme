SKIPCHECK;
#Region : Rule Header
# CUBE: Merch PreOwned Inventory
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-04-03
# COMMENTS: Pre-Owned inventory roll. Actual and Calculated-closed cells STET to stored loaded values.
# CHANGE HISTORY:
#   2026-04-03 | Steve Waterbury | Initial creation
#   2026-04-19 | Steve Waterbury | Added STET guard for Actual and Calculated-closed
#   2026-05-17 | Steve Waterbury | Removed WOS measure rules + feeder (WOS element deleted from measure dim)
#EndRegion

#Region : Version STET Guard
['Actual'] = N: STET;
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE, IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'), STET,CONTINUE));
#EndRegion

#Region : Inventory Calculations
['Sales Outflow'] = N: DB('Merch PreOwned Forecast', !Merch Version, !Merch Time Period, !Merch PreOwned Category, 'Sales Units');
['BOH Units'] = N: IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '', STET, DB('Merch PreOwned Inventory', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'), !Merch PreOwned Category, 'EOH Units'));
['EOH Units'] = N: ['BOH Units'] + ['Trade Receipts'] + ['External Purchases'] - ['Sales Outflow'] - ['Destroys'] + ['Inventory Adjustment'];
#EndRegion

#Region : C-level
['BOH Units'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, DB('Merch PreOwned Inventory', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'First Leaf Week'), !Merch PreOwned Category, 'BOH Units'));
['EOH Units'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, DB('Merch PreOwned Inventory', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Last Leaf Week'), !Merch PreOwned Category, 'EOH Units'));
#EndRegion

FEEDERS;
#Region : Feeders
['Trade Receipts'] => ['EOH Units'];
['External Purchases'] => ['EOH Units'];
['Destroys'] => ['EOH Units'];
['Inventory Adjustment'] => ['EOH Units'];
['Trade Receipts'] => ['BOH Units'];
#EndRegion
