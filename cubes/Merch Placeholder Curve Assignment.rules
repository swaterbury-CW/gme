SKIPCHECK;
#Region : Rule Header
# CUBE       : Merch Placeholder Curve Assignment
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-25
# LAST UPDATE: 2026-06-10
# COMMENTS: Mirror Override -> Applied per intersection. Start Mode default = 'Seasonal'.
#### CHANGE HISTORY:
### 2026-04-25  Steve Waterbury  Initial rule creation
### 2026-06-02  Steve Waterbury  Removed Applied Category Build Curve region (Category Build dropped as curve type, plan c1cd290268f6)
### 2026-06-10  Steve Waterbury  Added Applied Rate Adjustment % region (plan c83f39a376bb EP-PH1)
#EndRegion

#Region : Applied Velocity Curve
['Applied Velocity Curve'] = S:
  IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Velocity Curve') @<> '',
    DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Velocity Curve'),
    '');
#EndRegion

#Region : Applied Seasonality Curve
['Applied Seasonality Curve'] = S:
  IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Seasonality Curve') @<> '',
    DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Seasonality Curve'),
    '');
#EndRegion

#Region : Applied Regime Curve
['Applied Regime Curve'] = S:
  IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Regime Curve') @<> '',
    DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Regime Curve'),
    '');
#EndRegion

#Region : Applied Markdown Curve
['Applied Markdown Curve'] = S:
  IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Markdown Curve') @<> '',
    DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Markdown Curve'),
    '');
#EndRegion

#Region : Start Mode (default Seasonal)
['Start Mode'] = S:
  IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Start Mode') @<> '',
    DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Start Mode'),
    'Seasonal');
#EndRegion

#Region : Applied Rate Adjustment %
['Applied Rate Adjustment %'] = N:
  IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Rate Adjustment %') @<> '',
    NUMBR(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Override Rate Adjustment %')),
    0);
#EndRegion

FEEDERS;

#Region : Feeders
# String rules under SKIPCHECK don't require feeders.
#EndRegion

#Region : Rule Footer
#EndRegion
