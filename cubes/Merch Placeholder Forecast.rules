SKIPCHECK;
#Region : Rule Header
# CUBE       : Merch Placeholder Forecast
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-03-30
# CHANGE HISTORY:
#   2026-05-20 | Steve Waterbury | Full parity rewrite mirroring Merch Forecast
#   2026-06-02 | Steve Waterbury | Curve realign (plan c1cd290268f6)
#   2026-06-08 | Steve Waterbury | (plan e5097192187b) Rates from Merch Placeholder Settings via DB(); ECS/Calc Units compound prior-week Units x Build/Debuild; Units->next-week feeders
#EndRegion
[] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Static', STET, CONTINUE);
['Receipts'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Actual', CONTINUE, IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date') <= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period'), STET, CONTINUE));
['Buy Units'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Actual', CONTINUE, ['Receipts']);
['Category Build'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Promo Build'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Markdown %'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Rate Adjustment'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Price Adjustment'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Level'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Seasonality'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Velocity'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Regime'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, STET);
['Full Price AUR'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, DB('Merch Placeholder Settings', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Full Price AUR'));
['Base AUC'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, DB('Merch Placeholder Settings', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Base AUC'));
['Sales AUC'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, DB('Merch Placeholder Settings', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Sales AUC'));
['Receipt AUC'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, DB('Merch Placeholder Settings', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Receipt AUC'));
['Receipt Dollars'] = N: ['Receipts'] * ['Receipt AUC'];
['BOP Dollars'] = N: IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '', STET, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'EOP Dollars'));
['EOP Dollars'] = N: ['BOP Dollars'] + ['Receipt Dollars'] - ['Cost'] + ['Inv Adjustment Dollars'];
['Inventory AUC'] = N: ['EOP Dollars'] \ ['Ending Inventory'];
['Promo'] = N: ['Full Price AUR'] * ['Markdown %'];
['Rate Adj Amount'] = N: (['Full Price AUR'] - ['Promo']) * ['Rate Adjustment'];
['Build/Debuild'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, IF(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') <> 0 & ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date') <= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period'), STET, IF(['Seasonality'] = 0 & ['Velocity'] = 0 & ['Promo Build'] = 0 & ['Regime'] = 0, 0, IF(['Seasonality'] = 0, 1, ['Seasonality']) * IF(['Velocity'] = 0, 1, ['Velocity']) * IF(['Promo Build'] = 0, 1, ['Promo Build']) * IF(['Regime'] = 0, 1, ['Regime']))));
['Calc Units'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, IF(['Build/Debuild'] = 0 & ['Category Build'] = 0, 0, IF(['Adjustment Units'] <> 0, 0, IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '', CONTINUE, IF(['Expected Calc Sales'] <= (['Opening Inventory'] + ['Receipts']), ['Expected Calc Sales'], IF((['Opening Inventory'] + ['Receipts']) <= 0, 0, (['Opening Inventory'] + ['Receipts'])))))));
['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @<> 'Calculated', CONTINUE, IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '', CONTINUE, ROUND(DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units') * IF(['Build/Debuild'] = 0, 1, ['Build/Debuild']))));
['CB Weighted Calc'] = N: ['Calc Units'] * IF(['Category Build'] = 0, 1, ['Category Build']);
['Margin %'] = N: ['Margin'] \ ['Revenue'];
['Opening Inventory'] = N: IF(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') = 0, STET, IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date') <= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, STET, IF(ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative') @= '', STET, DB('Merch Placeholder Forecast', !Merch Version, TIMST(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, '\Y-\m-\d'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Opening Inventory') + DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Receipts') - DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', TIMST(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, '\Y-\m-\d'), 'Prior Cumulative'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Receipts') - DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units') + DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', TIMST(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, '\Y-\m-\d'), 'Prior Cumulative'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units'))));
['Opening Inventory'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'First Leaf Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Opening Inventory')));
['Ending Inventory'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Last Leaf Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Ending Inventory')));
['BOP Dollars'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'First Leaf Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'BOP Dollars')));
['EOP Dollars'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Last Leaf Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'EOP Dollars')));
['Build/Debuild'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET, IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Period') @<> '', ['Units'] \ DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Period'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units'), IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @<> '', ['Units'] \ DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units'), STET)));
['Category Build'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET, ['CB Weighted Calc'] \ ['Calc Units']);
['Applied/Effective AUR'] = C: ['Revenue'] \ ['Units'];
['Full Price AUR'] = C: ['Base Revenue'] \ ['Units'];
['Promo'] = C: ['Markdown Revenue'] \ ['Units'];
['Markdown %'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET, ['Promo'] \ ['Full Price AUR']);
['Rate Adj Amount'] = C: IF(['Units'] = 0, 0, (['Revenue Adjustment'] \ ['Units']) - ['Price Adjustment']);
['Base AUC'] = C: ['Base Cost'] \ ['Units'];
['Backend Adjustment'] = C: ['Backend Cost'] \ ['Units'];
['Other AUC Adjustment'] = C: ['Other Cost Adjustment'] \ ['Units'];
['AUC'] = C: ['Cost'] \ ['Units'];
['Margin %'] = C: ['Margin'] \ ['Revenue'];
['Sales AUC'] = C: ['Cost'] \ ['Units'];
['Receipt AUC'] = C: ['Receipt Dollars'] \ ['Receipts'];
['Inventory AUC'] = C: ['EOP Dollars'] \ ['Ending Inventory'];
['Base Revenue'] = N: ['Units'] * ['Full Price AUR'];
['Markdown Revenue'] = N: ['Units'] * ['Promo'];
['Revenue Adjustment'] = N: ['Units'] * (['Rate Adj Amount'] + ['Price Adjustment']);
['Base Cost'] = N: ['Units'] * ['Base AUC'];
['Backend Cost'] = N: ['Units'] * ['Backend Adjustment'];
['Other Cost Adjustment'] = N: ['Units'] * ['Other AUC Adjustment'];
FEEDERS;
['Velocity'] => ['Build/Debuild'];
['Seasonality'] => ['Build/Debuild'];
['Regime'] => ['Build/Debuild'];
['Promo Build'] => ['Build/Debuild'];
['Receipts'] => ['Buy Units'];
['Receipts'] => ['Opening Inventory'], ['Receipt Dollars'], ['Receipt AUC'], ['BOP Dollars'], ['EOP Dollars'], ['Inventory AUC'];
['Opening Inventory'] => ['BOP Dollars'], ['EOP Dollars'], ['Inventory AUC'];
['Inv Adjustment Dollars'] => ['BOP Dollars'], ['EOP Dollars'], ['Inventory AUC'];
['Opening Inventory'] => DB(IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date_Serial') >= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period'), 'Merch Placeholder Forecast', ''), !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, !Merch Forecast Measure);
['Units'] => ['Cost'], ['AUC'], ['Margin'];
['Build/Debuild'] => ['Calc Units'];
['Build/Debuild'] => ['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Build/Debuild'] => ['CB Weighted Calc'];
['Build/Debuild'] => ['Full Price AUR'];
['Build/Debuild'] => ['Base AUC'];
['Build/Debuild'] => ['Promo'];
['Build/Debuild'] => ['Rate Adj Amount'];
['Build/Debuild'] => ['Base Revenue'];
['Build/Debuild'] => ['Markdown Revenue'];
['Build/Debuild'] => ['Revenue Adjustment'];
['Build/Debuild'] => ['Base Cost'];
['Build/Debuild'] => ['Backend Cost'];
['Build/Debuild'] => ['Other Cost Adjustment'];
['Build/Debuild'] => ['Opening Inventory'];
['Build/Debuild'] => ['EOP Dollars'];
['Build/Debuild'] => ['Margin %'];
['Build/Debuild'] => ['Sales AUC'];
['Category Build'] => ['Calc Units'];
['Category Build'] => ['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Category Build'] => ['CB Weighted Calc'];
['Category Build'] => ['Opening Inventory'];
['Category Build'] => ['EOP Dollars'];
['Promo Build'] => ['Calc Units'];
['Promo Build'] => ['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Promo Build'] => ['CB Weighted Calc'];
['Promo Build'] => ['Opening Inventory'];
['Promo Build'] => ['EOP Dollars'];
['Adjustment Units'] => ['Calc Units'];
['Adjustment Units'] => DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Calc Units');
['Adjustment Units'] => ['Opening Inventory'];
['Adjustment Units'] => ['EOP Dollars'];
['Merch Forecast Measure':'Merch Forecast Measure':'Units'] => DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Calc Units');
['Merch Forecast Measure':'Merch Forecast Measure':'Units'] => DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Expected Calc Sales');
['Markdown %'] => ['Promo'];
['Markdown %'] => ['Rate Adj Amount'];
['Markdown %'] => ['Markdown Revenue'];
['Rate Adjustment'] => ['Rate Adj Amount'];
['Rate Adjustment'] => ['Revenue Adjustment'];
['Price Adjustment'] => ['Revenue Adjustment'];
['Backend Adjustment'] => ['Backend Cost'];
['Other AUC Adjustment'] => ['Other Cost Adjustment'];
