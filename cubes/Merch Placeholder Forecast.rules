SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-03-25
# LAST UPDATE: 2026-04-21
# CUBE       : Merch Placeholder Forecast
# COMMENTS:
# Placeholder SKU forecast cube. Per-group planning: }Groups dim threaded
# through all DB() self-refs and Curve Assignment lookups.
#
#### CHANGE HISTORY:
### 2026-03-25  Steve Waterbury  Initial creation; removed Buy Units feeder
### 2026-04-01  Steve Waterbury  Applied guardrails header/footer template
### 2026-04-01  Steve Waterbury  Static STET guards for Calc Units, Opening Inventory, BD, CB, PB
### 2026-04-02  Steve Waterbury  Fixed division operators in C-level rules
### 2026-04-14  Steve Waterbury  Dropped redundant zero-guard IF wrappers around safe-division in C-level Recalculations.
### 2026-04-21  Steve Waterbury  Added !}Groups to all DB() coordinates (self-refs + Curve Assignment) for per-group planning
#
#EndRegion

#Region : Static - STET Overrides
['Calc Units'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Static', STET, CONTINUE);
['Opening Inventory'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Static', STET, CONTINUE);
['Build/Debuild'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Static', STET, CONTINUE);
['Category Build'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Static', STET, CONTINUE);
['Promo Build'] = N: IF(ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Static', STET, CONTINUE);
#EndRegion

#Region : Calc Units, AUR/AUC Lookups, Derived N-level Measures
['Calc Units'] = N: IF(['Build/Debuild'] = 0, CONTINUE, IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '', CONTINUE, ROUND(DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units') * ['Build/Debuild'] * IF(['Category Build'] = 0, 1, ['Category Build']) * IF(['Promo Build'] = 0, 1, ['Promo Build']))));

['Full Price AUR'] = N: IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Base AUR') > 0, DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Base AUR'), ATTRN('Merch Placeholder SKU', !Merch Placeholder SKU, 'Sales_Price'));
['Base AUC'] = N: IF(DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'AUC') > 0, DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'AUC'), ATTRN('Merch Placeholder SKU', !Merch Placeholder SKU, 'Cost'));

['Promo'] = N: ['Full Price AUR'] * ['Markdown %'];
['Rate Adj Amount'] = N: (['Full Price AUR'] - ['Promo']) * ['Rate Adjustment'];
['CB Weighted Calc'] = N: ['Calc Units'] * IF(['Category Build'] = 0, 1, ['Category Build']);
#EndRegion

#Region : Opening / Ending Inventory
['Opening Inventory'] = N: IF(ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative') @= '', DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Starting Inventory'), DB('Merch Placeholder Curve Assignment', !Merch Version, !Merch Category, !Merch Placeholder SKU, !}Groups, 'Starting Inventory') + DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Buy Units') - DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units'));
['Opening Inventory'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'First Leaf Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Opening Inventory'));
['Ending Inventory'] = C: IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE, IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE, DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Last Leaf Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Ending Inventory')));
#EndRegion

#Region : C-level Recalculations
['Build/Debuild'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET, IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Period') @<> '', ['Units'] \ DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Period'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units'), IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @<> '', ['Units'] \ DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Units'), STET)));
['Category Build'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET, ['CB Weighted Calc'] \ ['Calc Units']);
['Applied/Effective AUR'] = C: ['Revenue'] \ ['Units'];
['Full Price AUR'] = C: ['Base Revenue'] \ ['Units'];
['Promo'] = C: ['Markdown Revenue'] \ ['Units'];
['Markdown %'] = C: IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET, ['Promo'] \ ['Full Price AUR']);
['Rate Adj Amount'] = C: IF(['Units'] = 0, 0, (['Revenue Adjustment'] \ ['Units']) - ['Price Adjustment']);
['Base AUC'] = C: ['Base Cost'] \ ['Units'];
['Backend Adjustment'] = C: ['Backend Cost'] \ ['Units'];
['Other AUC Adjustment'] = C: ['Other Cost Adjustment'] \ ['Units'];
['AUC'] = C: ['Cost'] \ ['Units'];
#EndRegion

#Region : Revenue and Cost Extensions
['Base Revenue'] = N: ['Units'] * ['Full Price AUR'];
['Markdown Revenue'] = N: ['Units'] * ['Promo'];
['Revenue Adjustment'] = N: ['Units'] * (['Rate Adj Amount'] + ['Price Adjustment']);
['Base Cost'] = N: ['Units'] * ['Base AUC'];
['Backend Cost'] = N: ['Units'] * ['Backend Adjustment'];
['Other Cost Adjustment'] = N: ['Units'] * ['Other AUC Adjustment'];
#EndRegion

FEEDERS;

#Region : Feeders
['Build/Debuild'] => ['Calc Units'];
['Build/Debuild'] => ['Full Price AUR'];
['Build/Debuild'] => ['Base AUC'];
['Build/Debuild'] => ['CB Weighted Calc'];
['Build/Debuild'] => ['Promo'];
['Build/Debuild'] => ['Rate Adj Amount'];
['Build/Debuild'] => ['Base Revenue'];
['Build/Debuild'] => ['Markdown Revenue'];
['Build/Debuild'] => ['Revenue Adjustment'];
['Build/Debuild'] => ['Base Cost'];
['Build/Debuild'] => ['Backend Cost'];
['Build/Debuild'] => ['Other Cost Adjustment'];
['Build/Debuild'] => ['Opening Inventory'];

['Category Build'] => ['Calc Units'];
['Category Build'] => ['CB Weighted Calc'];
['Category Build'] => ['Full Price AUR'];
['Category Build'] => ['Base AUC'];
['Category Build'] => ['Promo'];
['Category Build'] => ['Rate Adj Amount'];
['Category Build'] => ['Base Revenue'];
['Category Build'] => ['Markdown Revenue'];
['Category Build'] => ['Revenue Adjustment'];
['Category Build'] => ['Base Cost'];
['Category Build'] => ['Backend Cost'];
['Category Build'] => ['Other Cost Adjustment'];
['Category Build'] => ['Opening Inventory'];

['Promo Build'] => ['Calc Units'];
['Promo Build'] => ['Full Price AUR'];
['Promo Build'] => ['Base AUC'];
['Promo Build'] => ['CB Weighted Calc'];
['Promo Build'] => ['Promo'];
['Promo Build'] => ['Rate Adj Amount'];
['Promo Build'] => ['Base Revenue'];
['Promo Build'] => ['Markdown Revenue'];
['Promo Build'] => ['Revenue Adjustment'];
['Promo Build'] => ['Base Cost'];
['Promo Build'] => ['Backend Cost'];
['Promo Build'] => ['Other Cost Adjustment'];
['Promo Build'] => ['Opening Inventory'];

['Merch Forecast Measure':'Merch Forecast Measure':'Buy Units']=>DB('Merch Placeholder Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Fiscal Year'), !Merch Category, !Merch Placeholder SKU, !}Groups, 'Opening Inventory');

['Adjustment Units'] => ['Full Price AUR'];
['Adjustment Units'] => ['Base AUC'];
['Adjustment Units'] => ['Promo'];
['Adjustment Units'] => ['Rate Adj Amount'];
['Adjustment Units'] => ['Base Revenue'];
['Adjustment Units'] => ['Markdown Revenue'];
['Adjustment Units'] => ['Revenue Adjustment'];
['Adjustment Units'] => ['Base Cost'];
['Adjustment Units'] => ['Backend Cost'];
['Adjustment Units'] => ['Other Cost Adjustment'];
['Adjustment Units'] => ['Opening Inventory'];

['Markdown %'] => ['Promo'];
['Markdown %'] => ['Rate Adj Amount'];
['Markdown %'] => ['Markdown Revenue'];

['Rate Adjustment'] => ['Rate Adj Amount'];
['Rate Adjustment'] => ['Revenue Adjustment'];
['Price Adjustment'] => ['Revenue Adjustment'];

['Backend Adjustment'] => ['Backend Cost'];
['Other AUC Adjustment'] => ['Other Cost Adjustment'];
#EndRegion

#Region : Rule Footer
#############################
##~~ End Rule File ~~##
#############################
#EndRegion
