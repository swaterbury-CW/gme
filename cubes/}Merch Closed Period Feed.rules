FEEDERS;

#Region : Feeders
# Feed using !Merch SKU from control cube. Use consolidated measures.
# Ending Inventory(C) covers: Opening Inventory, Buy Units, Units (-> Calc Units, Adjustment Units)
# Applied/Effective AUR(C) covers: Full Price AUR, Promo, Rate Adjustment, Price Adjustment, Markdown %, Rate Adj Amount
# AUC(C) covers: Base AUC, Backend Adjustment, Other AUC Adjustment
# Margin(C) covers: Revenue(->Base Rev, MD Rev, Rev Adj), Cost(->Base Cost, Backend Cost, Other Cost Adj)
[] => DB('Merch Forecast', !Merch Version, !Merch Time Period, !Merch SKU, 'Ending Inventory');
[] => DB('Merch Forecast', !Merch Version, !Merch Time Period, !Merch SKU, 'Applied/Effective AUR');
[] => DB('Merch Forecast', !Merch Version, !Merch Time Period, !Merch SKU, 'AUC');
[] => DB('Merch Forecast', !Merch Version, !Merch Time Period, !Merch SKU, 'Margin');
#EndRegion

