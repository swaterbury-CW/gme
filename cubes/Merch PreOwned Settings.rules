SKIPCHECK;
#Region : Rule Header
# CUBE: Merch PreOwned Settings
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-04-08
# COMMENTS: Override/Applied cascade for PreOwned settings via canonical Merch Curve Assignment Roles-cascade recursion. String Override populated -> use it (NUMBR for numeric); else CellValueN/S at Merch PreOwned Category Roles parent. Recursion walks Roles chain.
# CHANGE HISTORY:
#   2026-04-08 | Steve Waterbury | Initial creation
#   2026-04-13 | Steve Waterbury | Added C: rules for Applied measures
#   2026-04-21 | Steve Waterbury | Added Applied Skip Start/End Date cascade
#   2026-05-17 | Steve Waterbury | Replaced SGM_Category_Group attribute-walk fallback with canonical Merch Curve Assignment Roles-cascade recursion
#EndRegion

#Region : Applied Numeric Cascade
['Applied Lookback Weeks'] = N: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Lookback Weeks') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Lookback Weeks')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
['Applied Lookback Weeks'] = C: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Lookback Weeks') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Lookback Weeks')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));

['Applied Mix Lookback Weeks'] = N: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Mix Lookback Weeks') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Mix Lookback Weeks')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
['Applied Mix Lookback Weeks'] = C: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Mix Lookback Weeks') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Mix Lookback Weeks')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));

