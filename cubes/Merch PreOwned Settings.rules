['Applied Year Weight 1'] = C: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 1') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 1')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));

