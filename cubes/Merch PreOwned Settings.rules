['Applied Year Weight 2'] = C: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 2') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 2')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));

['Applied Year Weight 3'] = N: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 3') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 3')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
['Applied Year Weight 3'] = C: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 3') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Year Weight 3')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));

['Applied Exclude Year 1'] = N: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Exclude Year 1') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Exclude Year 1')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
