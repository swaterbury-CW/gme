['Applied Exclude Year 2'] = C: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Exclude Year 2') @<> '', NUMBR(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Exclude Year 2')), CellValueN('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
#EndRegion

#Region : Applied Skip Date Cascade
['Applied Skip Start Date'] = S: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Skip Start Date') @<> '', DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Skip Start Date'), CellValueS('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
['Applied Skip End Date'] = S: IF(DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Skip End Date') @<> '', DB('Merch PreOwned Settings', !Merch Version, !Merch PreOwned Category, 'Override Skip End Date'), CellValueS('Merch PreOwned Settings', 'Merch Version':!Merch Version, 'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1), 'Merch PreOwned Settings Measure':!Merch PreOwned Settings Measure));
