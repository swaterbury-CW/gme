SKIPCHECK;
#Region : Rule Header
# CUBE: Merch PreOwned Warranty
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-04-03
# COMMENTS: Pre-Owned warranty Override/Applied cascade. Applied measures follow canonical Merch Curve Assignment pattern: String Override populated -> NUMBR; else CellValueN at Merch PreOwned Category Roles parent. Actual + Calculated-closed cells STET to stored loaded values.
# CHANGE HISTORY:
#   2026-04-03 | Steve Waterbury | Initial creation
#   2026-04-07 | Steve Waterbury | Added standard header/footer
#   2026-04-19 | Steve Waterbury | Added STET guard for Actual + Calculated-closed
#   2026-05-17 | Steve Waterbury | Added Override/Applied Attach Rate + Warranty AUR with Roles-cascade per canonical Merch Curve Assignment pattern; dropped legacy non-functional Warranty Dollars N-rule and C-recalc rules
#EndRegion

#Region : Version STET Guard
['Actual'] = N: STET;
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE, IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'), STET,CONTINUE));
#EndRegion

#Region : Applied Roles Cascade
['Applied Attach Rate'] = N:
  IF(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Attach Rate')),
    CellValueN('Merch PreOwned Warranty',
               'Merch Version':!Merch Version,
               'Merch Time Period':!Merch Time Period,
               'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1),
               'Merch Channel':!Merch Channel,
               'Merch PreOwned Warranty Measure':!Merch PreOwned Warranty Measure));

['Applied Attach Rate'] = C:
  IF(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Attach Rate')),
    CellValueN('Merch PreOwned Warranty',
               'Merch Version':!Merch Version,
               'Merch Time Period':!Merch Time Period,
               'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1),
               'Merch Channel':!Merch Channel,
               'Merch PreOwned Warranty Measure':!Merch PreOwned Warranty Measure));

['Applied Warranty AUR'] = N:
  IF(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Warranty AUR') @<> '',
    NUMBR(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Warranty AUR')),
    CellValueN('Merch PreOwned Warranty',
               'Merch Version':!Merch Version,
               'Merch Time Period':!Merch Time Period,
               'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1),
               'Merch Channel':!Merch Channel,
               'Merch PreOwned Warranty Measure':!Merch PreOwned Warranty Measure));

['Applied Warranty AUR'] = C:
  IF(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Warranty AUR') @<> '',
    NUMBR(DB('Merch PreOwned Warranty', !Merch Version, !Merch Time Period, !Merch PreOwned Category, !Merch Channel, 'Override Warranty AUR')),
    CellValueN('Merch PreOwned Warranty',
               'Merch Version':!Merch Version,
               'Merch Time Period':!Merch Time Period,
               'Merch PreOwned Category':'Roles':ElementParent('Merch PreOwned Category', 'Roles', !Merch PreOwned Category, 1),
               'Merch Channel':!Merch Channel,
               'Merch PreOwned Warranty Measure':!Merch PreOwned Warranty Measure));
#EndRegion

FEEDERS;
#Region : Feeders
# No feeders - SKIPCHECK cube.
#EndRegion
