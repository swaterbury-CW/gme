SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-24
# LAST UPDATE: 2026-05-04
# CUBE       : Merch Warranty Settings
# PURPOSE    : Override-then-Applied hierarchical resolution. Users input string
#              Override <X> at any Merch SKU level; Applied <X> = N: 5-level
#              ELPAR walk, NUMBR() of first non-empty Override, default 0.
#### CHANGE HISTORY:
### 2026-04-24  Steve Waterbury  Initial creation (Phase 2a) STET<>0 ELPAR(...,1).
### 2026-05-04  Steve Waterbury  Replaced STET<>0 with Override/Applied 5-level ELPAR walk.
#EndRegion

#Region : Applied Attach Rate
['Applied Attach Rate'] = N:
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, !Merch SKU, 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, !Merch SKU, 'Override Attach Rate')),
  IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', !Merch SKU, 1), 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', !Merch SKU, 1), 'Override Attach Rate')),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 'Override Attach Rate')),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 'Override Attach Rate')),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1), 'Override Attach Rate') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1), 'Override Attach Rate')),
  0 ))))))))) ;
#EndRegion

#Region : Applied Warranty Amount
['Applied Warranty Amount'] = N:
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, !Merch SKU, 'Override Warranty Amount') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, !Merch SKU, 'Override Warranty Amount')),
  IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', !Merch SKU, 1), 'Override Warranty Amount') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', !Merch SKU, 1), 'Override Warranty Amount')),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 'Override Warranty Amount') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 'Override Warranty Amount')),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 'Override Warranty Amount') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 'Override Warranty Amount')),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1) @= '', 0,
  IF(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1), 'Override Warranty Amount') @<> '',
    NUMBR(DB('Merch Warranty Settings', !Merch Version, !Merch Time Period, ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1), 'Override Warranty Amount')),
  0 ))))))))) ;
#EndRegion

FEEDERS;

