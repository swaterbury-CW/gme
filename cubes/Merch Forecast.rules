SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# CUBE: Merch Forecast
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-03-30
# LAST UPDATE: 2026-05-12
# CHANGE HISTORY:
#   2026-03-30 | Steve Waterbury | Initial creation
#   2026-04-14 | Steve Waterbury | Margin pct; removed redundant IF division guards
#   2026-04-15 | Steve Waterbury | EI=OI+Receipts-Units; Receipts=Buy Units; OI cumulative Receipts
#   2026-04-16 | Steve Waterbury | Flipped Receipts and Buy Units
#   2026-04-17 | Steve Waterbury | Removed unreachable closed-period DB Actual rule paths
#   2026-04-22 | Rose Morgan | Updated Calc unit rule to assume 1 if Build/Debuild is 0
#   2026-04-24 | Steve Waterbury | Phase 2b feeders + cleanup
#   2026-05-01 | Steve Waterbury | Calc Units rewrite
#   2026-05-11 | Steve Waterbury | Sellable Flag gate adds Static carve-out
#   2026-05-12 | Steve Waterbury | Calc Units post-week-1 sources from Expected Calc Sales; week-1 adds Adjustment Units short-circuit
#   2026-05-12 | Steve Waterbury | Calc Units split into 4 ordered gated rules
#   2026-05-12 | Steve Waterbury | Replicated Plan Reporting AUC: Sales/Receipt/Inventory AUC + Dollar Inventory chain (BOP$/Receipt$/EOP$/Inv Adj$)
#EndRegion

#Region : Receipts Lock
['Receipts'] = N:
  IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
     <= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period')
        + (DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') * 7),
  STET, CONTINUE);
#EndRegion

#Region : Buy Units
['Buy Units'] = N:
  IF(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') = 0, ['Receipts'],
  DB('Merch Forecast', !Merch Version,
     TIMST(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
           + (DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') * 7), '\Y-\m-\d'),
     !Merch SKU, 'Receipts'));
#EndRegion

#Region : Actual - Gate
['Merch Version':'Merch Version':'Actual'] = N:stet;
['Merch Version':'Merch Version':'Actual','Merch Forecast Measure':'Merch Forecast Measure':'AUC'] = C:stet;
['Merch Forecast Measure':'Merch Forecast Measure':'AUC'] = C:
  If(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Calculated',
  If(ATTRN('Merch Time Period',!Merch Time Period,'End_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),stet,CONTINUE),continue);

[]=N:
If(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Calculated',
  If(ATTRN('Merch Time Period',!Merch Time Period,'End_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),
  stet,Continue),Continue);
#EndRegion

#Region : Actual - BD AUR
['Build/Debuild'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Actual',CONTINUE,
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Week')@='',CONTINUE,
  ['Units'] \ DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units')));
['Full Price AUR'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Actual',STET,CONTINUE);
['Promo'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Actual',STET,CONTINUE);
['Markdown %'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Actual',CONTINUE,
  ['Promo'] \ ['Full Price AUR']);
#EndRegion

#Region : Static
['Calc Units'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Opening Inventory'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Build/Debuild'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Category Build'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Promo Build'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Level'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Seasonality'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Velocity'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
['Regime'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
#EndRegion

#Region : Calculated - Closed
['Build/Debuild'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Category Build'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Promo Build'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Markdown %'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Rate Adjustment'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Price Adjustment'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Level'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Seasonality'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Velocity'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
['Regime'] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,STET);
#EndRegion

#Region : Calculated - Pricing
['Full Price AUR'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
  DB('Merch Version SKU Attributes',!Merch Version,!Merch SKU,'Base AUR')));
['Base AUC'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
  DB('Merch Version SKU Attributes',!Merch Version,!Merch SKU,'AUC')));
#EndRegion

#Region : AUC Carry-Forward
['Sales AUC'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Week')@='',
     DB('Merch Version SKU Attributes',!Merch Version,!Merch SKU,'Cost'),
     DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Inventory AUC'))));
['Receipt AUC'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
  DB('Merch Version SKU Attributes',!Merch Version,!Merch SKU,'Cost')));
#EndRegion

#Region : Dollar Inventory
['Receipt Dollars'] = N: ['Receipts'] * ['Receipt AUC'];
['BOP Dollars'] = N:
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Week')@='',STET,
  DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'EOP Dollars'));
['EOP Dollars'] = N: ['BOP Dollars'] + ['Receipt Dollars'] - ['Cost'] + ['Inv Adjustment Dollars'];
['Inventory AUC'] = N: ['EOP Dollars'] \ ['Ending Inventory'];
#EndRegion

#Region : Derived
['Promo'] = N: ['Full Price AUR'] * ['Markdown %'];
['Rate Adj Amount'] = N: (['Full Price AUR'] - ['Promo']) * ['Rate Adjustment'];

# Calc Units - ordered gated rules (Calculated versions only; first match wins).
# Rule 1: both Build/Debuild and Category Build cleared -> 0
['Calc Units'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(['Build/Debuild']=0 & ['Category Build']=0,0,CONTINUE));

# Rule 2: Adjustment Units set -> Calc Units = 0 (rollup picks up adjustment)
['Calc Units'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(['Adjustment Units']<>0,0,CONTINUE));

# Rule 3: First open week -> prior Units * builds, capped by OI+Receipts
['Calc Units'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<>ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')+8,CONTINUE,
  IF(ROUND(DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units')
    * IF(['Build/Debuild']=0,1,['Build/Debuild'])
    * IF(['Category Build']=0,1,['Category Build'])
    * IF(['Promo Build']=0,1,['Promo Build']))<=(['Opening Inventory']+['Receipts']),
  ROUND(DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units')
    * IF(['Build/Debuild']=0,1,['Build/Debuild'])
    * IF(['Category Build']=0,1,['Category Build'])
    * IF(['Promo Build']=0,1,['Promo Build'])),
  IF((['Opening Inventory']+['Receipts'])<=0,0,(['Opening Inventory']+['Receipts'])))));

# Rule 4: Post-week-1 open weeks -> Expected Calc Sales, capped by OI+Receipts
['Calc Units'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Week')@='',CONTINUE,
  IF(['Expected Calc Sales']<=(['Opening Inventory']+['Receipts']),['Expected Calc Sales'],
  IF((['Opening Inventory']+['Receipts'])<=0,0,(['Opening Inventory']+['Receipts']))))));

['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<>ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')+8,continue,
   ROUND(DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units')
    * IF(['Build/Debuild']=0,1,['Build/Debuild'])
    * IF(['Category Build']=0,1,['Category Build'])
    * IF(['Promo Build']=0,1,['Promo Build']))));
['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
    IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
 ROUND(DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Expected Calc Sales')
    * IF(['Build/Debuild']=0,1,['Build/Debuild'])
    * IF(['Category Build']=0,1,['Category Build'])
    * IF(['Promo Build']=0,1,['Promo Build']))));
['CB Weighted Calc'] = N: ['Calc Units'] * IF(['Category Build']=0,1,['Category Build']);
['Margin %'] = N: ['Margin'] \ ['Revenue'];
#EndRegion

#Region : Inv
['Opening Inventory'] = C:
  IF(DTYPE('Merch Time Period',!Merch Time Period)@='N',CONTINUE,
  IF(SUBST(!Merch Time Period,1,4)@='Thru',CONTINUE,
  DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'First Leaf Week'),!Merch SKU,'Opening Inventory')));
['Ending Inventory'] = C:
  IF(DTYPE('Merch Time Period',!Merch Time Period)@='N',CONTINUE,
  IF(SUBST(!Merch Time Period,1,4)@='Thru',CONTINUE,
  DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Last Leaf Week'),!Merch SKU,'Ending Inventory')));
['BOP Dollars'] = C:
  IF(DTYPE('Merch Time Period',!Merch Time Period)@='N',CONTINUE,
  IF(SUBST(!Merch Time Period,1,4)@='Thru',CONTINUE,
  DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'First Leaf Week'),!Merch SKU,'BOP Dollars')));
['EOP Dollars'] = C:
  IF(DTYPE('Merch Time Period',!Merch Time Period)@='N',CONTINUE,
  IF(SUBST(!Merch Time Period,1,4)@='Thru',CONTINUE,
  DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Last Leaf Week'),!Merch SKU,'EOP Dollars')));
#EndRegion

#Region : C-level BD CB
['Build/Debuild'] = C:
  IF(SUBST(!Merch Time Period,1,4)@='Thru',STET,
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Period')@<>'',
    ['Units'] \ DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Period'),!Merch SKU,'Units'),
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Week')@<>'',
    ['Units'] \ DB('Merch Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units'),
  STET)));
['Category Build'] = C:
  IF(SUBST(!Merch Time Period,1,4)@='Thru',STET,['CB Weighted Calc'] \ ['Calc Units']);
#EndRegion

#Region : Gates
[] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Actual',CONTINUE,
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',CONTINUE,
  IF(DB('Merch Version SKU Attributes',!Merch Version,!Merch SKU,'Sellable Flag')@<>'Y',0,CONTINUE)));
#EndRegion

#Region : Inventory Calc
['Opening Inventory'] = N:
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period') = 0,
    STET,
  IF(ATTRN('Merch Time Period',!Merch Time Period,'Start_Date') <= ATTRN('Merch Version',!Merch Version,'Last_Closed_Period') + 7,
    STET,
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Prior Cumulative') @= '',
    STET,
  DB('Merch Forecast',!Merch Version,
     TIMST(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period') + 7, '\Y-\m-\d'),
     !Merch SKU,'Opening Inventory')
  + DB('Merch Forecast',!Merch Version,
       ATTRS('Merch Time Period',!Merch Time Period,'Prior Cumulative'),
       !Merch SKU,'Receipts')
  - DB('Merch Forecast',!Merch Version,
       ATTRS('Merch Time Period',
             TIMST(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period') + 7, '\Y-\m-\d'),
             'Prior Cumulative'),
       !Merch SKU,'Receipts')
  - DB('Merch Forecast',!Merch Version,
       ATTRS('Merch Time Period',!Merch Time Period,'Prior Cumulative'),
       !Merch SKU,'Units')
  + DB('Merch Forecast',!Merch Version,
       ATTRS('Merch Time Period',
             TIMST(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period') + 7, '\Y-\m-\d'),
             'Prior Cumulative'),
       !Merch SKU,'Units')
  )));
#EndRegion

#Region : C Rates
['Applied/Effective AUR'] = C: ['Revenue'] \ ['Units'];
['Full Price AUR'] = C: ['Base Revenue'] \ ['Units'];
['Promo'] = C: ['Markdown Revenue'] \ ['Units'];
['Markdown %'] = C: IF(SUBST(!Merch Time Period,1,4)@='Thru',STET,['Promo'] \ ['Full Price AUR']);
['Rate Adj Amount'] = C: IF(['Units']=0,0,(['Revenue Adjustment'] \ ['Units']) - ['Price Adjustment']);
['Base AUC'] = C: ['Base Cost'] \ ['Units'];
['Backend Adjustment'] = C: ['Backend Cost'] \ ['Units'];
['Other AUC Adjustment'] = C: ['Other Cost Adjustment'] \ ['Units'];
['AUC'] = C: ['Cost'] \ ['Units'];
['Margin %'] = C: ['Margin'] \ ['Revenue'];
['Sales AUC']     = C: ['Cost'] \ ['Units'];
['Receipt AUC']   = C: ['Receipt Dollars'] \ ['Receipts'];
['Inventory AUC'] = C: ['EOP Dollars'] \ ['Ending Inventory'];
#EndRegion

#Region : Ext
['Base Revenue'] = N: ['Units'] * ['Full Price AUR'];
['Markdown Revenue'] = N: ['Units'] * ['Promo'];
['Revenue Adjustment'] = N: ['Units'] * (['Rate Adj Amount'] + ['Price Adjustment']);
['Base Cost'] = N: ['Units'] * ['Base AUC'];
['Backend Cost'] = N: ['Units'] * ['Backend Adjustment'];
['Other Cost Adjustment'] = N: ['Units'] * ['Other AUC Adjustment'];
#EndRegion

#Region : FvA
['Forecast vs Actual BD'] = N:
  IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE,
  IF(ATTRS('Merch Time Period',!Merch Time Period,'Previous Week')@='',CONTINUE,
  IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'),CONTINUE,
  IF(DB('Merch Forecast','Actual',ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units')=0,CONTINUE,
  ['Units'] \ DB('Merch Forecast','Actual',ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch SKU,'Units')))));
#EndRegion


FEEDERS;
['Receipts'] => ['Buy Units'];
['Receipts'] => DB('Merch Forecast', !Merch Version,
    TIMST(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
          - (DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') * 7), '\Y-\m-\d'),
    !Merch SKU, 'Buy Units');
['Receipts'] => ['Opening Inventory'];
['Build/Debuild'] => ['Calc Units'],['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Build/Debuild'] => ['Full Price AUR'];
['Build/Debuild'] => ['Base AUC'];
['Build/Debuild'] => ['CB Weighted Calc'];
['Build/Debuild'] => ['Promo'];
['Build/Debuild'] => ['Rate Adj Amount'];
['Build/Debuild'] => ['Base Revenue'];
['Build/Debuild'] => ['Markdown Revenue'];
['Build/Debuild'] => ['Revenue Adjustment'];
['Build/Debuild'] => ['Base Cost'];
['Build/Debuild'] => ['Backend Cost'];
['Build/Debuild'] => ['Other Cost Adjustment'];
['Build/Debuild'] => ['Opening Inventory'];
['Build/Debuild'] => ['Forecast vs Actual BD'];
['Build/Debuild'] => ['Margin %'];
['Category Build'] =>['Calc Units'],['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Category Build'] => ['CB Weighted Calc'];
['Category Build'] => ['Full Price AUR'];
['Category Build'] => ['Base AUC'];
['Category Build'] => ['Promo'];
['Category Build'] => ['Rate Adj Amount'];
['Category Build'] => ['Base Revenue'];
['Category Build'] => ['Markdown Revenue'];
['Category Build'] => ['Revenue Adjustment'];
['Category Build'] => ['Base Cost'];
['Category Build'] => ['Backend Cost'];
['Category Build'] => ['Other Cost Adjustment'];
['Category Build'] => ['Opening Inventory'];
['Category Build'] => ['Forecast vs Actual BD'];
['Category Build'] => ['Margin %'];
['Promo Build'] => ['Calc Units'],['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Promo Build'] => ['Full Price AUR'];
['Promo Build'] => ['Base AUC'];
['Promo Build'] => ['CB Weighted Calc'];
['Promo Build'] => ['Promo'];
['Promo Build'] => ['Rate Adj Amount'];
['Promo Build'] => ['Base Revenue'];
['Promo Build'] => ['Markdown Revenue'];
['Promo Build'] => ['Revenue Adjustment'];
['Promo Build'] => ['Base Cost'];
['Promo Build'] => ['Backend Cost'];
['Promo Build'] => ['Other Cost Adjustment'];
['Promo Build'] => ['Opening Inventory'];
['Promo Build'] => ['Forecast vs Actual BD'];
['Promo Build'] => ['Margin %'];
['Adjustment Units'] => ['Calc Units'],['Merch Forecast Measure':'Merch Forecast Measure':'Expected Calc Sales'];
['Adjustment Units'] => DB('Merch Forecast', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'), !Merch SKU, 'Calc Units');
['Adjustment Units'] => ['Full Price AUR'];
['Adjustment Units'] => ['Base AUC'];
['Adjustment Units'] => ['Promo'];
['Adjustment Units'] => ['Rate Adj Amount'];
['Adjustment Units'] => ['Base Revenue'];
['Adjustment Units'] => ['Markdown Revenue'];
['Adjustment Units'] => ['Revenue Adjustment'];
['Adjustment Units'] => ['Base Cost'];
['Adjustment Units'] => ['Backend Cost'];
['Adjustment Units'] => ['Other Cost Adjustment'];
['Adjustment Units'] => ['Opening Inventory'];
['Adjustment Units'] => ['Forecast vs Actual BD'];
['Adjustment Units'] => ['Margin %'];
['Markdown %'] => ['Promo'];
['Markdown %'] => ['Rate Adj Amount'];
['Markdown %'] => ['Markdown Revenue'];
['Rate Adjustment'] => ['Rate Adj Amount'];
['Rate Adjustment'] => ['Revenue Adjustment'];
['Price Adjustment'] => ['Revenue Adjustment'];
['Backend Adjustment'] => ['Backend Cost'];
['Other AUC Adjustment'] => ['Other Cost Adjustment'];
['Opening Inventory'] => DB(
    IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date_Serial') >= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period'),
       'Merch Forecast', ''),
    !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'),
    !Merch SKU, !Merch Forecast Measure);
['Units'] => ['Cost'];
['Units'] => ['AUC'];
['Units'] => ['Margin'];
['Calc Units']       => DB('Merch Warranty Calculation', !Merch Version, !Merch Time Period, !Merch SKU, 'Forecast Units');
['Adjustment Units'] => DB('Merch Warranty Calculation', !Merch Version, !Merch Time Period, !Merch SKU, 'Forecast Units');
['Receipts'] => ['Receipt Dollars'],['Receipt AUC'],['BOP Dollars'],['EOP Dollars'],['Inventory AUC'];
['Opening Inventory'] => ['BOP Dollars'],['EOP Dollars'],['Inventory AUC'],['Sales AUC'];
['Build/Debuild'] => ['Sales AUC'],['EOP Dollars'];
['Category Build'] => ['Sales AUC'],['EOP Dollars'];
['Promo Build'] => ['Sales AUC'],['EOP Dollars'];
['Adjustment Units'] => ['Sales AUC'],['EOP Dollars'];
['Inv Adjustment Dollars'] => ['BOP Dollars'],['EOP Dollars'],['Inventory AUC'];
[]=>DB( If(elementIndex('Merch Version','Budget Rollup','Budget Rollup - '|!Merch Version)<>0,'Merch Forecast',''), 'Budget rollup':'Budget Rollup - '|!Merch version, !Merch Time Period, !Merch SKU, !Merch Forecast Measure );


#Region : Rule Footer
#############################
##~~ End Rule File ~~##
#############################
#EndRegion