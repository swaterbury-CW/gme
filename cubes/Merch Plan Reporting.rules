SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-01
# LAST UPDATE: 2026-04-30
# CUBE       : Merch Plan Reporting
# COMMENTS:
# Inventory roll: EI = OI + Receipts - Units.
# On Order is input-loaded. Avg Inventory C-level = sum(weekly avg) / Leaf_Week_Count via helpers.
#
#### CHANGE HISTORY:
### 2026-04-01  Steve Waterbury  Creation
### 2026-04-06  Steve Waterbury  Dollar-side inventory
### 2026-04-14  Steve Waterbury  COGS removal
### 2026-04-15  Steve Waterbury  EI=OI+Receipts-Units
### 2026-04-16  Steve Waterbury  Flipped Receipts/Buy Units
### 2026-04-20  Steve Waterbury  Removed [On Order] N rule
### 2026-04-20  Steve Waterbury  Avg Inv C via helpers (true time average)
### 2026-04-30  Steve Waterbury  Post-Horizon Budget Fallback (Receipts/Calc Units/Adjustment Units) + static Test pair cross-version feeders. In-horizon STET=null is a known limitation; production calc/static pairs added later.
#EndRegion

#Region : Receipts Lock + Buy Units Calc
['Receipts'] = N:
  IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
     <= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period')
        + (DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') * 7),
  STET, CONTINUE);
['Buy Units'] = N:
  IF(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') = 0, ['Receipts'],
  DB('Merch Plan Reporting', !Merch Version,
     TIMST(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
           + (DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') * 7), '\Y-\m-\d'),
     !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Receipts'));
#EndRegion

#Region : Post-Horizon Budget Fallback
['Receipts'] = N:
  IF( ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Calculated'
    & ATTRN('Merch Version', !Merch Version, 'Number_of_Forecast_Weeks') > 0
    & ATTRS('Merch Version', !Merch Version, 'Budget_Version') @<> ''
    & DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Use_Budget_After_Horizon Applied') @<> 'N'
    & ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
      >= ATTRN('Merch Time Period', ATTRS('Merch Version', !Merch Version, 'First_Forecast_Period'), 'Start_Date')
         + 7 * ATTRN('Merch Version', !Merch Version, 'Number_of_Forecast_Weeks'),
    DB('Merch Plan Reporting', ATTRS('Merch Version', !Merch Version, 'Budget_Version'), !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Receipts'),
    STET);
['Calc Units'] = N:
  IF( ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Calculated'
    & ATTRN('Merch Version', !Merch Version, 'Number_of_Forecast_Weeks') > 0
    & ATTRS('Merch Version', !Merch Version, 'Budget_Version') @<> ''
    & DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Use_Budget_After_Horizon Applied') @<> 'N'
    & ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
      >= ATTRN('Merch Time Period', ATTRS('Merch Version', !Merch Version, 'First_Forecast_Period'), 'Start_Date')
         + 7 * ATTRN('Merch Version', !Merch Version, 'Number_of_Forecast_Weeks'),
    DB('Merch Plan Reporting', ATTRS('Merch Version', !Merch Version, 'Budget_Version'), !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Calc Units'),
    STET);
['Adjustment Units'] = N:
  IF( ATTRS('Merch Version', !Merch Version, 'Version_Type') @= 'Calculated'
    & ATTRN('Merch Version', !Merch Version, 'Number_of_Forecast_Weeks') > 0
    & ATTRS('Merch Version', !Merch Version, 'Budget_Version') @<> ''
    & DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Use_Budget_After_Horizon Applied') @<> 'N'
    & ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
      >= ATTRN('Merch Time Period', ATTRS('Merch Version', !Merch Version, 'First_Forecast_Period'), 'Start_Date')
         + 7 * ATTRN('Merch Version', !Merch Version, 'Number_of_Forecast_Weeks'),
    DB('Merch Plan Reporting', ATTRS('Merch Version', !Merch Version, 'Budget_Version'), !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Adjustment Units'),
    STET);
#EndRegion

#Region : Opening Inventory
['Opening Inventory'] = N:
  IF(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') = 0, STET,
  IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date') <= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, STET,
  IF(ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative') @= '', STET,
  DB('Merch Plan Reporting', !Merch Version,
     TIMST(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, '\Y-\m-\d'),
     !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Opening Inventory')
  + DB('Merch Plan Reporting', !Merch Version,
       ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative'),
       !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Receipts')
  - DB('Merch Plan Reporting', !Merch Version,
       ATTRS('Merch Time Period',
             TIMST(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, '\Y-\m-\d'),
             'Prior Cumulative'),
       !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Receipts')
  - DB('Merch Plan Reporting', !Merch Version,
       ATTRS('Merch Time Period', !Merch Time Period, 'Prior Cumulative'),
       !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Units')
  + DB('Merch Plan Reporting', !Merch Version,
       ATTRS('Merch Time Period',
             TIMST(ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period') + 7, '\Y-\m-\d'),
             'Prior Cumulative'),
       !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Units')
  )));
['WOS'] = N:
  DB('}Merch WOS Calc', !Merch Version, !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'All WOS Period');
['Margin %'] = N: ['Margin'] \ ['Revenue'];
#EndRegion

#Region : AUC Carry-Forward
['Sales AUC'] = N:
  IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '',
    DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Cost'),
  DB('Merch Plan Reporting', !Merch Version,
     ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'),
     !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Inventory AUC'));
['Receipt AUC'] = N:
  DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Cost');
#EndRegion

#Region : Dollar-Side Inventory
['Receipt Dollars'] = N: ['Receipts'] * ['Receipt AUC'];
['BOP Dollars'] = N:
  IF(ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week') @= '', STET,
  DB('Merch Plan Reporting', !Merch Version,
     ATTRS('Merch Time Period', !Merch Time Period, 'Previous Week'),
     !Merch SKU, !Merch Channel, !Merch Lifecycle, 'EOP Dollars'));
['EOP Dollars'] = N: ['BOP Dollars'] + ['Receipt Dollars'] - ['Cost'] + ['Inv Adjustment Dollars'];
['Inventory AUC'] = N: ['EOP Dollars'] \ ['Ending Inventory'];
#EndRegion

#Region : Avg Inv Helper N
['Avg Inv $ Weekly Sum'] = N: (['BOP Dollars'] + ['EOP Dollars']) \ 2;
['Avg Inv Units Weekly Sum'] = N: (['Opening Inventory'] + ['Ending Inventory']) \ 2;
#EndRegion

#Region : C-level Dollar Inventory
['BOP Dollars'] = C:
  IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE,
  IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE,
  DB('Merch Plan Reporting', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'First Leaf Week'), !Merch SKU, !Merch Channel, !Merch Lifecycle, 'BOP Dollars')));
['EOP Dollars'] = C:
  IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE,
  IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE,
  DB('Merch Plan Reporting', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Last Leaf Week'), !Merch SKU, !Merch Channel, !Merch Lifecycle, 'EOP Dollars')));
['Sales AUC'] = C: ['Cost'] \ ['Units'];
['Receipt AUC'] = C: ['Receipt Dollars'] \ ['Receipts'];
['Inventory AUC'] = C: ['EOP Dollars'] \ ['Ending Inventory'];
['Margin %'] = C: ['Margin'] \ ['Revenue'];
#EndRegion

#Region : C-level OI and EI
['Opening Inventory'] = C:
  IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE,
  IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE,
  DB('Merch Plan Reporting', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'First Leaf Week'), !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Opening Inventory')));
['Ending Inventory'] = C:
  IF(DTYPE('Merch Time Period', !Merch Time Period) @= 'N', CONTINUE,
  IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', CONTINUE,
  DB('Merch Plan Reporting', !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Last Leaf Week'), !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Ending Inventory')));
#EndRegion

#Region : Average Inventory (leaf + time-weighted C)
['Avg Inventory Units'] = N: (['Opening Inventory'] + ['Ending Inventory']) \ 2;
['Avg Inventory Dollars'] = N: (['BOP Dollars'] + ['EOP Dollars']) \ 2;
['Avg Inventory Units'] = C:
  IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET,
  IF(ATTRN('Merch Time Period', !Merch Time Period, 'Leaf_Week_Count') = 0, STET,
  DB('Merch Plan Reporting', !Merch Version, !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Avg Inv Units Weekly Sum') \ ATTRN('Merch Time Period', !Merch Time Period, 'Leaf_Week_Count')));
['Avg Inventory Dollars'] = C:
  IF(SUBST(!Merch Time Period, 1, 4) @= 'Thru', STET,
  IF(ATTRN('Merch Time Period', !Merch Time Period, 'Leaf_Week_Count') = 0, STET,
  DB('Merch Plan Reporting', !Merch Version, !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Avg Inv $ Weekly Sum') \ ATTRN('Merch Time Period', !Merch Time Period, 'Leaf_Week_Count')));
#EndRegion


FEEDERS;

#Region : Feeders - Core
['Receipts'] => ['Buy Units'];
['Receipts'] => DB('Merch Plan Reporting', !Merch Version,
    TIMST(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date')
          - (DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Lead_Time_Weeks') * 7), '\Y-\m-\d'),
    !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Buy Units');
#EndRegion

['Opening Inventory'] => ['WOS'];
['Units'] => ['WOS'];
#Region : Feeders - Dollar & Avg Inventory
['Calc Units'] => ['Sales AUC'];
['Adjustment Units'] => ['Sales AUC'];
['Receipts'] => ['Receipt Dollars'];
['Receipts'] => ['Receipt AUC'];
['Opening Inventory'] => ['BOP Dollars'];
['Opening Inventory'] => ['EOP Dollars'];
['Opening Inventory'] => ['Inventory AUC'];
['Opening Inventory'] => ['Avg Inventory Units'];
['Opening Inventory'] => ['Avg Inventory Dollars'];
['Opening Inventory'] => ['Avg Inv Units Weekly Sum'];
['Ending Inventory'] => ['Avg Inv Units Weekly Sum'];
['Receipts'] => ['BOP Dollars'];
['Receipts'] => ['EOP Dollars'];
['Receipts'] => ['Inventory AUC'];
['Receipts'] => ['Avg Inventory Units'];
['Receipts'] => ['Avg Inventory Dollars'];
['Receipts'] => ['Avg Inv $ Weekly Sum'];
['Receipts'] => ['Avg Inv Units Weekly Sum'];
['BOP Dollars'] => ['Avg Inv $ Weekly Sum'];
['EOP Dollars'] => ['Avg Inv $ Weekly Sum'];
['Calc Units'] => ['Avg Inventory Units'];
['Calc Units'] => ['Avg Inventory Dollars'];
['Calc Units'] => ['Avg Inv Units Weekly Sum'];
['Adjustment Units'] => ['Avg Inventory Units'];
['Adjustment Units'] => ['Avg Inventory Dollars'];
['Adjustment Units'] => ['Avg Inv Units Weekly Sum'];
['Inv Adjustment Dollars'] => ['EOP Dollars'];
['Inv Adjustment Dollars'] => ['BOP Dollars'];
['Inv Adjustment Dollars'] => ['Inventory AUC'];
['Inv Adjustment Dollars'] => ['Avg Inv $ Weekly Sum'];
['Calc Units'] => ['Margin %'];
['Adjustment Units'] => ['Margin %'];
['Receipts'] => ['Margin %'];
  []=>DB( If(elementIndex('Merch Version','Budget Rollup','Budget Rollup - '|!Merch Version)<>0,'Merch Plan Reporting',''), 'budget rollup':'Budget Rollup - '|!Merch Version, !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, !Merch Plan Reporting Measure );
#EndRegion


#Region : Feeders - Cross-Period OI
['Receipts'] => DB('Merch Plan Reporting', !Merch Version,
    ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'),
    !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Opening Inventory');
['Opening Inventory'] => DB(
    IF(ATTRN('Merch Time Period', !Merch Time Period, 'Start_Date_Serial') >= ATTRN('Merch Version', !Merch Version, 'Last_Closed_Period'),
       'Merch Plan Reporting', ''),
    !Merch Version, ATTRS('Merch Time Period', !Merch Time Period, 'Next Week'),
    !Merch SKU, !Merch Channel, !Merch Lifecycle, !Merch Plan Reporting Measure);
['Units'] => DB('}Merch WOS Calc', !Merch Version, 'Thru ' | !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, !Merch Time Period);
['Opening Inventory'] => DB('}Merch WOS Calc', !Merch Version, 'Thru ' | !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, !Merch Time Period);
#EndRegion

#Region : Feeders - Post-Horizon Budget Fallback (static Test pair — update as production calc/static pairs are added)
['Test_Static', 'Receipts']         => DB('Merch Plan Reporting', 'Test_Calculated', !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Receipts');
['Test_Static', 'Calc Units']       => DB('Merch Plan Reporting', 'Test_Calculated', !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Calc Units');
['Test_Static', 'Adjustment Units'] => DB('Merch Plan Reporting', 'Test_Calculated', !Merch Time Period, !Merch SKU, !Merch Channel, !Merch Lifecycle, 'Adjustment Units');
#EndRegion

#Region : Rule Footer
#############################
##~~ End Rule File ~~##
#############################
#EndRegion