SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# CUBE: Merch PreOwned Forecast
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-03-30
# COMMENTS:
# Build decomposed: Build Yr1/2/3 <D> = prior-year lookback window \ Applied Lookback Weeks.
#   Build Yr1 = FY-1, Build Yr2 = FY-2, Build Yr3 = FY-3 (three completed prior fiscal years; current FY excluded).
# Category Calc <D> (Resulting Build) = exclude-gated weighted blend of the 3 per-year builds:
#   (Wn_eff*BuildYrn) \ (sum Wn_eff), Wn_eff = Applied Year Weight n * (Applied Exclude Year n <> 1).
# Final Build <D> = Category Calc <D> + Adjustment <D>. Leaf Calc reads Final Build at SGM group.
# Prior-year window via inline FY/week arithmetic (committed mechanism): FY string = current FY 2-digit minus i; rollover to prior FY at week 52+offset.
# Upper bound (all 3 years): Sales = Thru week N; Trades/Trade Units = Thru week N-1 (previous week). Lower = Thru week N-Lookback.
# CHANGE HISTORY:
# 2026-04-13 | Steve Waterbury | Stored mix pcts
# 2026-04-22 | Steve Waterbury | 8 rule-driven *Calc measures for BuildMix
# 2026-06-04 | Steve Waterbury | UAT: per-year Build extraction + exclude-gated Resulting + Final Build/Adjustment; leaf reads Final Build. Plan a3967117df82.
# 2026-06-08 | Steve Waterbury | UAT: build years shifted to 3 completed prior FYs (FY-1/-2/-3), current FY dropped; uniform N / N-1 upper bound across all 3 years.
#EndRegion
#Region : Version STET Guard
['Actual'] = N: STET;
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE, IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'), STET,CONTINUE));
#EndRegion
#Region : Per-year Builds
['Build Yr1 Sales'] = N: (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')),2,0)),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0)),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2),2,0))|'-W'|IF((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0))),!Merch PreOwned Category,'Sales Dollars')) \ DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks');
['Build Yr2 Sales'] = N: (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')),2,0)),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0)),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3),2,0))|'-W'|IF((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0))),!Merch PreOwned Category,'Sales Dollars')) \ DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks');
['Build Yr3 Sales'] = N: (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')),2,0)),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0)),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-4)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-4),2,0))|'-W'|IF((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0))),!Merch PreOwned Category,'Sales Dollars')) \ DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks');
['Build Yr1 Trades'] = N: (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>1,'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-1)<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-1),2,0)),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2),2,0))|'-W'|IF((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-1)<10,'0','')|TRIM(STR((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-1),2,0))),!Merch PreOwned Category,'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1),2,0))|'-W'|IF((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0)),'FY'|IF((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2)<10,'0','')|TRIM(STR((NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2),2,0))|'-W'|IF((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'))<10,'0','')|TRIM(STR((52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')),2,0))),!Merch PreOwned Category,'Trade Dollars')) \ DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks');
