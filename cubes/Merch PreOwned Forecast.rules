SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# CUBE: Merch PreOwned Forecast
# DEVELOPER: Steve Waterbury
# CREATED ON: 2026-03-30
# COMMENTS:
# Category Calc Sales/Trades/Trade Units: weighted Thru lookback at SGM group.
# Leaf drivers: Calc Sales/Trade Dollars, Trade Units (open-period rule).
# AUR, AUT, Margin Pct leaves = BuildMix-seeded inputs. C-level = weighted ratios.
# *Calc leaves (rule-driven mix/lookback) consumed by PreOwned.Calc.BuildMix.
# CHANGE HISTORY:
# 2026-04-13 | Steve Waterbury | Stored mix pcts
# 2026-04-19 | Steve Waterbury | Added Calc Margin/Trade Dollars leaves
# 2026-04-21 | Steve Waterbury | Trade path dollars-driven
# 2026-04-21 | Steve Waterbury | Cat Calc Trade Units + leaf Trade Units rule; Calc Margin = Margin Pct * Total Sales Dollars; AUR/AUT/Margin Pct C-rules on Total Sales Dollars
# 2026-04-22 | Steve Waterbury | Added 8 rule-driven *Calc measures for BuildMix; stripped redundant IF guards on safe division per KB feedback_no_redundant_division_guards
#EndRegion

#Region : Version STET Guard
['Actual'] = N: STET;
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@='Static',STET,CONTINUE);
[] = N: IF(ATTRS('Merch Version',!Merch Version,'Version_Type')@<>'Calculated',CONTINUE, IF(ATTRN('Merch Version',!Merch Version,'Last_Closed_Period')<>0 & ATTRN('Merch Time Period',!Merch Time Period,'Start_Date')<=ATTRN('Merch Version',!Merch Version,'Last_Closed_Period'), STET,CONTINUE));
#EndRegion

#Region : Category Calc Sales
['Category Calc Sales'] = N: IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')=0,0, IF((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3'))=0,0, (DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2)|'-W'|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0)),'FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1,2,0))|'-W'|IF(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0))),!Merch PreOwned Category,'Sales Dollars'))+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(DB('Merch PreOwned Forecast',!Merch Version,'Thru FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1,2,0))|'-W'|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')<10,'0','')|TRIM(STR(ATTRN('Merch Time Period',!Merch Time Period,'Week Number'),2,0)),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1,2,0))|'-W'|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0)),'FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2,2,0))|'-W'|IF(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0))),!Merch PreOwned Category,'Sales Dollars'))+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(DB('Merch PreOwned Forecast',!Merch Version,'Thru FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2,2,0))|'-W'|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')<10,'0','')|TRIM(STR(ATTRN('Merch Time Period',!Merch Time Period,'Week Number'),2,0)),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-2,2,0))|'-W'|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0)),'FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-3,2,0))|'-W'|IF(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0))),!Merch PreOwned Category,'Sales Dollars')))/(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')*(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')))));
#EndRegion

#Region : Category Calc Trades
['Category Calc Trades'] = N: IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')=0,0, IF((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3'))=0,0, (DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|ATTRS('Merch Time Period',!Merch Time Period,'Previous Week'),!Merch PreOwned Category,'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')>DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),'FY'|SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2)|'-W'|IF(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0)),'FY'|IF(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1<10,'0','')|TRIM(STR(NUMBR(SUBST(ATTRS('Merch Time Period',!Merch Time Period,'Fiscal Year'),5,2))-1,2,0))|'-W'|IF(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks')<10,'0','')|TRIM(STR(52+ATTRN('Merch Time Period',!Merch Time Period,'Week Number')-DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Lookback Weeks'),2,0))),!Merch PreOwned Category,'Trade Dollars'))+DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(DB('Merch 