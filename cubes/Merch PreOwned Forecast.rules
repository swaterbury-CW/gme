['Calc Sales Dollars'] => ['Calc Units'];
['Calc Sales Dollars'] => ['Calc Margin Dollars'];
['Sales Dollars'] => ['Calc Margin Dollars'];
['Calc Trade Dollars'] => ['Calc Trade Units'];
['AUR'] => ['Calc Units'];
['AUT'] => ['Calc Trade Units'];
['Margin Pct'] => ['Calc Margin Dollars'];
['Sales Dollars'] => ['Sales Mix Calc'];
['Trade Dollars'] => ['Trade Mix Calc'];
['Margin Dollars'] => ['Margin Mix Calc'];
['Sales Units'] => ['AUR Mix Calc'];
['Trade Units'] => ['AUT Mix Calc'];
['Total Sales Dollars'] => ['AUR Calc'];
['Trade Dollars'] => ['AUT Calc'];
['Margin Dollars'] => ['Margin Pct Calc'];
['Sales Dollars']=>DB('Merch PreOwned Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Next Week'),!Merch PreOwned Category,'Build Yr1 Sales');
['Trade Dollars']=>DB('Merch PreOwned Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Next Week'),!Merch PreOwned Category,'Build Yr1 Trades');
['Trade Units']=>DB('Merch PreOwned Forecast',!Merch Version,ATTRS('Merch Time Period',!Merch Time Period,'Next Week'),!Merch PreOwned Category,'Build Yr1 Trade Units');
#EndRegion
