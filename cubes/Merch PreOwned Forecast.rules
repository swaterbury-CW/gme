#Region : Mix Calc rules
['Sales Mix Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),!Merch PreOwned Category,'Sales Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Sales Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),ATTRS('Merch PreOwned Category