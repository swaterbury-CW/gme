#EndRegion
#Region : Resulting Build (Category Calc, exclude-gated weighted blend)
['Category Calc Sales'] = N: ((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 1')=1,1,0)))*['Build Yr1 Sales']+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 2')=1,1,0)))*['Build Yr2 Sales']+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 3')=1,1,0)))*['Build Yr3 Sales']) \ ((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 1')=1,1,0)))+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 2')=1,1,0)))+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 3')=1,1,0))));
['Category Calc Trades'] = N: ((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 1')=1,1,0)))*['Build Yr1 Trades']+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 2')=1,1,0)))*['Build Yr2 Trades']+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 3')=1,1,0)))*['Build Yr3 Trades']) \ ((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 1')=1,1,0)))+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 2')=1,1,0)))+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 3')=1,1,0))));
['Category Calc Trade Units'] = N: ((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 1')=1,1,0)))*['Build Yr1 Trade Units']+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 2')=1,1,0)))*['Build Yr2 Trade Units']+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 3')=1,1,0)))*['Build Yr3 Trade Units']) \ ((DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 1')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 1')=1,1,0)))+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 2')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 2')=1,1,0)))+(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Year Weight 3')*(1-IF(DB('Merch PreOwned Settings',!Merch Version,!Merch PreOwned Category,'Applied Exclude Year 3')=1,1,0))));
#EndRegion
#Region : Final Build = Resulting + Adjustment
['Final Build Sales'] = N: ['Category Calc Sales'] + ['Adjustment Sales'];
['Final Build Trades'] = N: ['Category Calc Trades'] + ['Adjustment Trades'];
['Final Build Trade Units'] = N: ['Category Calc Trade Units'] + ['Adjustment Trade Units'];
#EndRegion
#Region : Mix Calc rules
['Sales Mix Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),!Merch PreOwned Category,'Sales Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Sales Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Dollars'))));
['Trade Mix Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),!Merch PreOwned Category,'Trade Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Trade Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Dollars'))));
['Margin Mix Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Margin Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),!Merch PreOwned Category,'Margin Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Margin Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Margin Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Margin Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Margin Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Margin Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Margin Dollars'))));
['AUR Mix Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Sales Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),!Merch PreOwned Category,'Sales Units')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Sales Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Sales Units')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Units')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Sales Units'))));
['AUT Mix Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Trade Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),!Merch PreOwned Category,'Trade Units')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Trade Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Trade Units')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Mix Start Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Units')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Trade Units'))));
#EndRegion
#Region : Lookback Calc rules
['AUR Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Total Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Lookback Start Week'),!Merch PreOwned Category,'Total Sales Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Total Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Total Sales Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Sales Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Lookback Start Week'),!Merch PreOwned Category,'Sales Units')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Sales Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Sales Units'))));
['AUT Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Lookback Start Week'),!Merch PreOwned Category,'Trade Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Trade Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Trade Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Total Trade Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Lookback Start Week'),!Merch PreOwned Category,'Total Trade Units')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Total Trade Units')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Total Trade Units'))));
['Margin Pct Calc'] = N: IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Scope Flag')=0,0, (DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Margin Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Lookback Start Week'),!Merch PreOwned Category,'Margin Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Margin Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Margin Dollars')))\(DB('Merch PreOwned Forecast',!Merch Version,'Thru '|!Merch Time Period,!Merch PreOwned Category,'Total Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Lookback Start Week'),!Merch PreOwned Category,'Total Sales Dollars')-IF(DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week')@='',0,DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip End Week'),!Merch PreOwned Category,'Total Sales Dollars')-DB('Merch PreOwned Forecast',!Merch Version,'Thru '|DB('Merch PreOwned BuildMix Scope',!Merch Version,!Merch Time Period,!Merch PreOwned Category,'Skip Prior Week'),!Merch PreOwned Category,'Total Sales Dollars'))));
#EndRegion
#Region : Calc measures
['Calc Sales Dollars'] = N: DB('Merch PreOwned Forecast',!Merch Version,!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Final Build Sales')*['Sales Mix Pct'];
['Calc Trade Dollars'] = N: DB('Merch PreOwned Forecast',!Merch Version,!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Final Build Trades')*['Trade Mix Pct'];
['Trade Units'] = N: DB('Merch PreOwned Forecast',!Merch Version,!Merch Time Period,ATTRS('Merch PreOwned Category',!Merch PreOwned Category,'SGM_Category_Group'),'Final Build Trade Units')*['Trade Mix Pct'];
['Calc Units'] = N: ['Calc Sales Dollars']\['AUR'];
['Calc Trade Units'] = N: ['Calc Trade Dollars']\['AUT'];
['Calc Margin Dollars'] = N: ['Margin Pct']*['Total Sales Dollars'];
#EndRegion
#Region : C-level
['AUR'] = C: ['Total Sales Dollars']\['Sales Units'];
['AUT'] = C: ['Trade Dollars']\['Trade Units'];
['Margin Pct'] = C: ['Margin Dollars']\['Total Sales Dollars'];
#EndRegion
FEEDERS;
