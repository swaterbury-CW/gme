SKIPCHECK;
#Region : Rule Header
#############################
##~~ Start Rule File ~~##
#############################
# DEVELOPER : Steve Waterbury
# CREATED ON : 2026-04-23
# LAST UPDATE: 2026-05-11
# CUBE       : Merch Version SKU Attributes
#
#### CHANGE HISTORY:
### 2026-04-23  Steve Waterbury  Initial rule file — Target_WOS_Applied cascade (own SKU Override > parent Override > 0)
### 2026-04-30  Steve Waterbury  Use_Budget_After_Horizon Applied cascade (mirrors Target_WOS pattern; String S: rule)
### 2026-05-11  Steve Waterbury  Switch both cascades to CellValueN/S recursion over Merch SKU 'Roles' hierarchy (mirrors Merch Curve Assignment 2026-05-06 pattern). Walks all ancestor levels via auto-recursion; previous ELPAR resolved only against default flat hier and never found Roles parents. Added = C: rule for Target_WOS_Applied so consolidated cells resolve too. Dropped FEEDSTRINGS (no string feeders).
#
#EndRegion

#Region : Target_WOS Cascade
['Target_WOS_Applied'] = N:
  IF(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Target_WOS_Override') @<> '',
     NUMBR(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Target_WOS_Override')),
     CellValueN('Merch Version SKU Attributes',
                'Merch Version':!Merch Version,
                'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
                'Merch Version SKU Attribute Measure':!Merch Version SKU Attribute Measure)
  );

['Target_WOS_Applied'] = C:
  IF(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Target_WOS_Override') @<> '',
     NUMBR(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Target_WOS_Override')),
     CellValueN('Merch Version SKU Attributes',
                'Merch Version':!Merch Version,
                'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
                'Merch Version SKU Attribute Measure':!Merch Version SKU Attribute Measure)
  );
#EndRegion

#Region : Use_Budget_After_Horizon Cascade
['Use_Budget_After_Horizon Applied'] = S:
  IF(DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Use_Budget_After_Horizon Override') @<> '',
     DB('Merch Version SKU Attributes', !Merch Version, !Merch SKU, 'Use_Budget_After_Horizon Override'),
     CellValueS('Merch Version SKU Attributes',
                'Merch Version':!Merch Version,
                'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
                'Merch Version SKU Attribute Measure':!Merch Version SKU Attribute Measure)
  );
#EndRegion

FEEDERS;
['Target_WOS_Override'] => ['Target_WOS_Applied'];

#Region : Rule Footer
#############################
##~~ End Rule File ~~##
#############################
#EndRegion