  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1) @= '', '',
  IF(DB('Merch User Hierarchy Assignment', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), !}Clients, 'Override Hierarchy 2') @<> '',
    DB('Merch User Hierarchy Assignment', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), !}Clients, 'Override Hierarchy 2'),
  IF(ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1) @= '', '',
  IF(DB('Merch User Hierarchy Assignment', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1), !}Clients, 'Override Hierarchy 2') @<> '',
    DB('Merch User Hierarchy Assignment', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', ELPAR('Merch SKU', !Merch SKU, 1), 1), 1), 1), !}Clients, 'Override Hierarchy 2'),
  '' ))))))))) ;
