      CellValueN('Merch Curve Assignment', 'Merch Version':!Merch Version, 'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1), 'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)));

