#Region : Applied First Week Sell %
['Applied First Week Sell %'] = N:
  IF(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override First Week Sell %') @<> '',
    NUMBR(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override First Week Sell %')),
    CellValueN('Merch Curve Assignment',
               'Merch Version':!Merch Version,
               'Merch SKU':'Roles':ElementParent('Merch SKU', 'Roles', !Merch SKU, 1),
               'Merch Curve Assignment Measure':!Merch Curve Assignment Measure)
  );

['Applied First Week Sell %'] = C:
  IF(DB('Merch Curve Assignment', !Merch Version, !Merch SKU, 'Override First Week Sell %') @<> '',
