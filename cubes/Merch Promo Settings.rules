SKIPCHECK;
FEEDSTRINGS;

#Region : Rule Header
# DEVELOPER  : Steve Waterbury
# CREATED ON : 2026-04-10
# LAST UPDATE: 2026-05-06
# CUBE       : Merch Promo Settings
#### CHANGE HISTORY:
### 2026-04-13 | Steve Waterbury | Applied BER added
### 2026-05-01 | Steve Waterbury | Applied Curve Name (replaces orphan Curve Name rule)
### 2026-05-06 | Steve Waterbury | Applied Begin Date / Applied End Date rules: Override (string ISO) -> DAYNO -> serial numeric, 3-tier fallback (SKU -> SKU parent -> All SKUs)
#EndRegion

#Region : Applied Numeric Measures
['Applied Discount Pct'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Discount Pct') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Discount Pct')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Discount Pct') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Discount Pct')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Discount Pct') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Discount Pct')), 0))));
['Applied Promo Price'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Promo Price') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Promo Price')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Promo Price') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Promo Price')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Promo Price') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Promo Price')), 0))));
['Applied Pro Only'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Pro Only') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Pro Only')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Pro Only') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Pro Only')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Pro Only') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Pro Only')), 0))));
['Applied Base AUR'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Base AUR') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Base AUR')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Base AUR') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Base AUR')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Base AUR') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Base AUR')), 0))));
['Applied Sales Lift Pct'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Sales Lift Pct') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Sales Lift Pct')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Sales Lift Pct') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Sales Lift Pct')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Sales Lift Pct') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Sales Lift Pct')), 0))));
['Applied BER'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override BER') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override BER')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override BER') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override BER')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override BER') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override BER')), 0))));
['Applied Active'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Active') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Active')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Active') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Active')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Active') @<> '', NUMBR(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Active')), 0))));
[] = c:If(dtype('Merch Promo Settings Measure',!Merch Promo Settings Measure)@='N',0,CONTINUE);

#EndRegion

#Region : Applied Date Measures (Override -> DAYNO -> serial)
['Applied Begin Date'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Begin Date') @<> '', DAYNO(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Begin Date')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Begin Date') @<> '', DAYNO(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Begin Date')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Begin Date') @<> '', DAYNO(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Begin Date')), 0))));
['Applied End Date'] = N: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override End Date') @<> '', DAYNO(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override End Date')), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', 0, IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override End Date') @<> '', DAYNO(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override End Date')), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override End Date') @<> '', DAYNO(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override End Date')), 0))));
#EndRegion

#Region : String Measures
['Promo Name'] = S: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Promo Name') @<> '', DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Promo Name'), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', '', IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Promo Name') @<> '', DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Promo Name'), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Promo Name') @<> '', DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Promo Name'), ''))));
['Promo Type'] = S: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Promo Type') @<> '', DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Promo Type'), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', '', IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Promo Type') @<> '', DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Promo Type'), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Promo Type') @<> '', DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Promo Type'), ''))));
['Applied Curve Name'] = S: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Curve Name') @<> '', DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Curve Name'), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', '', IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Curve Name') @<> '', DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Curve Name'), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Curve Name') @<> '', DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Curve Name'), ''))));
['PPM Ticket'] = S: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override PPM Ticket') @<> '', DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override PPM Ticket'), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', '', IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override PPM Ticket') @<> '', DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override PPM Ticket'), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override PPM Ticket') @<> '', DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override PPM Ticket'), ''))));
#EndRegion

#Region : Resolved Dates (auxiliary string output)
['Resolved Begin Date'] = S: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Begin Date') @<> '', DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override Begin Date'), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', '', IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Begin Date') @<> '', DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override Begin Date'), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Begin Date') @<> '', DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override Begin Date'), ''))));
['Resolved End Date'] = S: IF(DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override End Date') @<> '', DB('Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, 'Override End Date'), IF(ELPAR('Merch SKU', !Merch SKU, 1) @= '', '', IF(DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override End Date') @<> '', DB('Merch Promo Settings', !Merch Version, ELPAR('Merch SKU', !Merch SKU, 1), !Merch Promo ID, 'Override End Date'), IF(DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override End Date') @<> '', DB('Merch Promo Settings', !Merch Version, 'All SKUs', !Merch Promo ID, 'Override End Date'), ''))));
#EndRegion

FEEDERS;

[]=>DB( 'Merch Promo Settings', !Merch Version, !Merch SKU, !Merch Promo ID, ATTRS( 'Merch Promo Settings Measure', !Merch Promo Settings Measure, 'Applied_Measure' ));


